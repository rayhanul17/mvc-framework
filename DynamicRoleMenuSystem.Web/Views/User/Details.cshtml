@model DynamicRoleMenuSystem.Web.Models.ViewModels.UserDetailsViewModel
@{
    ViewData["Title"] = "User Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>User Details</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                <i class="fas fa-edit"></i> Edit User
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Users
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">User Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.FullName):</dt>
                                <dd class="col-sm-8">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                                        {
                                            <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle me-2" style="width: 48px; height: 48px;">
                                        }
                                        else
                                        {
                                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 48px; height: 48px; font-size: 20px;">
                                                @Model.FullName.FirstOrDefault()
                                            </div>
                                        }
                                        <strong>@Html.DisplayFor(model => model.FullName)</strong>
                                    </div>
                                </dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Email):</dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.Email)
                                    @if (Model.EmailConfirmed)
                                    {
                                        <i class="fas fa-check-circle text-success ms-2" title="Email Confirmed"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-exclamation-circle text-warning ms-2" title="Email Not Confirmed"></i>
                                    }
                                </dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PhoneNumber):</dt>
                                <dd class="col-sm-8">
                                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                                    {
                                        @Html.DisplayFor(model => model.PhoneNumber)
                                        @if (Model.PhoneNumberConfirmed)
                                        {
                                            <i class="fas fa-check-circle text-success ms-2" title="Phone Confirmed"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-exclamation-circle text-warning ms-2" title="Phone Not Confirmed"></i>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Status:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.IsSuperAdmin)
                                    {
                                        <span class="badge bg-danger">SUPER ADMIN</span>
                                    }
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                        
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-5">User ID:</dt>
                                <dd class="col-sm-7"><small class="text-muted">@Model.Id</small></dd>

                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.CreatedAt):</dt>
                                <dd class="col-sm-7">@Model.CreatedAt.ToString("MMM dd, yyyy 'at' HH:mm")</dd>

                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.UpdatedAt):</dt>
                                <dd class="col-sm-7">
                                    @if (Model.UpdatedAt.HasValue)
                                    {
                                        @Model.UpdatedAt.Value.ToString("MMM dd, yyyy 'at' HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Never updated</span>
                                    }
                                </dd>

                                <dt class="col-sm-5">Email Confirmed:</dt>
                                <dd class="col-sm-7">
                                    @if (Model.EmailConfirmed)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">No</span>
                                    }
                                </dd>

                                <dt class="col-sm-5">Phone Confirmed:</dt>
                                <dd class="col-sm-7">
                                    @if (Model.PhoneNumberConfirmed)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">No</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <hr>
                        <div>
                            <h6>Description:</h6>
                            <p class="text-muted">@Model.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Assigned Roles</h5>
                </div>
                <div class="card-body">
                    @if (Model.AssignedRoles.Any())
                    {
                        @foreach (var role in Model.AssignedRoles)
                        {
                            <span class="badge bg-primary me-2 mb-2">@role</span>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No roles assigned to this user.</p>
                    }
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                            <i class="fas fa-edit"></i> Edit User
                        </a>
                        
                        <form asp-controller="User" asp-action="ToggleStatus" asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-@(Model.IsActive ? "warning" : "success") btn-sm w-100" 
                                    onclick="return confirm('Are you sure you want to @(Model.IsActive ? "deactivate" : "activate") this user?')">
                                <i class="fas fa-@(Model.IsActive ? "ban" : "check")"></i> @(Model.IsActive ? "Deactivate" : "Activate") User
                            </button>
                        </form>
                        
                        <form asp-controller="User" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm w-100" 
                                    onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.')">
                                <i class="fas fa-trash"></i> Delete User
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="mb-0">Avatar</h5>
                    </div>
                    <div class="card-body text-center">
                        <img src="@Model.AvatarUrl" alt="User Avatar" class="img-fluid rounded" style="max-height: 200px;">
                    </div>
                </div>
            }
        </div>
    </div>
</div>