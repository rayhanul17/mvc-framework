@model IEnumerable<DynamicRoleMenuSystem.Core.Entities.Menu>
@{
    ViewData["Title"] = "Menu Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Menu Management</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Create New Menu
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Menu Hierarchy</th>
                                <th>Display Name</th>
                                <th>Controller</th>
                                <th>Action</th>
                                <th>URL</th>
                                <th>Order</th>
                                <th>Status</th>
                                <th width="150">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var menu in Model.Where(m => m.ParentId == null).OrderBy(m => m.Order))
                            {
                                <tr>
                                    <td>
                                        <div>
                                            @if (!string.IsNullOrEmpty(menu.Icon))
                                            {
                                                <i class="@menu.Icon me-2"></i>
                                            }
                                            <strong>@menu.Name</strong>
                                        </div>
                                    </td>
                                    <td>@menu.DisplayName</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(menu.Controller))
                                        {
                                            <span class="badge bg-info">@menu.Controller</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(menu.Action))
                                        {
                                            <span class="badge bg-secondary">@menu.Action</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(menu.Url))
                                        {
                                            <code class="small">@menu.Url</code>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">@menu.Order</span>
                                    </td>
                                    <td>
                                        @if (menu.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@menu.Id" class="btn btn-outline-primary btn-sm" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@menu.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete"
                                                        onclick="return confirm('Are you sure you want to delete this menu item? This will also delete all child menu items.')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                
                                @foreach (var child in menu.Children.OrderBy(c => c.Order))
                                {
                                    <tr>
                                        <td>
                                            <div style="padding-left: 20px;">
                                                @if (!string.IsNullOrEmpty(child.Icon))
                                                {
                                                    <i class="@child.Icon me-2"></i>
                                                }
                                                <i class="fas fa-level-up-alt fa-rotate-90 text-muted me-1"></i>
                                                <strong>@child.Name</strong>
                                            </div>
                                        </td>
                                        <td>@child.DisplayName</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(child.Controller))
                                            {
                                                <span class="badge bg-info">@child.Controller</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(child.Action))
                                            {
                                                <span class="badge bg-secondary">@child.Action</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(child.Url))
                                            {
                                                <code class="small">@child.Url</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark">@child.Order</span>
                                        </td>
                                        <td>
                                            @if (child.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Edit" asp-route-id="@child.Id" class="btn btn-outline-primary btn-sm" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@child.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete"
                                                            onclick="return confirm('Are you sure you want to delete this menu item? This will also delete all child menu items.')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-bars fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No menu items found.</p>
                    <a asp-action="Create" class="btn btn-primary">Create First Menu Item</a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table td {
        vertical-align: middle;
    }
    
    .btn-group .btn {
        border-radius: 0.375rem;
        margin-right: 2px;
    }
    
    code.small {
        font-size: 0.8em;
    }
</style>