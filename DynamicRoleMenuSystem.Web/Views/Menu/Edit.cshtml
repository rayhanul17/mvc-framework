@model DynamicRoleMenuSystem.Web.Models.ViewModels.MenuViewModel
@{
    ViewData["Title"] = "Edit Menu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Edit Menu Item</h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Menu
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input asp-for="Id" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" placeholder="e.g., user-management" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                                <small class="form-text text-muted">Internal identifier for the menu item</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DisplayName" class="form-label"></label>
                                <input asp-for="DisplayName" class="form-control" placeholder="e.g., User Management" />
                                <span asp-validation-for="DisplayName" class="text-danger"></span>
                                <small class="form-text text-muted">Text shown in the menu</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Area" class="form-label"></label>
                                <input asp-for="Area" class="form-control" placeholder="e.g., Admin" />
                                <span asp-validation-for="Area" class="text-danger"></span>
                                <small class="form-text text-muted">Optional MVC Area</small>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Controller" class="form-label"></label>
                                <select asp-for="Controller" class="form-control" id="controllerSelect">
                                    <option value="">Select Controller</option>
                                </select>
                                <span asp-validation-for="Controller" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Action" class="form-label"></label>
                                <select asp-for="Action" class="form-control" id="actionSelect">
                                    <option value="">Select Action</option>
                                </select>
                                <span asp-validation-for="Action" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Url" class="form-label"></label>
                                <input asp-for="Url" class="form-control" placeholder="e.g., /User/Index" />
                                <span asp-validation-for="Url" class="text-danger"></span>
                                <small class="form-text text-muted">Custom URL (overrides Controller/Action)</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Icon" class="form-label"></label>
                                <input asp-for="Icon" class="form-control" placeholder="e.g., fas fa-users" />
                                <span asp-validation-for="Icon" class="text-danger"></span>
                                <small class="form-text text-muted">FontAwesome icon class</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ParentId" class="form-label"></label>
                                <select asp-for="ParentId" class="form-control" asp-items="ViewBag.ParentMenus">
                                    <option value="">-- Root Menu --</option>
                                </select>
                                <span asp-validation-for="ParentId" class="text-danger"></span>
                                <small class="form-text text-muted">Parent menu item (leave empty for top-level)</small>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="Order" class="form-label"></label>
                                <input asp-for="Order" class="form-control" type="number" min="0" />
                                <span asp-validation-for="Order" class="text-danger"></span>
                                <small class="form-text text-muted">Display order</small>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">&nbsp;</label>
                                <div class="form-check mt-2">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Update Menu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Menu Preview</h5>
                </div>
                <div class="card-body">
                    <div id="menuPreview" class="p-3 border rounded bg-light">
                        <div class="d-flex align-items-center">
                            <i id="previewIcon" class="fas fa-bars me-2"></i>
                            <span id="previewText">Menu Item</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">Menu Information</h5>
                </div>
                <div class="card-body">
                    <p><strong>Menu ID:</strong> @Model.Id</p>
                    <p><strong>Current Status:</strong> 
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </p>
                    @if (Model.ParentId.HasValue)
                    {
                        <p><strong>Parent Menu:</strong> Yes</p>
                    }
                    else
                    {
                        <p><strong>Level:</strong> Root Level</p>
                    }
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">Common Icons</h5>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-6">
                            <button type="button" class="btn btn-sm btn-outline-secondary w-100" onclick="setIcon('fas fa-home')">
                                <i class="fas fa-home"></i> Home
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-sm btn-outline-secondary w-100" onclick="setIcon('fas fa-users')">
                                <i class="fas fa-users"></i> Users
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-sm btn-outline-secondary w-100" onclick="setIcon('fas fa-cog')">
                                <i class="fas fa-cog"></i> Settings
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-sm btn-outline-secondary w-100" onclick="setIcon('fas fa-chart-bar')">
                                <i class="fas fa-chart-bar"></i> Reports
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        var controllers = @Html.Raw(Json.Serialize(ViewBag.Controllers ?? new Dictionary<string, List<string>>()));
        var currentController = '@Model.Controller';
        var currentAction = '@Model.Action';
        
        function updatePreview() {
            var displayName = $('#DisplayName').val() || 'Menu Item';
            var icon = $('#Icon').val() || 'fas fa-bars';
            
            $('#previewIcon').attr('class', icon + ' me-2');
            $('#previewText').text(displayName);
        }
        
        function setIcon(iconClass) {
            $('#Icon').val(iconClass);
            updatePreview();
        }
        
        $(document).ready(function() {
            // Populate controllers
            var controllerSelect = $('#controllerSelect');
            for (var controller in controllers) {
                var selected = controller === currentController ? ' selected' : '';
                controllerSelect.append('<option value="' + controller + '"' + selected + '>' + controller + '</option>');
            }
            
            // Handle controller change
            $('#controllerSelect').change(function() {
                var selectedController = $(this).val();
                var actionSelect = $('#actionSelect');
                
                actionSelect.empty().append('<option value="">Select Action</option>');
                
                if (selectedController && controllers[selectedController]) {
                    actionSelect.prop('disabled', false);
                    controllers[selectedController].forEach(function(action) {
                        var selected = action === currentAction ? ' selected' : '';
                        actionSelect.append('<option value="' + action + '"' + selected + '>' + action + '</option>');
                    });
                } else {
                    actionSelect.prop('disabled', true);
                }
            });
            
            // Trigger initial population of actions
            $('#controllerSelect').trigger('change');
            
            // Update preview on input change
            $('#DisplayName, #Icon').on('input', updatePreview);
            
            // Initial preview update
            updatePreview();
        });
    </script>
}