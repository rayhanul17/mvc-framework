@model DynamicRoleMenuSystem.Core.Entities.BlogPost

@{
    ViewData["Title"] = "Delete Blog Post";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i> Are you sure you want to delete this post?
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Slug</dt>
                <dd class="col-sm-9"><code>@Model.Slug</code></dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@(Model.Category?.Name ?? "-")</dd>

                <dt class="col-sm-3">Author</dt>
                <dd class="col-sm-9">@(Model.Author?.FullName ?? "-")</dd>

                <dt class="col-sm-3">Summary</dt>
                <dd class="col-sm-9">@(Model.Summary ?? "-")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsPublished)
                    {
                        <span class="badge bg-success">Published</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">Draft</span>
                    }
                </dd>

                <dt class="col-sm-3">View Count</dt>
                <dd class="col-sm-9">@Model.ViewCount</dd>

                <dt class="col-sm-3">Tags</dt>
                <dd class="col-sm-9">@(Model.Tags ?? "-")</dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                @if (Model.PublishedDate.HasValue)
                {
                    <dt class="col-sm-3">Published Date</dt>
                    <dd class="col-sm-9">@Model.PublishedDate.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                }

                @if (Model.UpdatedAt.HasValue)
                {
                    <dt class="col-sm-3">Updated At</dt>
                    <dd class="col-sm-9">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                }
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </form>
        </div>
    </div>
</div>