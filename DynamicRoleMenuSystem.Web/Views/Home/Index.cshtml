@inject Microsoft.Extensions.Options.IOptions<DynamicRoleMenuSystem.Core.Common.AppSettings> AppSettingsOptions
@{
    ViewData["Title"] = "Dashboard";
    var appSettings = AppSettingsOptions.Value;
}

<!-- Hero Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 bg-gradient" style="background: linear-gradient(135deg, var(--bs-primary) 0%, color-mix(in srgb, var(--bs-primary) 80%, var(--bs-secondary)) 100%);">
            <div class="card-body text-white p-4 p-md-5">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        @if (appSettings.Features.Dashboard.ShowWelcomeMessage)
                        {
                            <h1 class="display-5 fw-bold mb-3">
                                Welcome to @appSettings.Branding.OrganizationName
                            </h1>
                            <p class="lead mb-4">
                                @appSettings.Branding.Description
                            </p>
                            <p class="mb-0">
                                <i class="fas fa-quote-left me-2"></i>
                                <em>@appSettings.Branding.Slogan</em>
                                <i class="fas fa-quote-right ms-2"></i>
                            </p>
                        }
                        else
                        {
                            <h1 class="display-5 fw-bold mb-3">Dashboard</h1>
                            <p class="lead mb-0">Manage your system efficiently</p>
                        }
                    </div>
                    <div class="col-md-4 text-center">
                        <div class="d-none d-md-block">
                            @if (!string.IsNullOrEmpty(appSettings.Branding.LogoPath))
                            {
                                <img src="@appSettings.Branding.LogoPath" alt="@appSettings.Branding.OrganizationName" class="img-fluid" style="max-height: 120px; filter: brightness(0) invert(1);">
                            }
                            else
                            {
                                <i class="fas fa-cube fa-5x opacity-75"></i>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Statistics Cards -->
    @if (appSettings.Features.Dashboard.ShowStatistics)
    {
        <div class="row mb-4">
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="card border-0 h-100">
                    <div class="card-body text-center">
                        <div class="d-flex align-items-center justify-content-center mb-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                                <i class="fas fa-users fa-2x text-primary"></i>
                            </div>
                        </div>
                        <h5 class="card-title">Total Users</h5>
                        <h3 class="text-primary mb-0">1,247</h3>
                        <small class="text-success">
                            <i class="fas fa-arrow-up me-1"></i>12% increase
                        </small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="card border-0 h-100">
                    <div class="card-body text-center">
                        <div class="d-flex align-items-center justify-content-center mb-3">
                            <div class="rounded-circle bg-success bg-opacity-10 p-3">
                                <i class="fas fa-chart-line fa-2x text-success"></i>
                            </div>
                        </div>
                        <h5 class="card-title">Active Sessions</h5>
                        <h3 class="text-success mb-0">89</h3>
                        <small class="text-muted">Currently online</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="card border-0 h-100">
                    <div class="card-body text-center">
                        <div class="d-flex align-items-center justify-content-center mb-3">
                            <div class="rounded-circle bg-info bg-opacity-10 p-3">
                                <i class="fas fa-tasks fa-2x text-info"></i>
                            </div>
                        </div>
                        <h5 class="card-title">Menu Items</h5>
                        <h3 class="text-info mb-0">24</h3>
                        <small class="text-muted">System menus</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="card border-0 h-100">
                    <div class="card-body text-center">
                        <div class="d-flex align-items-center justify-content-center mb-3">
                            <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                                <i class="fas fa-shield-alt fa-2x text-warning"></i>
                            </div>
                        </div>
                        <h5 class="card-title">Security</h5>
                        <h3 class="text-warning mb-0">98%</h3>
                        <small class="text-muted">System health</small>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <!-- Quick Actions -->
        @if (appSettings.Features.Dashboard.ShowQuickActions)
        {
            <div class="col-lg-6 mb-4">
                <div class="card border-0 h-100">
                    <div class="card-header bg-transparent border-0 pb-0">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-bolt text-primary me-2"></i>Quick Actions
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "User")" class="btn btn-outline-primary w-100 py-3">
                                    <i class="fas fa-users fa-2x d-block mb-2"></i>
                                    <span>Manage Users</span>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "Menu")" class="btn btn-outline-success w-100 py-3">
                                    <i class="fas fa-list fa-2x d-block mb-2"></i>
                                    <span>Menu Settings</span>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "Role")" class="btn btn-outline-info w-100 py-3">
                                    <i class="fas fa-user-tag fa-2x d-block mb-2"></i>
                                    <span>Role Management</span>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a href="#" class="btn btn-outline-warning w-100 py-3">
                                    <i class="fas fa-cog fa-2x d-block mb-2"></i>
                                    <span>System Settings</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Recent Activity -->
        @if (appSettings.Features.Dashboard.ShowRecentActivity)
        {
            <div class="col-lg-6 mb-4">
                <div class="card border-0 h-100">
                    <div class="card-header bg-transparent border-0 pb-0">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-clock text-info me-2"></i>Recent Activity
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="timeline">
                            <div class="timeline-item d-flex mb-3">
                                <div class="timeline-marker">
                                    <div class="rounded-circle bg-success p-2">
                                        <i class="fas fa-user fa-sm text-white"></i>
                                    </div>
                                </div>
                                <div class="timeline-content ms-3">
                                    <h6 class="mb-1">New user registered</h6>
                                    <small class="text-muted">john.doe@@example.com joined the system</small>
                                    <br>
                                    <small class="text-muted">2 minutes ago</small>
                                </div>
                            </div>
                            <div class="timeline-item d-flex mb-3">
                                <div class="timeline-marker">
                                    <div class="rounded-circle bg-primary p-2">
                                        <i class="fas fa-edit fa-sm text-white"></i>
                                    </div>
                                </div>
                                <div class="timeline-content ms-3">
                                    <h6 class="mb-1">Menu updated</h6>
                                    <small class="text-muted">User Management menu permissions modified</small>
                                    <br>
                                    <small class="text-muted">15 minutes ago</small>
                                </div>
                            </div>
                            <div class="timeline-item d-flex mb-3">
                                <div class="timeline-marker">
                                    <div class="rounded-circle bg-warning p-2">
                                        <i class="fas fa-shield-alt fa-sm text-white"></i>
                                    </div>
                                </div>
                                <div class="timeline-content ms-3">
                                    <h6 class="mb-1">Security scan completed</h6>
                                    <small class="text-muted">System security check passed successfully</small>
                                    <br>
                                    <small class="text-muted">1 hour ago</small>
                                </div>
                            </div>
                            <div class="timeline-item d-flex">
                                <div class="timeline-marker">
                                    <div class="rounded-circle bg-info p-2">
                                        <i class="fas fa-database fa-sm text-white"></i>
                                    </div>
                                </div>
                                <div class="timeline-content ms-3">
                                    <h6 class="mb-1">Database backup</h6>
                                    <small class="text-muted">Scheduled backup completed successfully</small>
                                    <br>
                                    <small class="text-muted">3 hours ago</small>
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-3">
                            <a href="#" class="btn btn-sm btn-outline-secondary">View All Activity</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- System Information -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0">
                <div class="card-header bg-transparent border-0">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-info-circle text-secondary me-2"></i>System Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 col-sm-6 mb-3">
                            <strong>Version:</strong><br>
                            <span class="text-muted">@appSettings.Branding.Version</span>
                        </div>
                        <div class="col-md-3 col-sm-6 mb-3">
                            <strong>Environment:</strong><br>
                            <span class="text-muted">@(ViewContext.HttpContext.RequestServices.GetRequiredService<Microsoft.AspNetCore.Hosting.IWebHostEnvironment>().EnvironmentName)</span>
                        </div>
                        <div class="col-md-3 col-sm-6 mb-3">
                            <strong>Last Login:</strong><br>
                            <span class="text-muted">@DateTime.Now.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                        <div class="col-md-3 col-sm-6 mb-3">
                            <strong>User Role:</strong><br>
                            <span class="text-muted">@(User.IsInRole("Administrator") ? "Administrator" : "User")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Guest Welcome -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 text-center">
                <div class="card-body p-5">
                    <i class="fas fa-lock fa-3x text-muted mb-4"></i>
                    <h3 class="card-title">Access Required</h3>
                    <p class="card-text lead mb-4">
                        Please sign in to access the @appSettings.Branding.OrganizationName management system.
                    </p>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="@Url.Action("Login", "Account")" class="btn btn-primary">
                            <i class="fas fa-sign-in-alt me-2"></i>Sign In
                        </a>
                        @if (appSettings.Features.EnableUserRegistration)
                        {
                            <a href="@Url.Action("Register", "Account")" class="btn btn-outline-primary">
                                <i class="fas fa-user-plus me-2"></i>Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Features Overview -->
    <div class="row mt-5">
        <div class="col-12 text-center mb-4">
            <h4>Platform Features</h4>
            <p class="text-muted">Discover what makes our system powerful</p>
        </div>
        <div class="col-md-4 mb-4">
            <div class="text-center">
                <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center p-3 mb-3">
                    <i class="fas fa-users-cog fa-2x text-primary"></i>
                </div>
                <h5>User Management</h5>
                <p class="text-muted">Comprehensive user administration with role-based access control.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="text-center">
                <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center p-3 mb-3">
                    <i class="fas fa-list-alt fa-2x text-success"></i>
                </div>
                <h5>Dynamic Menus</h5>
                <p class="text-muted">Flexible menu system that adapts to user permissions automatically.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="text-center">
                <div class="rounded-circle bg-info bg-opacity-10 d-inline-flex align-items-center justify-content-center p-3 mb-3">
                    <i class="fas fa-shield-alt fa-2x text-info"></i>
                </div>
                <h5>Security First</h5>
                <p class="text-muted">Built-in security features to protect your data and users.</p>
            </div>
        </div>
    </div>
}
