@model DynamicRoleMenuSystem.Web.ViewComponents.AppBrandingViewModel

@{
    var defaultLogo = "/images/default-logo.svg";
    var logoPath = !string.IsNullOrEmpty(Model.Settings.Branding.LogoPath) 
        ? Model.Settings.Branding.LogoPath 
        : defaultLogo;
}

@switch (Model.Type.ToLower())
{
    case "logo-only":
        <img src="@logoPath" alt="@Model.Settings.Branding.OrganizationName" class="app-logo" style="height: 40px;" onerror="this.src='@defaultLogo'" />
        break;
        
    case "text-only":
        <div class="app-brand-text">
            <span class="app-name">@Model.Settings.Branding.ShortName</span>
        </div>
        break;
        
    case "compact":
        <div class="d-flex align-items-center app-brand-compact">
            <img src="@logoPath" alt="@Model.Settings.Branding.OrganizationName" class="app-logo me-2" style="height: 32px;" onerror="this.src='@defaultLogo'" />
            <span class="app-name fw-bold">@Model.Settings.Branding.ShortName</span>
        </div>
        break;
        
    case "sidebar":
        <div class="sidebar-brand d-flex align-items-center">
            <img src="@logoPath" alt="@Model.Settings.Branding.OrganizationName" class="app-logo me-3" style="height: 40px;" onerror="this.src='@defaultLogo'" />
            <div class="brand-text">
                <h5 class="mb-0 fw-bold text-primary">@Model.Settings.Branding.ShortName</h5>
                <small class="text-muted d-block lh-1">@Model.Settings.Branding.Slogan</small>
            </div>
        </div>
        break;
        
    default: // "full"
        <div class="app-brand-full d-flex align-items-center">
            <img src="@logoPath" alt="@Model.Settings.Branding.OrganizationName" class="app-logo me-3" style="height: 48px;" onerror="this.src='@defaultLogo'" />
            <div class="brand-info">
                <h4 class="mb-1 fw-bold text-primary">@Model.Settings.Branding.OrganizationName</h4>
                <p class="mb-0 text-muted">@Model.Settings.Branding.Slogan</p>
                <small class="text-muted">v@Model.Settings.Branding.Version</small>
            </div>
        </div>
        break;
}