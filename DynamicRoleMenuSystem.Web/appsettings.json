{
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;port=3306;database=mvc_framework_v2;userid=root;pwd=123456;sslmode=none;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "Branding": {
      "OrganizationName": "Dynamic Role Menu System",
      "ShortName": "DRMS",
      "Slogan": "Empowering Dynamic Access Control",
      "Description": "A comprehensive role-based menu management system with dynamic permissions",
      "LogoPath": "/images/logo.png",
      "FaviconPath": "/favicon.ico",
      "Version": "2.0.1",
      "Contact": {
        "Email": "admin@drms.com",
        "Phone": "+1-234-567-8900",
        "Address": "123 Tech Street, Digital City, DC 12345",
        "Website": "https://drms.example.com",
        "SocialMedia": {
          "GitHub": "https://github.com/yourorg/drms",
          "LinkedIn": "https://linkedin.com/company/yourorg",
          "Twitter": "https://twitter.com/yourorg"
        }
      }
    },
    "Theme": {
      "Colors": {
        "Primary": "#007bff",
        "Secondary": "#6c757d",
        "Success": "#28a745",
        "Danger": "#dc3545",
        "Warning": "#ffc107",
        "Info": "#17a2b8",
        "Light": "#f8f9fa",
        "Dark": "#343a40",
        "Background": "#ffffff",
        "Surface": "#f8f9fa",
        "OnPrimary": "#ffffff",
        "OnSecondary": "#ffffff",
        "OnBackground": "#212529",
        "OnSurface": "#212529"
      },
      "DefaultTheme": "light",
      "AllowUserThemeSelection": true,
      "Typography": {
        "FontFamily": "'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif",
        "HeadingFontFamily": "'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif",
        "MonospaceFontFamily": "'JetBrains Mono', 'Courier New', Courier, monospace",
        "BaseFontSize": "1rem",
        "LineHeight": "1.6"
      }
    },
    "Layout": {
      "Sidebar": {
        "IsCollapsible": true,
        "DefaultCollapsed": false,
        "Width": "280px",
        "CollapsedWidth": "80px",
        "ShowIcons": true,
        "ShowTooltips": true
      },
      "Header": {
        "ShowBreadcrumbs": true,
        "ShowUserProfile": true,
        "ShowNotifications": true,
        "ShowThemeToggle": true,
        "ShowSearch": true,
        "Height": "64px"
      },
      "Footer": {
        "Show": true,
        "CopyrightText": "© {year} {organizationName}. All rights reserved.",
        "ShowVersion": true,
        "ShowLinks": true,
        "Links": [
          {
            "Text": "Privacy Policy",
            "Url": "/privacy",
            "OpenInNewTab": false
          },
          {
            "Text": "Terms of Service", 
            "Url": "/terms",
            "OpenInNewTab": false
          },
          {
            "Text": "Documentation",
            "Url": "/docs",
            "OpenInNewTab": true
          },
          {
            "Text": "Support",
            "Url": "/support",
            "OpenInNewTab": false
          }
        ]
      },
      "Content": {
        "MaxWidth": "1400px",
        "Padding": "24px",
        "ShowPageTitle": true,
        "ShowBreadcrumbs": true
      }
    },
    "Security": {
      "RequireHttps": true,
      "EnableTwoFactor": false,
      "SessionTimeoutMinutes": 60,
      "PasswordExpiryDays": 90,
      "RequirePasswordChange": false
    },
    "Features": {
      "EnableUserRegistration": true,
      "EnablePasswordReset": true,
      "EnableEmailConfirmation": false,
      "EnableAuditLog": true,
      "EnableCaching": true,
      "EnableCompression": true,
      "EnableRateLimiting": false,
      "Dashboard": {
        "ShowWelcomeMessage": true,
        "ShowStatistics": true,
        "ShowRecentActivity": true,
        "ShowQuickActions": true,
        "RecentActivityCount": 15
      }
    }
  }
}
