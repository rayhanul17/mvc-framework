@model DynamicRoleMenuSystem.Web.Areas.CustomerSupport.Models.ResolveTicketViewModel
@{
    ViewData["Title"] = "Resolve Ticket";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>Resolve Ticket #@Model.TicketNumber</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Resolve" method="post">
                        <input type="hidden" asp-for="TicketId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="ResolutionNotes" class="form-label"></label>
                            <textarea asp-for="ResolutionNotes" class="form-control" rows="6" 
                                placeholder="Please provide detailed resolution notes including steps taken and final solution"></textarea>
                            <span asp-validation-for="ResolutionNotes" class="text-danger"></span>
                            <small class="form-text text-muted">
                                These notes will be visible to the customer. Be clear and professional.
                            </small>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            <strong>Before resolving:</strong>
                            <ul class="mb-0 mt-2">
                                <li>Ensure the issue has been fully addressed</li>
                                <li>Verify any fixes or changes are working properly</li>
                                <li>Document the solution clearly for future reference</li>
                                <li>Confirm the customer can verify the resolution</li>
                            </ul>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Details" asp-route-id="@Model.TicketId" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to Ticket
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-check-circle"></i> Resolve Ticket
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-header">
                    <h5 class="mb-0">Resolution Guidelines</h5>
                </div>
                <div class="card-body">
                    <h6>Good Resolution Notes Include:</h6>
                    <ul class="small">
                        <li>Root cause of the issue</li>
                        <li>Steps taken to resolve</li>
                        <li>Any workarounds applied</li>
                        <li>Preventive measures for future</li>
                        <li>Links to relevant documentation</li>
                    </ul>
                    
                    <hr>
                    
                    <h6>Next Steps:</h6>
                    <p class="small">
                        After marking as resolved, the ticket will be sent to the customer for confirmation. 
                        The customer can either close the ticket if satisfied or reopen it if the issue persists.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}