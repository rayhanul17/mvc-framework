@model DynamicRoleMenuSystem.Web.Areas.CustomerSupport.Models.AssignTicketViewModel
@{
    ViewData["Title"] = "Assign Ticket";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>Assign Ticket</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Ticket Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Ticket Number:</dt>
                        <dd class="col-sm-8">@Model.TicketNumber</dd>

                        <dt class="col-sm-4">Title:</dt>
                        <dd class="col-sm-8">@Model.Title</dd>
                    </dl>

                    <form asp-action="Assign" method="post">
                        <input type="hidden" asp-for="TicketId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="AssignToUserId" class="form-label"></label>
                            <select asp-for="AssignToUserId" class="form-select">
                                <option value="">-- Select Support Staff --</option>
                                @foreach (var staff in Model.AvailableStaff)
                                {
                                    <option value="@staff.Id">@staff.FullName (@staff.Email)</option>
                                }
                            </select>
                            <span asp-validation-for="AssignToUserId" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-user-check"></i> Assign Ticket
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card bg-light">
                <div class="card-header">
                    <h5 class="mb-0">Available Support Staff Workload</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Staff members and their current ticket count:</p>
                    <ul class="list-group">
                        @foreach (var staff in Model.AvailableStaff)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @staff.FullName
                                <span class="badge bg-primary rounded-pill">0 tickets</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}