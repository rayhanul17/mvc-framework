@model DynamicRoleMenuSystem.Web.Areas.CustomerSupport.Models.DashboardViewModel
@{
    ViewData["Title"] = "Support Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Total Tickets</h6>
                            <h3 class="mb-0">@Model.Statistics.TotalTickets</h3>
                        </div>
                        <i class="fas fa-ticket-alt fa-2x text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Open Tickets</h6>
                            <h3 class="mb-0">@Model.Statistics.OpenTickets</h3>
                        </div>
                        <i class="fas fa-clock fa-2x text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Resolved</h6>
                            <h3 class="mb-0">@Model.Statistics.ResolvedTickets</h3>
                        </div>
                        <i class="fas fa-check-circle fa-2x text-success"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Avg Resolution</h6>
                            <h3 class="mb-0">@Model.Statistics.AverageResolutionHours.ToString("F1")h</h3>
                        </div>
                        <i class="fas fa-hourglass-half fa-2x text-info"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- My Tickets / Unassigned Tickets -->
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        @if (User.IsInRole("SupportManager"))
                        {
                            <text>Unassigned Tickets</text>
                        }
                        else if (User.IsInRole("Support"))
                        {
                            <text>My Assigned Tickets</text>
                        }
                        else
                        {
                            <text>My Tickets</text>
                        }
                    </h5>
                    <a asp-area="CustomerSupport" asp-controller="Ticket" asp-action="Index" class="btn btn-sm btn-primary">
                        View All
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.MyTickets.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Ticket #</th>
                                        <th>Title</th>
                                        <th>Priority</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ticket in Model.MyTickets)
                                    {
                                        <tr>
                                            <td>@ticket.TicketNumber</td>
                                            <td>@ticket.Title</td>
                                            <td>
                                                <span class="badge bg-@GetPriorityColor(ticket.Priority)">
                                                    @ticket.Priority
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@GetStatusColor(ticket.Status)">
                                                    @ticket.Status
                                                </span>
                                            </td>
                                            <td>@ticket.CreatedAt.ToString("MM/dd HH:mm")</td>
                                            <td>
                                                @if (User.IsInRole("SupportManager"))
                                                {
                                                    <a asp-area="CustomerSupport" asp-controller="ManageTicket" 
                                                       asp-action="Assign" asp-route-id="@ticket.Id" 
                                                       class="btn btn-sm btn-info">
                                                        Assign
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-area="CustomerSupport" asp-controller="Ticket" 
                                                       asp-action="Details" asp-route-id="@ticket.Id" 
                                                       class="btn btn-sm btn-info">
                                                        View
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">No tickets to display</p>
                    }
                </div>
            </div>

            <!-- Recent Activity -->
            @if (User.IsInRole("SupportManager") && Model.RecentTickets.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Recent Tickets</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Ticket #</th>
                                        <th>Customer</th>
                                        <th>Assigned To</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ticket in Model.RecentTickets)
                                    {
                                        <tr>
                                            <td>@ticket.TicketNumber</td>
                                            <td>@ticket.Customer?.FullName</td>
                                            <td>
                                                @if (ticket.AssignedTo != null)
                                                {
                                                    @ticket.AssignedTo.FullName
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Unassigned</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-@GetStatusColor(ticket.Status)">
                                                    @ticket.Status
                                                </span>
                                            </td>
                                            <td>
                                                <a asp-area="CustomerSupport" asp-controller="ManageTicket" 
                                                   asp-action="Details" asp-route-id="@ticket.Id" 
                                                   class="btn btn-sm btn-outline-primary">
                                                    View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Notifications & Quick Actions -->
        <div class="col-md-4">
            <!-- Notifications -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        Notifications
                        @if (Model.UnreadNotificationCount > 0)
                        {
                            <span class="badge bg-danger">@Model.UnreadNotificationCount</span>
                        }
                    </h5>
                    <a asp-action="Notifications" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    @if (Model.RecentNotifications.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var notification in Model.RecentNotifications)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1">@notification.Title</h6>
                                            <p class="mb-1 small">@notification.Message</p>
                                            <small class="text-muted">
                                                @notification.CreatedAt.ToString("MM/dd HH:mm")
                                            </small>
                                        </div>
                                        @if (!notification.IsRead)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary mark-read" 
                                                    data-id="@notification.Id">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">No new notifications</p>
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (User.IsInRole("Customer"))
                        {
                            <a asp-area="CustomerSupport" asp-controller="Ticket" asp-action="Create" 
                               class="btn btn-primary">
                                <i class="fas fa-plus"></i> Create New Ticket
                            </a>
                            <a asp-area="CustomerSupport" asp-controller="Ticket" asp-action="Index" 
                               class="btn btn-outline-primary">
                                <i class="fas fa-list"></i> View My Tickets
                            </a>
                        }
                        @if (User.IsInRole("Support"))
                        {
                            <a asp-area="CustomerSupport" asp-controller="SupportTicket" asp-action="MyTickets" 
                               class="btn btn-primary">
                                <i class="fas fa-tasks"></i> My Assigned Tickets
                            </a>
                        }
                        @if (User.IsInRole("SupportManager"))
                        {
                            <a asp-area="CustomerSupport" asp-controller="ManageTicket" asp-action="Unassigned" 
                               class="btn btn-warning">
                                <i class="fas fa-exclamation-triangle"></i> Unassigned Tickets
                            </a>
                            <a asp-area="CustomerSupport" asp-controller="ManageTicket" asp-action="Statistics" 
                               class="btn btn-info">
                                <i class="fas fa-chart-bar"></i> View Statistics
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Mark notification as read
            document.querySelectorAll('.mark-read').forEach(button => {
                button.addEventListener('click', function() {
                    const notificationId = this.dataset.id;
                    fetch('@Url.Action("MarkNotificationAsRead")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify({ id: notificationId })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            this.remove();
                            // Update notification count
                            const badge = document.querySelector('.badge.bg-danger');
                            if (badge) {
                                const count = parseInt(badge.textContent) - 1;
                                if (count > 0) {
                                    badge.textContent = count;
                                } else {
                                    badge.remove();
                                }
                            }
                        }
                    });
                });
            });
        });
    </script>
}

@functions {
    string GetStatusColor(DynamicRoleMenuSystem.Core.Entities.TicketStatus status)
    {
        return status switch
        {
            DynamicRoleMenuSystem.Core.Entities.TicketStatus.New => "primary",
            DynamicRoleMenuSystem.Core.Entities.TicketStatus.Assigned => "info",
            DynamicRoleMenuSystem.Core.Entities.TicketStatus.InProgress => "warning",
            DynamicRoleMenuSystem.Core.Entities.TicketStatus.Resolved => "success",
            DynamicRoleMenuSystem.Core.Entities.TicketStatus.Closed => "secondary",
            DynamicRoleMenuSystem.Core.Entities.TicketStatus.Reopened => "danger",
            _ => "secondary"
        };
    }

    string GetPriorityColor(DynamicRoleMenuSystem.Core.Entities.TicketPriority priority)
    {
        return priority switch
        {
            DynamicRoleMenuSystem.Core.Entities.TicketPriority.Low => "success",
            DynamicRoleMenuSystem.Core.Entities.TicketPriority.Medium => "warning",
            DynamicRoleMenuSystem.Core.Entities.TicketPriority.High => "danger",
            DynamicRoleMenuSystem.Core.Entities.TicketPriority.Urgent => "dark",
            _ => "secondary"
        };
    }
}