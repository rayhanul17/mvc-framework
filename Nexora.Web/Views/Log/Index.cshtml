@model Nexora.Web.Models.LogViewModel
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                    <div class="card-tools">
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                        {
                            <form method="post" asp-action="ArchiveLogs" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-info" onclick="return confirm('Are you sure you want to archive old logs?')">
                                    <i class="fas fa-archive"></i> Archive Old Logs
                                </button>
                            </form>
                        }
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <form method="post" asp-action="CleanupArchives" class="d-inline ms-2">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to cleanup old archives?')">
                                    <i class="fas fa-trash"></i> Cleanup Archives
                                </button>
                            </form>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <!-- Filter Form -->
                    <form method="get" asp-action="Index" class="mb-4">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Table Name</label>
                                <select name="tableName" asp-items="Model.TableNames" class="form-select">
                                    <option value="">All Tables</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Entity ID</label>
                                <input type="number" name="entityId" value="@Model.EntityId" class="form-control" placeholder="Entity ID">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Action</label>
                                <select name="action" class="form-select">
                                    <option value="">All Actions</option>
                                    <option value="Added" selected="@(Model.SelectedAction == "Added")">Added</option>
                                    <option value="Modified" selected="@(Model.SelectedAction == "Modified")">Modified</option>
                                    <option value="Deleted" selected="@(Model.SelectedAction == "Deleted")">Deleted</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Source</label>
                                <select name="source" class="form-select">
                                    <option value="all" selected="@(Model.Source == "all")">All</option>
                                    <option value="log" selected="@(Model.Source == "log")">Current Logs</option>
                                    <option value="archive" selected="@(Model.Source == "archive")">Archived</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Start Date</label>
                                <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">End Date</label>
                                <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">&nbsp;</label>
                                <div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-search"></i> Filter
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                                        <i class="fas fa-redo"></i> Reset
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                    
                    <!-- Logs Table -->
                    <div class="table-responsive">
                        <table id="auditLogsTable" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Date/Time</th>
                                    <th>Table</th>
                                    <th>Entity ID</th>
                                    <th>Action</th>
                                    <th>User</th>
                                    <th>Changes</th>
                                    <th>IP Address</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Logs.Any())
                                {
                                    @foreach (dynamic log in Model.Logs)
                                    {
                                        <tr>
                                            <td>@log.LoggedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            <td>@log.TableName</td>
                                            <td>@log.EntityId</td>
                                            <td>
                                                <span class="badge bg-@(log.Action == "Added" ? "success" : log.Action == "Modified" ? "info" : "danger")">
                                                    @log.Action
                                                </span>
                                            </td>
                                            <td>@(log.User?.FullName ?? "System")</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(log.Changes))
                                                {
                                                    <span title="@log.Changes">
                                                        @(log.Changes.Length > 50 ? log.Changes.Substring(0, 50) + "..." : log.Changes)
                                                    </span>
                                                }
                                            </td>
                                            <td>@log.IpAddress</td>
                                            <td>
                                                @if (log.IsArchived)
                                                {
                                                    <span class="badge bg-secondary">Archived</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary">Active</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("EntityHistory", new { tableName = log.TableName, entityId = log.EntityId })" 
                                                   class="btn btn-sm btn-info" title="View Entity History">
                                                    <i class="fas fa-history"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center">No logs found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { 
                                        tableName = Model.SelectedTableName, 
                                        entityId = Model.EntityId,
                                        action = Model.SelectedAction,
                                        source = Model.Source,
                                        startDate = Model.StartDate,
                                        endDate = Model.EndDate,
                                        page = Model.CurrentPage - 1,
                                        pageSize = Model.PageSize 
                                    })">Previous</a>
                                </li>
                                
                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { 
                                            tableName = Model.SelectedTableName, 
                                            entityId = Model.EntityId,
                                            action = Model.SelectedAction,
                                            source = Model.Source,
                                            startDate = Model.StartDate,
                                            endDate = Model.EndDate,
                                            page = i,
                                            pageSize = Model.PageSize 
                                        })">@i</a>
                                    </li>
                                }
                                
                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { 
                                        tableName = Model.SelectedTableName, 
                                        entityId = Model.EntityId,
                                        action = Model.SelectedAction,
                                        source = Model.Source,
                                        startDate = Model.StartDate,
                                        endDate = Model.EndDate,
                                        page = Model.CurrentPage + 1,
                                        pageSize = Model.PageSize 
                                    })">Next</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#auditLogsTable').DataTable({
                responsive: true,
                order: [[0, 'desc']], // Sort by Date/Time column by default
                columnDefs: [
                    { orderable: false, targets: [8] }, // Disable sorting on Actions column
                    { searchable: false, targets: [8] }, // Disable searching on Actions column
                    { width: "150px", targets: [0] }, // Set width for Date/Time column
                    { width: "100px", targets: [8] } // Set fixed width for Actions column
                ],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    search: "Search audit logs:",
                    lengthMenu: "Show _MENU_ logs per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ audit logs",
                    infoEmpty: "No audit logs found",
                    infoFiltered: "(filtered from _MAX_ total logs)",
                    emptyTable: "No audit logs available",
                    zeroRecords: "No matching audit logs found"
                }
            });
        });
    </script>
}