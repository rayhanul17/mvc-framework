@{
    ViewData["Title"] = "System Logs";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                    <div class="card-tools">
                        @if (await RoleAuthService.IsAdminAsync(User))
                        {
                            <form method="post" asp-action="ArchiveLogs" class="d-inline">
                                <button type="submit" class="btn btn-info btn-sm" onclick="return confirm('Are you sure you want to archive old logs?')">
                                    <i class="fas fa-archive"></i> Archive Old Logs
                                </button>
                            </form>
                        }
                        @if (await RoleAuthService.IsSuperAdminAsync(User))
                        {
                            <form method="post" asp-action="CleanupArchives" class="d-inline ms-2">
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to cleanup old archives?')">
                                    <i class="fas fa-trash"></i> Cleanup Archives
                                </button>
                            </form>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <!-- Enhanced Filter Controls -->
                    <div class="card mb-3">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <button class="btn btn-link text-dark text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="true">
                                    <i class="fas fa-filter"></i> Advanced Filters
                                </button>
                            </h5>
                        </div>
                        <div id="filterCollapse" class="collapse show">
                            <div class="card-body">
                                <!-- First Row of Filters -->
                                <div class="row mb-3">
                                    <div class="col-md-3">
                                        <label for="filterSource" class="form-label">Data Source <span class="text-danger">*</span></label>
                                        <select id="filterSource" class="form-select form-select-sm">
                                            <option value="log" selected>Main Logs (Active)</option>
                                            <option value="archive">Archived Logs</option>
                                            <option value="all">All Logs (Main + Archive)</option>
                                        </select>
                                        <small class="text-muted">Select which log table to search</small>
                                    </div>
                                    <div class="col-md-3">
                                        <label for="filterTableName" class="form-label">Table Name</label>
                                        <select id="filterTableName" class="form-select form-select-sm">
                                            <option value="">All Tables</option>
                                            @foreach (var tableName in ViewBag.TableNames)
                                            {
                                                <option value="@tableName">@tableName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label for="filterRowId" class="form-label">Row ID</label>
                                        <input type="number" id="filterRowId" class="form-control form-control-sm" placeholder="Log Row ID">
                                    </div>
                                    <div class="col-md-2">
                                        <label for="filterEntityId" class="form-label">Entity ID</label>
                                        <input type="number" id="filterEntityId" class="form-control form-control-sm" placeholder="Entity ID">
                                    </div>
                                    <div class="col-md-2">
                                        <label for="filterAction" class="form-label">Action</label>
                                        <select id="filterAction" class="form-select form-select-sm">
                                            <option value="">All Actions</option>
                                            <option value="Create">Create</option>
                                            <option value="Added">Added</option>
                                            <option value="Update">Update</option>
                                            <option value="Modified">Modified</option>
                                            <option value="Delete">Delete</option>
                                            <option value="Deleted">Deleted</option>
                                            <option value="Login">Login</option>
                                            <option value="Logout">Logout</option>
                                            <option value="Error">Error</option>
                                        </select>
                                    </div>
                                </div>
                                
                                <!-- Second Row of Filters -->
                                <div class="row mb-3">
                                    <div class="col-md-3">
                                        <label for="filterUsername" class="form-label">Username</label>
                                        <input type="text" id="filterUsername" class="form-control form-control-sm" placeholder="Search by username">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="filterIpAddress" class="form-label">IP Address</label>
                                        <input type="text" id="filterIpAddress" class="form-control form-control-sm" placeholder="e.g., 192.168.1.1">
                                    </div>
                                    <div class="col-md-2">
                                        <label for="filterStartDate" class="form-label">Start Date</label>
                                        <input type="date" id="filterStartDate" class="form-control form-control-sm">
                                    </div>
                                    <div class="col-md-2">
                                        <label for="filterEndDate" class="form-label">End Date</label>
                                        <input type="date" id="filterEndDate" class="form-control form-control-sm">
                                    </div>
                                    <div class="col-md-2">
                                        <label for="filterKeyword" class="form-label">Keyword</label>
                                        <input type="text" id="filterKeyword" class="form-control form-control-sm" placeholder="Search in changes">
                                    </div>
                                </div>
                                
                                <!-- Quick Date Range Buttons -->
                                <div class="row mb-3">
                                    <div class="col-12">
                                        <label class="form-label">Quick Date Range:</label>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-outline-secondary quick-date" data-range="today">Today</button>
                                            <button type="button" class="btn btn-outline-secondary quick-date" data-range="yesterday">Yesterday</button>
                                            <button type="button" class="btn btn-outline-secondary quick-date" data-range="week">This Week</button>
                                            <button type="button" class="btn btn-outline-secondary quick-date" data-range="month">This Month</button>
                                            <button type="button" class="btn btn-outline-secondary quick-date" data-range="last30">Last 30 Days</button>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Filter Statistics -->
                                <div class="row mb-2">
                                    <div class="col-12">
                                        <div id="filterStats" class="text-muted small" style="display: none;">
                                            <i class="fas fa-info-circle"></i> <span id="filterStatsText"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Filter Action Buttons -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <button type="button" id="applyFilters" class="btn btn-primary">
                                <i class="fas fa-search"></i> Apply Filters
                            </button>
                            <button type="button" id="clearFilters" class="btn btn-secondary ms-2">
                                <i class="fas fa-redo"></i> Clear All
                            </button>
                            <button type="button" id="exportFiltered" class="btn btn-success ms-2">
                                <i class="fas fa-download"></i> Export Filtered
                            </button>
                            <span id="activeFiltersCount" class="ms-3 badge bg-info" style="display: none;">0 Active Filters</span>
                        </div>
                    </div>
                    
                    <!-- DataTable -->
                    <table id="logsTable" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Date/Time</th>
                                <th>Table</th>
                                <th>Entity ID</th>
                                <th>Action</th>
                                <th>User</th>
                                <th>IP Address</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .dataTables_processing {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 200px;
            margin-left: -100px;
            margin-top: -26px;
            text-align: center;
            padding: 20px;
            background-color: rgba(255, 255, 255, 0.95);
            border: 1px solid #ddd;
            border-radius: 5px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            z-index: 10000;
        }
    </style>
    
    <script>
        $(document).ready(function() {
            var table = $('#logsTable').DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: '@Url.Action("GetLogs", "Log")',
                    type: 'POST',
                    contentType: 'application/x-www-form-urlencoded',
                    data: function(d) {
                        // Add all custom filters to the request
                        d.source = $('#filterSource').val() || 'log'; // Default to main logs
                        d.tableName = $('#filterTableName').val();
                        d.rowId = $('#filterRowId').val();
                        d.entityId = $('#filterEntityId').val();
                        d.action = $('#filterAction').val();
                        d.username = $('#filterUsername').val();
                        d.ipAddress = $('#filterIpAddress').val();
                        d.startDate = $('#filterStartDate').val();
                        d.endDate = $('#filterEndDate').val();
                        d.keyword = $('#filterKeyword').val();
                        
                        // Update active filters count
                        updateActiveFiltersCount();
                        
                        return $.param(d);
                    },
                    dataSrc: function(json) {
                        // Ensure processing indicator is hidden when data is received
                        table.processing(false);
                        return json.data || [];
                    },
                    error: function(xhr, error, thrown) {
                        // Hide processing indicator on error
                        table.processing(false);
                        console.error('DataTables AJAX error:', error, thrown);
                    }
                },
                columns: [
                    { 
                        data: 'id', 
                        name: 'Id', 
                        orderable: true,
                        width: '5%'
                    },
                    { 
                        data: 'loggedAt', 
                        name: 'LoggedAt',
                        orderable: true,
                        render: function(data) {
                            if (data) {
                                var date = new Date(data);
                                return date.toLocaleString();
                            }
                            return '-';
                        }
                    },
                    { 
                        data: 'tableName', 
                        name: 'TableName',
                        orderable: true
                    },
                    { 
                        data: 'entityId', 
                        name: 'EntityId',
                        orderable: true,
                        width: '8%'
                    },
                    { 
                        data: 'action', 
                        name: 'Action',
                        orderable: true,
                        render: function(data) {
                            var badgeClass = '';
                            var action = data.toLowerCase();
                            if (action === 'create' || action === 'added') {
                                badgeClass = 'badge bg-success';
                            } else if (action === 'update' || action === 'modified') {
                                badgeClass = 'badge bg-warning';
                            } else if (action === 'delete' || action === 'deleted') {
                                badgeClass = 'badge bg-danger';
                            } else {
                                badgeClass = 'badge bg-secondary';
                            }
                            return '<span class="' + badgeClass + '">' + data + '</span>';
                        }
                    },
                    { 
                        data: null,
                        orderable: false,
                        render: function(data, type, row) {
                            if (row.fullName) {
                                return row.fullName;
                            } else if (row.userName) {
                                return row.userName;
                            }
                            return 'System';
                        }
                    },
                    { 
                        data: 'ipAddress', 
                        orderable: false,
                        render: function(data) {
                            return data || '-';
                        }
                    },
                    { 
                        data: 'isArchived',
                        orderable: false,
                        render: function(data, type, row) {
                            if (data) {
                                var archivedDate = row.archivedAt ? new Date(row.archivedAt).toLocaleDateString() : '';
                                return '<span class="badge bg-secondary" title="Archived on ' + archivedDate + '">Archived</span>';
                            }
                            return '<span class="badge bg-primary">Active</span>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function(data, type, row) {
                            var buttons = '<div class="btn-group btn-group-sm">';
                            
                            // View Details button
                            buttons += '<button class="btn btn-info view-details" data-id="' + row.id + '" title="View Details">';
                            buttons += '<i class="fas fa-eye"></i></button>';
                            
                            // Entity History button
                            buttons += '<a href="@Url.Action("EntityHistory", "Log")?tableName=' + row.tableName + '&entityId=' + row.entityId + '" ';
                            buttons += 'class="btn btn-secondary" title="View Entity History">';
                            buttons += '<i class="fas fa-history"></i></a>';
                            
                            buttons += '</div>';
                            return buttons;
                        }
                    }
                ],
                order: [[1, 'desc']], // Sort by LoggedAt descending by default
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                language: {
                    processing: '<div class="text-center"><i class="fa fa-spinner fa-spin fa-3x fa-fw"></i><br/><span>Loading logs...</span></div>',
                    search: 'Search:',
                    lengthMenu: 'Show _MENU_ entries',
                    info: 'Showing _START_ to _END_ of _TOTAL_ entries',
                    infoEmpty: 'Showing 0 to 0 of 0 entries',
                    infoFiltered: '(filtered from _MAX_ total entries)',
                    paginate: {
                        first: 'First',
                        last: 'Last',
                        next: 'Next',
                        previous: 'Previous'
                    },
                    emptyTable: 'No logs available'
                },
                initComplete: function() {
                    // Ensure processing indicator is hidden after initialization
                    this.api().processing(false);
                }
            });
            
            // Add event handlers to properly manage processing indicator
            table.on('preXhr.dt', function() {
                // Show processing indicator before request
                table.processing(true);
            });
            
            table.on('xhr.dt', function() {
                // Hide processing indicator after successful request
                table.processing(false);
            });
            
            table.on('error.dt', function() {
                // Hide processing indicator on error
                table.processing(false);
            });
            
            // Apply filters button
            $('#applyFilters').on('click', function() {
                table.ajax.reload();
            });
            
            // Clear filters button
            $('#clearFilters').on('click', function() {
                $('#filterSource').val('log'); // Reset to main logs
                $('#filterTableName').val('');
                $('#filterRowId').val('');
                $('#filterEntityId').val('');
                $('#filterAction').val('');
                $('#filterUsername').val('');
                $('#filterIpAddress').val('');
                $('#filterStartDate').val('');
                $('#filterEndDate').val('');
                $('#filterKeyword').val('');
                table.ajax.reload();
                updateActiveFiltersCount();
            });
            
            // Quick date range buttons
            $('.quick-date').on('click', function() {
                var range = $(this).data('range');
                var today = new Date();
                var startDate, endDate;
                
                switch(range) {
                    case 'today':
                        startDate = endDate = today.toISOString().split('T')[0];
                        break;
                    case 'yesterday':
                        var yesterday = new Date(today);
                        yesterday.setDate(today.getDate() - 1);
                        startDate = endDate = yesterday.toISOString().split('T')[0];
                        break;
                    case 'week':
                        var weekStart = new Date(today);
                        weekStart.setDate(today.getDate() - today.getDay());
                        startDate = weekStart.toISOString().split('T')[0];
                        endDate = today.toISOString().split('T')[0];
                        break;
                    case 'month':
                        var monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
                        startDate = monthStart.toISOString().split('T')[0];
                        endDate = today.toISOString().split('T')[0];
                        break;
                    case 'last30':
                        var thirtyDaysAgo = new Date(today);
                        thirtyDaysAgo.setDate(today.getDate() - 30);
                        startDate = thirtyDaysAgo.toISOString().split('T')[0];
                        endDate = today.toISOString().split('T')[0];
                        break;
                }
                
                $('#filterStartDate').val(startDate);
                $('#filterEndDate').val(endDate);
                
                // Highlight selected button
                $('.quick-date').removeClass('btn-primary').addClass('btn-outline-secondary');
                $(this).removeClass('btn-outline-secondary').addClass('btn-primary');
            });
            
            // Export filtered data
            $('#exportFiltered').on('click', function() {
                var filters = {
                    source: $('#filterSource').val() || 'log',
                    tableName: $('#filterTableName').val(),
                    rowId: $('#filterRowId').val(),
                    entityId: $('#filterEntityId').val(),
                    action: $('#filterAction').val(),
                    username: $('#filterUsername').val(),
                    ipAddress: $('#filterIpAddress').val(),
                    startDate: $('#filterStartDate').val(),
                    endDate: $('#filterEndDate').val(),
                    keyword: $('#filterKeyword').val()
                };
                
                // Create form and submit for export
                var form = $('<form>', {
                    'method': 'POST',
                    'action': '@Url.Action("ExportLogs", "Log")'
                });
                
                $.each(filters, function(key, value) {
                    if (value) {
                        form.append($('<input>', {
                            'type': 'hidden',
                            'name': key,
                            'value': value
                        }));
                    }
                });
                
                form.append($('<input>', {
                    'type': 'hidden',
                    'name': '__RequestVerificationToken',
                    'value': $('input[name="__RequestVerificationToken"]').val()
                }));
                
                $('body').append(form);
                form.submit();
                form.remove();
            });
            
            // Function to update active filters count
            function updateActiveFiltersCount() {
                var count = 0;
                var filterInfo = [];
                
                if ($('#filterSource').val() !== 'log') {
                    count++;
                    filterInfo.push('Source: ' + $('#filterSource option:selected').text());
                }
                if ($('#filterTableName').val()) {
                    count++;
                    filterInfo.push('Table: ' + $('#filterTableName').val());
                }
                if ($('#filterRowId').val()) {
                    count++;
                    filterInfo.push('Row ID: ' + $('#filterRowId').val());
                }
                if ($('#filterEntityId').val()) {
                    count++;
                    filterInfo.push('Entity ID: ' + $('#filterEntityId').val());
                }
                if ($('#filterAction').val()) {
                    count++;
                    filterInfo.push('Action: ' + $('#filterAction').val());
                }
                if ($('#filterUsername').val()) {
                    count++;
                    filterInfo.push('User: ' + $('#filterUsername').val());
                }
                if ($('#filterIpAddress').val()) {
                    count++;
                    filterInfo.push('IP: ' + $('#filterIpAddress').val());
                }
                if ($('#filterStartDate').val() || $('#filterEndDate').val()) {
                    count++;
                    filterInfo.push('Date Range');
                }
                if ($('#filterKeyword').val()) {
                    count++;
                    filterInfo.push('Keyword: ' + $('#filterKeyword').val());
                }
                
                if (count > 0) {
                    $('#activeFiltersCount').text(count + ' Active Filter' + (count > 1 ? 's' : '')).show();
                    $('#filterStats').show();
                    $('#filterStatsText').text('Filters: ' + filterInfo.join(', '));
                } else {
                    $('#activeFiltersCount').hide();
                    $('#filterStats').hide();
                }
            }
            
            // Show source indicator
            $('#filterSource').on('change', function() {
                var source = $(this).val();
                var sourceText = $(this).find('option:selected').text();
                
                // Update table header to show current source
                var headerText = 'System Logs - ' + sourceText;
                $('.card-title').first().text(headerText);
                
                // Change card border color based on source
                var cardClass = 'border-primary';
                if (source === 'archive') {
                    cardClass = 'border-secondary';
                } else if (source === 'all') {
                    cardClass = 'border-info';
                }
                
                $('.card').first().removeClass('border-primary border-secondary border-info').addClass(cardClass);
            });
            
            // View details modal
            $(document).on('click', '.view-details', function() {
                var id = $(this).data('id');
                // You can implement a modal or redirect to a details page
                // For now, let's just show an alert
                alert('View details for log ID: ' + id + '\nYou can implement a modal here to show full details including Changes, Old Values, and New Values.');
            });
        });
    </script>
}