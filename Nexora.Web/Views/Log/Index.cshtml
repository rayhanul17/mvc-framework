@model Nexora.Web.Models.LogViewModel
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
        <div class="d-flex gap-2">
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
            {
                <form method="post" asp-action="ArchiveLogs" class="d-inline">
                    <button type="submit" class="btn btn-info" onclick="return confirm('Are you sure you want to archive old logs?')">
                        <i class="fas fa-archive"></i> Archive Old Logs
                    </button>
                </form>
            }
            @if (User.IsInRole("SuperAdmin"))
            {
                <form method="post" asp-action="CleanupArchives" class="d-inline">
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to cleanup old archives?')">
                        <i class="fas fa-trash"></i> Cleanup Archives
                    </button>
                </form>
            }
        </div>
    </div>
    
    <!-- Filter Form -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label">Table Name</label>
                        <select name="tableName" asp-items="Model.TableNames" class="form-select">
                            <option value="">All Tables</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Entity ID</label>
                        <input type="number" name="entityId" value="@Model.EntityId" class="form-control" placeholder="Entity ID">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Action</label>
                        <select name="action" class="form-select">
                            <option value="">All Actions</option>
                            @if (Model.SelectedAction == "Added")
                            {
                                <option value="Added" selected>Added</option>
                            }
                            else
                            {
                                <option value="Added">Added</option>
                            }
                            @if (Model.SelectedAction == "Modified")
                            {
                                <option value="Modified" selected>Modified</option>
                            }
                            else
                            {
                                <option value="Modified">Modified</option>
                            }
                            @if (Model.SelectedAction == "Deleted")
                            {
                                <option value="Deleted" selected>Deleted</option>
                            }
                            else
                            {
                                <option value="Deleted">Deleted</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Source</label>
                        <select name="source" class="form-select">
                            @if (Model.Source == "all")
                            {
                                <option value="all" selected>All Tables</option>
                            }
                            else
                            {
                                <option value="all">All Tables</option>
                            }
                            @if (Model.Source == "log")
                            {
                                <option value="log" selected>Log Main Table</option>
                            }
                            else
                            {
                                <option value="log">Log Main Table</option>
                            }
                            @if (Model.Source == "archive")
                            {
                                <option value="archive" selected>Log Archive Table</option>
                            }
                            else
                            {
                                <option value="archive">Log Archive Table</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Start Date</label>
                        <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control">
                    </div>
                </div>
                <div class="row g-3 align-items-end mt-2">
                    <div class="col-md-2">
                        <label class="form-label">End Date</label>
                        <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control">
                    </div>
                    <div class="col-md-2">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i> Filter
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-redo"></i> Reset
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Logs Table -->
    <div class="card">
        <div class="card-body p-0">
            <!-- Table Controls -->
            <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
                <div class="d-flex align-items-center">
                    <label class="me-2">Show</label>
                    <select class="form-select form-select-sm" style="width: auto;" onchange="changePageSize(this.value)">
                        @if (Model.PageSize == 10)
                        {
                            <option value="10" selected>10</option>
                        }
                        else
                        {
                            <option value="10">10</option>
                        }
                        @if (Model.PageSize == 25)
                        {
                            <option value="25" selected>25</option>
                        }
                        else
                        {
                            <option value="25">25</option>
                        }
                        @if (Model.PageSize == 50)
                        {
                            <option value="50" selected>50</option>
                        }
                        else
                        {
                            <option value="50">50</option>
                        }
                        @if (Model.PageSize == 100)
                        {
                            <option value="100" selected>100</option>
                        }
                        else
                        {
                            <option value="100">100</option>
                        }
                    </select>
                    <label class="ms-2">logs per page</label>
                </div>
                <div>
                    <label>Search audit logs:</label>
                    <input type="text" class="form-control form-control-sm d-inline-block ms-2" style="width: 200px;" id="searchBox" placeholder="Search...">
                </div>
            </div>
            
            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="auditLogsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Date/Time</th>
                            <th>Table</th>
                            <th>Entity ID</th>
                            <th>Action</th>
                            <th>User</th>
                            <th>Changes</th>
                            <th>IP Address</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Logs != null && Model.Logs.Any())
                        {
                            @foreach (dynamic log in Model.Logs)
                            {
                                <tr>
                                    <td>@log.LoggedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@log.TableName</td>
                                    <td>@log.EntityId</td>
                                    <td>
                                        <span class="badge bg-@(log.Action == "Added" ? "success" : log.Action == "Modified" ? "info" : "danger")">
                                            @log.Action
                                        </span>
                                    </td>
                                    <td>@(log.User?.FullName ?? "System")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.Changes))
                                        {
                                            <span title="@log.Changes">
                                                @(log.Changes.Length > 50 ? log.Changes.Substring(0, 50) + "..." : log.Changes)
                                            </span>
                                        }
                                    </td>
                                    <td>@log.IpAddress</td>
                                    <td>
                                        @if (log.IsArchived)
                                        {
                                            <span class="badge bg-secondary">Archived</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">Active</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("EntityHistory", new { tableName = log.TableName, entityId = log.EntityId })" 
                                           class="btn btn-sm btn-info" title="View Entity History">
                                            <i class="fas fa-history"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4">No logs found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination Info and Controls -->
            <div class="d-flex justify-content-between align-items-center p-3 border-top">
                <div>
                    @if (Model.Logs != null && Model.Logs.Any())
                    {
                        var startItem = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
                        var endItem = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
                        <span>Showing @startItem to @endItem of @Model.TotalCount audit logs</span>
                    }
                    else
                    {
                        <span>Showing 0 to 0 of 0 audit logs</span>
                    }
                </div>
                
                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination mb-0">
                            <!-- First Page -->
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { 
                                    tableName = Model.SelectedTableName, 
                                    entityId = Model.EntityId,
                                    action = Model.SelectedAction,
                                    source = Model.Source,
                                    startDate = Model.StartDate,
                                    endDate = Model.EndDate,
                                    page = 1,
                                    pageSize = Model.PageSize 
                                })" aria-label="First">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>
                            
                            <!-- Previous Page -->
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { 
                                    tableName = Model.SelectedTableName, 
                                    entityId = Model.EntityId,
                                    action = Model.SelectedAction,
                                    source = Model.Source,
                                    startDate = Model.StartDate,
                                    endDate = Model.EndDate,
                                    page = Model.CurrentPage - 1,
                                    pageSize = Model.PageSize 
                                })" aria-label="Previous">
                                    <span aria-hidden="true">&lsaquo;</span>
                                </a>
                            </li>
                            
                            <!-- Page Numbers -->
                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { 
                                        tableName = Model.SelectedTableName, 
                                        entityId = Model.EntityId,
                                        action = Model.SelectedAction,
                                        source = Model.Source,
                                        startDate = Model.StartDate,
                                        endDate = Model.EndDate,
                                        page = i,
                                        pageSize = Model.PageSize 
                                    })">@i</a>
                                </li>
                            }
                            
                            <!-- Next Page -->
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { 
                                    tableName = Model.SelectedTableName, 
                                    entityId = Model.EntityId,
                                    action = Model.SelectedAction,
                                    source = Model.Source,
                                    startDate = Model.StartDate,
                                    endDate = Model.EndDate,
                                    page = Model.CurrentPage + 1,
                                    pageSize = Model.PageSize 
                                })" aria-label="Next">
                                    <span aria-hidden="true">&rsaquo;</span>
                                </a>
                            </li>
                            
                            <!-- Last Page -->
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { 
                                    tableName = Model.SelectedTableName, 
                                    entityId = Model.EntityId,
                                    action = Model.SelectedAction,
                                    source = Model.Source,
                                    startDate = Model.StartDate,
                                    endDate = Model.EndDate,
                                    page = Model.TotalPages,
                                    pageSize = Model.PageSize 
                                })" aria-label="Last">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Client-side search functionality
        document.getElementById('searchBox')?.addEventListener('keyup', function(e) {
            const searchValue = e.target.value.toLowerCase();
            const table = document.getElementById('auditLogsTable');
            const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');
            
            for (let i = 0; i < rows.length; i++) {
                const row = rows[i];
                const cells = row.getElementsByTagName('td');
                let found = false;
                
                // Skip if it's the "No logs found" row
                if (cells.length === 1 && cells[0].getAttribute('colspan') === '9') {
                    continue;
                }
                
                for (let j = 0; j < cells.length; j++) {
                    const cellValue = cells[j].textContent || cells[j].innerText;
                    if (cellValue.toLowerCase().indexOf(searchValue) > -1) {
                        found = true;
                        break;
                    }
                }
                
                row.style.display = found ? '' : 'none';
            }
        });
        
        // Change page size
        function changePageSize(size) {
            const url = new URL(window.location.href);
            url.searchParams.set('pageSize', size);
            url.searchParams.set('page', '1'); // Reset to first page
            window.location.href = url.toString();
        }
    </script>
}