@model Nexora.Web.Models.EntityHistoryViewModel
@{
    ViewData["Title"] = $"History for {Model.TableName} (ID: {Model.EntityId})";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                    <div class="card-tools">
                        <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Logs
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        @foreach (dynamic log in Model.Logs.OrderByDescending(l => l.LoggedAt))
                        {
                            <div class="timeline-item">
                                <span class="time">
                                    <i class="fas fa-clock"></i> @log.LoggedAt.ToString("yyyy-MM-dd HH:mm:ss")
                                </span>
                                <h3 class="timeline-header">
                                    <span class="badge bg-@(log.Action == "Create" ? "success" : log.Action == "Update" ? "info" : "danger")">
                                        @log.Action
                                    </span>
                                    by @(log.User?.FullName ?? "System")
                                    @if (log.IsArchived)
                                    {
                                        <span class="badge bg-secondary ms-2">Archived</span>
                                    }
                                </h3>
                                <div class="timeline-body">
                                    @if (!string.IsNullOrEmpty(log.Changes))
                                    {
                                        <p><strong>Changes:</strong> @log.Changes</p>
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(log.OldValues) || !string.IsNullOrEmpty(log.NewValues))
                                    {
                                        <div class="row">
                                            @if (!string.IsNullOrEmpty(log.OldValues))
                                            {
                                                <div class="col-md-6">
                                                    <h5>Old Values:</h5>
                                                    <pre class="bg-light p-2"><code>@FormatJson(log.OldValues)</code></pre>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(log.NewValues))
                                            {
                                                <div class="col-md-6">
                                                    <h5>New Values:</h5>
                                                    <pre class="bg-light p-2"><code>@FormatJson(log.NewValues)</code></pre>
                                                </div>
                                            }
                                        </div>
                                    }
                                    
                                    <p class="text-muted">
                                        <small>
                                            IP: @(log.IpAddress ?? "N/A") | 
                                            User Agent: @(string.IsNullOrEmpty(log.UserAgent) ? "N/A" : 
                                                (log.UserAgent.Length > 50 ? log.UserAgent.Substring(0, 50) + "..." : log.UserAgent))
                                        </small>
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string FormatJson(string json)
    {
        try
        {
            if (string.IsNullOrEmpty(json)) return "";
            var obj = System.Text.Json.JsonSerializer.Deserialize<object>(json);
            return System.Text.Json.JsonSerializer.Serialize(obj, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }
}

<style>
    .timeline {
        position: relative;
        padding: 20px 0;
    }
    
    .timeline::before {
        content: '';
        position: absolute;
        top: 0;
        left: 30px;
        height: 100%;
        width: 3px;
        background: #dee2e6;
    }
    
    .timeline-item {
        position: relative;
        padding-left: 60px;
        margin-bottom: 20px;
    }
    
    .timeline-item::before {
        content: '';
        position: absolute;
        left: 24px;
        top: 5px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #007bff;
        border: 2px solid #fff;
        box-shadow: 0 0 0 3px #dee2e6;
    }
    
    .timeline-header {
        margin: 0 0 10px;
        font-size: 16px;
        font-weight: 600;
    }
    
    .timeline-body {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 4px;
    }
    
    .time {
        color: #6c757d;
        font-size: 14px;
        display: block;
        margin-bottom: 5px;
    }
    
    pre {
        max-height: 300px;
        overflow-y: auto;
        font-size: 12px;
    }
</style>