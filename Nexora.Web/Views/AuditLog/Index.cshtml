@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <!-- Filter Controls -->
                    <div class="row mb-3">
                        <div class="col-md-2">
                            <label for="filterTableName" class="form-label">Table Name</label>
                            <select id="filterTableName" class="form-select form-select-sm">
                                <option value="">All Tables</option>
                                <!-- Options will be populated dynamically -->
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="filterAction" class="form-label">Action</label>
                            <select id="filterAction" class="form-select form-select-sm">
                                <option value="">All Actions</option>
                                <option value="Create">Create</option>
                                <option value="Update">Update</option>
                                <option value="Delete">Delete</option>
                                <option value="Login">Login</option>
                                <option value="Logout">Logout</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="filterUser" class="form-label">User</label>
                            <input type="text" id="filterUser" class="form-control form-control-sm" placeholder="Username">
                        </div>
                        <div class="col-md-2">
                            <label for="filterStartDate" class="form-label">Start Date</label>
                            <input type="date" id="filterStartDate" class="form-control form-control-sm">
                        </div>
                        <div class="col-md-2">
                            <label for="filterEndDate" class="form-label">End Date</label>
                            <input type="date" id="filterEndDate" class="form-control form-control-sm">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="button" id="applyFilters" class="btn btn-primary btn-sm me-2">
                                <i class="fas fa-search"></i> Apply
                            </button>
                            <button type="button" id="clearFilters" class="btn btn-secondary btn-sm">
                                <i class="fas fa-redo"></i> Clear
                            </button>
                        </div>
                    </div>
                    
                    <!-- Quick Date Range Buttons -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label small">Quick Date Range:</label>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-secondary quick-date" data-range="today">Today</button>
                                <button type="button" class="btn btn-outline-secondary quick-date" data-range="yesterday">Yesterday</button>
                                <button type="button" class="btn btn-outline-secondary quick-date" data-range="week">This Week</button>
                                <button type="button" class="btn btn-outline-secondary quick-date" data-range="month">This Month</button>
                                <button type="button" class="btn btn-outline-secondary quick-date" data-range="last7">Last 7 Days</button>
                                <button type="button" class="btn btn-outline-secondary quick-date" data-range="last30">Last 30 Days</button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- DataTable -->
                    <div class="table-responsive">
                        <table id="auditLogTable" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Table Name</th>
                                    <th>Entity ID</th>
                                    <th>Action</th>
                                    <th>User</th>
                                    <th>IP Address</th>
                                    <th>Date/Time</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .dataTables_processing {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 200px;
            margin-left: -100px;
            margin-top: -26px;
            text-align: center;
            padding: 20px;
            background-color: rgba(255, 255, 255, 0.95);
            border: 1px solid #ddd;
            border-radius: 5px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            z-index: 10000;
        }
        
        /* Custom responsive styles */
        @@media (max-width: 768px) {
            .table-responsive {
                font-size: 0.85rem;
            }
            .btn-group-sm .btn {
                padding: 0.125rem 0.25rem;
                font-size: 0.75rem;
            }
        }
    </style>
    
    <script>
        $(document).ready(function() {
            // Add anti-forgery token to the page if not present
            if (!$('input[name="__RequestVerificationToken"]').length) {
                $('body').append('@Html.AntiForgeryToken()'.replace(/<\/?form[^>]*>/g, ''));
            }
            
            var table = $('#auditLogTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetAuditLogs", "AuditLog")',
                    type: 'POST',
                    contentType: 'application/x-www-form-urlencoded',
                    data: function(d) {
                        // Add anti-forgery token to the request
                        d.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();
                        
                        // Add filter parameters
                        d.tableName = $('#filterTableName').val();
                        d.action = $('#filterAction').val();
                        d.userName = $('#filterUser').val();
                        d.startDate = $('#filterStartDate').val();
                        d.endDate = $('#filterEndDate').val();
                        
                        return $.param(d);
                    },
                    dataSrc: function(json) {
                        return json.data || [];
                    },
                    error: function(xhr, error, thrown) {
                        console.error('DataTables AJAX error:', error, thrown);
                        if (xhr.responseText) {
                            console.error('Response:', xhr.responseText);
                        }
                        
                        // Show user-friendly error message
                        if (xhr.status === 400) {
                            toastr.error('Invalid request. Please refresh the page and try again.');
                        } else if (xhr.status === 500) {
                            toastr.error('Server error occurred. Please contact support.');
                        } else {
                            toastr.error('Failed to load audit logs. Please try again.');
                        }
                    }
                },
                columns: [
                    { data: 'id', name: 'Id', orderable: true },
                    { data: 'tableName', name: 'TableName', orderable: true },
                    { data: 'entityId', name: 'EntityId', orderable: true },
                    { 
                        data: 'action', 
                        name: 'Action',
                        orderable: true,
                        render: function(data) {
                            var badgeClass = '';
                            switch(data.toLowerCase()) {
                                case 'create':
                                    badgeClass = 'badge bg-success';
                                    break;
                                case 'update':
                                    badgeClass = 'badge bg-warning';
                                    break;
                                case 'delete':
                                    badgeClass = 'badge bg-danger';
                                    break;
                                default:
                                    badgeClass = 'badge bg-secondary';
                            }
                            return '<span class="' + badgeClass + '">' + data + '</span>';
                        }
                    },
                    { 
                        data: 'userName', 
                        name: 'UserName',
                        orderable: false,
                        render: function(data, type, row) {
                            return data || 'System';
                        }
                    },
                    { 
                        data: 'ipAddress', 
                        name: 'IpAddress',
                        orderable: false,
                        render: function(data) {
                            return data || '-';
                        }
                    },
                    { 
                        data: 'loggedAt', 
                        name: 'LoggedAt',
                        orderable: true,
                        render: function(data) {
                            if (data) {
                                var date = new Date(data);
                                return date.toLocaleString();
                            }
                            return '-';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function(data, type, row) {
                            return '<a href="@Url.Action("Details", "AuditLog")/' + row.id + '" class="btn btn-sm btn-info"><i class="fas fa-eye"></i> View</a>';
                        }
                    }
                ],
                order: [[6, 'desc']],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                language: {
                    processing: '<div class="text-center"><i class="fa fa-spinner fa-spin fa-3x fa-fw"></i><br/><span>Loading audit logs...</span></div>',
                    search: 'Search:',
                    lengthMenu: 'Show _MENU_ entries',
                    info: 'Showing _START_ to _END_ of _TOTAL_ entries',
                    infoEmpty: 'Showing 0 to 0 of 0 entries',
                    infoFiltered: '(filtered from _MAX_ total entries)',
                    paginate: {
                        first: 'First',
                        last: 'Last',
                        next: 'Next',
                        previous: 'Previous'
                    },
                    emptyTable: 'No audit logs available'
                },
                initComplete: function() {
                    console.log('AuditLog DataTable initialized successfully');
                    // Load unique table names for filter dropdown
                    loadTableNames();
                }
            });
            
            // Apply filters button
            $('#applyFilters').on('click', function() {
                table.ajax.reload();
            });
            
            // Clear filters button
            $('#clearFilters').on('click', function() {
                $('#filterTableName').val('');
                $('#filterAction').val('');
                $('#filterUser').val('');
                $('#filterStartDate').val('');
                $('#filterEndDate').val('');
                table.ajax.reload();
            });
            
            // Quick date range buttons
            $('.quick-date').on('click', function() {
                var range = $(this).data('range');
                var today = new Date();
                var startDate, endDate;
                
                switch(range) {
                    case 'today':
                        startDate = endDate = today.toISOString().split('T')[0];
                        break;
                    case 'yesterday':
                        var yesterday = new Date(today);
                        yesterday.setDate(yesterday.getDate() - 1);
                        startDate = endDate = yesterday.toISOString().split('T')[0];
                        break;
                    case 'week':
                        var weekStart = new Date(today);
                        weekStart.setDate(today.getDate() - today.getDay());
                        startDate = weekStart.toISOString().split('T')[0];
                        endDate = today.toISOString().split('T')[0];
                        break;
                    case 'month':
                        var monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
                        startDate = monthStart.toISOString().split('T')[0];
                        endDate = today.toISOString().split('T')[0];
                        break;
                    case 'last7':
                        var week = new Date(today);
                        week.setDate(today.getDate() - 7);
                        startDate = week.toISOString().split('T')[0];
                        endDate = today.toISOString().split('T')[0];
                        break;
                    case 'last30':
                        var month = new Date(today);
                        month.setDate(today.getDate() - 30);
                        startDate = month.toISOString().split('T')[0];
                        endDate = today.toISOString().split('T')[0];
                        break;
                }
                
                $('#filterStartDate').val(startDate);
                $('#filterEndDate').val(endDate);
                table.ajax.reload();
            });
            
            // Function to load table names for dropdown
            function loadTableNames() {
                $.get('@Url.Action("GetTableNames", "AuditLog")', function(data) {
                    var select = $('#filterTableName');
                    select.empty().append('<option value="">All Tables</option>');
                    if (data && data.length > 0) {
                        $.each(data, function(index, tableName) {
                            select.append('<option value="' + tableName + '">' + tableName + '</option>');
                        });
                    }
                }).fail(function() {
                    console.log('Failed to load table names');
                });
            }
        });
    </script>
}