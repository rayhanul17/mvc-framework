@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-8 col-lg-6">
            <div class="card">
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="fas fa-ban text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="card-title text-danger mb-3">Access Denied</h2>
                    <p class="card-text mb-4">You do not have permission to access this resource.</p>
                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="alert alert-info">
                            <p class="mb-2">You are logged in as: <strong>@User.Identity.Name</strong></p>
                            <p class="mb-0">This account doesn't have the required permissions.</p>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-md-2">
                                <i class="fas fa-home"></i> Go to Home
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary">
                                    <i class="fas fa-sign-out-alt"></i> Logout & Login Different Account
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <p class="mb-0">You need to be logged in to access this resource.</p>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-success me-md-2">
                                <i class="fas fa-sign-in-alt"></i> Login
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                                <i class="fas fa-home"></i> Go to Home
                            </a>
                        </div>
                    }
                    
                    <hr class="my-4">
                    <p class="text-muted mb-0">
                        <small>Please contact your administrator if you believe this is an error.</small>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>