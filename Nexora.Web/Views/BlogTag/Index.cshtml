@{
    ViewData["Title"] = "Blog Tags";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-header mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2>
                            <i class="fas fa-tags text-primary me-2"></i>
                            Blog Tags
                        </h2>
                        <p class="text-muted">Manage tags for blog posts</p>
                    </div>
                    <div>
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Add New Tag
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="tagsTable">
                            <thead>
                                <tr>
                                    <th>Tag Name</th>
                                    <th>Post Count</th>
                                    <th>Created Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-secondary">Sample Tag @i</span>
                                        </td>
                                        <td>@(i * 3)</td>
                                        <td>@DateTime.Now.AddDays(-i).ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <a asp-action="Edit" asp-route-id="@i" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete(@i)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/js/dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
    
    <script>
        $(document).ready(function() {
            $('#tagsTable').DataTable({
                "pageLength": 10,
                "order": [[0, "asc"]]
            });
        });

        function confirmDelete(id) {
            if (confirm('Are you sure you want to delete this tag?')) {
                // Show loading mask
                LoadingMask.show({
                    message: 'Deleting tag...',
                    animation: 'pulse'
                });
                
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("Delete", "BlogTag")/' + id;
                
                var token = document.createElement('input');
                token.type = 'hidden';
                token.name = '__RequestVerificationToken';
                token.value = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                form.appendChild(token);
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}