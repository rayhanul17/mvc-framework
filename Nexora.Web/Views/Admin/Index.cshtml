@{
    ViewData["Title"] = "Admin Tools";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2 class="mb-4">Admin Tools</h2>
            
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Database Management</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="card mb-3">
                                <div class="card-body">
                                    <h6 class="card-title">Reseed Database</h6>
                                    <p class="card-text">
                                        This will run the database initialization process, including roles, users, menus, 
                                        and all initial data. Use with caution as it may affect existing data.
                                    </p>
                                    <form asp-action="ReseedData" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-warning" 
                                                onclick="return confirm('Are you sure you want to reseed the database? This operation cannot be undone.');">
                                            <i class="fas fa-database"></i> Reseed Database
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="alert alert-info mt-3">
                        <i class="fas fa-info-circle"></i> 
                        <strong>Note:</strong> This operation is only available to users with SuperAdmin privileges.
                        Always backup your database before performing seeding operations.
                    </div>
                </div>
            </div>
            
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Quick Links</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        <a asp-controller="Menu" asp-action="Index" class="list-group-item list-group-item-action">
                            <i class="fas fa-bars"></i> Menu Management
                        </a>
                        <a asp-controller="Role" asp-action="Index" class="list-group-item list-group-item-action">
                            <i class="fas fa-user-tag"></i> Role Management
                        </a>
                        <a asp-controller="User" asp-action="Index" class="list-group-item list-group-item-action">
                            <i class="fas fa-users"></i> User Management
                        </a>
                        <a asp-controller="Log" asp-action="Index" class="list-group-item list-group-item-action">
                            <i class="fas fa-history"></i> Audit Logs
                        </a>
                        <a asp-controller="SiteSetting" asp-action="Index" class="list-group-item list-group-item-action">
                            <i class="fas fa-sliders-h"></i> Site Settings
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Show success/error messages if any
        $(document).ready(function() {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                toastr.success('@TempData["SuccessMessage"]');
                </text>
            }
            
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                toastr.error('@TempData["ErrorMessage"]');
                </text>
            }
        });
    </script>
}