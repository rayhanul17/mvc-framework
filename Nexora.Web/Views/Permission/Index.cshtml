@using Nexora.Web.Extensions
@model IEnumerable<Nexora.Core.Entities.Permission>
@{
    ViewData["Title"] = "Permission Management";
    var isSuperAdmin = await UserPermissionExtensions.IsSuperAdminAsync(User);
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Permission Management</h2>
        <div>
            @if (await User.CanAccessUrlAsync("/Permission/RolePermissions"))
            {
                <a asp-action="RolePermissions" class="btn btn-info">
                    <i class="fas fa-user-tag"></i> Role Permissions
                </a>
            }
            @if (await User.CanAccessUrlAsync("/Permission/UserPermissions"))
            {
                <a asp-action="UserPermissions" class="btn btn-warning">
                    <i class="fas fa-users"></i> User Permissions
                </a>
            }
            @if (await User.CanAccessUrlAsync("/Permission/Create"))
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Create Permission
                </a>
            }
            @if (isSuperAdmin)
            {
                <a asp-action="TestDashboard" class="btn btn-warning">
                    <i class="fas fa-flask"></i> Test Dashboard
                </a>
            }
        </div>
    </div>

    @if (isSuperAdmin)
    {
        <div class="card mb-3 border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="fas fa-tools"></i> Cache Management (SuperAdmin Only)</h5>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <p class="mb-0">
                            <strong>Permission Cache Status:</strong> 
                            <span id="cacheStatus" class="badge bg-info">Loading...</span>
                        </p>
                        <small class="text-muted">
                            Cached permissions expire after 5 minutes. Clear cache to immediately apply permission changes.
                        </small>
                    </div>
                    <div class="col-md-4 text-end">
                        <button type="button" id="clearCacheBtn" class="btn btn-danger">
                            <i class="fas fa-sync-alt"></i> Clear Permission Cache
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table id="permissionsTable" class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Area</th>
                            <th>Controller</th>
                            <th>Action</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th width="120">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var permission in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@permission.Name</strong>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(permission.Area))
                                    {
                                        <span class="badge bg-primary">@permission.Area</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info">@permission.Controller</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@permission.Action</span>
                                </td>
                                <td>
                                    @(permission.Description ?? "-")
                                </td>
                                <td>
                                    @if (permission.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @permission.CreatedAt.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @if (await User.CanAccessUrlAsync($"/Permission/Edit/{permission.Id}"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@permission.Id" 
                                           class="btn btn-sm btn-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    }
                                    @if (await User.CanAccessUrlAsync($"/Permission/Delete/{permission.Id}"))
                                    {
                                        <button type="button" class="btn btn-sm btn-danger delete-permission" 
                                                data-id="@permission.Id" data-name="@permission.Name" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#permissionsTable').DataTable({
                responsive: true,
                order: [[1, 'asc'], [2, 'asc'], [3, 'asc']], // Sort by Area, Controller, Action
                columnDefs: [
                    { orderable: false, targets: [7] }, // Disable sorting on Actions column
                    { searchable: false, targets: [7] } // Disable searching on Actions column
                ],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]]
            });

            $('.delete-permission').on('click', function() {
                var id = $(this).data('id');
                var name = $(this).data('name');
                
                if (confirm('Are you sure you want to delete the permission: ' + name + '?')) {
                    $.post('@Url.Action("Delete", "Permission")', { id: id }, function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    });
                }
            });

            // Cache management for SuperAdmin
            @if (isSuperAdmin)
            {
                <text>
                // Load cache status
                function loadCacheStatus() {
                    $.get('@Url.Action("CacheStatus", "Permission")', function(response) {
                        if (response.success) {
                            $('#cacheStatus').removeClass('bg-info bg-danger bg-success')
                                .addClass('bg-success')
                                .text(response.cachedItems + ' items cached');
                        } else {
                            $('#cacheStatus').removeClass('bg-info bg-danger bg-success')
                                .addClass('bg-danger')
                                .text('Error loading status');
                        }
                    }).fail(function() {
                        $('#cacheStatus').removeClass('bg-info bg-danger bg-success')
                            .addClass('bg-danger')
                            .text('Failed to load');
                    });
                }

                // Load status on page load
                loadCacheStatus();

                // Clear cache button
                $('#clearCacheBtn').on('click', function() {
                    var btn = $(this);
                    
                    if (confirm('Are you sure you want to clear the permission cache? This will force all permission checks to be re-evaluated.')) {
                        btn.prop('disabled', true);
                        btn.html('<i class="fas fa-spinner fa-spin"></i> Clearing...');
                        
                        $.post('@Url.Action("ClearCache", "Permission")', function(response) {
                            if (response.success) {
                                $('#cacheStatus').removeClass('bg-info bg-danger bg-success')
                                    .addClass('bg-warning')
                                    .text('Cache cleared!');
                                
                                // Show success message
                                alert(response.message + '\nRemaining cached items: ' + response.remainingItems);
                                
                                // Reload cache status after a delay
                                setTimeout(function() {
                                    loadCacheStatus();
                                }, 2000);
                            } else {
                                alert('Error: ' + response.message);
                            }
                        }).fail(function() {
                            alert('Failed to clear cache. Please try again.');
                        }).always(function() {
                            btn.prop('disabled', false);
                            btn.html('<i class="fas fa-sync-alt"></i> Clear Permission Cache');
                        });
                    }
                });

                // Auto-refresh cache status every 30 seconds
                setInterval(loadCacheStatus, 30000);
                </text>
            }
        });
    </script>
}