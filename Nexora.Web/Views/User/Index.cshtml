@model IEnumerable<Nexora.Web.Models.ViewModels.UserViewModel>
@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Users Management</h2>
        @if (await User.CanAccessUrlAsync("/User/CreateEdit"))
        {
            <a asp-action="CreateEdit" class="btn btn-primary">
                <i class="fas fa-plus"></i> Create New User
            </a>
        }
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table id="usersTable" class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.FullName)</th>
                                <th>@Html.DisplayNameFor(model => model.Email)</th>
                                <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
                                <th>Roles</th>
                                <th>@Html.DisplayNameFor(model => model.IsActive)</th>
                                <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                                <th width="200">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(item.AvatarUrl))
                                            {
                                                <img src="@item.AvatarUrl" alt="Avatar" class="rounded-circle me-2" style="width: 32px; height: 32px;">
                                            }
                                            else
                                            {
                                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 14px;">
                                                    @item.FullName.FirstOrDefault()
                                                </div>
                                            }
                                            @Html.DisplayFor(modelItem => item.FullName)
                                        </div>
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                                    <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                                    <td>
                                        @if (item.IsSuperAdmin)
                                        {
                                            <span class="badge bg-danger me-1">SUPER ADMIN</span>
                                        }
                                        @if (item.AssignedRoles.Any())
                                        {
                                            @foreach (var role in item.AssignedRoles)
                                            {
                                                <span class="badge bg-info me-1">@role</span>
                                            }
                                        }
                                        else if (!item.IsSuperAdmin)
                                        {
                                            <span class="text-muted">No roles assigned</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            @if (await User.CanAccessUrlAsync($"/User/Details/{item.Id}"))
                                            {
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            }
                                            @if (await User.CanAccessUrlAsync($"/User/CreateEdit/{item.Id}"))
                                            {
                                                <a asp-action="CreateEdit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            }
                                            @if (await User.CanAccessUrlAsync($"/User/ToggleStatus/{item.Id}"))
                                            {
                                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-warning btn-sm" 
                                                            onclick="return confirm('Are you sure you want to @(item.IsActive ? "deactivate" : "activate") this user?')">
                                                        <i class="fas fa-@(item.IsActive ? "ban" : "check")"></i>
                                                    </button>
                                                </form>
                                            }
                                            @if (await User.CanAccessUrlAsync($"/User/Delete/{item.Id}"))
                                            {
                                                <button type="button" class="btn btn-outline-danger btn-sm" 
                                                        onclick="return showDeleteModal('@Url.Action("Delete", "User", new { id = item.Id })', @Html.Raw(Json.Serialize(item.FullName)), 'user', @Html.Raw(Json.Serialize($"<small class='text-muted'>Email: {item.Email}</small>")))">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No users found.</p>
                    <a asp-action="CreateEdit" class="btn btn-primary">Create First User</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Show loading mask while initializing DataTable
            LoadingMask.show({ message: 'Loading users data...', animation: 'pulse' });
            
            $('#usersTable').DataTable({
                responsive: true,
                order: [[5, 'desc']], // Sort by Created Date column by default
                columnDefs: [
                    { orderable: false, targets: [6] }, // Disable sorting on Actions column
                    { searchable: false, targets: [6] }, // Disable searching on Actions column
                    { width: "200px", targets: [6] } // Set fixed width for Actions column
                ],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                processing: true,
                language: {
                    search: "Search users:",
                    lengthMenu: "Show _MENU_ users per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ users",
                    infoEmpty: "No users found",
                    infoFiltered: "(filtered from _MAX_ total users)",
                    emptyTable: "No users available",
                    zeroRecords: "No matching users found",
                    processing: '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>'
                },
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                initComplete: function() {
                    // Hide loading mask after DataTable is initialized
                    LoadingMask.hide();
                }
            });
        });
    </script>
}