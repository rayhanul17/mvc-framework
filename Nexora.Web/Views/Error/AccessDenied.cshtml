@model ErrorViewModel
@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid d-flex align-items-center justify-content-center min-vh-100">
    <div class="row justify-content-center w-100">
        <div class="col-md-8 col-lg-6">
            <div class="text-center">
                <!-- Error Icon -->
                <div class="mb-4">
                    <i class="fas fa-lock fa-6x text-warning opacity-50"></i>
                </div>

                <!-- Error Code -->
                <h1 class="display-1 fw-bold text-warning">403</h1>
                <h2 class="h4 mb-3">@Model.GetStatusCodeDescription()</h2>
                
                <!-- User-friendly message -->
                <p class="lead text-muted mb-4">
                    @Model.GetUserFriendlyMessage()
                </p>

                <!-- Authentication status -->
                <div class="alert alert-warning" role="alert">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <i class="fas fa-user-shield me-2"></i>
                        <strong>You are logged in as:</strong> @(User.Identity?.Name ?? "Unknown")
                        <br><small>You may not have the required permissions for this resource.</small>
                    }
                    else
                    {
                        <i class="fas fa-sign-in-alt me-2"></i>
                        <strong>You are not logged in.</strong>
                        <br><small>This resource requires authentication.</small>
                    }
                </div>

                <!-- Action buttons -->
                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a href="@Url.Action("Login", "Account", new { returnUrl = Context.Request.Path })" class="btn btn-primary">
                            <i class="fas fa-sign-in-alt me-2"></i>Login
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Dashboard", "Home")" class="btn btn-primary">
                            <i class="fas fa-tachometer-alt me-2"></i>Go to Dashboard
                        </a>
                    }
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                        <i class="fas fa-home me-2"></i>Homepage
                    </a>
                    <button type="button" class="btn btn-outline-secondary" onclick="window.history.back()">
                        <i class="fas fa-arrow-left me-2"></i>Go Back
                    </button>
                </div>

                <!-- Help information -->
                <div class="mt-5">
                    <h6 class="text-muted">Need access to this resource?</h6>
                    <div class="row mt-3">
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-user-plus text-warning me-3 mt-1"></i>
                                <div>
                                    <h6 class="h6">Request Access</h6>
                                    <small class="text-muted">Contact an administrator to request permissions</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-sign-in-alt text-warning me-3 mt-1"></i>
                                <div>
                                    <h6 class="h6">Login Required</h6>
                                    <small class="text-muted">Some features require you to be logged in</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-question-circle text-warning me-3 mt-1"></i>
                                <div>
                                    <h6 class="h6">Get Help</h6>
                                    <small class="text-muted">Contact support if you think this is an error</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Technical details -->
                @if (Model.ShowRequestId)
                {
                    <div class="mt-4">
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#technicalDetails">
                            <i class="fas fa-cog me-1"></i>Technical Details
                        </button>
                        <div class="collapse mt-3" id="technicalDetails">
                            <div class="card">
                                <div class="card-body text-start">
                                    <h6>Debug Information</h6>
                                    <hr>
                                    <div class="row">
                                        <div class="col-sm-3"><strong>Request ID:</strong></div>
                                        <div class="col-sm-9"><code>@Model.RequestId</code></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-3"><strong>Timestamp:</strong></div>
                                        <div class="col-sm-9">@Model.Timestamp.ToString("yyyy-MM-dd HH:mm:ss UTC")</div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-3"><strong>User:</strong></div>
                                        <div class="col-sm-9">@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Anonymous")</div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.OriginalPath))
                                    {
                                        <div class="row">
                                            <div class="col-sm-3"><strong>Path:</strong></div>
                                            <div class="col-sm-9"><code>@Model.OriginalPath</code></div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        body {
            background: linear-gradient(135deg, #fff3cd 0%, #f8d7da 100%);
        }
        
        .min-vh-100 {
            min-height: 100vh;
        }
        
        .opacity-50 {
            opacity: 0.5;
        }
    </style>
}