@model ErrorViewModel
@{
    ViewData["Title"] = "Server Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid d-flex align-items-center justify-content-center min-vh-100">
    <div class="row justify-content-center w-100">
        <div class="col-md-8 col-lg-6">
            <div class="text-center">
                <!-- Error Icon -->
                <div class="mb-4">
                    <i class="fas fa-exclamation-triangle fa-6x text-danger opacity-50"></i>
                </div>

                <!-- Error Code -->
                <h1 class="display-1 fw-bold text-danger">500</h1>
                <h2 class="h4 mb-3">@Model.GetStatusCodeDescription()</h2>
                
                <!-- User-friendly message -->
                <p class="lead text-muted mb-4">
                    @Model.GetUserFriendlyMessage()
                </p>

                <!-- Error status -->
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-server me-2"></i>
                    <strong>We're experiencing technical difficulties.</strong>
                    <br><small>Our team has been notified and is working on a fix.</small>
                </div>

                <!-- Action buttons -->
                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                    <button type="button" class="btn btn-primary" onclick="window.location.reload()">
                        <i class="fas fa-sync-alt me-2"></i>Try Again
                    </button>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                        <i class="fas fa-home me-2"></i>Homepage
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-info">
                            <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                        </a>
                    }
                </div>

                <!-- Status and help -->
                <div class="mt-5">
                    <h6 class="text-muted">What happened?</h6>
                    <div class="row mt-3">
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-cogs text-danger me-3 mt-1"></i>
                                <div>
                                    <h6 class="h6">System Error</h6>
                                    <small class="text-muted">An unexpected error occurred on our servers</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-tools text-danger me-3 mt-1"></i>
                                <div>
                                    <h6 class="h6">Being Fixed</h6>
                                    <small class="text-muted">Our team is working to resolve this issue</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-clock text-danger me-3 mt-1"></i>
                                <div>
                                    <h6 class="h6">Try Later</h6>
                                    <small class="text-muted">Please try again in a few minutes</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Technical details (for debugging) -->
                @if (Model.ShowRequestId || Model.ShowTechnicalDetails)
                {
                    <div class="mt-4">
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#technicalDetails">
                            <i class="fas fa-cog me-1"></i>Technical Details
                        </button>
                        <div class="collapse mt-3" id="technicalDetails">
                            <div class="card">
                                <div class="card-body text-start">
                                    <h6>Debug Information</h6>
                                    <hr>
                                    @if (Model.ShowRequestId)
                                    {
                                        <div class="row">
                                            <div class="col-sm-3"><strong>Request ID:</strong></div>
                                            <div class="col-sm-9"><code>@Model.RequestId</code></div>
                                        </div>
                                    }
                                    <div class="row">
                                        <div class="col-sm-3"><strong>Timestamp:</strong></div>
                                        <div class="col-sm-9">@Model.Timestamp.ToString("yyyy-MM-dd HH:mm:ss UTC")</div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.OriginalPath))
                                    {
                                        <div class="row">
                                            <div class="col-sm-3"><strong>Path:</strong></div>
                                            <div class="col-sm-9"><code>@Model.OriginalPath</code></div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ExceptionType))
                                    {
                                        <div class="row">
                                            <div class="col-sm-3"><strong>Exception:</strong></div>
                                            <div class="col-sm-9"><code>@Model.ExceptionType</code></div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ErrorMessage) && await RoleAuthService.IsAdminAsync(User))
                                    {
                                        <div class="row">
                                            <div class="col-sm-3"><strong>Message:</strong></div>
                                            <div class="col-sm-9"><code>@Model.ErrorMessage</code></div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Report issue (for authenticated users) -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="mt-4">
                        <p class="text-muted small">
                            If this problem persists, please contact support with the Request ID above.
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-retry after 30 seconds (optional)
        setTimeout(function() {
            const retryButton = document.querySelector('[onclick="window.location.reload()"]');
            if (retryButton) {
                retryButton.innerHTML = '<i class="fas fa-sync-alt me-2"></i>Retry Now (Auto-retry in progress)';
                retryButton.classList.add('btn-warning');
                retryButton.classList.remove('btn-primary');
            }
        }, 30000);
    </script>
}

@section Styles {
    <style>
        body {
            background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        }
        
        .min-vh-100 {
            min-height: 100vh;
        }
        
        .opacity-50 {
            opacity: 0.5;
        }
    </style>
}