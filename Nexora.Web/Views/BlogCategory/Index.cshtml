@model IEnumerable<Nexora.Core.Entities.BlogCategory>

@{
    ViewData["Title"] = "Blog Categories";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="CreateEdit" class="btn btn-primary">
                <i class="fas fa-plus"></i> Create New Category
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table id="blogCategoriesTable" class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Slug</th>
                            <th>Description</th>
                            <th>Display Order</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th width="150">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model.OrderBy(c => c.DisplayOrder))
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td><code>@item.Slug</code></td>
                                    <td>@(item.Description ?? "-")</td>
                                    <td>@item.DisplayOrder</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <a asp-action="CreateEdit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger"
                                                onclick="return showDeleteModal('@Url.Action("Delete", "BlogCategory", new { id = item.Id })', @Html.Raw(Json.Serialize(item.Name)), 'blog category', null)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center">No categories found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#blogCategoriesTable').DataTable({
                responsive: true,
                order: [[3, 'asc']], // Sort by Display Order column by default
                columnDefs: [
                    { orderable: false, targets: [6] }, // Disable sorting on Actions column
                    { searchable: false, targets: [6] }, // Disable searching on Actions column
                    { width: "150px", targets: [6] }, // Set fixed width for Actions column
                    { type: "num", targets: [3] } // Treat Display Order column as numeric
                ],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                language: {
                    search: "Search blog categories:",
                    lengthMenu: "Show _MENU_ categories per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ blog categories",
                    infoEmpty: "No blog categories found",
                    infoFiltered: "(filtered from _MAX_ total categories)",
                    emptyTable: "No blog categories available",
                    zeroRecords: "No matching blog categories found"
                }
            });
        });
    </script>
}