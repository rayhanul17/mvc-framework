@{
    ViewData["Title"] = "File Documents";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h6 class="card-title">Total Files</h6>
                    <h3 class="mb-0" id="totalFiles">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h6 class="card-title">Total Size</h6>
                    <h3 class="mb-0">@ViewBag.TotalSize</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h6 class="card-title">Total Downloads</h6>
                    <h3 class="mb-0">@ViewBag.TotalDownloads</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h6 class="card-title">Categories</h6>
                    <h3 class="mb-0">@(((IEnumerable<string>)ViewBag.Categories).Count())</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                    <div class="card-tools">
                        @if (await User.CanAccessUrlAsync("/FileDocument/Upload"))
                        {
                            <a href="@Url.Action("Upload", "FileDocument")" class="btn btn-primary btn-sm">
                                <i class="fas fa-upload"></i> Upload File
                            </a>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <!-- Filter Controls -->
                    <div class="row mb-3">
                        <div class="col-md-2">
                            <label for="filterCategory" class="form-label">Category</label>
                            <select id="filterCategory" class="form-select form-select-sm">
                                <option value="">All Categories</option>
                                @foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="filterExtension" class="form-label">File Type</label>
                            <select id="filterExtension" class="form-select form-select-sm">
                                <option value="">All Types</option>
                                @foreach (var extension in ViewBag.Extensions)
                                {
                                    <option value="@extension">@extension</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="filterStartDate" class="form-label">Start Date</label>
                            <input type="date" id="filterStartDate" class="form-control form-control-sm">
                        </div>
                        <div class="col-md-2">
                            <label for="filterEndDate" class="form-label">End Date</label>
                            <input type="date" id="filterEndDate" class="form-control form-control-sm">
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="button" id="applyFilters" class="btn btn-primary btn-sm me-2">
                                <i class="fas fa-search"></i> Apply Filters
                            </button>
                            <button type="button" id="clearFilters" class="btn btn-secondary btn-sm">
                                <i class="fas fa-redo"></i> Clear
                            </button>
                        </div>
                    </div>
                    
                    <!-- DataTable -->
                    <table id="fileDocumentsTable" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>File Name</th>
                                <th>Category</th>
                                <th>Size</th>
                                <th>Downloads</th>
                                <th>Uploaded</th>
                                <th>Uploaded By</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    
    <style>
        .dataTables_processing {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 200px;
            margin-left: -100px;
            margin-top: -26px;
            text-align: center;
            padding: 20px;
            background-color: rgba(255, 255, 255, 0.95);
            border: 1px solid #ddd;
            border-radius: 5px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            z-index: 10000;
        }
        
        .file-type-badge {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
            border-radius: 0.25rem;
            font-weight: 500;
        }
        
        .file-type-pdf { background-color: #dc3545; color: white; }
        .file-type-doc, .file-type-docx { background-color: #0066cc; color: white; }
        .file-type-xls, .file-type-xlsx { background-color: #28a745; color: white; }
        .file-type-ppt, .file-type-pptx { background-color: #fd7e14; color: white; }
        .file-type-image { background-color: #6c757d; color: white; }
        .file-type-archive { background-color: #6f42c1; color: white; }
        .file-type-media { background-color: #17a2b8; color: white; }
        .file-type-other { background-color: #adb5bd; color: white; }
    </style>
    
    <script>
        $(document).ready(function() {
            var table = $('#fileDocumentsTable').DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: '@Url.Action("GetFileDocuments", "FileDocument")',
                    type: 'POST',
                    contentType: 'application/x-www-form-urlencoded',
                    data: function(d) {
                        // Add custom filters to the request
                        d.category = $('#filterCategory').val();
                        d.fileExtension = $('#filterExtension').val();
                        d.startDate = $('#filterStartDate').val();
                        d.endDate = $('#filterEndDate').val();
                        return $.param(d);
                    },
                    dataSrc: function(json) {
                        // Update total files counter
                        $('#totalFiles').text(json.recordsFiltered);
                        // Ensure processing indicator is hidden when data is received
                        table.processing(false);
                        return json.data || [];
                    },
                    error: function(xhr, error, thrown) {
                        // Hide processing indicator on error
                        table.processing(false);
                        console.error('DataTables AJAX error:', error, thrown);
                    }
                },
                columns: [
                    { 
                        data: 'id', 
                        name: 'Id', 
                        orderable: true,
                        width: '5%'
                    },
                    { 
                        data: 'originalFileName', 
                        name: 'OriginalFileName',
                        orderable: true,
                        render: function(data, type, row) {
                            var truncated = data.length > 40 ? data.substring(0, 40) + '...' : data;
                            var typeClass = getFileTypeClass(row.fileExtension);
                            var badge = '<span class="file-type-badge file-type-' + typeClass + '">' + 
                                       row.fileExtension.toUpperCase() + '</span>';
                            return '<div>' + truncated + '</div>' + badge;
                        }
                    },
                    { 
                        data: 'category', 
                        name: 'Category',
                        orderable: true,
                        render: function(data) {
                            return '<span class="badge bg-secondary">' + data + '</span>';
                        }
                    },
                    { 
                        data: 'fileSize', 
                        name: 'FileSize',
                        orderable: true,
                        width: '10%'
                    },
                    { 
                        data: 'downloadCount', 
                        name: 'DownloadCount',
                        orderable: true,
                        width: '8%',
                        render: function(data) {
                            return '<span class="badge bg-info">' + data + '</span>';
                        }
                    },
                    { 
                        data: 'createdAt', 
                        name: 'CreatedAt',
                        orderable: true,
                        render: function(data) {
                            if (data) {
                                var date = new Date(data);
                                return date.toLocaleDateString();
                            }
                            return '-';
                        }
                    },
                    { 
                        data: 'uploadedBy',
                        orderable: true,
                        render: function(data) {
                            return data || 'Unknown';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function(data, type, row) {
                            var buttons = '<div class="btn-group btn-group-sm">';
                            
                            // Download button
                            buttons += '<a href="@Url.Action("Download", "FileDocument")/' + row.id + '" ';
                            buttons += 'class="btn btn-success" title="Download">';
                            buttons += '<i class="fas fa-download"></i></a>';
                            
                            // View details button
                            buttons += '<button class="btn btn-info view-details" data-id="' + row.id + '" ';
                            buttons += 'data-description="' + (row.description || '') + '" ';
                            buttons += 'data-tags="' + (row.tags || '') + '" title="View Details">';
                            buttons += '<i class="fas fa-eye"></i></button>';
                            
                            // Delete button (if user has permission)
                            @if (await User.CanAccessUrlAsync("/FileDocument/Delete"))
                            {
                                @Html.Raw("buttons += '<button class=\"btn btn-danger delete-file\" data-id=\"' + row.id + '\" title=\"Delete\">';");
                                @Html.Raw("buttons += '<i class=\"fas fa-trash\"></i></button>';");
                            }
                            
                            buttons += '</div>';
                            return buttons;
                        }
                    }
                ],
                order: [[5, 'desc']], // Sort by upload date descending by default
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                language: {
                    processing: '<div class="text-center"><i class="fa fa-spinner fa-spin fa-3x fa-fw"></i><br/><span>Loading files...</span></div>',
                    search: 'Search:',
                    lengthMenu: 'Show _MENU_ entries',
                    info: 'Showing _START_ to _END_ of _TOTAL_ files',
                    infoEmpty: 'Showing 0 to 0 of 0 files',
                    infoFiltered: '(filtered from _MAX_ total files)',
                    paginate: {
                        first: 'First',
                        last: 'Last',
                        next: 'Next',
                        previous: 'Previous'
                    },
                    emptyTable: 'No files available'
                },
                initComplete: function() {
                    // Ensure processing indicator is hidden after initialization
                    this.api().processing(false);
                }
            });
            
            // Add event handlers to properly manage processing indicator
            table.on('preXhr.dt', function() {
                // Show processing indicator before request
                table.processing(true);
            });
            
            table.on('xhr.dt', function() {
                // Hide processing indicator after successful request
                table.processing(false);
            });
            
            table.on('error.dt', function() {
                // Hide processing indicator on error
                table.processing(false);
            });
            
            // Apply filters button
            $('#applyFilters').on('click', function() {
                table.ajax.reload();
            });
            
            // Clear filters button
            $('#clearFilters').on('click', function() {
                $('#filterCategory').val('');
                $('#filterExtension').val('');
                $('#filterStartDate').val('');
                $('#filterEndDate').val('');
                table.ajax.reload();
            });
            
            // View details modal
            $(document).on('click', '.view-details', function() {
                var description = $(this).data('description');
                var tags = $(this).data('tags');
                var message = 'Description: ' + (description || 'N/A') + '\n\nTags: ' + (tags || 'N/A');
                alert(message);
            });
            
            // Delete file
            $(document).on('click', '.delete-file', function() {
                if (confirm('Are you sure you want to delete this file?')) {
                    var id = $(this).data('id');
                    var form = $('<form>', {
                        'method': 'POST',
                        'action': '@Url.Action("Delete", "FileDocument")'
                    });
                    form.append($('<input>', {
                        'type': 'hidden',
                        'name': 'id',
                        'value': id
                    }));
                    form.append($('<input>', {
                        'type': 'hidden',
                        'name': '__RequestVerificationToken',
                        'value': $('input[name="__RequestVerificationToken"]').val()
                    }));
                    $('body').append(form);
                    form.submit();
                }
            });
            
            function getFileTypeClass(extension) {
                extension = extension.toLowerCase().replace('.', '');
                
                if (extension === 'pdf') return 'pdf';
                if (['doc', 'docx'].includes(extension)) return 'doc';
                if (['xls', 'xlsx'].includes(extension)) return 'xls';
                if (['ppt', 'pptx'].includes(extension)) return 'ppt';
                if (['jpg', 'jpeg', 'png', 'gif', 'bmp', 'svg', 'webp'].includes(extension)) return 'image';
                if (['zip', 'rar', '7z', 'tar', 'gz'].includes(extension)) return 'archive';
                if (['mp3', 'mp4', 'avi', 'mov', 'wmv', 'flv'].includes(extension)) return 'media';
                
                return 'other';
            }
        });
    </script>
}