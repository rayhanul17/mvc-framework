@{
    ViewData["Title"] = "Blog Comments";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-header mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2>
                            <i class="fas fa-comments text-primary me-2"></i>
                            Blog Comments
                        </h2>
                        <p class="text-muted">Manage comments on blog posts</p>
                    </div>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-primary active">All Comments</button>
                        <button type="button" class="btn btn-outline-warning">Pending</button>
                        <button type="button" class="btn btn-outline-success">Approved</button>
                        <button type="button" class="btn btn-outline-danger">Rejected</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped" id="commentsTable">
                            <thead>
                                <tr>
                                    <th>Comment</th>
                                    <th>Author</th>
                                    <th>Post</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 1; i <= 10; i++)
                                {
                                    var statuses = new[] { "Pending", "Approved", "Rejected" };
                                    var status = statuses[i % 3];
                                    var statusClass = status == "Pending" ? "warning" : status == "Approved" ? "success" : "danger";
                                    
                                    <tr>
                                        <td>
                                            <div class="comment-preview">
                                                This is sample comment #@i. Great blog post!
                                            </div>
                                        </td>
                                        <td>User @i</td>
                                        <td>Sample Blog Post @((i % 3) + 1)</td>
                                        <td>@DateTime.Now.AddHours(-i).ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>
                                            <span class="badge bg-@statusClass">@status</span>
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                @if (status == "Pending")
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="approveComment(@i)">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-warning" onclick="rejectComment(@i)">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                }
                                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#replyModal" data-comment-id="@i">
                                                    <i class="fas fa-reply"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteComment(@i)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reply Modal -->
<div class="modal fade" id="replyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="replyForm" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Reply to Comment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="commentId" name="id" />
                    <div class="mb-3">
                        <label for="replyText" class="form-label">Your Reply</label>
                        <textarea class="form-control" id="replyText" name="replyText" rows="4" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Post Reply</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/js/dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
    
    <script>
        $(document).ready(function() {
            $('#commentsTable').DataTable({
                "pageLength": 10,
                "order": [[3, "desc"]]
            });
        });

        var replyModal = document.getElementById('replyModal');
        replyModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var commentId = button.getAttribute('data-comment-id');
            document.getElementById('commentId').value = commentId;
            document.getElementById('replyForm').action = '@Url.Action("Reply", "BlogComment")/' + commentId;
        });

        function approveComment(id) {
            window.location.href = '@Url.Action("Approve", "BlogComment")/' + id;
        }

        function rejectComment(id) {
            window.location.href = '@Url.Action("Reject", "BlogComment")/' + id;
        }

        function deleteComment(id) {
            if (confirm('Are you sure you want to delete this comment?')) {
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("Delete", "BlogComment")/' + id;
                
                var token = document.createElement('input');
                token.type = 'hidden';
                token.name = '__RequestVerificationToken';
                token.value = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                form.appendChild(token);
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
    
    <style>
        .comment-preview {
            max-width: 300px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
    </style>
}