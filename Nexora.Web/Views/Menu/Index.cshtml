@model IEnumerable<Nexora.Core.Entities.Menu>
@{
    ViewData["Title"] = "Menu Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Menu Management</h2>
        <a asp-action="CreateEdit" class="btn btn-primary">
            <i class="fas fa-plus"></i> Create New Menu
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table id="menusTable" class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Menu Hierarchy</th>
                                <th>Display Name</th>
                                <th>Controller</th>
                                <th>Action</th>
                                <th>URL</th>
                                <th>Order</th>
                                <th>Status</th>
                                <th width="150">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var menu in Model.Where(m => m.ParentId == null).OrderBy(m => m.Order))
                            {
                                <tr>
                                    <td>
                                        <div>
                                            @if (!string.IsNullOrEmpty(menu.Icon))
                                            {
                                                <i class="@menu.Icon me-2"></i>
                                            }
                                            <strong>@menu.Name</strong>
                                        </div>
                                    </td>
                                    <td>@menu.DisplayName</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(menu.Controller))
                                        {
                                            <span class="badge bg-info">@menu.Controller</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(menu.Action))
                                        {
                                            <span class="badge bg-secondary">@menu.Action</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(menu.Url))
                                        {
                                            <code class="small">@menu.Url</code>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">@menu.Order</span>
                                    </td>
                                    <td>
                                        @if (menu.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="CreateEdit" asp-route-id="@menu.Id" class="btn btn-outline-primary btn-sm" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger btn-sm" title="Delete"
                                                    onclick="return showDeleteModal('@Url.Action("Delete", "Menu", new { id = menu.Id })', @Html.Raw(Json.Serialize(menu.Name)), 'menu item', '<small class=\'text-warning\'>⚠️ This will also delete all child menu items.</small>')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                
                                @foreach (var child in menu.Children.OrderBy(c => c.Order))
                                {
                                    <tr>
                                        <td>
                                            <div style="padding-left: 20px;">
                                                @if (!string.IsNullOrEmpty(child.Icon))
                                                {
                                                    <i class="@child.Icon me-2"></i>
                                                }
                                                <i class="fas fa-level-up-alt fa-rotate-90 text-muted me-1"></i>
                                                <strong>@child.Name</strong>
                                            </div>
                                        </td>
                                        <td>@child.DisplayName</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(child.Controller))
                                            {
                                                <span class="badge bg-info">@child.Controller</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(child.Action))
                                            {
                                                <span class="badge bg-secondary">@child.Action</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(child.Url))
                                            {
                                                <code class="small">@child.Url</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark">@child.Order</span>
                                        </td>
                                        <td>
                                            @if (child.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="CreateEdit" asp-route-id="@child.Id" class="btn btn-outline-primary btn-sm" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <button type="button" class="btn btn-outline-danger btn-sm" title="Delete"
                                                        onclick="return showDeleteModal('@Url.Action("Delete", "Menu", new { id = child.Id })', @Html.Raw(Json.Serialize(child.Name)), 'menu item', '<small class=\'text-warning\'>⚠️ This will also delete all child menu items.</small>')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-bars fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No menu items found.</p>
                    <a asp-action="CreateEdit" class="btn btn-primary">Create First Menu Item</a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table td {
        vertical-align: middle;
    }
    
    .btn-group .btn {
        border-radius: 0.375rem;
        margin-right: 2px;
    }
    
    code.small {
        font-size: 0.8em;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#menusTable').DataTable({
                responsive: true,
                order: [[5, 'asc']], // Sort by Order column by default
                columnDefs: [
                    { orderable: false, targets: [7] }, // Disable sorting on Actions column
                    { searchable: false, targets: [7] }, // Disable searching on Actions column
                    { width: "150px", targets: [7] }, // Set fixed width for Actions column
                    { type: "num", targets: [5] } // Treat Order column as numeric
                ],
                pageLength: 50,
                lengthMenu: [[25, 50, 100, -1], [25, 50, 100, "All"]],
                language: {
                    search: "Search menus:",
                    lengthMenu: "Show _MENU_ menus per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ menu items",
                    infoEmpty: "No menu items found",
                    infoFiltered: "(filtered from _MAX_ total menu items)",
                    emptyTable: "No menu items available",
                    zeroRecords: "No matching menu items found"
                }
            });
        });
    </script>
}