@model Nexora.Web.Models.ViewModels.BlogImportResult
@{
    ViewData["Title"] = "Import Results";
    var isSuccess = Model.Success && Model.FailedCount == 0;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header @(isSuccess ? "bg-success" : "bg-warning")">
                    <h3 class="card-title text-white">
                        <i class="fas @(isSuccess ? "fa-check-circle" : "fa-exclamation-triangle")"></i> 
                        @ViewData["Title"]
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12">
                            @if (isSuccess)
                            {
                                <div class="alert alert-success">
                                    <h4><i class="fas fa-check"></i> Import Completed Successfully!</h4>
                                    <p>@Model.Message</p>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    <h4><i class="fas fa-exclamation-triangle"></i> Import Completed with Issues</h4>
                                    <p>@Model.Message</p>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4">
                            <div class="info-box">
                                <span class="info-box-icon bg-success"><i class="fas fa-plus"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Posts Created</span>
                                    <span class="info-box-number">@Model.ImportedCount</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-box">
                                <span class="info-box-icon bg-info"><i class="fas fa-edit"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Posts Updated</span>
                                    <span class="info-box-number">@Model.UpdatedCount</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-box">
                                <span class="info-box-icon bg-danger"><i class="fas fa-times"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Failed</span>
                                    <span class="info-box-number">@Model.FailedCount</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    @if (Model.Errors != null && Model.Errors.Any())
                    {
                        <div class="row">
                            <div class="col-12">
                                <h4>Import Errors:</h4>
                                <div class="alert alert-danger">
                                    <ul>
                                        @foreach (var error in Model.Errors)
                                        {
                                            <li>@error</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                    
                    <div class="row">
                        <div class="col-12">
                            <h4>Summary:</h4>
                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <td><strong>Total Rows Processed:</strong></td>
                                        <td>@Model.Statistics.TotalRows</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Valid Rows:</strong></td>
                                        <td>@Model.Statistics.ValidRows</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Invalid Rows:</strong></td>
                                        <td>@Model.Statistics.InvalidRows</td>
                                    </tr>
                                    <tr>
                                        <td><strong>New Posts Created:</strong></td>
                                        <td>@Model.ImportedCount</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Existing Posts Updated:</strong></td>
                                        <td>@Model.UpdatedCount</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-12">
                            <div class="form-group">
                                <a href="@Url.Action("Index", "BlogPost")" class="btn btn-primary">
                                    <i class="fas fa-list"></i> View All Posts
                                </a>
                                <a href="@Url.Action("Index", "BlogImport")" class="btn btn-secondary">
                                    <i class="fas fa-file-import"></i> Import More Posts
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>