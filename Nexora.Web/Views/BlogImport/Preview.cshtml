@model Nexora.Web.Models.ViewModels.BlogImportPreviewViewModel
@{
    ViewData["Title"] = "Preview Import Data";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Statistics Card -->
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Import Preview</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="info-box">
                                <span class="info-box-icon bg-info"><i class="fas fa-file-excel"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Total Rows</span>
                                    <span class="info-box-number">@Model.Statistics.TotalRows</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-box">
                                <span class="info-box-icon bg-success"><i class="fas fa-check"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Valid Rows</span>
                                    <span class="info-box-number">@Model.Statistics.ValidRows</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-box">
                                <span class="info-box-icon bg-danger"><i class="fas fa-times"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Invalid Rows</span>
                                    <span class="info-box-number">@Model.Statistics.InvalidRows</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-box">
                                <span class="info-box-icon bg-warning"><i class="fas fa-cog"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Import Mode</span>
                                    <span class="info-box-number small">@Model.Mode</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Invalid Rows (if any) -->
            @if (Model.InvalidRows.Any())
            {
                <div class="card border-danger">
                    <div class="card-header bg-danger">
                        <h3 class="card-title text-white">
                            <i class="fas fa-exclamation-triangle"></i> Invalid Rows (@Model.InvalidRows.Count)
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool text-white" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-warning">
                            <i class="fas fa-info-circle"></i> These rows contain validation errors and will be skipped during import.
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm">
                                <thead>
                                    <tr>
                                        <th>Row</th>
                                        <th>Title</th>
                                        <th>Slug</th>
                                        <th>Category</th>
                                        <th>Errors</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.InvalidRows)
                                    {
                                        <tr>
                                            <td>@row.RowNumber</td>
                                            <td>@row.Title</td>
                                            <td>@row.Slug</td>
                                            <td>@row.Category</td>
                                            <td>
                                                <ul class="mb-0">
                                                    @foreach (var error in row.Errors)
                                                    {
                                                        <li class="text-danger">@error</li>
                                                    }
                                                </ul>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Valid Rows -->
            <div class="card">
                <div class="card-header bg-success">
                    <h3 class="card-title text-white">
                        <i class="fas fa-check-circle"></i> Valid Rows (@Model.ValidRows.Count)
                    </h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool text-white" data-card-widget="collapse">
                            <i class="fas fa-minus"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.ValidRows.Any())
                    {
                        <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                            <table class="table table-bordered table-sm table-hover">
                                <thead class="thead-light sticky-top">
                                    <tr>
                                        <th>Row</th>
                                        <th>Title</th>
                                        <th>Slug</th>
                                        <th>Category</th>
                                        <th>Tags</th>
                                        <th>Author</th>
                                        <th>Publish Date</th>
                                        <th>Published</th>
                                        <th>Featured</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.ValidRows)
                                    {
                                        <tr>
                                            <td>@row.RowNumber</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(row.Title))
                                                {
                                                    <span title="@row.Title">
                                                        @(row.Title.Length > 50 ? row.Title.Substring(0, 50) + "..." : row.Title)
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <small class="text-muted">@row.Slug</small>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(row.Category))
                                                {
                                                    <span class="badge badge-info">@row.Category</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(row.Tags))
                                                {
                                                    @foreach (var tag in row.Tags.Split(','))
                                                    {
                                                        <span class="badge badge-secondary">@tag.Trim()</span>
                                                    }
                                                }
                                            </td>
                                            <td>@row.Author</td>
                                            <td>@row.PublishDate?.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                @if (row.IsPublished == true)
                                                {
                                                    <span class="badge badge-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">No</span>
                                                }
                                            </td>
                                            <td>
                                                @if (row.IsFeatured == true)
                                                {
                                                    <span class="badge badge-warning">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">No</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i> No valid rows found in the uploaded file.
                        </div>
                    }
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Import Settings:</h5>
                            <ul>
                                <li>Mode: <strong>@Model.Mode</strong></li>
                                <li>Update Existing: <strong>@(Model.UpdateExisting ? "Yes" : "No")</strong></li>
                                <li>Create Categories: <strong>@(Model.CreateCategories ? "Yes" : "No")</strong></li>
                                <li>Create Tags: <strong>@(Model.CreateTags ? "Yes" : "No")</strong></li>
                            </ul>
                        </div>
                        <div class="col-md-6 text-right">
                            @if (Model.ValidRows.Any())
                            {
                                <form asp-action="ConfirmImport" asp-controller="BlogImport" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="tempFileName" value="@Model.TempFileName" />
                                    <input type="hidden" name="mode" value="@Model.Mode" />
                                    <input type="hidden" name="updateExisting" value="@Model.UpdateExisting.ToString()" />
                                    <input type="hidden" name="createCategories" value="@Model.CreateCategories.ToString()" />
                                    <input type="hidden" name="createTags" value="@Model.CreateTags.ToString()" />
                                    
                                    <button type="submit" class="btn btn-success btn-lg" 
                                            onclick="return confirm('Are you sure you want to import @Model.ValidRows.Count posts?');">
                                        <i class="fas fa-check"></i> Confirm Import (@Model.ValidRows.Count posts)
                                    </button>
                                </form>
                            }
                            
                            <form asp-action="CancelImport" asp-controller="BlogImport" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="tempFileName" value="@Model.TempFileName" />
                                <button type="submit" class="btn btn-secondary btn-lg">
                                    <i class="fas fa-times"></i> Cancel
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Enable card widget
            $('[data-card-widget="collapse"]').on('click', function() {
                $(this).closest('.card').CardWidget('toggle');
            });
        });
    </script>
}