@model Nexora.Web.Models.ViewModels.BlogImportViewModel
@{
    ViewData["Title"] = "Import Blog Posts from Excel";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                    <div class="card-tools">
                        <a href="@Url.Action("DownloadTemplate", "BlogImport")" class="btn btn-sm btn-info">
                            <i class="fas fa-download"></i> Download Template
                        </a>
                        <a href="@Url.Action("Index", "BlogPost")" class="btn btn-sm btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Posts
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="Upload" asp-controller="BlogImport" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="ExcelFile" class="control-label"></label>
                                    <div class="custom-file">
                                        <input type="file" class="custom-file-input" id="excelFile" asp-for="ExcelFile" accept=".xlsx,.xls" required>
                                        <label class="custom-file-label" for="excelFile">Choose Excel file...</label>
                                    </div>
                                    <span asp-validation-for="ExcelFile" class="text-danger"></span>
                                    <small class="form-text text-muted">
                                        Accepted formats: .xlsx, .xls (Max size: 10MB)
                                    </small>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Mode" class="control-label"></label>
                                    <select asp-for="Mode" class="form-control">
                                        <option value="CreateNew">Create New Posts Only</option>
                                        <option value="UpdateExisting">Update Existing Posts Only</option>
                                        <option value="CreateOrUpdate">Create New or Update Existing</option>
                                    </select>
                                    <span asp-validation-for="Mode" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" id="updateExisting" asp-for="UpdateExisting">
                                        <label class="custom-control-label" for="updateExisting">
                                            Update existing posts if slug matches
                                        </label>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="form-group">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" id="createCategories" asp-for="CreateCategories" checked>
                                        <label class="custom-control-label" for="createCategories">
                                            Create categories if they don't exist
                                        </label>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="form-group">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" id="createTags" asp-for="CreateTags" checked>
                                        <label class="custom-control-label" for="createTags">
                                            Create tags if they don't exist
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-upload"></i> Upload and Preview
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="card mt-3">
                <div class="card-header">
                    <h4 class="card-title">Import Instructions</h4>
                </div>
                <div class="card-body">
                    <h5>Excel File Format:</h5>
                    <p>Your Excel file should contain the following columns:</p>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Column Name</th>
                                <th>Required</th>
                                <th>Description</th>
                                <th>Example</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Title</strong></td>
                                <td><span class="badge badge-danger">Yes</span></td>
                                <td>The title of the blog post</td>
                                <td>My Amazing Blog Post</td>
                            </tr>
                            <tr>
                                <td><strong>Slug</strong></td>
                                <td><span class="badge badge-warning">Auto</span></td>
                                <td>URL-friendly version (auto-generated from title if empty)</td>
                                <td>my-amazing-blog-post</td>
                            </tr>
                            <tr>
                                <td><strong>Content</strong></td>
                                <td><span class="badge badge-danger">Yes</span></td>
                                <td>The main content of the post (HTML supported)</td>
                                <td>&lt;p&gt;This is the content...&lt;/p&gt;</td>
                            </tr>
                            <tr>
                                <td><strong>Summary</strong></td>
                                <td><span class="badge badge-info">No</span></td>
                                <td>Brief description or excerpt</td>
                                <td>A brief summary of the post</td>
                            </tr>
                            <tr>
                                <td><strong>Category</strong></td>
                                <td><span class="badge badge-info">No</span></td>
                                <td>Category name</td>
                                <td>Technology</td>
                            </tr>
                            <tr>
                                <td><strong>Tags</strong></td>
                                <td><span class="badge badge-info">No</span></td>
                                <td>Comma-separated tags</td>
                                <td>tech, programming, web</td>
                            </tr>
                            <tr>
                                <td><strong>Author</strong></td>
                                <td><span class="badge badge-info">No</span></td>
                                <td>Author name or username</td>
                                <td>John Doe</td>
                            </tr>
                            <tr>
                                <td><strong>PublishDate</strong></td>
                                <td><span class="badge badge-info">No</span></td>
                                <td>Publication date (YYYY-MM-DD)</td>
                                <td>2024-01-15</td>
                            </tr>
                            <tr>
                                <td><strong>IsPublished</strong></td>
                                <td><span class="badge badge-info">No</span></td>
                                <td>true/false or yes/no</td>
                                <td>true</td>
                            </tr>
                            <tr>
                                <td><strong>IsFeatured</strong></td>
                                <td><span class="badge badge-info">No</span></td>
                                <td>true/false or yes/no</td>
                                <td>false</td>
                            </tr>
                            <tr>
                                <td><strong>MetaTitle</strong></td>
                                <td><span class="badge badge-info">No</span></td>
                                <td>SEO meta title</td>
                                <td>Amazing Blog Post | My Site</td>
                            </tr>
                            <tr>
                                <td><strong>MetaDescription</strong></td>
                                <td><span class="badge badge-info">No</span></td>
                                <td>SEO meta description</td>
                                <td>Learn about amazing things...</td>
                            </tr>
                            <tr>
                                <td><strong>MetaKeywords</strong></td>
                                <td><span class="badge badge-info">No</span></td>
                                <td>SEO keywords</td>
                                <td>blog, technology, tutorial</td>
                            </tr>
                            <tr>
                                <td><strong>FeaturedImage</strong></td>
                                <td><span class="badge badge-info">No</span></td>
                                <td>URL or path to featured image</td>
                                <td>/images/blog/post1.jpg</td>
                            </tr>
                            <tr>
                                <td><strong>ViewCount</strong></td>
                                <td><span class="badge badge-info">No</span></td>
                                <td>Initial view count</td>
                                <td>0</td>
                            </tr>
                        </tbody>
                    </table>
                    
                    <div class="alert alert-info mt-3">
                        <i class="fas fa-info-circle"></i> <strong>Tips:</strong>
                        <ul class="mb-0">
                            <li>Download the template file to see the correct format</li>
                            <li>Dates should be in YYYY-MM-DD format</li>
                            <li>Boolean values can be: true/false, yes/no, 1/0</li>
                            <li>Tags should be comma-separated</li>
                            <li>HTML content is supported in the Content field</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Update file input label with selected file name
            $('.custom-file-input').on('change', function() {
                var fileName = $(this).val().split('\\').pop();
                $(this).siblings('.custom-file-label').addClass('selected').html(fileName);
            });
            
            // Handle import mode changes
            $('#Mode').on('change', function() {
                var mode = $(this).val();
                if (mode === 'UpdateExisting') {
                    $('#updateExisting').prop('checked', true).prop('disabled', true);
                } else if (mode === 'CreateNew') {
                    $('#updateExisting').prop('checked', false).prop('disabled', true);
                } else {
                    $('#updateExisting').prop('disabled', false);
                }
            });
        });
    </script>
}