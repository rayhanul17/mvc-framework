@model IEnumerable<Nexora.Core.Entities.SiteSetting>
@{
    ViewData["Title"] = "Branding Settings";
    var settings = Model.ToDictionary(s => s.Key, s => s);
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-palette text-primary me-2"></i>Branding Settings</h2>
            <p class="text-muted">Configure your organization's branding and visual identity</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Settings
            </a>
        </div>
    </div>

    <form asp-action="SaveBranding" method="post" enctype="multipart/form-data" id="brandingForm">
        @Html.AntiForgeryToken()
        
        <div class="row">
            <!-- Organization Info -->
            <div class="col-lg-6">
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-building me-2"></i>Organization Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Organization Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="OrganizationName" 
                                   value="@(settings.ContainsKey("OrganizationName") ? settings["OrganizationName"].Value : "")" 
                                   required placeholder="Your Company Name">
                            <small class="text-muted">Full name of your organization</small>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Short Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="ShortName" maxlength="5"
                                   value="@(settings.ContainsKey("ShortName") ? settings["ShortName"].Value : "")" 
                                   required placeholder="ABC">
                            <small class="text-muted">3-5 character abbreviation for mobile view</small>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Slogan</label>
                            <input type="text" class="form-control" name="Slogan" 
                                   value="@(settings.ContainsKey("Slogan") ? settings["Slogan"].Value : "")" 
                                   placeholder="Your inspiring tagline">
                            <small class="text-muted">Optional tagline or motto</small>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Logo Settings -->
            <div class="col-lg-6">
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-image me-2"></i>Logo Settings</h5>
                    </div>
                    <div class="card-body">
                        <!-- Small Logo -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Small Logo (40x40px)</label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="logo-preview small-logo-preview">
                                    @if (settings.ContainsKey("SmallLogo") && !string.IsNullOrEmpty(settings["SmallLogo"].Value))
                                    {
                                        <img src="@settings["SmallLogo"].Value" alt="Small Logo" />
                                    }
                                    else
                                    {
                                        <div class="placeholder-logo">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <input type="file" class="form-control" name="SmallLogoFile" accept="image/*">
                                    <small class="text-muted">Used in collapsed sidebar and mobile view</small>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Large Logo -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Large Logo (200x50px)</label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="logo-preview large-logo-preview">
                                    @if (settings.ContainsKey("LargeLogo") && !string.IsNullOrEmpty(settings["LargeLogo"].Value))
                                    {
                                        <img src="@settings["LargeLogo"].Value" alt="Large Logo" />
                                    }
                                    else
                                    {
                                        <div class="placeholder-logo">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <input type="file" class="form-control" name="LargeLogoFile" accept="image/*">
                                    <small class="text-muted">Main logo for desktop view</small>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Favicon -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Favicon (32x32px .ico)</label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="logo-preview favicon-preview">
                                    @if (settings.ContainsKey("FaviconPath") && !string.IsNullOrEmpty(settings["FaviconPath"].Value))
                                    {
                                        <img src="@settings["FaviconPath"].Value" alt="Favicon" />
                                    }
                                    else
                                    {
                                        <div class="placeholder-logo">
                                            <i class="fas fa-star"></i>
                                        </div>
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <input type="file" class="form-control" name="FaviconFile" accept=".ico,image/x-icon">
                                    <small class="text-muted">Browser tab icon</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Theme Colors -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-paint-brush me-2"></i>Theme Colors</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Primary Color</label>
                            <div class="input-group">
                                <input type="color" class="form-control form-control-color" name="PrimaryColor" 
                                       value="@(settings.ContainsKey("PrimaryColor") ? settings["PrimaryColor"].Value : "#0d6efd")" 
                                       id="primaryColor">
                                <input type="text" class="form-control" value="@(settings.ContainsKey("PrimaryColor") ? settings["PrimaryColor"].Value : "#0d6efd")" 
                                       id="primaryColorText" pattern="^#[0-9A-Fa-f]{6}$">
                            </div>
                            <small class="text-muted">Main brand color used throughout the site</small>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Secondary Color</label>
                            <div class="input-group">
                                <input type="color" class="form-control form-control-color" name="SecondaryColor" 
                                       value="@(settings.ContainsKey("SecondaryColor") ? settings["SecondaryColor"].Value : "#6c757d")" 
                                       id="secondaryColor">
                                <input type="text" class="form-control" value="@(settings.ContainsKey("SecondaryColor") ? settings["SecondaryColor"].Value : "#6c757d")" 
                                       id="secondaryColorText" pattern="^#[0-9A-Fa-f]{6}$">
                            </div>
                            <small class="text-muted">Accent color for secondary elements</small>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Dark Mode Default</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="DarkModeDefault" value="true" 
                                       @(settings.ContainsKey("DarkModeDefault") && settings["DarkModeDefault"].Value == "true" ? "checked" : "")>
                                <label class="form-check-label">Enable dark mode by default</label>
                            </div>
                            <small class="text-muted">Users can still toggle their preference</small>
                        </div>
                    </div>
                </div>
                
                <!-- Color Preview -->
                <div class="mt-3">
                    <h6>Preview</h6>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary preview-primary">Primary Button</button>
                        <button type="button" class="btn btn-secondary preview-secondary">Secondary Button</button>
                        <button type="button" class="btn btn-outline-primary preview-primary-outline">Outline Primary</button>
                        <button type="button" class="btn btn-outline-secondary preview-secondary-outline">Outline Secondary</button>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Save Button -->
        <div class="text-end">
            <button type="button" class="btn btn-secondary me-2" onclick="window.location.reload()">
                <i class="fas fa-undo me-2"></i>Reset
            </button>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-2"></i>Save Branding Settings
            </button>
        </div>
    </form>
</div>

<style>
    .logo-preview {
        width: 80px;
        height: 80px;
        border: 2px dashed #dee2e6;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        overflow: hidden;
    }
    
    .logo-preview.small-logo-preview {
        width: 40px;
        height: 40px;
    }
    
    .logo-preview.large-logo-preview {
        width: 200px;
        height: 50px;
    }
    
    .logo-preview.favicon-preview {
        width: 32px;
        height: 32px;
    }
    
    .logo-preview img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }
    
    .placeholder-logo {
        color: #6c757d;
        font-size: 24px;
    }
    
    .form-control-color {
        width: 50px;
        padding: 0.375rem;
    }
</style>

@section Scripts {
    <script>
        // Sync color inputs
        document.getElementById('primaryColor').addEventListener('input', function() {
            document.getElementById('primaryColorText').value = this.value;
            updatePreview();
        });
        
        document.getElementById('primaryColorText').addEventListener('input', function() {
            if (this.value.match(/^#[0-9A-Fa-f]{6}$/)) {
                document.getElementById('primaryColor').value = this.value;
                updatePreview();
            }
        });
        
        document.getElementById('secondaryColor').addEventListener('input', function() {
            document.getElementById('secondaryColorText').value = this.value;
            updatePreview();
        });
        
        document.getElementById('secondaryColorText').addEventListener('input', function() {
            if (this.value.match(/^#[0-9A-Fa-f]{6}$/)) {
                document.getElementById('secondaryColor').value = this.value;
                updatePreview();
            }
        });
        
        // Update button preview
        function updatePreview() {
            const primary = document.getElementById('primaryColor').value;
            const secondary = document.getElementById('secondaryColor').value;
            
            document.querySelector('.preview-primary').style.backgroundColor = primary;
            document.querySelector('.preview-primary').style.borderColor = primary;
            document.querySelector('.preview-secondary').style.backgroundColor = secondary;
            document.querySelector('.preview-secondary').style.borderColor = secondary;
            document.querySelector('.preview-primary-outline').style.color = primary;
            document.querySelector('.preview-primary-outline').style.borderColor = primary;
            document.querySelector('.preview-secondary-outline').style.color = secondary;
            document.querySelector('.preview-secondary-outline').style.borderColor = secondary;
        }
        
        // Preview uploaded images
        document.querySelector('input[name="SmallLogoFile"]').addEventListener('change', function(e) {
            previewImage(e.target, '.small-logo-preview');
        });
        
        document.querySelector('input[name="LargeLogoFile"]').addEventListener('change', function(e) {
            previewImage(e.target, '.large-logo-preview');
        });
        
        document.querySelector('input[name="FaviconFile"]').addEventListener('change', function(e) {
            previewImage(e.target, '.favicon-preview');
        });
        
        function previewImage(input, previewSelector) {
            const preview = document.querySelector(previewSelector);
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.innerHTML = '<img src="' + e.target.result + '" alt="Preview" />';
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
        
        // Form submission
        document.getElementById('brandingForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const loadingModal = ModalSystem.showLoadingModal('Saving branding settings...');
            
            fetch(this.action, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                ModalSystem.hideLoadingModal();
                if (data.success) {
                    NotificationSystem.success('Branding settings saved successfully!');
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    NotificationSystem.error(data.message || 'Failed to save settings');
                }
            })
            .catch(error => {
                ModalSystem.hideLoadingModal();
                NotificationSystem.error('An error occurred while saving settings');
            });
        });
    </script>
}