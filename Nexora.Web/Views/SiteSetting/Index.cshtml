@model IEnumerable<Nexora.Web.Models.ViewModels.SiteSettingCategoryViewModel>
@{
    ViewData["Title"] = "Site Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Site Settings Management</h2>
        <div class="d-flex gap-2">
            <a asp-action="Branding" class="btn btn-success">
                <i class="fas fa-palette"></i> Branding
            </a>
            <a asp-action="Footer" class="btn btn-info">
                <i class="fas fa-shoe-prints"></i> Footer
            </a>
            @if (await RoleAuthService.IsSuperAdminAsync(User))
            {
                <a asp-action="CreateEdit" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add Setting
                </a>
                <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#resetModal">
                    <i class="fas fa-undo"></i> Reset Defaults
                </button>
            }
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-download"></i> Export
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" asp-action="Export">All Settings</a></li>
                    <li><hr class="dropdown-divider"></li>
                    @foreach (var category in (SettingCategory[])ViewBag.Categories)
                    {
                        <li><a class="dropdown-item" asp-action="Export" asp-route-category="@category">@category</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Category Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h6 class="mb-0">Filter by Category:</h6>
                </div>
                <div class="col-md-6">
                    <div class="btn-group w-100" role="group">
                        <a asp-action="Index" class="btn @(ViewBag.SelectedCategory == null ? "btn-primary" : "btn-outline-primary")">All</a>
                        @foreach (var category in (SettingCategory[])ViewBag.Categories)
                        {
                            <a asp-action="Index" asp-route-category="@category" 
                               class="btn @(ViewBag.SelectedCategory?.ToString() == category.ToString() ? "btn-primary" : "btn-outline-primary")">
                                @category
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        @foreach (var categoryGroup in Model)
        {
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-cog me-2"></i>@categoryGroup.CategoryName Settings
                        </h5>
                        <div class="btn-group">
                            <a asp-action="BulkEdit" asp-route-category="@categoryGroup.Category" 
                               class="btn btn-sm btn-outline-light">
                                <i class="fas fa-edit"></i> Bulk Edit
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table id="settingsTable-@categoryGroup.Category" class="table table-hover mb-0 settings-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Key</th>
                                    <th>Value</th>
                                    <th>Type</th>
                                    <th>Required</th>
                                    <th>System</th>
                                    <th>Last Updated</th>
                                    <th width="150">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var setting in categoryGroup.Settings)
                                {
                                    <tr>
                                        <td>
                                            <strong>@setting.Key</strong>
                                            @if (!string.IsNullOrEmpty(setting.Description))
                                            {
                                                <br><small class="text-muted">@setting.Description</small>
                                            }
                                        </td>
                                        <td>
                                            <div class="setting-value" style="max-width: 200px;">
                                                @if (setting.Type == SettingType.Boolean)
                                                {
                                                    <span class="badge @(setting.Value.ToLower() == "true" ? "bg-success" : "bg-secondary")">
                                                        @(setting.Value.ToLower() == "true" ? "Enabled" : "Disabled")
                                                    </span>
                                                }
                                                else if (setting.Type == SettingType.Color)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <div class="color-preview me-2" style="width: 20px; height: 20px; background-color: @setting.Value; border: 1px solid #ccc;"></div>
                                                        <code class="small">@setting.Value</code>
                                                    </div>
                                                }
                                                else if (setting.Value.Length > 50)
                                                {
                                                    <span class="text-truncate d-block" title="@setting.Value">@setting.Value</span>
                                                }
                                                else
                                                {
                                                    @setting.Value
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">@setting.Type</span>
                                        </td>
                                        <td>
                                            @if (setting.IsRequired)
                                            {
                                                <i class="fas fa-check-circle text-warning" title="Required"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-circle text-muted" title="Optional"></i>
                                            }
                                        </td>
                                        <td>
                                            @if (setting.IsSystemSetting)
                                            {
                                                <i class="fas fa-lock text-danger" title="System Setting"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-unlock text-success" title="User Setting"></i>
                                            }
                                        </td>
                                        <td>
                                            @if (setting.UpdatedAt.HasValue)
                                            {
                                                <small>
                                                    @setting.UpdatedAt.Value.ToString("MMM dd, yyyy")<br>
                                                    <span class="text-muted">by @setting.UpdatedBy</span>
                                                </small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">Never</small>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@setting.Id" 
                                                   class="btn btn-outline-info btn-sm" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="CreateEdit" asp-route-id="@setting.Id" 
                                                   class="btn btn-outline-primary btn-sm" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                @if (await RoleAuthService.IsSuperAdminAsync(User) && !setting.IsSystemSetting)
                                                {
                                                    <button type="button" class="btn btn-outline-danger btn-sm" title="Delete"
                                                            onclick="return showDeleteModal('@Url.Action("Delete", "SiteSetting", new { id = setting.Id })', @Html.Raw(Json.Serialize(setting.Key)), 'site setting', @Html.Raw(Json.Serialize($"<small class='text-muted'>{setting.Description ?? ""}</small>")))">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-cogs fa-3x text-muted mb-3"></i>
            <p class="text-muted">No site settings found.</p>
            @if (await RoleAuthService.IsSuperAdminAsync(User))
            {
                <a asp-action="CreateEdit" class="btn btn-primary">Create First Setting</a>
            }
        </div>
    }
</div>

<!-- Reset Confirmation Modal -->
@if (await RoleAuthService.IsSuperAdminAsync(User))
{
    <div class="modal fade" id="resetModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Reset to Defaults</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to reset all settings to their default values?</p>
                    <p class="text-warning"><strong>Warning:</strong> This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="ResetToDefaults" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Reset to Defaults</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTables for all settings tables
            $('.settings-table').each(function() {
                $(this).DataTable({
                    responsive: true,
                    order: [[0, 'asc']], // Sort by Key column by default
                    columnDefs: [
                        { orderable: false, targets: [6] }, // Disable sorting on Actions column
                        { searchable: false, targets: [6] }, // Disable searching on Actions column
                        { width: "150px", targets: [6] } // Set fixed width for Actions column
                    ],
                    pageLength: 25,
                    lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                    language: {
                        search: "Search settings:",
                        lengthMenu: "Show _MENU_ settings per page",
                        info: "Showing _START_ to _END_ of _TOTAL_ settings",
                        infoEmpty: "No settings found",
                        infoFiltered: "(filtered from _MAX_ total settings)",
                        emptyTable: "No settings available",
                        zeroRecords: "No matching settings found"
                    }
                });
            });
        });
    </script>
}