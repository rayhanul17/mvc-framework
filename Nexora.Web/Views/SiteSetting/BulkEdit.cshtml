@model Nexora.Web.Models.ViewModels.BulkUpdateSettingsViewModel
@{
    ViewData["Title"] = $"Bulk Edit {ViewBag.CategoryName} Settings";
}

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">@ViewData["Title"]</h5>
            <a asp-action="Index" asp-route-category="@ViewBag.Category" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </div>
    <div class="card-body">
        <form asp-action="BulkEdit" asp-route-category="@ViewBag.Category" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            
            @for (int i = 0; i < Model.Settings.Count; i++)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <input asp-for="Settings[i].Key" type="hidden" />
                        <input asp-for="Settings[i].Type" type="hidden" />
                        <input asp-for="Settings[i].ValidValues" type="hidden" />
                        <input asp-for="Settings[i].IsRequired" type="hidden" />
                        
                        <div class="row align-items-center">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">
                                    @Model.Settings[i].Key
                                    @if (Model.Settings[i].IsRequired)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                @if (!string.IsNullOrEmpty(Model.Settings[i].Description))
                                {
                                    <small class="d-block text-muted">@Model.Settings[i].Description</small>
                                }
                            </div>
                            <div class="col-md-8">
                                @if (Model.Settings[i].Type == SettingType.Boolean)
                                {
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" 
                                               name="Settings[@i].Value" value="true" 
                                               @(Model.Settings[i].Value.ToLower() == "true" ? "checked" : "") />
                                        <input type="hidden" name="Settings[@i].Value" value="false" />
                                        <label class="form-check-label">Enable/Disable</label>
                                    </div>
                                }
                                else if (Model.Settings[i].Type == SettingType.TextArea)
                                {
                                    <textarea asp-for="Settings[i].Value" class="form-control" rows="3"></textarea>
                                }
                                else if (Model.Settings[i].Type == SettingType.Color)
                                {
                                    <input asp-for="Settings[i].Value" class="form-control form-control-color" type="color" />
                                }
                                else if (Model.Settings[i].Type == SettingType.Number)
                                {
                                    <input asp-for="Settings[i].Value" class="form-control" type="number" />
                                }
                                else if (Model.Settings[i].Type == SettingType.Email)
                                {
                                    <input asp-for="Settings[i].Value" class="form-control" type="email" />
                                }
                                else if (Model.Settings[i].Type == SettingType.Url)
                                {
                                    <input asp-for="Settings[i].Value" class="form-control" type="url" />
                                }
                                else if (Model.Settings[i].Type == SettingType.Select && !string.IsNullOrEmpty(Model.Settings[i].ValidValues))
                                {
                                    <select asp-for="Settings[i].Value" class="form-select">
                                        @{
                                            try
                                            {
                                                var options = System.Text.Json.JsonSerializer.Deserialize<string[]>(Model.Settings[i].ValidValues);
                                                if (options != null)
                                                {
                                                    foreach (var option in options)
                                                    {
                                                        <option value="@option" selected="@(Model.Settings[i].Value == option)">@option</option>
                                                    }
                                                }
                                            }
                                            catch { }
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input asp-for="Settings[i].Value" class="form-control" />
                                }
                                <span asp-validation-for="Settings[i].Value" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" asp-route-category="@ViewBag.Category" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save All Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}