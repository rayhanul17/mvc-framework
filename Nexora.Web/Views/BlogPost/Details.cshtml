@model Nexora.Core.Entities.BlogPost
@{
    ViewData["Title"] = Model.MetaTitle ?? Model.Title;
    ViewData["MetaDescription"] = Model.MetaDescription ?? Model.Summary;
    ViewData["MetaKeywords"] = Model.MetaKeywords;
    
    // Use layout only if user is authenticated
    if (User.Identity?.IsAuthenticated == true)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    else
    {
        Layout = null;
    }
}

<style>
    .featured-image-container {
        text-align: center;
        margin-bottom: 2rem;
    }
    .featured-image-container img {
        max-width: 100%;
        height: auto;
        display: inline-block;
    }
</style>

@if (Layout == null)
{
    @Html.Raw("<!DOCTYPE html>")
    @Html.Raw("<html lang=\"en\">")
    @Html.Raw("<head>")
    @Html.Raw("<meta charset=\"utf-8\" />")
    @Html.Raw("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />")
    <title>@ViewData["Title"] - Nexora</title>
    <meta name="description" content="@ViewData["MetaDescription"]" />
    <meta name="keywords" content="@ViewData["MetaKeywords"]" />
    
    @Html.Raw("<!-- Bootstrap -->")
    @Html.Raw("<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" />")
    @Html.Raw("<!-- Font Awesome -->")
    @Html.Raw("<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />")
    
    @Html.Raw("<style>")
    @Html.Raw("body { padding-top: 20px; background-color: #f8f9fa; }")
    @Html.Raw(".navbar-simple { background-color: #fff; box-shadow: 0 2px 4px rgba(0,0,0,.1); padding: 1rem 0; margin-bottom: 2rem; }")
    @Html.Raw(".featured-image-container { text-align: center; margin-bottom: 2rem; }")
    @Html.Raw(".featured-image-container img { max-width: 100%; height: auto; display: inline-block; }")
    @Html.Raw("</style>")
    @Html.Raw("</head>")
    @Html.Raw("<body>")
    
    @Html.Raw("<!-- Simple Navigation for non-authenticated users -->")
    @Html.Raw("<nav class=\"navbar navbar-simple\">")
    @Html.Raw("<div class=\"container\">")
    @Html.Raw("<a class=\"navbar-brand\" href=\"/\">")
    @Html.Raw("<i class=\"fas fa-building me-2\"></i>")
    @Html.Raw("<strong>Nexora</strong>")
    @Html.Raw("</a>")
    @Html.Raw("<div class=\"d-flex\">")
    @Html.Raw("<a href=\"/\" class=\"btn btn-outline-primary btn-sm me-2\">")
    @Html.Raw("<i class=\"fas fa-home\"></i> Home")
    @Html.Raw("</a>")
    @Html.Raw("<a href=\"/Account/Login\" class=\"btn btn-primary btn-sm\">")
    @Html.Raw("<i class=\"fas fa-sign-in-alt\"></i> Login")
    @Html.Raw("</a>")
    @Html.Raw("</div>")
    @Html.Raw("</div>")
    @Html.Raw("</nav>")
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <article class="blog-post">
                <header class="blog-post-header mb-4">
                    @if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
                    {
                        <div class="featured-image-container">
                            <img src="@Model.FeaturedImageUrl" alt="@Model.Title" class="img-fluid rounded" />
                        </div>
                    }
                    
                    <h1 class="blog-post-title">@Model.Title</h1>
                    
                    <div class="blog-post-meta text-muted mb-3">
                        <small>
                            <i class="fas fa-calendar"></i> @Model.PublishedDate?.ToString("MMMM dd, yyyy")
                            @if (Model.Author != null)
                            {
                                <span class="mx-2">|</span>
                                <i class="fas fa-user"></i> @Model.Author.FullName
                            }
                            @if (Model.Category != null)
                            {
                                <span class="mx-2">|</span>
                                <i class="fas fa-folder"></i> @Model.Category.Name
                            }
                            <span class="mx-2">|</span>
                            <i class="fas fa-eye"></i> @Model.ViewCount views
                        </small>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Summary))
                    {
                        <div class="blog-post-summary alert alert-info">
                            <strong>Summary:</strong> @Model.Summary
                        </div>
                    }
                </header>

                <div class="blog-post-content">
                    @Html.Raw(Model.Content)
                </div>

                @if (!string.IsNullOrEmpty(Model.Tags))
                {
                    <div class="blog-post-tags mt-4">
                        <strong>Tags: </strong>
                        @foreach (var tag in Model.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="badge bg-secondary me-2">#@tag.Trim()</span>
                        }
                    </div>
                }
            </article>

            <!-- Comments Section -->
            @if (Model.CommentsEnabled)
            {
                <section class="comments-section mt-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="comments-title mb-0">
                            <i class="fas fa-comments"></i> Comments
                            <span id="comments-count" class="badge bg-primary ms-2">0</span>
                        </h3>
                        @if (User.Identity?.IsAuthenticated == true && await RoleAuthService.IsAdminAsync(User))
                        {
                            <button id="toggle-comments-visibility" class="btn btn-sm btn-outline-secondary" data-visible="@Model.CommentsVisible.ToString().ToLower()">
                                <i class="fas fa-eye@(!Model.CommentsVisible ? "-slash" : "")"></i>
                                @(Model.CommentsVisible ? "Hide" : "Show") Comments
                            </button>
                        }
                    </div>

                    <!-- Comment Form and List -->
                    <div id="comments-container" style="@(!Model.CommentsVisible ? "display: none;" : "")">
                        <div class="comment-form mb-4">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">Leave a Comment</h5>
                                    <form id="comment-form">
                                        @Html.AntiForgeryToken()
                                    @if (!User.Identity!.IsAuthenticated)
                                    {
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <input type="text" id="author-name" class="form-control" placeholder="Your Name *" required />
                                            </div>
                                            <div class="col-md-6">
                                                <input type="email" id="author-email" class="form-control" placeholder="Your Email (optional)" />
                                            </div>
                                        </div>
                                    }
                                    <div class="mb-3">
                                        <textarea id="comment-content" class="form-control" rows="4" placeholder="Write your comment here..." required></textarea>
                                    </div>
                                    <div class="mb-3">
                                        <input type="file" id="comment-attachments" class="form-control" multiple accept="image/*,.pdf,.doc,.docx,.txt" />
                                        <small class="form-text text-muted">Optional: Attach images or documents (max 5MB each)</small>
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-paper-plane"></i> Post Comment
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                        <!-- Comments List -->
                        <div id="comments-list" class="comments-list">
                            <div class="text-center py-4">
                                <div class="spinner-border" role="status">
                                    <span class="visually-hidden">Loading comments...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            }
            else
            {
                <div class="alert alert-info mt-4">
                    <i class="fas fa-info-circle"></i> Comments are disabled for this post.
                </div>
            }
            
            <!-- Post Information and Admin Actions -->
            <div class="mt-5 pt-4 border-top">
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="mb-3">Post Information</h5>
                        <ul class="list-unstyled">
                            <li><strong>Published:</strong> @Model.PublishedDate?.ToString("MMM dd, yyyy")</li>
                            <li><strong>Category:</strong> @(Model.Category?.Name ?? "Uncategorized")</li>
                            <li><strong>Author:</strong> @(Model.Author?.FullName ?? "Unknown")</li>
                            <li><strong>Views:</strong> @Model.ViewCount</li>
                            @if (Model.UpdatedAt.HasValue && Model.UpdatedAt != Model.CreatedAt)
                            {
                                <li><strong>Last Updated:</strong> @Model.UpdatedAt.Value.ToString("MMM dd, yyyy")</li>
                            }
                        </ul>
                    </div>
                    @if (User.Identity?.IsAuthenticated == true && await RoleAuthService.IsAdminAsync(User))
                    {
                        <div class="col-md-6">
                            <h5 class="mb-3">Admin Actions</h5>
                            <a href="@Url.Action("CreateEdit", "BlogPost", new { id = Model.Id })" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i> Edit Post
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (Layout != null)
{
    @section Scripts {
        <script>
            $(document).ready(function() {
            const blogPostId = @Model.Id;
            
            // Load comments when page loads
            loadComments();
            
            // Handle comment form submission
            $('#comment-form').on('submit', function(e) {
                e.preventDefault();
                submitComment();
            });
            
            // Handle toggle comments visibility (admin only)
            $('#toggle-comments-visibility').on('click', function() {
                const button = $(this);
                const isVisible = button.data('visible') === 'true';
                
                $.ajax({
                    url: '/BlogPost/ToggleCommentsVisibility',
                    type: 'POST',
                    data: { 
                        id: blogPostId,
                        visible: !isVisible,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            const newVisibility = !isVisible;
                            button.data('visible', newVisibility.toString());
                            
                            if (newVisibility) {
                                $('#comments-container').slideDown();
                                button.html('<i class="fas fa-eye"></i> Hide Comments');
                            } else {
                                $('#comments-container').slideUp();
                                button.html('<i class="fas fa-eye-slash"></i> Show Comments');
                            }
                        }
                    }
                });
            });
            
            function loadComments() {
                $.ajax({
                    url: '/Comment/GetComments',
                    type: 'GET',
                    data: { blogPostId: blogPostId },
                    success: function(response) {
                        if (response.success) {
                            displayComments(response.data);
                            updateCommentsCount(response.data.length);
                        } else {
                            $('#comments-list').html('<div class="alert alert-warning">Failed to load comments.</div>');
                        }
                    },
                    error: function() {
                        $('#comments-list').html('<div class="alert alert-danger">Error loading comments.</div>');
                    }
                });
            }
            
            function displayComments(comments) {
                if (comments.length === 0) {
                    $('#comments-list').html('<div class="alert alert-info"><i class="fas fa-info-circle"></i> No comments yet. Be the first to comment!</div>');
                    return;
                }
                
                var html = '';
                comments.forEach(function(comment) {
                    html += renderComment(comment);
                });
                $('#comments-list').html(html);
            }
            
            function renderComment(comment) {
                var html = '<div class="comment mb-3 p-3 border rounded">';
                html += '<div class="comment-header d-flex justify-content-between align-items-center mb-2">';
                
                // Display proper user name
                var displayName = comment.authorName;
                if (!displayName || displayName.trim() === '') {
                    displayName = 'Anonymous User';
                }
                
                // Show if user is authenticated (has UserId) vs anonymous
                if (comment.userId) {
                    html += '<div class="comment-author">';
                    html += '<strong>' + escapeHtml(displayName) + '</strong>';
                    html += ' <span class="badge bg-primary ms-2" title="Registered User"><i class="fas fa-user"></i> Member</span>';
                    html += '</div>';
                } else {
                    html += '<div class="comment-author">';
                    html += '<strong>' + escapeHtml(displayName) + '</strong>';
                    html += ' <span class="badge bg-secondary ms-2" title="Anonymous User"><i class="fas fa-user-secret"></i> Guest</span>';
                    html += '</div>';
                }
                
                html += '<div class="comment-date text-muted"><small>' + formatDate(comment.createdAt) + '</small></div>';
                html += '</div>';
                html += '<div class="comment-content">' + escapeHtml(comment.content) + '</div>';
                
                if (comment.attachments && comment.attachments.length > 0) {
                    html += '<div class="comment-attachments mt-3">';
                    
                    // Separate images from other attachments
                    var images = comment.attachments.filter(a => a.isImage);
                    var files = comment.attachments.filter(a => !a.isImage);
                    
                    // Display image previews
                    if (images.length > 0) {
                        html += '<div class="attachment-images mb-2">';
                        images.forEach(function(attachment) {
                            html += '<div class="image-preview-wrapper d-inline-block me-2 mb-2">';
                            html += '<a href="/Comment/PreviewAttachment/' + attachment.id + '" target="_blank" class="d-block">';
                            html += '<img src="/Comment/PreviewAttachment/' + attachment.id + '" ';
                            html += 'class="img-thumbnail" style="max-width: 200px; max-height: 200px; cursor: pointer;" ';
                            html += 'alt="' + escapeHtml(attachment.fileName) + '" ';
                            html += 'title="Click to view full size" />';
                            html += '</a>';
                            html += '<small class="d-block text-center text-muted">' + escapeHtml(attachment.fileName) + '</small>';
                            html += '</div>';
                        });
                        html += '</div>';
                    }
                    
                    // Display other file attachments
                    if (files.length > 0) {
                        html += '<div class="attachment-files">';
                        files.forEach(function(attachment) {
                            html += '<a href="/Comment/DownloadAttachment/' + attachment.id + '" ';
                            html += 'class="btn btn-sm btn-outline-secondary me-2 mb-2" download>';
                            html += '<i class="fas fa-download"></i> ' + escapeHtml(attachment.fileName);
                            html += ' (' + formatFileSize(attachment.fileSize) + ')';
                            html += '</a>';
                        });
                        html += '</div>';
                    }
                    
                    html += '</div>';
                }
                
                // Add reply button for authenticated users (can be added later)
                @if (User.Identity!.IsAuthenticated)
                {
                    @:html += '<div class="comment-actions mt-2">';
                    @:html += '<button class="btn btn-sm btn-outline-primary" onclick="replyToComment(' + comment.id + ')">';
                    @:html += '<i class="fas fa-reply"></i> Reply';
                    @:html += '</button>';
                    @:html += '</div>';
                }
                
                html += '</div>';
                return html;
            }
            
            function submitComment() {
                var content = $('#comment-content').val().trim();
                if (!content) {
                    alert('Please enter a comment.');
                    return;
                }
                
                var formData = new FormData();
                formData.append('blogPostId', blogPostId);
                formData.append('content', content);
                
                @if (!User.Identity!.IsAuthenticated)
                {
                    @:var authorName = $('#author-name').val().trim();
                    @:var authorEmail = $('#author-email').val().trim();
                    @:if (!authorName) {
                        @:alert('Please enter your name.');
                        @:return;
                    @:}
                    @:formData.append('authorName', authorName);
                    @:if (authorEmail) {
                        @:formData.append('authorEmail', authorEmail);
                    @:}
                }
                
                // Handle file attachments
                var files = $('#comment-attachments')[0].files;
                for (var i = 0; i < files.length; i++) {
                    formData.append('attachments', files[i]);
                }
                
                // Disable form during submission
                $('#comment-form button[type="submit"]').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Posting...');
                
                $.ajax({
                    url: '/Comment/AddComment',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        if (response.success) {
                            // Clear form
                            $('#comment-content').val('');
                            $('#author-name').val('');
                            $('#author-email').val('');
                            $('#comment-attachments').val('');
                            
                            // Reload comments
                            loadComments();
                            
                            // Show success message
                            showAlert('success', 'Comment posted successfully!');
                        } else {
                            showAlert('danger', response.message || 'Failed to post comment');
                        }
                    },
                    error: function() {
                        showAlert('danger', 'Error posting comment. Please try again.');
                    },
                    complete: function() {
                        // Re-enable form
                        $('#comment-form button[type="submit"]').prop('disabled', false).html('<i class="fas fa-paper-plane"></i> Post Comment');
                    }
                });
            }
            
            function updateCommentsCount(count) {
                $('#comments-count').text(count);
            }
            
            function formatDate(dateString) {
                var date = new Date(dateString);
                return date.toLocaleDateString() + ' ' + date.toLocaleTimeString();
            }
            
            function escapeHtml(text) {
                var div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
            
            function formatFileSize(bytes) {
                if (bytes === 0) return '0 Bytes';
                const k = 1024;
                const sizes = ['Bytes', 'KB', 'MB', 'GB'];
                const i = Math.floor(Math.log(bytes) / Math.log(k));
                return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
            }
            
            function showAlert(type, message) {
                var alertHtml = '<div class="alert alert-' + type + ' alert-dismissible fade show" role="alert">';
                alertHtml += message;
                alertHtml += '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
                alertHtml += '</div>';
                
                $('.comments-section').prepend(alertHtml);
                
                // Auto-hide success alerts after 3 seconds
                if (type === 'success') {
                    setTimeout(function() {
                        $('.alert-success').fadeOut();
                    }, 3000);
                }
            }
            
            // Reply functionality (for future enhancement)
            function replyToComment(commentId) {
                // For now, just scroll to comment form
                document.getElementById('comment-content').focus();
                showAlert('info', 'Reply functionality will be enhanced in future updates. For now, please post your reply as a new comment.');
            }
        });
    </script>
    }
}
