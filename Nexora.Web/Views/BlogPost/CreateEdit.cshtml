@model Nexora.Web.Models.ViewModels.BlogPostViewModel

@{
    var isCreate = Model.Id == 0;
    ViewData["Title"] = isCreate ? "Create Blog Post" : "Edit Blog Post";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="CreateEdit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label"></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label asp-for="Slug" class="form-label"></label>
                            <input asp-for="Slug" class="form-control" placeholder="Leave empty to auto-generate" />
                            <span asp-validation-for="Slug" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label asp-for="Summary" class="form-label"></label>
                            <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Summary" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label asp-for="Content" class="form-label"></label>
                            <textarea asp-for="Content" class="form-control" rows="10" id="content-editor"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="FeaturedImageUrl" class="form-label"></label>
                            <input asp-for="FeaturedImageUrl" class="form-control" />
                            <span asp-validation-for="FeaturedImageUrl" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Tags" class="form-label"></label>
                            <input asp-for="Tags" class="form-control" placeholder="Comma separated tags" />
                            <span asp-validation-for="Tags" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <h5>SEO Settings</h5>
                        <hr />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label asp-for="MetaTitle" class="form-label"></label>
                            <input asp-for="MetaTitle" class="form-control" />
                            <span asp-validation-for="MetaTitle" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="MetaDescription" class="form-label"></label>
                            <textarea asp-for="MetaDescription" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="MetaDescription" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="MetaKeywords" class="form-label"></label>
                            <textarea asp-for="MetaKeywords" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="MetaKeywords" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
                                <label asp-for="IsPublished" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="CommentsEnabled" class="form-check-input" type="checkbox" />
                                <label asp-for="CommentsEnabled" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> @(isCreate ? "Create" : "Update") Post
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <!-- Summernote CSS -->
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs5.min.css" rel="stylesheet">
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <!-- Summernote JS -->
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs5.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Initialize Summernote
            $('#content-editor').summernote({
                height: 400,
                placeholder: 'Write your blog content here...',
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'underline', 'clear']],
                    ['fontname', ['fontname']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link', 'picture', 'video']],
                    ['view', ['fullscreen', 'codeview', 'help']]
                ],
                callbacks: {
                    onImageUpload: function(files) {
                        // Handle image upload
                        for (let i = 0; i < files.length; i++) {
                            uploadImage(files[i], this);
                        }
                    }
                }
            });
            
            // Auto-generate slug from title
            $('#Title').on('keyup', function() {
                if ($('#Slug').val() === '') {
                    var slug = $(this).val()
                        .toLowerCase()
                        .replace(/[^a-z0-9]+/g, '-')
                        .replace(/^-+|-+$/g, '');
                    $('#Slug').val(slug);
                }
            });
            
            // Auto-generate meta title from title
            $('#Title').on('keyup', function() {
                if ($('#MetaTitle').val() === '') {
                    $('#MetaTitle').val($(this).val());
                }
            });
            
            // Auto-generate meta description from summary
            $('#Summary').on('keyup', function() {
                if ($('#MetaDescription').val() === '') {
                    $('#MetaDescription').val($(this).val());
                }
            });
        });
        
        function uploadImage(file, editor) {
            // Create form data
            var data = new FormData();
            data.append('file', file);
            
            // You can implement image upload to server here
            // For now, we'll use a placeholder
            var reader = new FileReader();
            reader.onload = function(e) {
                $(editor).summernote('insertImage', e.target.result);
            };
            reader.readAsDataURL(file);
        }
    </script>
}