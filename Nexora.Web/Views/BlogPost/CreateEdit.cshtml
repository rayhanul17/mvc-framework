@model Nexora.Web.Models.ViewModels.BlogPostViewModel

@{
    var isCreate = Model.Id == 0;
    ViewData["Title"] = isCreate ? "Create Blog Post" : "Edit Blog Post";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="CreateEdit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label"></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label asp-for="Slug" class="form-label"></label>
                            <input asp-for="Slug" class="form-control" placeholder="Leave empty to auto-generate" />
                            <span asp-validation-for="Slug" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label asp-for="Summary" class="form-label"></label>
                            <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Summary" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label asp-for="Content" class="form-label"></label>
                            <textarea asp-for="Content" class="form-control" rows="10" id="content-editor"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="FeaturedImageUrl" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="FeaturedImageUrl" class="form-control" id="featured-image-url" />
                                <button class="btn btn-outline-secondary" type="button" id="upload-featured-btn">
                                    <i class="fas fa-upload"></i> Upload
                                </button>
                            </div>
                            <input type="file" id="featured-image-file" class="d-none" accept="image/*" />
                            <div id="featured-image-preview" class="mt-2"></div>
                            <span asp-validation-for="FeaturedImageUrl" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Tags" class="form-label"></label>
                            <input asp-for="Tags" class="form-control" placeholder="Comma separated tags" />
                            <span asp-validation-for="Tags" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <h5>SEO Settings</h5>
                        <hr />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label asp-for="MetaTitle" class="form-label"></label>
                            <input asp-for="MetaTitle" class="form-control" />
                            <span asp-validation-for="MetaTitle" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="MetaDescription" class="form-label"></label>
                            <textarea asp-for="MetaDescription" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="MetaDescription" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="MetaKeywords" class="form-label"></label>
                            <textarea asp-for="MetaKeywords" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="MetaKeywords" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
                                <label asp-for="IsPublished" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="CommentsEnabled" class="form-check-input" type="checkbox" />
                                <label asp-for="CommentsEnabled" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> @(isCreate ? "Create" : "Update") Post
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <!-- Summernote CSS (Local) -->
    <link href="~/lib/summernote/summernote-bs5.min.css" rel="stylesheet" asp-append-version="true">
    <style>
        .note-editor.note-frame {
            border: 1px solid #dee2e6;
        }
        .note-editor .note-toolbar {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }
    </style>
}

@section Scripts {
    <!-- Summernote JS (Local) -->
    <script src="~/lib/summernote/summernote-bs5.min.js" asp-append-version="true"></script>
    
    <script>
        // Wait for jQuery and page to be ready
        function initializeSummernote() {
            console.log('Initializing Summernote editor...');
            
            // Check if Summernote is loaded
            if (typeof $.fn.summernote === 'undefined') {
                console.error('Summernote is not loaded!');
                return;
            }
            
            // Initialize Summernote with full toolbar
            $('#content-editor').summernote({
                height: 400,
                minHeight: 300,
                maxHeight: 800,
                focus: false,
                placeholder: 'Write your blog content here...',
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'italic', 'underline', 'clear']],
                    ['fontname', ['fontname']],
                    ['fontsize', ['fontsize']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['height', ['height']],
                    ['table', ['table']],
                    ['insert', ['link', 'picture', 'video', 'hr']],
                    ['view', ['fullscreen', 'codeview', 'help']]
                ],
                popover: {
                    image: [
                        ['image', ['resizeFull', 'resizeHalf', 'resizeQuarter', 'resizeNone']],
                        ['float', ['floatLeft', 'floatRight', 'floatNone']],
                        ['remove', ['removeMedia']]
                    ],
                    link: [
                        ['link', ['linkDialogShow', 'unlink']]
                    ],
                    table: [
                        ['add', ['addRowDown', 'addRowUp', 'addColLeft', 'addColRight']],
                        ['delete', ['deleteRow', 'deleteCol', 'deleteTable']]
                    ]
                },
                callbacks: {
                    onInit: function() {
                        console.log('Summernote is launched');
                    },
                    onImageUpload: function(files) {
                        // Handle image upload
                        for (let i = 0; i < files.length; i++) {
                            uploadImage(files[i], this);
                        }
                    }
                }
            });
            
            console.log('Summernote initialized successfully');
        }
        
        // Initialize when document is ready
        $(document).ready(function() {
            initializeSummernote();
            
            // Auto-generate slug from title
            $('#Title').on('keyup', function() {
                if ($('#Slug').val() === '') {
                    var slug = $(this).val()
                        .toLowerCase()
                        .replace(/[^a-z0-9]+/g, '-')
                        .replace(/^-+|-+$/g, '');
                    $('#Slug').val(slug);
                }
            });
            
            // Auto-generate meta title from title
            $('#Title').on('keyup', function() {
                if ($('#MetaTitle').val() === '') {
                    $('#MetaTitle').val($(this).val());
                }
            });
            
            // Auto-generate meta description from summary
            $('#Summary').on('keyup', function() {
                if ($('#MetaDescription').val() === '') {
                    $('#MetaDescription').val($(this).val());
                }
            });
            
            // Featured image upload handling
            $('#upload-featured-btn').on('click', function() {
                $('#featured-image-file').click();
            });
            
            $('#featured-image-file').on('change', function(e) {
                var file = e.target.files[0];
                if (file) {
                    uploadFeaturedImage(file);
                }
            });
            
            // Show preview if URL exists
            var existingUrl = $('#featured-image-url').val();
            if (existingUrl) {
                showFeaturedImagePreview(existingUrl);
            }
            
            // Update preview when URL changes manually
            $('#featured-image-url').on('change', function() {
                var url = $(this).val();
                if (url) {
                    showFeaturedImagePreview(url);
                } else {
                    $('#featured-image-preview').empty();
                }
            });
        });
        
        function uploadImage(file, editor) {
            // Create form data
            var data = new FormData();
            data.append('file', file);
            
            // Show loading indicator in editor
            var loadingText = '<p>Uploading image...</p>';
            $(editor).summernote('pasteHTML', loadingText);
            
            // Show loading mask
            LoadingMask.show({ message: 'Uploading image...' });
            
            // Upload to server using FileDocumentController
            $.ajax({
                url: '@Url.Action("UploadImage", "FileDocument")',
                type: 'POST',
                data: data,
                processData: false,
                contentType: false,
                beforeSend: function() {
                    // Prevent default loading mask from $.ajaxSetup
                    return true;
                },
                success: function(response) {
                    if (response.success) {
                        // Remove loading text and insert image
                        $(editor).summernote('undo');
                        $(editor).summernote('insertImage', response.url, function($image) {
                            $image.css('max-width', '100%');
                            $image.addClass('img-fluid');
                        });
                        toastr.success('Image uploaded successfully');
                    } else {
                        // Remove loading text and show error
                        $(editor).summernote('undo');
                        toastr.error(response.message || 'Failed to upload image');
                    }
                },
                error: function(xhr, status, error) {
                    // Remove loading text and show error
                    $(editor).summernote('undo');
                    toastr.error('Error uploading image: ' + error);
                },
                complete: function() {
                    // Always hide loading mask when done
                    LoadingMask.hide();
                }
            });
        }
        
        function uploadFeaturedImage(file) {
            // Check if it's an image
            if (!file.type.startsWith('image/')) {
                toastr.error('Please select an image file');
                return;
            }
            
            // Check file size (max 5MB)
            if (file.size > 5 * 1024 * 1024) {
                toastr.error('Image size must be less than 5MB');
                return;
            }
            
            var data = new FormData();
            data.append('file', file);
            
            // Show loading
            $('#upload-featured-btn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Uploading...');
            LoadingMask.show({ message: 'Uploading featured image...' });
            
            $.ajax({
                url: '@Url.Action("UploadImage", "FileDocument")',
                type: 'POST',
                data: data,
                processData: false,
                contentType: false,
                beforeSend: function() {
                    // Prevent default loading mask from $.ajaxSetup
                    return true;
                },
                success: function(response) {
                    if (response.success) {
                        $('#featured-image-url').val(response.url);
                        showFeaturedImagePreview(response.url);
                        toastr.success('Featured image uploaded successfully');
                    } else {
                        toastr.error(response.message || 'Failed to upload image');
                    }
                },
                error: function(xhr, status, error) {
                    toastr.error('Error uploading image: ' + error);
                },
                complete: function() {
                    // Always hide loading mask
                    LoadingMask.hide();
                    $('#upload-featured-btn').prop('disabled', false).html('<i class="fas fa-upload"></i> Upload');
                    $('#featured-image-file').val('');
                }
            });
        }
        
        function showFeaturedImagePreview(url) {
            var preview = $('#featured-image-preview');
            preview.html('<img src="' + url + '" class="img-thumbnail" style="max-height: 200px; max-width: 100%;" />');
        }
    </script>
}