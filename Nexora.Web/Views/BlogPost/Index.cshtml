@model IEnumerable<Nexora.Core.Entities.BlogPost>

@{
    ViewData["Title"] = "Blog Posts";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="CreateEdit" class="btn btn-primary">
                <i class="fas fa-plus"></i> Create New Post
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Author</th>
                            <th>Status</th>
                            <th>Views</th>
                            <th>Published Date</th>
                            <th>Created At</th>
                            <th width="200">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model.OrderByDescending(p => p.CreatedAt))
                            {
                                <tr>
                                    <td>
                                        @item.Title
                                        @if (!string.IsNullOrEmpty(item.Slug))
                                        {
                                            <br /><small class="text-muted"><code>@item.Slug</code></small>
                                        }
                                    </td>
                                    <td>@(item.Category?.Name ?? "-")</td>
                                    <td>@(item.Author?.FullName ?? "-")</td>
                                    <td>
                                        @if (item.IsPublished)
                                        {
                                            <span class="badge bg-success">Published</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Draft</span>
                                        }
                                    </td>
                                    <td>@item.ViewCount</td>
                                    <td>@(item.PublishedDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <a asp-action="CreateEdit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        @if (!item.IsPublished)
                                        {
                                            <button class="btn btn-sm btn-success publish-btn" data-id="@item.Id">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-secondary unpublish-btn" data-id="@item.Id">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        }
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center">No posts found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.publish-btn').on('click', function() {
                var id = $(this).data('id');
                var btn = $(this);
                
                if (confirm('Are you sure you want to publish this post?')) {
                    $.post('@Url.Action("Publish", "BlogPost")', { id: id }, function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    });
                }
            });
            
            $('.unpublish-btn').on('click', function() {
                var id = $(this).data('id');
                var btn = $(this);
                
                if (confirm('Are you sure you want to unpublish this post?')) {
                    $.post('@Url.Action("Unpublish", "BlogPost")', { id: id }, function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    });
                }
            });
        });
    </script>
}