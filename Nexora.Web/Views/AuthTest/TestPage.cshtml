@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Authorization Test Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <div class="container mt-5">
        <h1>Authorization Testing Dashboard</h1>
        <p class="text-muted">Test different authorization scenarios</p>

        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5>Current User Status</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Authenticated:</strong> <span id="userAuth">@(User.Identity?.IsAuthenticated ?? false)</span></p>
                        <p><strong>Username:</strong> <span id="userName">@(User.Identity?.Name ?? "Anonymous")</span></p>
                        <p><strong>Roles:</strong> <span id="userRoles">@string.Join(", ", User.Claims.Where(c => c.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role").Select(c => c.Value))</span></p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5>Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <a href="/Account/Login" class="btn btn-primary btn-sm">Login</a>
                        <a href="/Account/Logout" class="btn btn-secondary btn-sm">Logout</a>
                        <a href="/" class="btn btn-info btn-sm">Home</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <h3>Authorization Tests</h3>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Endpoint</th>
                                <th>Required Auth</th>
                                <th>Action</th>
                                <th>Result</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>/AuthTest/Anonymous</td>
                                <td>[AllowAnonymous]</td>
                                <td><button class="btn btn-sm btn-primary" onclick="testEndpoint('/AuthTest/Anonymous', 'anonymous')">Test</button></td>
                                <td><div id="result-anonymous"></div></td>
                            </tr>
                            <tr>
                                <td>/AuthTest/Authenticated</td>
                                <td>[Authorize]</td>
                                <td><button class="btn btn-sm btn-primary" onclick="testEndpoint('/AuthTest/Authenticated', 'authenticated')">Test</button></td>
                                <td><div id="result-authenticated"></div></td>
                            </tr>
                            <tr>
                                <td>/AuthTest/AdminOnly</td>
                                <td>[Authorize(Roles = "Administrator,SuperAdmin")]</td>
                                <td><button class="btn btn-sm btn-primary" onclick="testEndpoint('/AuthTest/AdminOnly', 'admin')">Test</button></td>
                                <td><div id="result-admin"></div></td>
                            </tr>
                            <tr>
                                <td>/AuthTest/SuperAdminOnly</td>
                                <td>[Authorize(Roles = "SuperAdmin")]</td>
                                <td><button class="btn btn-sm btn-primary" onclick="testEndpoint('/AuthTest/SuperAdminOnly', 'superadmin')">Test</button></td>
                                <td><div id="result-superadmin"></div></td>
                            </tr>
                            <tr>
                                <td>/Comment/GetComments</td>
                                <td>[AllowAnonymous] (CommentController)</td>
                                <td><button class="btn btn-sm btn-primary" onclick="testEndpoint('/Comment/GetComments?blogPostId=1', 'comments')">Test</button></td>
                                <td><div id="result-comments"></div></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="alert alert-info">
                    <h5>Test Scenarios:</h5>
                    <ul>
                        <li><strong>Anonymous Access:</strong> Should work for everyone</li>
                        <li><strong>Authenticated:</strong> Should redirect to login if not authenticated</li>
                        <li><strong>Admin Only:</strong> Should work for Administrator and SuperAdmin roles</li>
                        <li><strong>SuperAdmin Only:</strong> Should work only for SuperAdmin role</li>
                        <li><strong>Comments:</strong> Should work for everyone (anonymous comments enabled)</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <script>
        function testEndpoint(url, resultId) {
            const resultElement = $('#result-' + resultId);
            resultElement.html('<span class="text-info">Testing...</span>');
            
            $.ajax({
                url: url,
                type: 'GET',
                success: function(data) {
                    if (data.success) {
                        resultElement.html(`
                            <div class="text-success">
                                <small><strong>✓ Success</strong><br>
                                ${data.message}<br>
                                Auth: ${data.isAuthenticated}<br>
                                User: ${data.userName}</small>
                            </div>
                        `);
                    } else {
                        resultElement.html(`<div class="text-warning"><small>⚠ ${data.message}</small></div>`);
                    }
                },
                error: function(xhr, status, error) {
                    if (xhr.status === 401) {
                        resultElement.html('<div class="text-warning"><small>⚠ Unauthorized (401)</small></div>');
                    } else if (xhr.status === 403) {
                        resultElement.html('<div class="text-danger"><small>✗ Forbidden (403)</small></div>');
                    } else if (xhr.status === 302 || xhr.status === 0) {
                        resultElement.html('<div class="text-info"><small>→ Redirected (likely to login)</small></div>');
                    } else {
                        resultElement.html(`<div class="text-danger"><small>✗ Error: ${xhr.status} ${error}</small></div>`);
                    }
                }
            });
        }

        // Test all endpoints on page load
        $(document).ready(function() {
            setTimeout(() => {
                testEndpoint('/AuthTest/Anonymous', 'anonymous');
            }, 500);
        });
    </script>
</body>
</html>