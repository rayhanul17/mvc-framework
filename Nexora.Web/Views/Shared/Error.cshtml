@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

@{
    // Redirect to appropriate error page based on status code
    if (Model.StatusCode == 404)
    {
        Response.Redirect(Url.Action("NotFound", "Error"));
        return;
    }
    if (Model.StatusCode == 403)
    {
        Response.Redirect(Url.Action("AccessDenied", "Error"));
        return;
    }
    if (Model.StatusCode == 500)
    {
        Response.Redirect(Url.Action("ServerError", "Error"));
        return;
    }
    
    // For other status codes, redirect to general error page
    Response.Redirect(Url.Action("Index", "Error", new { statusCode = Model.StatusCode }));
}
