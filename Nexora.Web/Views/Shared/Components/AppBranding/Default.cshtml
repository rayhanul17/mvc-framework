@model Nexora.Web.ViewComponents.AppBrandingViewModel

@{
    var organizationName = Model.SiteSettings.OrganizationName;
    var shortName = Model.SiteSettings.ShortName;
    var slogan = Model.SiteSettings.Slogan;
    var smallLogo = Model.SiteSettings.SmallLogo;
    var largeLogo = Model.SiteSettings.LargeLogo;
    var hasSmallLogo = !string.IsNullOrEmpty(smallLogo) && smallLogo != "/images/logo-small.png";
    var hasLargeLogo = !string.IsNullOrEmpty(largeLogo) && largeLogo != "/images/logo-large.png";
}

@switch (Model.Type.ToLower())
{
    case "logo-only":
        @if (hasSmallLogo)
        {
            <img src="@smallLogo" alt="@organizationName" class="app-logo" style="height: 40px;" />
        }
        else
        {
            <div class="app-logo-placeholder">
                <span class="fw-bold">@shortName</span>
            </div>
        }
        break;
        
    case "text-only":
        <div class="app-brand-text">
            <span class="app-name fw-bold">@shortName</span>
        </div>
        break;
        
    case "compact":
        <div class="d-flex align-items-center app-brand-compact">
            @if (hasSmallLogo)
            {
                <img src="@smallLogo" alt="@organizationName" class="app-logo me-2" style="height: 32px;" />
            }
            else
            {
                <div class="app-logo-placeholder me-2">
                    <i class="fas fa-building"></i>
                </div>
            }
            <span class="app-name fw-bold">@shortName</span>
        </div>
        break;
        
    case "sidebar":
        <div class="sidebar-brand d-flex align-items-center">
            @if (hasLargeLogo)
            {
                <img src="@largeLogo" alt="@organizationName" class="app-logo me-3" style="max-height: 40px; max-width: 160px;" />
            }
            else
            {
                <div class="brand-text">
                    <h5 class="mb-0 fw-bold text-primary">@shortName</h5>
                    @if (!string.IsNullOrEmpty(slogan))
                    {
                        <small class="text-muted d-block lh-1">@slogan</small>
                    }
                </div>
            }
        </div>
        break;
        
    default: // "full"
        <div class="app-brand-full d-flex align-items-center">
            @if (hasLargeLogo)
            {
                <img src="@largeLogo" alt="@organizationName" class="app-logo me-3" style="max-height: 48px; max-width: 200px;" />
            }
            else
            {
                <div class="brand-info">
                    <h4 class="mb-1 fw-bold text-primary">@organizationName</h4>
                    @if (!string.IsNullOrEmpty(slogan))
                    {
                        <p class="mb-0 text-muted">@slogan</p>
                    }
                </div>
            }
        </div>
        break;
}