@model Nexora.Core.Common.AppSettings
@inject Nexora.Application.Services.ISiteSettingHelperService SiteSettings
@{
    var settings = await SiteSettings.GetAllSettingsAsync();
    var primaryColor = settings.PrimaryColor ?? "#0d6efd";
    var secondaryColor = settings.SecondaryColor ?? "#6c757d";
}

<style id="dynamic-theme-styles">
:root {
    /* Brand Colors - Dynamic from site settings */
    --bs-primary: @primaryColor;
    --bs-secondary: @secondaryColor;
    --bs-success: #198754;
    --bs-danger: #dc3545;
    --bs-warning: #ffc107;
    --bs-info: #0dcaf0;
    --bs-light: #f8f9fa;
    --bs-dark: #212529;
    
    /* Custom Theme Variables */
    --app-bg: #ffffff;
    --app-surface: #ffffff;
    --app-on-primary: #ffffff;
    --app-on-secondary: #ffffff;
    --app-on-background: #212529;
    --app-on-surface: #212529;
    
    /* Typography */
    --app-font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --app-heading-font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --app-monospace-font-family: SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    --app-base-font-size: 1rem;
    --app-line-height: 1.5;
    
    /* Layout */
    --sidebar-width: 280px;
    --sidebar-collapsed-width: 60px;
    --header-height: 60px;
    --content-max-width: 1200px;
    --content-padding: 1.5rem;
}

/* Apply custom theme */
body {
    font-family: var(--app-font-family);
    font-size: var(--app-base-font-size);
    line-height: var(--app-line-height);
    background-color: var(--app-bg);
    color: var(--app-on-background);
}

h1, h2, h3, h4, h5, h6 {
    font-family: var(--app-heading-font-family);
}

code, pre {
    font-family: var(--app-monospace-font-family);
}

/* Bootstrap overrides */
.btn-primary {
    background-color: var(--bs-primary);
    border-color: var(--bs-primary);
}

.btn-primary:hover {
    background-color: color-mix(in srgb, var(--bs-primary) 85%, black);
    border-color: color-mix(in srgb, var(--bs-primary) 85%, black);
}

.text-primary {
    color: var(--bs-primary) !important;
}

.bg-primary {
    background-color: var(--bs-primary) !important;
}

.border-primary {
    border-color: var(--bs-primary) !important;
}

/* App-specific styles */
.app-brand-full .text-primary,
.app-brand-compact .text-primary {
    color: var(--bs-primary) !important;
}

.sidebar {
    width: var(--sidebar-width);
    background-color: var(--app-surface);
    border-right: 1px solid var(--bs-light);
}

.sidebar.collapsed {
    width: var(--sidebar-collapsed-width);
}

.main-header {
    height: var(--header-height);
    background-color: var(--app-surface);
    border-bottom: 1px solid var(--bs-light);
}

.main-content {
    max-width: var(--content-max-width);
    padding: var(--content-padding);
    background-color: var(--app-bg);
}

/* Card styles */
.card {
    background-color: var(--app-surface);
    border-color: var(--bs-light);
}

.card-header {
    background-color: color-mix(in srgb, var(--app-surface) 95%, var(--bs-primary));
    border-bottom-color: var(--bs-light);
}

/* Table styles */
.table {
    --bs-table-bg: var(--app-surface);
    color: var(--app-on-surface);
}

.table-dark {
    --bs-table-bg: var(--bs-dark);
    --bs-table-color: var(--app-on-primary);
}

/* Form controls */
.form-control, .form-select {
    background-color: var(--app-bg);
    border-color: var(--bs-light);
    color: var(--app-on-background);
}

.form-control:focus, .form-select:focus {
    border-color: var(--bs-primary);
    box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--bs-primary) 25%, transparent);
}

/* Navigation */
.nav-link {
    color: var(--app-on-surface);
}

.nav-link:hover {
    color: var(--bs-primary);
}

.nav-link.active {
    color: var(--bs-primary);
    background-color: color-mix(in srgb, var(--bs-primary) 10%, transparent);
}

/* Alerts */
.alert-primary {
    background-color: color-mix(in srgb, var(--bs-primary) 15%, transparent);
    border-color: color-mix(in srgb, var(--bs-primary) 30%, transparent);
    color: color-mix(in srgb, var(--bs-primary) 80%, black);
}

/* Badges */
.badge.bg-primary {
    background-color: var(--bs-primary) !important;
}

/* Responsive adjustments */
@@media (max-width: 1200px) {
    .main-content {
        max-width: 100%;
        padding: calc(var(--content-padding) * 0.75);
    }
}

@@media (max-width: 992px) {
    .main-content {
        padding: calc(var(--content-padding) * 0.6);
    }
    
    .navbar-nav .nav-item .input-group {
        width: 150px !important;
    }
}

@@media (max-width: 768px) {
    .main-content {
        padding: 16px;
        max-width: 100%;
    }
    
    .navbar-brand .app-brand-compact .app-name {
        display: none;
    }
    
    .navbar-nav .nav-item:not(:last-child) {
        margin-bottom: 0.5rem;
    }
    
    .btn-group .btn {
        padding: 0.375rem 0.5rem;
        font-size: 0.875rem;
    }
    
    .table-responsive {
        font-size: 0.875rem;
    }
    
    .card-body {
        padding: 1rem 0.75rem;
    }
    
    .footer .row .col-md-6 {
        text-align: center !important;
        margin-bottom: 1rem;
    }
    
    .footer .social-links {
        margin-top: 1rem;
    }
    
    /* Hide search on mobile */
    .navbar-nav .nav-item form[role="search"] {
        display: none;
    }
    
    /* Stack navigation items on mobile */
    .navbar-nav.ms-auto {
        margin-top: 1rem;
        border-top: 1px solid var(--bs-light);
        padding-top: 1rem;
    }
    
    /* Improve dropdown menus on mobile */
    .dropdown-menu {
        border: none;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
    
    /* Better button spacing on mobile */
    .btn-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
    }
    
    .btn-group .btn {
        flex: 1;
        min-width: auto;
    }
}

@@media (max-width: 576px) {
    .main-content {
        padding: 12px;
    }
    
    .container-fluid {
        padding-left: 8px;
        padding-right: 8px;
    }
    
    .main-header {
        height: auto;
        min-height: var(--header-height);
    }
    
    .navbar-brand {
        font-size: 1.1rem;
    }
    
    .card {
        margin-bottom: 1rem;
    }
    
    .table {
        font-size: 0.8rem;
    }
    
    .btn-sm {
        padding: 0.25rem 0.375rem;
        font-size: 0.75rem;
    }
    
    /* Stack form elements on very small screens */
    .row .col-md-6,
    .row .col-md-4,
    .row .col-md-3 {
        margin-bottom: 0.75rem;
    }
    
    /* Make tables more mobile friendly */
    .table-responsive {
        border: none;
    }
    
    .table td, .table th {
        padding: 0.5rem 0.25rem;
        vertical-align: middle;
    }
    
    /* Improve alert spacing */
    .alert {
        margin-bottom: 1rem;
        padding: 0.75rem;
    }
    
    /* Better breadcrumb on mobile */
    .breadcrumb {
        font-size: 0.875rem;
        margin-bottom: 0;
    }
    
    /* Footer improvements */
    .footer {
        padding: 1rem 0;
        background-color: var(--app-surface);
        border-top: 1px solid var(--bs-light) !important;
    }
    
    .footer .footer-text {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
    }
    
    .footer .footer-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
    }
    
    .footer .social-link {
        transition: color 0.3s ease-in-out;
    }
    
    .footer .social-link:hover {
        color: var(--bs-primary) !important;
    }
    
    .copyright-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
        display: inline-block;
    }
    
    @@media (min-width: 768px) {
        .footer .footer-text {
            justify-content: flex-start;
        }
        
        .footer .footer-links {
            justify-content: flex-end;
        }
    }
}

/* Mobile-first improvements */
.navbar-toggler {
    padding: 0.25rem 0.5rem;
    font-size: 1rem;
    border: 1px solid transparent;
}

.navbar-toggler:focus {
    box-shadow: 0 0 0 0.2rem rgba(var(--bs-primary), 0.25);
}

/* Better mobile navigation */
@@media (max-width: 991.98px) {
    .navbar-collapse {
        margin-top: 1rem;
        border-top: 1px solid var(--bs-light);
        padding-top: 1rem;
    }
    
    .navbar-nav .nav-link {
        padding: 0.75rem 0;
        border-bottom: 1px solid transparent;
    }
    
    .navbar-nav .nav-link:hover {
        background-color: color-mix(in srgb, var(--bs-primary) 10%, transparent);
        border-radius: 0.375rem;
        padding-left: 0.5rem;
        padding-right: 0.5rem;
    }
}

/* Animation for smooth transitions */
.sidebar,
.main-content,
.btn,
.form-control,
.card {
    transition: all 0.3s ease-in-out;
}
</style>