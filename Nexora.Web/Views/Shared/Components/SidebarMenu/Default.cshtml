@model Nexora.Web.ViewComponents.SidebarMenuViewModel

@foreach (var menu in Model.Menus.Where(m => m.ParentId == null).OrderBy(m => m.Order))
{
    var hasChildren = menu.Children != null && menu.Children.Any();
    var isActive = IsMenuActive(menu);
    
    if (hasChildren)
    {
        <div class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#">
                <i class="@menu.Icon"></i>
                <span>@menu.DisplayName</span>
                <i class="fas fa-chevron-down ms-auto"></i>
            </a>
            <div class="dropdown-menu">
                @foreach (var child in menu.Children.OrderBy(m => m.Order))
                {
                    <a class="dropdown-item @(IsMenuActive(child) ? "active" : "")" 
                       href="@GetMenuUrl(child)">
                        @if (!string.IsNullOrEmpty(child.Icon))
                        {
                            <i class="@child.Icon me-2"></i>
                        }
                        @child.DisplayName
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="nav-item">
            <a class="nav-link @(isActive ? "active" : "")" href="@GetMenuUrl(menu)">
                <i class="@menu.Icon"></i>
                <span>@menu.DisplayName</span>
            </a>
        </div>
    }
}

@functions {
    private string GetMenuUrl(Nexora.Core.Entities.Menu menu)
    {
        if (!string.IsNullOrEmpty(menu.Url))
            return menu.Url;
            
        var url = "/";
        if (!string.IsNullOrEmpty(menu.Area))
            url += menu.Area + "/";
        if (!string.IsNullOrEmpty(menu.Controller))
            url += menu.Controller + "/";
        if (!string.IsNullOrEmpty(menu.Action) && menu.Action != "Index")
            url += menu.Action;
            
        return url.TrimEnd('/');
    }
    
    private bool IsMenuActive(Nexora.Core.Entities.Menu menu)
    {
        // Check ActiveMenuUrl first
        if (!string.IsNullOrEmpty(menu.ActiveMenuUrl))
        {
            return Model.CurrentPath?.Equals(menu.ActiveMenuUrl, StringComparison.OrdinalIgnoreCase) == true;
        }
        
        // Check current controller/action
        return menu.Controller?.Equals(Model.CurrentController, StringComparison.OrdinalIgnoreCase) == true &&
               (string.IsNullOrEmpty(menu.Action) || menu.Action.Equals(Model.CurrentAction, StringComparison.OrdinalIgnoreCase)) &&
               (string.IsNullOrEmpty(menu.Area) || menu.Area.Equals(Model.CurrentArea, StringComparison.OrdinalIgnoreCase));
    }
}