@model IEnumerable<Nexora.Core.Entities.Menu>

@if (Model != null && Model.Any())
{
    <ul class="navbar-nav">
        @foreach (var menu in Model.Where(m => m.ParentId == null).OrderBy(m => m.Order))
        {
            @if (menu.Children != null && menu.Children.Any())
            {
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown_@menu.Id" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @if (!string.IsNullOrEmpty(menu.Icon))
                        {
                            <i class="@menu.Icon"></i>
                        }
                        @(menu.DisplayName ?? menu.Name)
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="navbarDropdown_@menu.Id">
                        @foreach (var child in menu.Children.Where(c => c.IsActive).OrderBy(c => c.Order))
                        {
                            <li>
                                @if (!string.IsNullOrEmpty(child.Url))
                                {
                                    <a class="dropdown-item" href="@child.Url">
                                        @if (!string.IsNullOrEmpty(child.Icon))
                                        {
                                            <i class="@child.Icon"></i>
                                        }
                                        @(child.DisplayName ?? child.Name)
                                    </a>
                                }
                                else if (!string.IsNullOrEmpty(child.Controller))
                                {
                                    <a class="dropdown-item" asp-area="@child.Area" asp-controller="@child.Controller" asp-action="@(child.Action ?? "Index")">
                                        @if (!string.IsNullOrEmpty(child.Icon))
                                        {
                                            <i class="@child.Icon"></i>
                                        }
                                        @(child.DisplayName ?? child.Name)
                                    </a>
                                }
                                else
                                {
                                    <span class="dropdown-item">
                                        @if (!string.IsNullOrEmpty(child.Icon))
                                        {
                                            <i class="@child.Icon"></i>
                                        }
                                        @(child.DisplayName ?? child.Name)
                                    </span>
                                }
                            </li>
                        }
                    </ul>
                </li>
            }
            else
            {
                <li class="nav-item">
                    @if (!string.IsNullOrEmpty(menu.Url))
                    {
                        <a class="nav-link" href="@menu.Url">
                            @if (!string.IsNullOrEmpty(menu.Icon))
                            {
                                <i class="@menu.Icon"></i>
                            }
                            @(menu.DisplayName ?? menu.Name)
                        </a>
                    }
                    else if (!string.IsNullOrEmpty(menu.Controller))
                    {
                        <a class="nav-link" asp-area="@menu.Area" asp-controller="@menu.Controller" asp-action="@(menu.Action ?? "Index")">
                            @if (!string.IsNullOrEmpty(menu.Icon))
                            {
                                <i class="@menu.Icon"></i>
                            }
                            @(menu.DisplayName ?? menu.Name)
                        </a>
                    }
                    else
                    {
                        <span class="nav-link">
                            @if (!string.IsNullOrEmpty(menu.Icon))
                            {
                                <i class="@menu.Icon"></i>
                            }
                            @(menu.DisplayName ?? menu.Name)
                        </span>
                    }
                </li>
            }
        }
    </ul>
}