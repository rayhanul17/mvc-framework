@using Microsoft.AspNetCore.Identity
@using Nexora.Core.Entities
@using Microsoft.Extensions.Options
@using Nexora.Core.Common

@inject UserManager<ApplicationUser> UserManager
@inject IOptions<AppSettings> AppSettings

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var settings = AppSettings.Value;
    
    ApplicationUser? currentUser = null;
    if (User.Identity?.IsAuthenticated == true)
    {
        currentUser = await UserManager.GetUserAsync(User);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    
    <!-- Bootstrap 5 -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Font Awesome Local -->
    <link rel="stylesheet" href="~/css/fontawesome-all.min.css" />
    
    <!-- Simple Layout CSS -->
    <link rel="stylesheet" href="~/css/simple-layout.css" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Mobile Overlay -->
    <div class="sidebar-overlay"></div>
    
    <!-- Sidebar -->
    <nav class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <i class="fas fa-cube"></i>
            <span>Admin Panel</span>
        </div>
        
        <div class="sidebar-nav">
            @if (User.Identity?.IsAuthenticated == true)
            {
                @await Component.InvokeAsync("SidebarMenu", new { currentController, currentAction, currentArea })
            }
            else
            {
                <div class="nav-item">
                    <a class="nav-link" href="/Account/Login">
                        <i class="fas fa-sign-in-alt"></i>
                        <span>Login</span>
                    </a>
                </div>
            }
        </div>
        
        @if (User.Identity?.IsAuthenticated == true && currentUser != null)
        {
            <div class="sidebar-footer">
                <div class="user-avatar">
                    @currentUser.DisplayName?.Substring(0, 1).ToUpper()
                </div>
                <div class="user-info">
                    <div class="user-name">@currentUser.DisplayName</div>
                    <div class="user-role">@(User.IsInRole("Administrator") ? "Admin" : "User")</div>
                </div>
            </div>
        }
    </nav>
    
    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navbar -->
        <nav class="navbar navbar-expand-lg top-navbar">
            <div class="container-fluid">
                <!-- Mobile Toggle -->
                <button class="btn btn-icon d-lg-none" data-toggle="sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                
                <!-- Desktop Collapse Toggle -->
                <button class="btn btn-icon d-none d-lg-block" data-toggle="sidebar-collapse">
                    <i class="fas fa-bars"></i>
                </button>
                
                <!-- Mobile Brand -->
                <a class="navbar-brand d-lg-none" href="/">
                    <i class="fas fa-cube"></i>
                    <span>Admin Panel</span>
                </a>
                
                <!-- Right Side Items -->
                <div class="ms-auto d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- Theme Toggle -->
                        <button class="btn btn-icon" data-toggle="theme" title="Toggle Theme">
                            <i class="fas fa-moon"></i>
                        </button>
                        
                        <!-- Notifications -->
                        <div class="dropdown">
                            <button class="btn btn-icon" data-bs-toggle="dropdown">
                                <i class="fas fa-bell"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><h6 class="dropdown-header">Notifications</h6></li>
                                <li><a class="dropdown-item" href="#">No new notifications</a></li>
                            </ul>
                        </div>
                        
                        <!-- User Menu -->
                        <div class="dropdown">
                            <button class="btn btn-icon" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><h6 class="dropdown-header">@currentUser?.DisplayName</h6></li>
                                <li><a class="dropdown-item" href="/Profile">
                                    <i class="fas fa-user me-2"></i> Profile
                                </a></li>
                                <li><a class="dropdown-item" href="/SiteSetting">
                                    <i class="fas fa-cog me-2"></i> Settings
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item">
                                            <i class="fas fa-sign-out-alt me-2"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-icon" data-toggle="theme" title="Toggle Theme">
                            <i class="fas fa-moon"></i>
                        </button>
                        <a href="/Account/Login" class="btn btn-primary btn-sm">
                            <i class="fas fa-sign-in-alt me-1"></i> Login
                        </a>
                    }
                </div>
            </div>
        </nav>
        
        <!-- Page Content -->
        <div class="page-content">
            @RenderBody()
        </div>
    </div>
    
    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/simple-sidebar.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>