@model Nexora.Application.Interfaces.TicketStatistics
@{
    ViewData["Title"] = "Ticket Statistics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>@ViewData["Title"]</h2>
            <p class="text-muted">Performance metrics and analytics</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Tickets
            </a>
        </div>
    </div>

    <!-- Overview Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Tickets</h5>
                    <h2 class="mb-0">@Model.TotalTickets</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Open Tickets</h5>
                    <h2 class="mb-0">@Model.OpenTickets</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Resolved</h5>
                    <h2 class="mb-0">@Model.ResolvedTickets</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Avg Resolution</h5>
                    <h2 class="mb-0">@Model.AverageResolutionHours.ToString("F1")h</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Tickets by Priority -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Tickets by Priority</h5>
                </div>
                <div class="card-body">
                    <canvas id="priorityChart"></canvas>
                    <table class="table table-sm mt-3">
                        <thead>
                            <tr>
                                <th>Priority</th>
                                <th>Count</th>
                                <th>Percentage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var priority in Model.TicketsByPriority)
                            {
                                var percentage = Model.TotalTickets > 0 ? (priority.Value * 100.0 / Model.TotalTickets) : 0;
                                <tr>
                                    <td>
                                        <span class="badge bg-@GetPriorityColor(priority.Key)">
                                            @priority.Key
                                        </span>
                                    </td>
                                    <td>@priority.Value</td>
                                    <td>@percentage.ToString("F1")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tickets by Category -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Tickets by Category</h5>
                </div>
                <div class="card-body">
                    <canvas id="categoryChart"></canvas>
                    <table class="table table-sm mt-3">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Count</th>
                                <th>Percentage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model.TicketsByCategory.OrderByDescending(c => c.Value))
                            {
                                var percentage = Model.TotalTickets > 0 ? (category.Value * 100.0 / Model.TotalTickets) : 0;
                                <tr>
                                    <td>@category.Key</td>
                                    <td>@category.Value</td>
                                    <td>@percentage.ToString("F1")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Performance Metrics -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Performance Metrics</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="metric-box text-center p-3 border rounded">
                        <h6>Resolution Rate</h6>
                        <h3 class="text-success">
                            @if (Model.TotalTickets > 0)
                            {
                                @(((Model.ResolvedTickets + Model.ClosedTickets) * 100.0 / Model.TotalTickets).ToString("F1"))@("%")
                            }
                            else
                            {
                                @("N/A")
                            }
                        </h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="metric-box text-center p-3 border rounded">
                        <h6>Unassigned Tickets</h6>
                        <h3 class="@(Model.UnassignedTickets > 0 ? "text-warning" : "text-success")">
                            @Model.UnassignedTickets
                        </h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="metric-box text-center p-3 border rounded">
                        <h6>Closed Tickets</h6>
                        <h3 class="text-info">
                            @Model.ClosedTickets
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Actions</h5>
        </div>
        <div class="card-body">
            <div class="btn-group" role="group">
                <button class="btn btn-outline-primary" onclick="exportReport('pdf')">
                    <i class="fas fa-file-pdf"></i> Export PDF Report
                </button>
                <button class="btn btn-outline-success" onclick="exportReport('excel')">
                    <i class="fas fa-file-excel"></i> Export to Excel
                </button>
                <button class="btn btn-outline-info" onclick="window.print()">
                    <i class="fas fa-print"></i> Print Report
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Priority Chart
        const priorityCtx = document.getElementById('priorityChart').getContext('2d');
        new Chart(priorityCtx, {
            type: 'doughnut',
            data: {
                labels: [@Html.Raw(string.Join(",", Model.TicketsByPriority.Keys.Select(k => $"'{k}'")))],
                datasets: [{
                    data: [@string.Join(",", Model.TicketsByPriority.Values)],
                    backgroundColor: ['#28a745', '#ffc107', '#dc3545', '#343a40']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                legend: {
                    position: 'bottom'
                }
            }
        });

        // Category Chart
        const categoryCtx = document.getElementById('categoryChart').getContext('2d');
        new Chart(categoryCtx, {
            type: 'bar',
            data: {
                labels: [@Html.Raw(string.Join(",", Model.TicketsByCategory.Keys.Select(k => $"'{k}'")))],
                datasets: [{
                    label: 'Tickets',
                    data: [@string.Join(",", Model.TicketsByCategory.Values)],
                    backgroundColor: '#007bff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        function exportReport(format) {
            alert('Export to ' + format + ' feature coming soon!');
        }
    </script>
}

@functions {
    string GetPriorityColor(Nexora.Core.Entities.TicketPriority priority)
    {
        return priority switch
        {
            Nexora.Core.Entities.TicketPriority.Low => "success",
            Nexora.Core.Entities.TicketPriority.Medium => "warning",
            Nexora.Core.Entities.TicketPriority.High => "danger",
            Nexora.Core.Entities.TicketPriority.Urgent => "dark",
            _ => "secondary"
        };
    }
}