@model Nexora.Web.Areas.CustomerSupport.Models.AssignTicketViewModel
@{
    ViewData["Title"] = "Assign Ticket";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-header mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2>
                            <i class="fas fa-user-plus text-primary me-2"></i>
                            Assign Ticket
                        </h2>
                        <p class="text-muted">Assign ticket #@Model.TicketNumber to support staff</p>
                    </div>
                    <div>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Back to Manage Tickets
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-ticket-alt me-2"></i>Ticket Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-3"><strong>Ticket Number:</strong></div>
                        <div class="col-sm-9">
                            <span class="badge bg-primary">@Model.TicketNumber</span>
                        </div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-sm-3"><strong>Title:</strong></div>
                        <div class="col-sm-9">@Model.Title</div>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user-cog me-2"></i>Assignment Details
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Assign" method="post">
                        <input type="hidden" asp-for="TicketId" />
                        <input type="hidden" asp-for="TicketNumber" />
                        <input type="hidden" asp-for="Title" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-4">
                            <label asp-for="AssignToUserId" class="form-label">
                                <i class="fas fa-user me-1"></i>Assign To <span class="text-danger">*</span>
                            </label>
                            <select asp-for="AssignToUserId" class="form-select form-select-lg">
                                <option value="">-- Select Support Staff --</option>
                                @foreach (var staff in Model.AvailableStaff)
                                {
                                    <option value="@staff.Id">
                                        @staff.FullName (@staff.Email)
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="AssignToUserId" class="text-danger"></span>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Select a support team member to assign this ticket to.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="assignmentNotes" class="form-label">
                                <i class="fas fa-sticky-note me-1"></i>Assignment Notes
                            </label>
                            <textarea name="assignmentNotes" class="form-control" rows="4" 
                                     placeholder="Optional notes about this assignment (visible to the assignee)"></textarea>
                            <div class="form-text">
                                Provide any context or instructions for the assigned team member.
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="sendNotification" name="sendNotification" checked />
                                <label class="form-check-label" for="sendNotification">
                                    <i class="fas fa-bell me-1"></i>Send email notification to assignee
                                </label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="notifyCustomer" name="notifyCustomer" />
                                <label class="form-check-label" for="notifyCustomer">
                                    <i class="fas fa-envelope me-1"></i>Notify customer about assignment
                                </label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-user-plus me-2"></i>Assign Ticket
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Quick Assignment Options -->
            <div class="card">
                <div class="card-header">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-zap me-2"></i>Quick Assign
                    </h6>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">Assign to available team members based on workload:</p>
                    
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-primary" onclick="quickAssign('auto')">
                            <i class="fas fa-magic me-2"></i>Auto-Assign (Least Busy)
                        </button>
                        <button type="button" class="btn btn-outline-success" onclick="quickAssign('round-robin')">
                            <i class="fas fa-sync-alt me-2"></i>Round Robin Assignment
                        </button>
                        <button type="button" class="btn btn-outline-info" onclick="quickAssign('skill-match')">
                            <i class="fas fa-bullseye me-2"></i>Skill-Based Assignment
                        </button>
                    </div>
                    
                    <hr>
                    
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i>
                        Quick assignment options automatically select the best available team member based on different criteria.
                    </small>
                </div>
            </div>

            <!-- Team Workload -->
            <div class="card mt-4">
                <div class="card-header">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-chart-bar me-2"></i>Team Workload
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.AvailableStaff.Any())
                    {
                        @foreach (var staff in Model.AvailableStaff.Take(5))
                        {
                            var workload = new Random().Next(0, 20); // Placeholder - should come from actual data
                            var workloadPercent = Math.Min(100, (workload * 5));
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" 
                                             style="width: 24px; height: 24px; font-size: 10px;">
                                            @staff.FullName.First()
                                        </div>
                                        <small class="fw-bold">@staff.FullName</small>
                                    </div>
                                    <small class="text-muted">@workload tickets</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-@(workloadPercent > 80 ? "danger" : workloadPercent > 60 ? "warning" : "success")" 
                                         style="width: @workloadPercent%"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted">
                            <i class="fas fa-user-slash fa-2x mb-2"></i>
                            <p>No support staff available</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        function quickAssign(method) {
            const staffSelect = document.getElementById('AssignToUserId');
            const availableStaff = Array.from(staffSelect.options).slice(1); // Skip the first "Select" option
            
            if (availableStaff.length === 0) {
                alert('No support staff available for assignment.');
                return;
            }
            
            let selectedStaff = null;
            
            switch(method) {
                case 'auto':
                case 'round-robin':
                case 'skill-match':
                    // For demo purposes, just pick the first available staff
                    // In real implementation, this would use actual workload/skill data
                    selectedStaff = availableStaff[0];
                    break;
            }
            
            if (selectedStaff) {
                staffSelect.value = selectedStaff.value;
                
                // Highlight the selection
                staffSelect.classList.add('border-success');
                setTimeout(() => staffSelect.classList.remove('border-success'), 2000);
                
                // Add a note about the assignment method
                let notes = document.querySelector('textarea[name="assignmentNotes"]');
                const methodName = method.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase());
                notes.value = `Auto-assigned using ${methodName} method.\n\n` + notes.value;
                
                // Show success message
                showToast(`Selected ${selectedStaff.text} using ${methodName} assignment.`, 'success');
            }
        }
        
        function showToast(message, type = 'info') {
            // Simple toast notification
            const toast = document.createElement('div');
            toast.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
            toast.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            document.body.appendChild(toast);
            
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.parentNode.removeChild(toast);
                }
            }, 5000);
        }
        
        // Form validation enhancement
        document.querySelector('form').addEventListener('submit', function(e) {
            const assignToSelect = document.getElementById('AssignToUserId');
            if (!assignToSelect.value) {
                e.preventDefault();
                assignToSelect.focus();
                assignToSelect.classList.add('border-danger');
                showToast('Please select a team member to assign the ticket to.', 'warning');
                return false;
            }
        });
    </script>
}