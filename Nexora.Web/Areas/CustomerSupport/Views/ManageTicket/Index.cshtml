        function showLoadingSpinner() {
            const spinner = document.createElement('div');
            spinner.id = 'loading-spinner';
            spinner.className = 'position-fixed top-50 start-50 translate-middle';
            spinner.style.zIndex = '9999';
            spinner.innerHTML = `
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            `;
            document.body.appendChild(spinner);
        }

        function hideLoadingSpinner() {
            const spinner = document.getElementById('loading-spinner');
            if (spinner) {
                spinner.remove();
            }
        }

        function showNotification(type, message) {
            const toast = document.createElement('div');
            toast.className = `alert alert-${type === 'success' ? 'success' : 'danger'} alert-dismissible fade show position-fixed`;
            toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
            toast.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            document.body.appendChild(toast);
            
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.parentNode.removeChild(toast);
                }
            }, 5000);
        }
        
        function quickStatusUpdate(ticketId, newStatus) {
            if (confirm(`Are you sure you want to change this ticket's status to ${newStatus}?`)) {
                // Create a form and submit it
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("QuickStatusUpdate", "ManageTicket", new { area = "CustomerSupport" })';
                
                const ticketIdInput = document.createElement('input');
                ticketIdInput.type = 'hidden';
                ticketIdInput.name = 'ticketId';
                ticketIdInput.value = ticketId;
                form.appendChild(ticketIdInput);
                
                const statusInput = document.createElement('input');
                statusInput.type = 'hidden';
                statusInput.name = 'newStatus';
                statusInput.value = newStatus;
                form.appendChild(statusInput);
                
                const tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = $('input[name="__RequestVerificationToken"]').val();
                form.appendChild(tokenInput);
                
                document.body.appendChild(form);
                form.submit();
            }
        }
        
        // Initialize DataTables and bulk operations
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize DataTables
            $('#ticketsTable').DataTable({
                responsive: true,
                order: [[7, 'desc']], // Sort by Created Date column by default
                columnDefs: [
                    { orderable: false, targets: [0, 9] }, // Disable sorting on checkbox and Actions columns
                    { searchable: false, targets: [0, 9] }, // Disable searching on checkbox and Actions columns
                    { width: "30px", targets: [0] }, // Set fixed width for checkbox column
                    { width: "200px", targets: [9] } // Set fixed width for Actions column
                ],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    search: "Search tickets:",
                    lengthMenu: "Show _MENU_ tickets per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ tickets",
                    infoEmpty: "No tickets found",
                    infoFiltered: "(filtered from _MAX_ total tickets)",
                    emptyTable: "No tickets available",
                    zeroRecords: "No matching tickets found"
                },
                drawCallback: function() {
                    // Re-attach event handlers after each redraw (pagination, search, etc.)
                    updateSelectionCount();
                    
                    // Re-bind checkbox event handlers
                    const checkboxes = document.querySelectorAll('.ticket-checkbox');
                    checkboxes.forEach(cb => {
                        cb.onchange = updateSelectionCount;
                    });
                    
                    const selectAllCheckbox = document.getElementById('selectAllCheckbox');
                    if (selectAllCheckbox) {
                        selectAllCheckbox.onchange = toggleSelectAll;
                    }
                }
            });
            
            updateSelectionCount(); // Initial state
            
            // Auto-refresh every 30 seconds
            setInterval(function() {
                // Check if any tickets are in critical status and show notification
                const criticalTickets = document.querySelectorAll('.border-danger').length;
                if (criticalTickets > 0) {
                    document.title = `(${criticalTickets}) Manage Tickets - Critical Attention Needed`;
                }
            }, 30000);
        });
    </script>
}

@functions {
    string GetStatusBadgeClass(Nexora.Core.Entities.TicketStatus status)
    {
        return status switch
        {
            Nexora.Core.Entities.TicketStatus.New => "primary",
            Nexora.Core.Entities.TicketStatus.Open => "info",
            Nexora.Core.Entities.TicketStatus.InProgress => "warning",
            Nexora.Core.Entities.TicketStatus.OnHold => "secondary",
            Nexora.Core.Entities.TicketStatus.Resolved => "success",
            Nexora.Core.Entities.TicketStatus.Closed => "dark",
            Nexora.Core.Entities.TicketStatus.Cancelled => "danger",
            Nexora.Core.Entities.TicketStatus.Reopened => "info",
            _ => "secondary"
        };
    }

    string GetPriorityBadgeClass(Nexora.Core.Entities.TicketPriority priority)
    {
        return priority switch
        {
            Nexora.Core.Entities.TicketPriority.Low => "success",
            Nexora.Core.Entities.TicketPriority.Medium => "info",
            Nexora.Core.Entities.TicketPriority.High => "warning",
            Nexora.Core.Entities.TicketPriority.Urgent => "danger",
            Nexora.Core.Entities.TicketPriority.Critical => "dark",
            _ => "secondary"
        };
    }
}

