        function executeBulkCategoryUpdate(selectedTickets, newCategory, modal) {
            if (!newCategory || newCategory.trim() === '') {
                alert('Please enter a category.');
                return;
            }
            
            showLoadingSpinner();
            
            fetch('@Url.Action("BulkCategoryUpdate", "ManageTicket", new { area = "CustomerSupport" })', {
                method: 'POST',
