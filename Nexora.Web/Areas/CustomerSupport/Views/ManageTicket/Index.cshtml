@model Nexora.Web.Areas.CustomerSupport.Models.TicketListViewModel
@{
    ViewData["Title"] = "Manage Tickets";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-header mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2>
                            <i class="fas fa-tasks text-primary me-2"></i>
                            Manage Tickets
                        </h2>
                        <p class="text-muted">Comprehensive ticket management dashboard for support staff</p>
                    </div>
                    <div>
                        <a asp-area="CustomerSupport" asp-controller="Ticket" asp-action="Create" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Create New Ticket
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.Tickets.Count(t => t.Status == Nexora.Core.Entities.TicketStatus.New)</h4>
                            <small>New Tickets</small>
                        </div>
                        <i class="fas fa-plus-circle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.Tickets.Count(t => t.Status == Nexora.Core.Entities.TicketStatus.InProgress)</h4>
                            <small>In Progress</small>
                        </div>
                        <i class="fas fa-cog fa-spin fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.Tickets.Count(t => t.AssignedToId == null)</h4>
                            <small>Unassigned</small>
                        </div>
                        <i class="fas fa-user-slash fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.Tickets.Count(t => t.Status == Nexora.Core.Entities.TicketStatus.Resolved)</h4>
                            <small>Resolved Today</small>
                        </div>
                        <i class="fas fa-check-circle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-filter me-2"></i>Filters & Search
                    </h6>
                </div>
                <div class="card-body">
                    <form method="get" asp-action="Index" class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Search</label>
                            <input name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search tickets, numbers, descriptions..." />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Status</label>
                            <select name="filterStatus" class="form-select">
                                <option value="all" selected="@(Model.FilterStatus == "all")">All Status</option>
                                <option value="New" selected="@(Model.FilterStatus == "New")">New</option>
                                <option value="Open" selected="@(Model.FilterStatus == "Open")">Open</option>
                                <option value="InProgress" selected="@(Model.FilterStatus == "InProgress")">In Progress</option>
                                <option value="OnHold" selected="@(Model.FilterStatus == "OnHold")">On Hold</option>
                                <option value="Resolved" selected="@(Model.FilterStatus == "Resolved")">Resolved</option>
                                <option value="Closed" selected="@(Model.FilterStatus == "Closed")">Closed</option>
                                <option value="Cancelled" selected="@(Model.FilterStatus == "Cancelled")">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Priority</label>
                            <select name="filterPriority" class="form-select">
                                <option value="all" selected="@(Model.FilterPriority == "all")">All Priority</option>
                                <option value="Low" selected="@(Model.FilterPriority == "Low")">Low</option>
                                <option value="Medium" selected="@(Model.FilterPriority == "Medium")">Medium</option>
                                <option value="High" selected="@(Model.FilterPriority == "High")">High</option>
                                <option value="Urgent" selected="@(Model.FilterPriority == "Urgent")">Urgent</option>
                                <option value="Critical" selected="@(Model.FilterPriority == "Critical")">Critical</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Assignment</label>
                            <select name="filterAssignment" class="form-select">
                                <option value="all">All Tickets</option>
                                <option value="unassigned">Unassigned</option>
                                <option value="assigned">Assigned</option>
                                <option value="my">My Tickets</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="fas fa-search me-1"></i>Filter
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary me-2">
                                <i class="fas fa-times me-1"></i>Clear
                            </a>
                            <a asp-action="Unassigned" class="btn btn-warning">
                                <i class="fas fa-user-slash me-1"></i>Unassigned
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Tickets Table -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="card-title mb-0">
                            Tickets (@Model.TotalCount total) <span id="selection-count" class="text-muted"></span>
                        </h6>
                        <div class="btn-toolbar" role="toolbar">
                            <div class="btn-group btn-group-sm me-2" role="group">
                                <button type="button" class="btn btn-outline-secondary" onclick="selectAll()">
                                    <i class="fas fa-check-square me-1"></i>Select All
                                </button>
                                <button type="button" class="btn btn-outline-secondary" onclick="clearSelection()">
                                    <i class="fas fa-times me-1"></i>Clear
                                </button>
                            </div>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-primary" onclick="bulkAction('assign')">
                                    <i class="fas fa-user-plus me-1"></i>Assign
                                </button>
                                <button type="button" class="btn btn-outline-warning" onclick="bulkAction('status')">
                                    <i class="fas fa-edit me-1"></i>Status
                                </button>
                                <button type="button" class="btn btn-outline-info" onclick="bulkAction('priority')">
                                    <i class="fas fa-flag me-1"></i>Priority
                                </button>
                                <button type="button" class="btn btn-outline-success" onclick="bulkAction('category')">
                                    <i class="fas fa-tag me-1"></i>Category
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (Model.Tickets.Any())
                    {
                        <div class="table-responsive">
                            <table id="ticketsTable" class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th width="30">
                                            <input type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll()" />
                                        </th>
                                        <th>Ticket #</th>
                                        <th>Title</th>
                                        <th>Status</th>
                                        <th>Priority</th>
                                        <th>Customer</th>
                                        <th>Assigned To</th>
                                        <th>Created</th>
                                        <th>Last Updated</th>
                                        <th width="200">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ticket in Model.Tickets)
                                    {
                                        var overdue = ticket.DueDate.HasValue && ticket.DueDate.Value < DateTime.Now && 
                                                     ticket.Status != Nexora.Core.Entities.TicketStatus.Closed && 
                                                     ticket.Status != Nexora.Core.Entities.TicketStatus.Resolved;
                                        <tr class="@(overdue ? "table-warning" : "") @(ticket.Priority == Nexora.Core.Entities.TicketPriority.Critical ? "border-start border-danger border-3" : "")">
                                            <td>
                                                <input type="checkbox" class="ticket-checkbox" value="@ticket.Id" onchange="updateSelectionCount()" />
                                            </td>
                                            <td>
                                                <strong class="text-primary">@(ticket.TicketNumber ?? $"T{ticket.Id:D6}")</strong>
                                                @if (overdue)
                                                {
                                                    <br><small class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>Overdue</small>
                                                }
                                            </td>
                                            <td>
                                                <div>
                                                    <strong>@ticket.Title</strong>
                                                    @if (!string.IsNullOrEmpty(ticket.Category))
                                                    {
                                                        <br><small class="text-muted">@ticket.Category</small>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-@(GetStatusBadgeClass(ticket.Status))">
                                                    @ticket.Status.ToString().Replace("InProgress", "In Progress")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@(GetPriorityBadgeClass(ticket.Priority))">
                                                    @ticket.Priority
                                                </span>
                                            </td>
                                            <td>
                                                @if (ticket.Customer != null)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center me-2" 
                                                             style="width: 24px; height: 24px; font-size: 10px;">
                                                            @ticket.Customer.FullName.First()
                                                        </div>
                                                        <div>
                                                            <div class="fw-bold">@ticket.Customer.FullName</div>
                                                            <small class="text-muted">@ticket.Customer.Email</small>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Unknown</span>
                                                }
                                            </td>
                                            <td>
                                                @if (ticket.AssignedTo != null)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-2" 
                                                             style="width: 24px; height: 24px; font-size: 10px;">
                                                            @ticket.AssignedTo.FullName.First()
                                                        </div>
                                                        <div>
                                                            <div class="fw-bold">@ticket.AssignedTo.FullName</div>
                                                            <small class="text-muted">@ticket.AssignedTo.Email</small>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Unassigned</span>
                                                }
                                            </td>
                                            <td>
                                                <div title="@ticket.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")">
                                                    @ticket.CreatedAt.ToString("MMM dd")
                                                    <br><small class="text-muted">@ticket.CreatedAt.ToString("HH:mm")</small>
                                                </div>
                                            </td>
                                            <td>
                                                @if (ticket.UpdatedAt.HasValue)
                                                {
                                                    <div title="@ticket.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm:ss")">
                                                        @ticket.UpdatedAt.Value.ToString("MMM dd")
                                                        <br><small class="text-muted">@ticket.UpdatedAt.Value.ToString("HH:mm")</small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not updated</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    @if (await User.CanAccessUrlAsync($"/CustomerSupport/ManageTicket/Details/{ticket.Id}"))
                                                    {
                                                        <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-outline-primary" title="View Details">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                    }
                                                    @if (await User.CanAccessUrlAsync($"/CustomerSupport/ManageTicket/Assign/{ticket.Id}"))
                                                    {
                                                        @if (ticket.AssignedToId == null)
                                                        {
                                                            <a asp-action="Assign" asp-route-id="@ticket.Id" class="btn btn-outline-success" title="Assign">
                                                                <i class="fas fa-user-plus"></i>
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a asp-action="Assign" asp-route-id="@ticket.Id" class="btn btn-outline-warning" title="Reassign">
                                                                <i class="fas fa-user-edit"></i>
                                                            </a>
                                                        }
                                                    }
                                                    @if (ticket.Status != Nexora.Core.Entities.TicketStatus.Resolved && ticket.Status != Nexora.Core.Entities.TicketStatus.Closed)
                                                    {
                                                        <button type="button" class="btn btn-outline-info" onclick="quickStatusUpdate(@ticket.Id, 'Resolved')" title="Quick Resolve">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                    }
                                                    <div class="dropdown">
                                                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                            <i class="fas fa-ellipsis-v"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end">
                                                            <li><a class="dropdown-item" asp-area="CustomerSupport" asp-controller="Ticket" asp-action="Edit" asp-route-id="@ticket.Id">
                                                                <i class="fas fa-edit me-2"></i>Edit
                                                            </a></li>
                                                            <li><hr class="dropdown-divider"></li>
                                                            <li><a class="dropdown-item" href="#" onclick="quickStatusUpdate(@ticket.Id, 'Open')">
                                                                <i class="fas fa-folder-open me-2"></i>Set Open
                                                            </a></li>
                                                            <li><a class="dropdown-item" href="#" onclick="quickStatusUpdate(@ticket.Id, 'InProgress')">
                                                                <i class="fas fa-cog me-2"></i>Set In Progress
                                                            </a></li>
                                                            <li><a class="dropdown-item" href="#" onclick="quickStatusUpdate(@ticket.Id, 'OnHold')">
                                                                <i class="fas fa-pause me-2"></i>Put On Hold
                                                            </a></li>
                                                            <li><a class="dropdown-item" href="#" onclick="quickStatusUpdate(@ticket.Id, 'Resolved')">
                                                                <i class="fas fa-check me-2"></i>Mark Resolved
                                                            </a></li>
                                                            <li><a class="dropdown-item" href="#" onclick="quickStatusUpdate(@ticket.Id, 'Closed')">
                                                                <i class="fas fa-times me-2"></i>Close Ticket
                                                            </a></li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No tickets found</h5>
                            <p class="text-muted">Try adjusting your filters or create a new ticket to get started.</p>
                            <a asp-area="CustomerSupport" asp-controller="Ticket" asp-action="Create" class="btn btn-primary">
                                <i class="fas fa-plus me-2"></i>Create New Ticket
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectAll() {
            const checkboxes = document.querySelectorAll('.ticket-checkbox');
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            const allChecked = Array.from(checkboxes).every(cb => cb.checked);
            
            checkboxes.forEach(cb => cb.checked = !allChecked);
            selectAllCheckbox.checked = !allChecked;
            updateSelectionCount();
        }

        function clearSelection() {
            const checkboxes = document.querySelectorAll('.ticket-checkbox');
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            
            checkboxes.forEach(cb => cb.checked = false);
            selectAllCheckbox.checked = false;
            updateSelectionCount();
        }
        
        function toggleSelectAll() {
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            const checkboxes = document.querySelectorAll('.ticket-checkbox');
            
            checkboxes.forEach(cb => cb.checked = selectAllCheckbox.checked);
            updateSelectionCount();
        }

        function updateSelectionCount() {
            const selectedCount = document.querySelectorAll('.ticket-checkbox:checked').length;
            const countElement = document.getElementById('selection-count');
            
            if (countElement) {
                countElement.textContent = selectedCount > 0 ? `(${selectedCount} selected)` : '';
            }
            
            // Enable/disable bulk action buttons based on selection
            const bulkButtons = document.querySelectorAll('[onclick*="bulkAction"]');
            bulkButtons.forEach(btn => {
                btn.disabled = selectedCount === 0;
                if (selectedCount === 0) {
                    btn.classList.add('disabled');
                } else {
                    btn.classList.remove('disabled');
                }
            });
        }
        
        function getSelectedTickets() {
            const checkboxes = document.querySelectorAll('.ticket-checkbox:checked');
            return Array.from(checkboxes).map(cb => cb.value);
        }
        
        function bulkAction(action) {
            const selectedTickets = getSelectedTickets();
            if (selectedTickets.length === 0) {
                alert('Please select at least one ticket.');
                return;
            }
            
            if (action === 'assign') {
                showBulkAssignModal(selectedTickets);
            } else if (action === 'status') {
                showBulkStatusModal(selectedTickets);
            } else if (action === 'priority') {
                showBulkPriorityModal(selectedTickets);
            } else if (action === 'category') {
                showBulkCategoryModal(selectedTickets);
            }
        }

        function showBulkAssignModal(selectedTickets) {
            const modal = createBulkModal('Bulk Assign Tickets', `Assign ${selectedTickets.length} selected tickets to:`);
            
            fetch('@Url.Action("GetAvailableAgents", "ManageTicket", new { area = "CustomerSupport" })')
                .then(response => response.json())
                .then(agents => {
                    const select = document.createElement('select');
                    select.className = 'form-select';
                    select.id = 'bulk-assignee';
                    select.innerHTML = '<option value="">Select an agent...</option>';
                    
                    agents.forEach(agent => {
                        const option = document.createElement('option');
                        option.value = agent.id;
                        option.textContent = `${agent.name} (${agent.email})`;
                        select.appendChild(option);
                    });
                    
                    modal.querySelector('.modal-body').appendChild(select);
                    
                    const confirmBtn = modal.querySelector('.btn-primary');
                    confirmBtn.onclick = () => executeBulkAssign(selectedTickets, select.value, modal);
                })
                .catch(error => {
                    console.error('Error loading agents:', error);
                    alert('Error loading available agents. Please try again.');
                });
            
            document.body.appendChild(modal);
            new bootstrap.Modal(modal).show();
        }

        function showBulkStatusModal(selectedTickets) {
            const modal = createBulkModal('Bulk Status Update', `Update status of ${selectedTickets.length} selected tickets to:`);
            
            const select = document.createElement('select');
            select.className = 'form-select mb-3';
            select.id = 'bulk-status';
            select.innerHTML = `
                <option value="">Select status...</option>
                <option value="New">New</option>
                <option value="Open">Open</option>
                <option value="InProgress">In Progress</option>
                <option value="OnHold">On Hold</option>
                <option value="Resolved">Resolved</option>
                <option value="Closed">Closed</option>
                <option value="Cancelled">Cancelled</option>
            `;
            
            const textarea = document.createElement('textarea');
            textarea.className = 'form-control';
            textarea.id = 'bulk-notes';
            textarea.placeholder = 'Optional notes for this status change...';
            textarea.rows = 3;
            
            const label = document.createElement('label');
            label.textContent = 'Notes (optional):';
            label.className = 'form-label mt-2';
            
            const modalBody = modal.querySelector('.modal-body');
            modalBody.appendChild(select);
            modalBody.appendChild(label);
            modalBody.appendChild(textarea);
            
            const confirmBtn = modal.querySelector('.btn-primary');
            confirmBtn.onclick = () => executeBulkStatusUpdate(selectedTickets, select.value, textarea.value, modal);
            
            document.body.appendChild(modal);
            new bootstrap.Modal(modal).show();
        }

        function showBulkPriorityModal(selectedTickets) {
            const modal = createBulkModal('Bulk Priority Update', `Update priority of ${selectedTickets.length} selected tickets to:`);
            
            const select = document.createElement('select');
            select.className = 'form-select mb-3';
            select.id = 'bulk-priority';
            select.innerHTML = `
                <option value="">Select priority...</option>
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
                <option value="Urgent">Urgent</option>
                <option value="Critical">Critical</option>
            `;
            
            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.id = 'send-priority-notification';
            checkbox.className = 'form-check-input';
            checkbox.checked = true;
            
            const checkboxLabel = document.createElement('label');
            checkboxLabel.textContent = ' Send notification to customers';
            checkboxLabel.className = 'form-check-label ms-2';
            
            const checkboxDiv = document.createElement('div');
            checkboxDiv.className = 'form-check';
            checkboxDiv.appendChild(checkbox);
            checkboxDiv.appendChild(checkboxLabel);
            
            const modalBody = modal.querySelector('.modal-body');
            modalBody.appendChild(select);
            modalBody.appendChild(checkboxDiv);
            
            const confirmBtn = modal.querySelector('.btn-primary');
            confirmBtn.onclick = () => executeBulkPriorityUpdate(selectedTickets, select.value, checkbox.checked, modal);
            
            document.body.appendChild(modal);
            new bootstrap.Modal(modal).show();
        }

        function showBulkCategoryModal(selectedTickets) {
            const modal = createBulkModal('Bulk Category Update', `Update category of ${selectedTickets.length} selected tickets to:`);
            
            const input = document.createElement('input');
            input.type = 'text';
            input.className = 'form-control';
            input.id = 'bulk-category';
            input.placeholder = 'Enter new category...';
            
            // Add some common categories as datalist
            const datalist = document.createElement('datalist');
            datalist.id = 'category-suggestions';
            const commonCategories = ['General', 'Technical Support', 'Billing', 'Account Issues', 'Feature Request', 'Bug Report', 'Hardware', 'Software'];
            commonCategories.forEach(cat => {
                const option = document.createElement('option');
                option.value = cat;
                datalist.appendChild(option);
            });
            
            input.setAttribute('list', 'category-suggestions');
            
            const modalBody = modal.querySelector('.modal-body');
            modalBody.appendChild(input);
            modalBody.appendChild(datalist);
            
            const confirmBtn = modal.querySelector('.btn-primary');
            confirmBtn.onclick = () => executeBulkCategoryUpdate(selectedTickets, input.value, modal);
            
            document.body.appendChild(modal);
            new bootstrap.Modal(modal).show();
        }

        function createBulkModal(title, bodyText) {
            const modal = document.createElement('div');
            modal.className = 'modal fade';
            modal.innerHTML = `
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">${title}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p>${bodyText}</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary">Confirm</button>
                        </div>
                    </div>
                </div>
            `;
            return modal;
        }

        function executeBulkAssign(selectedTickets, assigneeId, modal) {
            if (!assigneeId) {
                alert('Please select an assignee.');
                return;
            }
            
            showLoadingSpinner();
            
            fetch('@Url.Action("BulkAssign", "ManageTicket", new { area = "CustomerSupport" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({
                    selectedTicketIds: selectedTickets.map(id => parseInt(id)),
                    newAssigneeId: assigneeId,
                    sendNotification: true
                })
            })
            .then(response => response.json())
            .then(data => {
                hideLoadingSpinner();
                bootstrap.Modal.getInstance(modal).hide();
                
                if (data.success) {
                    showNotification('success', data.message);
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showNotification('error', data.message);
                }
            })
            .catch(error => {
                hideLoadingSpinner();
                console.error('Error:', error);
                showNotification('error', 'An error occurred during bulk assignment.');
            });
        }

        function executeBulkStatusUpdate(selectedTickets, newStatus, notes, modal) {
            if (!newStatus) {
                alert('Please select a status.');
                return;
            }
            
            showLoadingSpinner();
            
            fetch('@Url.Action("BulkStatusUpdate", "ManageTicket", new { area = "CustomerSupport" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({
                    selectedTicketIds: selectedTickets.map(id => parseInt(id)),
                    newStatus: newStatus,
                    notes: notes,
                    sendNotification: true
                })
            })
            .then(response => response.json())
            .then(data => {
