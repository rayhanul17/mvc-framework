@model Nexora.Web.Areas.CustomerSupport.Models.TicketDetailsViewModel
@{
    ViewData["Title"] = $"Ticket #{Model.Ticket.TicketNumber}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">@Model.Ticket.Title</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Status:</strong>
                            <span class="badge bg-@GetStatusColor(Model.Ticket.Status)">
                                @Model.Ticket.Status
                            </span>
                        </div>
                        <div class="col-md-6">
                            <strong>Priority:</strong>
                            <span class="badge bg-@GetPriorityColor(Model.Ticket.Priority)">
                                @Model.Ticket.Priority
                            </span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <strong>Description:</strong>
                        <p class="mt-2">@Html.Raw(Model.Ticket.Description.Replace("\n", "<br />"))</p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Ticket.ResolutionNotes))
                    {
                        <div class="alert alert-success">
                            <h6>Resolution Notes:</h6>
                            <p>@Model.Ticket.ResolutionNotes</p>
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Comments</h5>
                </div>
                <div class="card-body">
                    @if (Model.Comments.Any())
                    {
                        foreach (var comment in Model.Comments.OrderBy(c => c.CreatedAt))
                        {
                            <div class="comment-item mb-3 pb-3 border-bottom">
                                <div class="d-flex justify-content-between">
                                    <strong>@comment.User?.FullName</strong>
                                    <small class="text-muted">@comment.CreatedAt.ToString("MM/dd/yyyy HH:mm")</small>
                                </div>
                                @if (comment.Type != Nexora.Core.Entities.CommentType.Comment)
                                {
                                    <span class="badge bg-info">@comment.Type</span>
                                }
                                <p class="mt-2 mb-0">@comment.Comment</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No comments yet.</p>
                    }

                    @if (Model.Ticket.Status != Nexora.Core.Entities.TicketStatus.Closed)
                    {
                        <form asp-action="AddComment" method="post" class="mt-3">
                            <input type="hidden" asp-for="@Model.Ticket.Id" name="ticketId" />
                            <div class="mb-3">
                                <label class="form-label">Add Comment</label>
                                <textarea name="comment" class="form-control" rows="3" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-comment"></i> Add Comment
                            </button>
                        </form>
                    }
                </div>
            </div>

            @if (Model.Attachments.Any())
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Attachments</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-group">
                            @foreach (var attachment in Model.Attachments)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fas fa-file"></i> @attachment.FileName
                                        <small class="text-muted">(@((attachment.FileSize / 1024.0).ToString("F2")) KB)</small>
                                    </div>
                                    <a href="@attachment.FilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-download"></i> Download
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Ticket Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">Ticket #:</dt>
                        <dd class="col-sm-7">@Model.Ticket.TicketNumber</dd>

                        <dt class="col-sm-5">Category:</dt>
                        <dd class="col-sm-7">@Model.Ticket.Category</dd>

                        <dt class="col-sm-5">Created:</dt>
                        <dd class="col-sm-7">@Model.Ticket.CreatedAt.ToString("MM/dd/yyyy HH:mm")</dd>

                        <dt class="col-sm-5">Customer:</dt>
                        <dd class="col-sm-7">@Model.Ticket.Customer?.FullName</dd>

                        <dt class="col-sm-5">Assigned To:</dt>
                        <dd class="col-sm-7">
                            @if (Model.Ticket.AssignedTo != null)
                            {
                                @Model.Ticket.AssignedTo.FullName
                            }
                            else
                            {
                                <span class="text-muted">Unassigned</span>
                            }
                        </dd>

                        @if (Model.Ticket.ResolvedAt.HasValue)
                        {
                            <dt class="col-sm-5">Resolved:</dt>
                            <dd class="col-sm-7">@Model.Ticket.ResolvedAt.Value.ToString("MM/dd/yyyy HH:mm")</dd>
                        }

                        @if (Model.Ticket.ClosedAt.HasValue)
                        {
                            <dt class="col-sm-5">Closed:</dt>
                            <dd class="col-sm-7">@Model.Ticket.ClosedAt.Value.ToString("MM/dd/yyyy HH:mm")</dd>
                        }
                    </dl>
                </div>
            </div>

            @if (Model.CanReopen && Model.Ticket.Status == Nexora.Core.Entities.TicketStatus.Closed)
            {
                <div class="card">
                    <div class="card-body">
                        <form asp-action="Reopen" method="post">
                            <input type="hidden" asp-for="@Model.Ticket.Id" name="ticketId" />
                            <div class="mb-3">
                                <label class="form-label">Reason for Reopening</label>
                                <textarea name="reason" class="form-control" rows="3" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-warning w-100">
                                <i class="fas fa-redo"></i> Reopen Ticket
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (Model.History.Any())
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Activity History</h5>
            </div>
            <div class="card-body">
                <div class="timeline">
                    @foreach (var history in Model.History.OrderByDescending(h => h.CreatedAt))
                    {
                        <div class="timeline-item mb-3">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <strong>@history.Action</strong>
                                    @if (!string.IsNullOrEmpty(history.Description))
                                    {
                                        <span> - @history.Description</span>
                                    }
                                </div>
                                <small class="text-muted">
                                    @history.User?.FullName - @history.CreatedAt.ToString("MM/dd/yyyy HH:mm")
                                </small>
                            </div>
                            @if (!string.IsNullOrEmpty(history.OldValue) && !string.IsNullOrEmpty(history.NewValue))
                            {
                                <small class="text-muted">Changed from "@history.OldValue" to "@history.NewValue"</small>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@functions {
    string GetStatusColor(Nexora.Core.Entities.TicketStatus status)
    {
        return status switch
        {
            Nexora.Core.Entities.TicketStatus.New => "primary",
            Nexora.Core.Entities.TicketStatus.Assigned => "info",
            Nexora.Core.Entities.TicketStatus.InProgress => "warning",
            Nexora.Core.Entities.TicketStatus.Resolved => "success",
            Nexora.Core.Entities.TicketStatus.Closed => "secondary",
            Nexora.Core.Entities.TicketStatus.Reopened => "danger",
            _ => "secondary"
        };
    }

    string GetPriorityColor(Nexora.Core.Entities.TicketPriority priority)
    {
        return priority switch
        {
            Nexora.Core.Entities.TicketPriority.Low => "success",
            Nexora.Core.Entities.TicketPriority.Medium => "warning",
            Nexora.Core.Entities.TicketPriority.High => "danger",
            Nexora.Core.Entities.TicketPriority.Urgent => "dark",
            _ => "secondary"
        };
    }
}