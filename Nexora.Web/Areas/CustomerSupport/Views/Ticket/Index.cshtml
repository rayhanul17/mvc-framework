@model Nexora.Web.Areas.CustomerSupport.Models.TicketListViewModel
@{
    ViewData["Title"] = "My Tickets";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="col-md-6 text-end">
            @if (await User.CanAccessUrlAsync("/CustomerSupport/Ticket/Create"))
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Create New Ticket
                </a>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search tickets...">
                </div>
                <div class="col-md-3">
                    <select name="filterStatus" class="form-select">
                        <option value="all">All Status</option>
                        @foreach (var status in Enum.GetValues<Nexora.Core.Entities.TicketStatus>())
                        {
                            <option value="@status" selected="@(Model.FilterStatus == status.ToString().ToLower())">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="filterPriority" class="form-select">
                        <option value="all">All Priority</option>
                        @foreach (var priority in Enum.GetValues<Nexora.Core.Entities.TicketPriority>())
                        {
                            <option value="@priority" selected="@(Model.FilterPriority == priority.ToString().ToLower())">@priority</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary w-100">
                        <i class="fas fa-filter"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Tickets.Any())
    {
        <div class="table-responsive">
            <table id="supportTicketsTable" class="table table-hover">
                <thead>
                    <tr>
                        <th>Ticket #</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Assigned To</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model.Tickets)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@ticket.Id" class="text-decoration-none">
                                    @ticket.TicketNumber
                                </a>
                            </td>
                            <td>@ticket.Title</td>
                            <td>@ticket.Category</td>
                            <td>
                                <span class="badge bg-@GetPriorityColor(ticket.Priority)">
                                    @ticket.Priority
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-@GetStatusColor(ticket.Status)">
                                    @ticket.Status
                                </span>
                            </td>
                            <td>@ticket.CreatedAt.ToString("MM/dd/yyyy HH:mm")</td>
                            <td>
                                @if (ticket.AssignedTo != null)
                                {
                                    <span>@ticket.AssignedTo.FullName</span>
                                }
                                else
                                {
                                    <span class="text-muted">Unassigned</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-info" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (ViewBag.IsAgent == true && ticket.Status != Nexora.Core.Entities.TicketStatus.Closed)
                                    {
                                        <button type="button" class="btn btn-sm btn-warning" onclick="showAssignModal(@ticket.Id, '@ticket.TicketNumber')" title="Assign Ticket">
                                            <i class="fas fa-user-check"></i>
                                        </button>
                                    }
                                    <a asp-action="Track" asp-route-ticketNumber="@ticket.TicketNumber" class="btn btn-sm btn-success" title="Track Ticket">
                                        <i class="fas fa-map-marker-alt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalCount > Model.PageSize)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Math.Ceiling((double)Model.TotalCount / Model.PageSize); i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="?pageNumber=@i&searchTerm=@Model.SearchTerm&filterStatus=@Model.FilterStatus&filterPriority=@Model.FilterPriority">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No tickets found. 
            @if (await User.CanAccessUrlAsync("/CustomerSupport/Ticket/Create"))
            {
                <a asp-action="Create">Create your first ticket</a>
            }
        </div>
    }
</div>

@functions {
    string GetStatusColor(Nexora.Core.Entities.TicketStatus status)
    {
        return status switch
        {
            Nexora.Core.Entities.TicketStatus.New => "primary",
            Nexora.Core.Entities.TicketStatus.Assigned => "info",
            Nexora.Core.Entities.TicketStatus.InProgress => "warning",
            Nexora.Core.Entities.TicketStatus.Resolved => "success",
            Nexora.Core.Entities.TicketStatus.Closed => "secondary",
            Nexora.Core.Entities.TicketStatus.Reopened => "danger",
            _ => "secondary"
        };
    }

    string GetPriorityColor(Nexora.Core.Entities.TicketPriority priority)
    {
        return priority switch
        {
            Nexora.Core.Entities.TicketPriority.Low => "success",
            Nexora.Core.Entities.TicketPriority.Medium => "warning",
            Nexora.Core.Entities.TicketPriority.High => "danger",
            Nexora.Core.Entities.TicketPriority.Urgent => "dark",
            _ => "secondary"
        };
    }
}

@if (ViewBag.IsAgent == true)
{
    <!-- Assign Ticket Modal -->
    <div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="assignModalLabel">Assign Ticket</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="assignForm">
                        <input type="hidden" id="assignTicketId" />
                        <div class="mb-3">
                            <label class="form-label">Ticket Number</label>
                            <input type="text" class="form-control" id="assignTicketNumber" readonly />
                        </div>
                        <div class="mb-3">
                            <label for="assignToUserId" class="form-label">Assign To</label>
                            <select class="form-select" id="assignToUserId" required>
                                <option value="">Select Agent</option>
                                @if (ViewBag.SupportAgents != null)
                                {
                                    @foreach (var agent in ViewBag.SupportAgents as List<Nexora.Core.Entities.ApplicationUser>)
                                    {
                                        <option value="@agent.Id">@agent.FullName (@agent.Email)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="assignNotes" class="form-label">Notes (Optional)</label>
                            <textarea class="form-control" id="assignNotes" rows="3"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="assignTicket()">Assign</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#supportTicketsTable').DataTable({
                responsive: true,
                order: [[5, 'desc']], // Sort by Created Date column by default
                columnDefs: [
                    { orderable: false, targets: [7] }, // Disable sorting on Actions column
                    { searchable: false, targets: [7] }, // Disable searching on Actions column
                    { width: "150px", targets: [7] } // Set fixed width for Actions column
                ],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    search: "Search support tickets:",
                    lengthMenu: "Show _MENU_ tickets per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ support tickets",
                    infoEmpty: "No support tickets found",
                    infoFiltered: "(filtered from _MAX_ total tickets)",
                    emptyTable: "No support tickets available",
                    zeroRecords: "No matching support tickets found"
                }
            });
        });
        
        function showAssignModal(ticketId, ticketNumber) {
            $('#assignTicketId').val(ticketId);
            $('#assignTicketNumber').val(ticketNumber);
            $('#assignToUserId').val('');
            $('#assignNotes').val('');
            $('#assignModal').modal('show');
        }
        
        function assignTicket() {
            var ticketId = $('#assignTicketId').val();
            var assignToUserId = $('#assignToUserId').val();
            var notes = $('#assignNotes').val();
            
            if (!assignToUserId) {
                toastr.error('Please select an agent to assign the ticket');
                return;
            }
            
            $.ajax({
                url: '@Url.Action("Assign", "Ticket", new { area = "CustomerSupport" })',
                type: 'POST',
                data: {
                    id: ticketId,
                    assignToUserId: assignToUserId,
                    notes: notes
                },
                success: function(result) {
                    if (result.success) {
                        toastr.success(result.message);
                        $('#assignModal').modal('hide');
                        setTimeout(function() {
                            location.reload();
                        }, 1500);
                    } else {
                        toastr.error(result.message || 'Failed to assign ticket');
                    }
                },
                error: function() {
                    toastr.error('An error occurred while assigning the ticket');
                }
            });
        }
    </script>
}