@model Nexora.Core.Entities.Ticket
@{
    ViewData["Title"] = "Track Ticket";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var history = ViewBag.History as List<Nexora.Core.Entities.TicketHistory> ?? new List<Nexora.Core.Entities.TicketHistory>();
    var isAgent = ViewBag.IsAgent ?? false;
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="fas fa-map-marker-alt"></i> Track Ticket</h2>
        </div>
    </div>

    @if (Model == null)
    {
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Track Your Ticket</h5>
                <form method="get" asp-action="Track">
                    <div class="mb-3">
                        <label for="ticketNumber" class="form-label">Enter Ticket Number</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="ticketNumber" name="ticketNumber" placeholder="e.g., TKT-2024-000001" required>
                            <button class="btn btn-primary" type="submit">
                                <i class="fas fa-search"></i> Track
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <!-- Ticket Details Card -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-ticket-alt"></i> Ticket #@Model.TicketNumber
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <h4>@Model.Title</h4>
                        <p class="text-muted">@Model.Description</p>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="text-muted small">Status</label>
                            <div>
                                <span class="badge bg-@GetStatusColor(Model.Status) fs-6">@Model.Status</span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Priority</label>
                            <div>
                                <span class="badge bg-@GetPriorityColor(Model.Priority) fs-6">@Model.Priority</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Category))
                        {
                            <div class="mb-3">
                                <label class="text-muted small">Category</label>
                                <div>@Model.Category</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Timeline Card -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-history"></i> Ticket Timeline
                </h5>
            </div>
            <div class="card-body">
                <div class="timeline">
                    <!-- Current Status -->
                    <div class="timeline-item">
                        <div class="timeline-marker bg-primary"></div>
                        <div class="timeline-content">
                            <h6 class="fw-bold">Current Status: @Model.Status</h6>
                            <small class="text-muted">
                                @if (Model.UpdatedAt.HasValue)
                                {
                                    <text>Last updated @Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</text>
                                }
                                else
                                {
                                    <text>Created @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</text>
                                }
                            </small>
                        </div>
                    </div>

                    @foreach (var item in history.OrderByDescending(h => h.CreatedAt))
                    {
                        <div class="timeline-item">
                            <div class="timeline-marker @GetHistoryMarkerColor(item.Action)"></div>
                            <div class="timeline-content">
                                <h6>@item.Action</h6>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <p class="mb-1">@item.Description</p>
                                }
                                <small class="text-muted">
                                    @item.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    @if (item.User != null)
                                    {
                                        <text> by @item.User.FullName</text>
                                    }
                                </small>
                            </div>
                        </div>
                    }

                    <!-- Created Event -->
                    <div class="timeline-item">
                        <div class="timeline-marker bg-success"></div>
                        <div class="timeline-content">
                            <h6 class="fw-bold">Ticket Created</h6>
                            <small class="text-muted">
                                @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                @if (Model.Customer != null)
                                {
                                    <text> by @Model.Customer.FullName</text>
                                }
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Key Information Card -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-info-circle"></i> Key Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-sm">
                            <tr>
                                <td class="text-muted">Created:</td>
                                <td>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Customer:</td>
                                <td>@(Model.Customer?.FullName ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Assigned To:</td>
                                <td>
                                    @if (Model.AssignedTo != null)
                                    {
                                        <text>@Model.AssignedTo.FullName</text>
                                    }
                                    else
                                    {
                                        <span class="text-warning">Unassigned</span>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-sm">
                            @if (Model.DueDate.HasValue)
                            {
                                <tr>
                                    <td class="text-muted">Due Date:</td>
                                    <td>
                                        @Model.DueDate.Value.ToString("MMM dd, yyyy HH:mm")
                                        @if (Model.DueDate.Value < DateTime.UtcNow && Model.Status != Nexora.Core.Entities.TicketStatus.Closed && Model.Status != Nexora.Core.Entities.TicketStatus.Resolved)
                                        {
                                            <span class="badge bg-danger ms-2">Overdue</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (Model.ResponseTimeHours.HasValue)
                            {
                                <tr>
                                    <td class="text-muted">Response Time:</td>
                                    <td>@Model.ResponseTimeHours.Value hours</td>
                                </tr>
                            }
                            @if (Model.ResolutionTimeHours.HasValue)
                            {
                                <tr>
                                    <td class="text-muted">Resolution Time:</td>
                                    <td>@Model.ResolutionTimeHours.Value hours</td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="text-center mb-4">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fas fa-eye"></i> View Full Details
            </a>
            @if (!isAgent && Model.Status != Nexora.Core.Entities.TicketStatus.Closed)
            {
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-success">
                    <i class="fas fa-comment"></i> Add Comment
                </a>
            }
            <button type="button" class="btn btn-secondary" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
        </div>
    }
</div>

@functions {
    string GetStatusColor(Nexora.Core.Entities.TicketStatus status)
    {
        return status switch
        {
            Nexora.Core.Entities.TicketStatus.New => "primary",
            Nexora.Core.Entities.TicketStatus.Open => "info",
            Nexora.Core.Entities.TicketStatus.InProgress => "warning",
            Nexora.Core.Entities.TicketStatus.Resolved => "success",
            Nexora.Core.Entities.TicketStatus.Closed => "secondary",
            Nexora.Core.Entities.TicketStatus.OnHold => "dark",
            _ => "secondary"
        };
    }

    string GetPriorityColor(Nexora.Core.Entities.TicketPriority priority)
    {
        return priority switch
        {
            Nexora.Core.Entities.TicketPriority.Critical => "danger",
            Nexora.Core.Entities.TicketPriority.Urgent => "warning",
            Nexora.Core.Entities.TicketPriority.High => "info",
            Nexora.Core.Entities.TicketPriority.Medium => "primary",
            Nexora.Core.Entities.TicketPriority.Low => "secondary",
            _ => "light"
        };
    }

    string GetHistoryMarkerColor(string action)
    {
        return action?.ToLower() switch
        {
            "assigned" => "bg-info",
            "status changed" => "bg-warning",
            "resolved" => "bg-success",
            "closed" => "bg-secondary",
            "reopened" => "bg-danger",
            "comment added" => "bg-primary",
            _ => "bg-light"
        };
    }
}

<style>
    .timeline {
        position: relative;
        padding-left: 40px;
    }

    .timeline::before {
        content: '';
        position: absolute;
        left: 15px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #dee2e6;
    }

    .timeline-item {
        position: relative;
        padding-bottom: 30px;
    }

    .timeline-marker {
        position: absolute;
        left: -25px;
        top: 5px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 2px solid #fff;
        box-shadow: 0 0 0 1px #dee2e6;
    }

    .timeline-content {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
    }

    .timeline-content h6 {
        margin-bottom: 5px;
        color: #495057;
    }

    @@media print {
        .btn {
            display: none;
        }
    }
</style>