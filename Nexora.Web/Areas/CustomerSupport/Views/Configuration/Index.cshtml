@model Nexora.Web.Areas.CustomerSupport.Models.ConfigurationViewModel
@inject Nexora.Application.Services.IRoleAuthorizationService RoleAuthService
@{
    ViewData["Title"] = "Customer Support Configuration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                    <div class="card-tools">
                        @if (await RoleAuthService.IsSuperAdminAsync(User))
                        {
                            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addMappingModal">
                                <i class="fas fa-plus"></i> Add Role Mapping
                            </button>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <!-- Nav tabs -->
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#roleMappings">
                                <i class="fas fa-user-tag"></i> Role Mappings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#ticketSettings">
                                <i class="fas fa-cog"></i> Ticket Settings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#statistics">
                                <i class="fas fa-chart-bar"></i> Statistics
                            </a>
                        </li>
                    </ul>

                    <!-- Tab content -->
                    <div class="tab-content mt-3">
                        <!-- Role Mappings Tab -->
                        <div id="roleMappings" class="tab-pane fade show active">
                            <h4>Customer Service Role Mappings</h4>
                            <p class="text-muted">Map customer service roles to ASP.NET Identity roles for proper authorization.</p>
                            
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <th>Customer Service Role</th>
                                            <th>Mapped to ASP.NET Role</th>
                                            <th>Description</th>
                                            <th>Status</th>
                                            <th>Last Updated</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var mapping in Model.RoleMappings)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="badge bg-info">@mapping.CustomerServiceRole</span>
                                                </td>
                                                <td>
                                                    <select class="form-select form-select-sm role-mapping-select" 
                                                            data-role="@mapping.CustomerServiceRole">
                                                        <option value="">-- Not Mapped --</option>
                                                        @foreach (var role in Model.AvailableRoles)
                                                        {
                                                            if (mapping.AspNetRoleId == role.Id)
                                                            {
                                                                <option value="@role.Id" selected>
                                                                    @role.Name
                                                                </option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@role.Id">
                                                                    @role.Name
                                                                </option>
                                                            }
                                                        }
                                                    </select>
                                                </td>
                                                <td>@mapping.Description</td>
                                                <td>
                                                    @if (mapping.IsActive)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Inactive</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (mapping.UpdatedAt.HasValue)
                                                    {
                                                        @mapping.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")
                                                    }
                                                    else
                                                    {
                                                        @mapping.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                                    }
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-success save-mapping" 
                                                            data-role="@mapping.CustomerServiceRole">
                                                        <i class="fas fa-save"></i>
                                                    </button>
                                                    @if (await RoleAuthService.IsSuperAdminAsync(User))
                                                    {
                                                        <button class="btn btn-sm btn-danger delete-mapping" 
                                                                data-id="@mapping.Id">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Ticket Settings Tab -->
                        <div id="ticketSettings" class="tab-pane fade">
                            <h4>Ticket Configuration</h4>
                            <div class="row">
                                <div class="col-md-6">
                                    <h5>Available Priorities</h5>
                                    <ul class="list-group">
                                        @foreach (var priority in Model.TicketPriorities)
                                        {
                                            <li class="list-group-item">
                                                <i class="fas fa-flag text-primary"></i> @priority
                                            </li>
                                        }
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <h5>Available Statuses</h5>
                                    <ul class="list-group">
                                        @foreach (var status in Model.TicketStatuses)
                                        {
                                            <li class="list-group-item">
                                                <i class="fas fa-circle text-info"></i> @status
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Statistics Tab -->
                        <div id="statistics" class="tab-pane fade">
                            <h4>Support Statistics</h4>
                            <div id="statistics-container">
                                <div class="text-center">
                                    <div class="spinner-border" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Role Mapping Modal -->
<div class="modal fade" id="addMappingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Role Mapping</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addMappingForm">
                    <div class="mb-3">
                        <label for="newCustomerServiceRole" class="form-label">Customer Service Role</label>
                        <input type="text" class="form-control" id="newCustomerServiceRole" required>
                    </div>
                    <div class="mb-3">
                        <label for="newAspNetRoleId" class="form-label">Map to ASP.NET Role</label>
                        <select class="form-select" id="newAspNetRoleId" required>
                            <option value="">-- Select Role --</option>
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <option value="@role.Id">@role.Name</option>
                            }
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveNewMapping">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Save role mapping
            $('.save-mapping').click(function() {
                var btn = $(this);
                var role = btn.data('role');
                var select = $('.role-mapping-select[data-role="' + role + '"]');
                var aspNetRoleId = select.val();
                
                if (!aspNetRoleId) {
                    toastr.warning('Please select a role to map to');
                    return;
                }
                
                $.ajax({
                    url: '@Url.Action("UpdateRoleMapping", "Configuration")',
                    type: 'POST',
                    data: {
                        customerServiceRole: role,
                        aspNetRoleId: aspNetRoleId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function() {
                        toastr.error('An error occurred while updating the role mapping');
                    }
                });
            });
            
            // Delete role mapping
            $('.delete-mapping').click(function() {
                if (!confirm('Are you sure you want to delete this role mapping?')) {
                    return;
                }
                
                var btn = $(this);
                var id = btn.data('id');
                
                $.ajax({
                    url: '@Url.Action("DeleteRoleMapping", "Configuration")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            location.reload();
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function() {
                        toastr.error('An error occurred while deleting the role mapping');
                    }
                });
            });
            
            // Save new mapping
            $('#saveNewMapping').click(function() {
                var role = $('#newCustomerServiceRole').val();
                var aspNetRoleId = $('#newAspNetRoleId').val();
                
                if (!role || !aspNetRoleId) {
                    toastr.warning('Please fill in all fields');
                    return;
                }
                
                $.ajax({
                    url: '@Url.Action("AddRoleMapping", "Configuration")',
                    type: 'POST',
                    data: {
                        customerServiceRole: role,
                        aspNetRoleId: aspNetRoleId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            $('#addMappingModal').modal('hide');
                            location.reload();
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function() {
                        toastr.error('An error occurred while creating the role mapping');
                    }
                });
            });
            
            // Load statistics when tab is shown
            $('a[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                if ($(e.target).attr('href') === '#statistics') {
                    loadStatistics();
                }
            });
            
            function loadStatistics() {
                $.ajax({
                    url: '@Url.Action("GetStatistics", "Configuration")',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            var html = '<div class="row">';
                            html += '<div class="col-md-4"><div class="info-box">';
                            html += '<span class="info-box-icon bg-info"><i class="fas fa-ticket-alt"></i></span>';
                            html += '<div class="info-box-content">';
                            html += '<span class="info-box-text">Total Tickets</span>';
                            html += '<span class="info-box-number">' + response.data.totalTickets + '</span>';
                            html += '</div></div></div>';
                            
                            html += '<div class="col-md-4"><div class="info-box">';
                            html += '<span class="info-box-icon bg-warning"><i class="fas fa-clock"></i></span>';
                            html += '<div class="info-box-content">';
                            html += '<span class="info-box-text">Open Tickets</span>';
                            html += '<span class="info-box-number">' + response.data.openTickets + '</span>';
                            html += '</div></div></div>';
                            
                            html += '<div class="col-md-4"><div class="info-box">';
                            html += '<span class="info-box-icon bg-success"><i class="fas fa-check"></i></span>';
                            html += '<div class="info-box-content">';
                            html += '<span class="info-box-text">Resolved Tickets</span>';
                            html += '<span class="info-box-number">' + response.data.resolvedTickets + '</span>';
                            html += '</div></div></div>';
                            
                            html += '<div class="col-md-4"><div class="info-box">';
                            html += '<span class="info-box-icon bg-primary"><i class="fas fa-users"></i></span>';
                            html += '<div class="info-box-content">';
                            html += '<span class="info-box-text">Support Agents</span>';
                            html += '<span class="info-box-number">' + response.data.totalAgents + '</span>';
                            html += '</div></div></div>';
                            
                            html += '<div class="col-md-4"><div class="info-box">';
                            html += '<span class="info-box-icon bg-secondary"><i class="fas fa-user"></i></span>';
                            html += '<div class="info-box-content">';
                            html += '<span class="info-box-text">Customers</span>';
                            html += '<span class="info-box-number">' + response.data.totalCustomers + '</span>';
                            html += '</div></div></div>';
                            
                            html += '</div>';
                            $('#statistics-container').html(html);
                        } else {
                            $('#statistics-container').html('<div class="alert alert-danger">' + response.message + '</div>');
                        }
                    },
                    error: function() {
                        $('#statistics-container').html('<div class="alert alert-danger">Failed to load statistics</div>');
                    }
                });
            }
        });
    </script>
    @Html.AntiForgeryToken()
}

<style>
    .info-box {
        display: flex;
        align-items: center;
        background: #fff;
        border-radius: .25rem;
        box-shadow: 0 0 1px rgba(0,0,0,.125), 0 1px 3px rgba(0,0,0,.2);
        margin-bottom: 1rem;
        min-height: 80px;
        padding: .5rem;
        position: relative;
    }
    
    .info-box-icon {
        align-items: center;
        display: flex;
        font-size: 1.875rem;
        justify-content: center;
        text-align: center;
        width: 70px;
        color: #fff;
        border-radius: .25rem;
    }
    
    .info-box-content {
        flex: 1;
        padding: 5px 10px;
    }
    
    .info-box-text {
        display: block;
        font-size: 14px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    .info-box-number {
        display: block;
        font-size: 18px;
        font-weight: 700;
    }
</style>