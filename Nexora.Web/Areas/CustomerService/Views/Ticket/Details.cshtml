@model Nexora.Web.Areas.CustomerService.Models.TicketDetailsViewModel
@{
    ViewData["Title"] = $"Ticket #{Model.TicketNumber}";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-header mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2>
                            <i class="fas fa-ticket-alt text-primary me-2"></i>
                            Ticket #@Model.TicketNumber
                        </h2>
                        <p class="text-muted">@Model.Title</p>
                    </div>
                    <div>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Back to Tickets
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Ticket Details -->
            <div class="card mb-4">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-info-circle me-2"></i>Ticket Details
                        </h5>
                        <div>
                            <span class="badge bg-@(GetStatusBadgeClass(Model.Status)) me-2">@Model.Status</span>
                            <span class="badge bg-@(GetPriorityBadgeClass(Model.Priority))">@Model.Priority</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Title:</strong></div>
                        <div class="col-sm-9">@Model.Title</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Description:</strong></div>
                        <div class="col-sm-9">
                            <div class="border p-3 rounded bg-light">
                                @Html.Raw(Model.Description.Replace("\n", "<br/>"))
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Category))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Category:</strong></div>
                            <div class="col-sm-9">@Model.Category @if (!string.IsNullOrEmpty(Model.SubCategory)) { <text>/ @Model.SubCategory</text> }</div>
                        </div>
                    }
                    @if (Model.DueDate.HasValue)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Due Date:</strong></div>
                            <div class="col-sm-9">
                                @Model.DueDate.Value.ToString("MMM dd, yyyy")
                                @if (Model.DueDate.Value < DateTime.Now && Model.Status != Nexora.Core.Entities.TicketStatus.Closed && Model.Status != Nexora.Core.Entities.TicketStatus.Resolved)
                                {
                                    <span class="badge bg-warning ms-2">Overdue</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Comments Section -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-comments me-2"></i>Comments (@Model.Comments.Count)
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Comments.Any())
                    {
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="comment-item mb-3 p-3 @(comment.IsInternal ? "bg-warning bg-opacity-10 border-warning" : "bg-light") rounded">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-2">
                                            @if (!string.IsNullOrEmpty(comment.UserAvatar))
                                            {
                                                <img src="@comment.UserAvatar" alt="@comment.UserName" class="rounded-circle" width="32" height="32" />
                                            }
                                            else
                                            {
                                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                    @comment.UserName.First()
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <strong>@comment.UserName</strong>
                                            @if (comment.IsSystemGenerated)
                                            {
                                                <span class="badge bg-secondary ms-2">System</span>
                                            }
                                            @if (comment.IsInternal)
                                            {
                                                <span class="badge bg-warning ms-2">Internal</span>
                                            }
                                        </div>
                                    </div>
                                    <small class="text-muted">@comment.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                </div>
                                <div class="comment-content">
                                    @Html.Raw(comment.Content.Replace("\n", "<br/>"))
                                </div>
                                @if (comment.Attachments.Any())
                                {
                                    <div class="mt-2">
                                        <small class="text-muted">Attachments:</small>
                                        @foreach (var attachment in comment.Attachments)
                                        {
                                            <div class="d-inline-block me-2">
                                                <i class="fas fa-paperclip me-1"></i>
                                                <a href="@attachment.FilePath" target="_blank">@attachment.FileName</a>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-comments fa-2x text-muted mb-2"></i>
                            <p class="text-muted">No comments yet</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Add Comment -->
            @if (Model.CanComment)
            {
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-plus me-2"></i>Add Comment
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="AddComment" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="TicketId" value="@Model.Id" />
                            
                            <div class="mb-3">
                                <label for="Content" class="form-label">Comment</label>
                                <textarea name="Content" class="form-control" rows="4" placeholder="Add your comment..." required></textarea>
                            </div>
                            
                            <div class="mb-3">
                                <label for="Attachments" class="form-label">Attachments</label>
                                <input name="Attachments" type="file" class="form-control" multiple />
                                <div class="form-text">Optional: Attach files to your comment</div>
                            </div>

                            <div class="form-check mb-3">
                                <input name="IsInternal" type="checkbox" class="form-check-input" id="isInternal" />
                                <label class="form-check-label" for="isInternal">
                                    Internal comment (not visible to customer)
                                </label>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-comment me-2"></i>Add Comment
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Status Management -->
            @if (Model.CanChangeStatus)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="card-title mb-0">
                            <i class="fas fa-cogs me-2"></i>Status Management
                        </h6>
                    </div>
                    <div class="card-body">
                        <form asp-action="UpdateStatus" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            
                            <div class="mb-3">
                                <label for="newStatus" class="form-label">Change Status</label>
                                <select name="newStatus" class="form-select">
                                    <option value="New" selected="@(Model.Status == Nexora.Core.Entities.TicketStatus.New)">New</option>
                                    <option value="Open" selected="@(Model.Status == Nexora.Core.Entities.TicketStatus.Open)">Open</option>
                                    <option value="InProgress" selected="@(Model.Status == Nexora.Core.Entities.TicketStatus.InProgress)">In Progress</option>
                                    <option value="OnHold" selected="@(Model.Status == Nexora.Core.Entities.TicketStatus.OnHold)">On Hold</option>
                                    <option value="Resolved" selected="@(Model.Status == Nexora.Core.Entities.TicketStatus.Resolved)">Resolved</option>
                                    <option value="Closed" selected="@(Model.Status == Nexora.Core.Entities.TicketStatus.Closed)">Closed</option>
                                </select>
                            </div>
                            
                            <div class="mb-3">
                                <label for="statusNote" class="form-label">Status Note</label>
                                <textarea name="statusNote" class="form-control" rows="3" placeholder="Optional note about status change"></textarea>
                            </div>

                            <button type="submit" class="btn btn-warning btn-sm">
                                <i class="fas fa-save me-1"></i>Update Status
                            </button>
                        </form>
                    </div>
                </div>
            }

            <!-- Ticket Information -->
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-info me-2"></i>Ticket Information
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <strong>Created:</strong><br>
                        <small class="text-muted">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                    </div>
                    
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="mb-2">
                            <strong>Last Updated:</strong><br>
                            <small class="text-muted">@Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</small>
                        </div>
                    }
                    
                    @if (Model.ResolvedAt.HasValue)
                    {
                        <div class="mb-2">
                            <strong>Resolved:</strong><br>
                            <small class="text-muted">@Model.ResolvedAt.Value.ToString("MMM dd, yyyy HH:mm")</small>
                        </div>
                    }
                    
                    @if (Model.ClosedAt.HasValue)
                    {
                        <div class="mb-2">
                            <strong>Closed:</strong><br>
                            <small class="text-muted">@Model.ClosedAt.Value.ToString("MMM dd, yyyy HH:mm")</small>
                        </div>
                    }
                </div>
            </div>

            <!-- People -->
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-users me-2"></i>People
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Created By:</strong><br>
                        <div class="d-flex align-items-center mt-1">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 24px; height: 24px; font-size: 12px;">
                                @Model.CreatedByName.First()
                            </div>
                            <div>
                                <div>@Model.CreatedByName</div>
                                <small class="text-muted">@Model.CreatedByEmail</small>
                            </div>
                        </div>
                    </div>
                    
                    <div>
                        <strong>Assigned To:</strong><br>
                        @if (!string.IsNullOrEmpty(Model.AssignedToUserId))
                        {
                            <div class="d-flex align-items-center mt-1">
                                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 24px; height: 24px; font-size: 12px;">
                                    @Model.AssignedToName?.First()
                                </div>
                                <div>
                                    <div>@Model.AssignedToName</div>
                                    <small class="text-muted">@Model.AssignedToEmail</small>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">Unassigned</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Attachments -->
            @if (Model.Attachments.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">
                            <i class="fas fa-paperclip me-2"></i>Attachments (@Model.Attachments.Count)
                        </h6>
                    </div>
                    <div class="card-body">
                        @foreach (var attachment in Model.Attachments)
                        {
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-file me-2 text-muted"></i>
                                <div class="flex-grow-1">
                                    <a href="@attachment.FilePath" target="_blank" class="text-decoration-none">
                                        @attachment.FileName
                                    </a>
                                    <div class="text-muted small">
                                        @(attachment.FileSize / 1024) KB • @attachment.CreatedAt.ToString("MMM dd")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(Nexora.Core.Entities.TicketStatus status)
    {
        return status switch
        {
            Nexora.Core.Entities.TicketStatus.New => "primary",
            Nexora.Core.Entities.TicketStatus.Open => "info",
            Nexora.Core.Entities.TicketStatus.InProgress => "warning",
            Nexora.Core.Entities.TicketStatus.OnHold => "secondary",
            Nexora.Core.Entities.TicketStatus.Resolved => "success",
            Nexora.Core.Entities.TicketStatus.Closed => "dark",
            Nexora.Core.Entities.TicketStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }

    string GetPriorityBadgeClass(Nexora.Core.Entities.TicketPriority priority)
    {
        return priority switch
        {
            Nexora.Core.Entities.TicketPriority.Low => "success",
            Nexora.Core.Entities.TicketPriority.Medium => "info",
            Nexora.Core.Entities.TicketPriority.High => "warning",
            Nexora.Core.Entities.TicketPriority.Urgent => "danger",
            Nexora.Core.Entities.TicketPriority.Critical => "dark",
            _ => "secondary"
        };
    }
}