@model Nexora.Web.Areas.CustomerService.Models.RoleMappingViewModel
@{
    ViewData["Title"] = "Customer Service Role Configuration";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-header mb-4">
                <h2>
                    <i class="fas fa-user-cog text-primary me-2"></i>
                    Customer Service Role Configuration
                </h2>
                <p class="text-muted">Configure role mappings for the Customer Service area. Map Customer Service roles to existing ASP.NET Identity roles.</p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-transparent">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-link me-2"></i>Role Mappings
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info mb-4">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Important:</strong> Each Customer Service role must be mapped to an existing ASP.NET Identity role for proper authorization.
                    </div>

                    <div class="table-responsive">
                        <table id="roleMappingsTable" class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Customer Service Role</th>
                                    <th>Description</th>
                                    <th>Mapped to ASP.NET Role</th>
                                    <th>Status</th>
                                    <th width="200">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mapping in Model.Mappings)
                                {
                                    <tr data-role="@mapping.CustomerServiceRole" class="@(!mapping.IsActive ? "table-secondary" : "")">
                                        <td>
                                            <strong>@mapping.CustomerServiceRole</strong>
                                            @if (mapping.IsSystemDefault)
                                            {
                                                <span class="badge bg-primary ms-2">System</span>
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted">@(mapping.Description ?? "No description")</small>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm asp-net-role" 
                                                    data-role="@mapping.CustomerServiceRole"
                                                    @(mapping.IsActive && !string.IsNullOrEmpty(mapping.AspNetRoleName) ? "disabled" : "")>
                                                <option value="">-- Select Role --</option>
                                                @foreach (var role in Model.AvailableRoles)
                                                {
                                                    <option value="@role.Value" 
                                                            selected="@(role.Value == mapping.AspNetRoleName)">
                                                        @role.Text
                                                    </option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            @if (mapping.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else if (!string.IsNullOrEmpty(mapping.AspNetRoleName))
                                            {
                                                <span class="badge bg-warning">Inactive</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Not Configured</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                @if (string.IsNullOrEmpty(mapping.AspNetRoleName))
                                                {
                                                    <button type="button" 
                                                            class="btn btn-primary btn-save" 
                                                            data-role="@mapping.CustomerServiceRole"
                                                            data-description="@mapping.Description">
                                                        <i class="fas fa-save"></i> Save
                                                    </button>
                                                }
                                                else
                                                {
                                                    @if (mapping.IsActive)
                                                    {
                                                        <button type="button" 
                                                                class="btn btn-warning btn-toggle" 
                                                                data-role="@mapping.CustomerServiceRole">
                                                            <i class="fas fa-toggle-on"></i> Deactivate
                                                        </button>
                                                        <button type="button" 
                                                                class="btn btn-info btn-edit" 
                                                                data-role="@mapping.CustomerServiceRole">
                                                            <i class="fas fa-edit"></i> Edit
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" 
                                                                class="btn btn-success btn-toggle" 
                                                                data-role="@mapping.CustomerServiceRole">
                                                            <i class="fas fa-toggle-off"></i> Activate
                                                        </button>
                                                        <button type="button" 
                                                                class="btn btn-primary btn-save" 
                                                                data-role="@mapping.CustomerServiceRole"
                                                                data-description="@mapping.Description">
                                                            <i class="fas fa-save"></i> Update
                                                        </button>
                                                    }
                                                    
                                                    @if (!mapping.IsSystemDefault)
                                                    {
                                                        <button type="button" 
                                                                class="btn btn-danger btn-delete" 
                                                                data-role="@mapping.CustomerServiceRole">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    }
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-transparent">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-info-circle me-2"></i>Role Descriptions
                    </h5>
                </div>
                <div class="card-body">
                    <dl>
                        <dt>CustomerSupportAdmin</dt>
                        <dd class="text-muted mb-3">Full administrative access to all Customer Service features and tickets.</dd>
                        
                        <dt>CustomerSupportManager</dt>
                        <dd class="text-muted mb-3">Can view all tickets, assign work to agents, and manage team operations.</dd>
                        
                        <dt>CustomerSupportAgent</dt>
                        <dd class="text-muted mb-3">Can view and respond to assigned tickets, update ticket status.</dd>
                        
                        <dt>CustomerSupportCustomer</dt>
                        <dd class="text-muted">Can only view and comment on their own tickets.</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-transparent">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-shield-alt me-2"></i>Access Control
                    </h5>
                </div>
                <div class="card-body">
                    <p>The role mappings control access to Customer Service features:</p>
                    <ul>
                        <li><strong>Ticket Management:</strong> Role-based access to create, view, edit, and delete tickets</li>
                        <li><strong>Assignment:</strong> Managers and Admins can assign tickets to agents</li>
                        <li><strong>Comments:</strong> All roles can comment on accessible tickets</li>
                        <li><strong>Reports:</strong> Managers and Admins have access to reporting features</li>
                        <li><strong>Configuration:</strong> Only Admins can access this configuration page</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTables
            $('#roleMappingsTable').DataTable({
                responsive: true,
                order: [[0, 'asc']], // Sort by Customer Service Role column by default
                columnDefs: [
                    { orderable: false, targets: [4] }, // Disable sorting on Actions column
                    { searchable: false, targets: [4] }, // Disable searching on Actions column
                    { width: "200px", targets: [4] } // Set fixed width for Actions column
                ],
                pageLength: 10,
                lengthMenu: [[5, 10, 25, -1], [5, 10, 25, "All"]],
                language: {
                    search: "Search role mappings:",
                    lengthMenu: "Show _MENU_ mappings per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ role mappings",
                    infoEmpty: "No role mappings found",
                    infoFiltered: "(filtered from _MAX_ total mappings)",
                    emptyTable: "No role mappings available",
                    zeroRecords: "No matching role mappings found"
                },
                drawCallback: function() {
                    // Re-attach event handlers after DataTables redraw
                    attachRoleMappingHandlers();
                }
            });
            
            // Initial attachment of handlers
            attachRoleMappingHandlers();
        });
        
        function attachRoleMappingHandlers() {
            // Save mapping
            $('.btn-save').off('click').on('click', function() {
                var button = $(this);
                var role = button.data('role');
                var description = button.data('description');
                var aspNetRole = $('select[data-role="' + role + '"]').val();
                
                if (!aspNetRole) {
                    toastr.warning('Please select an ASP.NET role to map to');
                    return;
                }
                
                $.ajax({
                    url: '@Url.Action("SaveMapping", "Configuration")',
                    type: 'POST',
                    data: {
                        CustomerServiceRole: role,
                        AspNetRoleName: aspNetRole,
                        Description: description,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function() {
                        toastr.error('An error occurred while saving the mapping');
                    }
                });
            });
            
            // Toggle mapping
            $('.btn-toggle').off('click').on('click', function() {
                var button = $(this);
                var role = button.data('role');
                
                $.ajax({
                    url: '@Url.Action("ToggleMapping", "Configuration")',
                    type: 'POST',
                    data: {
                        customerServiceRole: role,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            toastr.success('Role mapping status updated');
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function() {
                        toastr.error('An error occurred while updating the mapping');
                    }
                });
            });
            
            // Edit mapping
            $('.btn-edit').off('click').on('click', function() {
                var role = $(this).data('role');
                var select = $('select[data-role="' + role + '"]');
                select.prop('disabled', false);
                $(this).hide();
                $(this).siblings('.btn-toggle').hide();
                
                // Add save button
                var saveBtn = $('<button>')
                    .addClass('btn btn-primary btn-sm btn-save-edit')
                    .attr('data-role', role)
                    .html('<i class="fas fa-save"></i> Save');
                
                var cancelBtn = $('<button>')
                    .addClass('btn btn-secondary btn-sm btn-cancel-edit ms-1')
                    .attr('data-role', role)
                    .html('<i class="fas fa-times"></i> Cancel');
                
                $(this).parent().append(saveBtn).append(cancelBtn);
                
                // Handle save
                saveBtn.on('click', function() {
                    var aspNetRole = select.val();
                    $.ajax({
                        url: '@Url.Action("SaveMapping", "Configuration")',
                        type: 'POST',
                        data: {
                            CustomerServiceRole: role,
                            AspNetRoleName: aspNetRole,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                toastr.success(response.message);
                                setTimeout(function() {
                                    location.reload();
                                }, 1500);
                            } else {
                                toastr.error(response.message);
                            }
                        }
                    });
                });
                
                // Handle cancel
                cancelBtn.on('click', function() {
                    location.reload();
                });
            });
            
            // Delete mapping
            $('.btn-delete').off('click').on('click', function() {
                var role = $(this).data('role');
                
                if (confirm('Are you sure you want to delete this role mapping?')) {
                    $.ajax({
                        url: '@Url.Action("DeleteMapping", "Configuration")',
                        type: 'POST',
                        data: {
                            customerServiceRole: role,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                toastr.success(response.message);
                                setTimeout(function() {
                                    location.reload();
                                }, 1500);
                            } else {
                                toastr.error(response.message);
                            }
                        },
                        error: function() {
                            toastr.error('An error occurred while deleting the mapping');
                        }
                    });
                }
            });
        }
    </script>
}