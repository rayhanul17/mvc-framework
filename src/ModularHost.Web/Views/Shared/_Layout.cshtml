@using MRCMS.Core.Extensions
@inject IPermissionHelper PermissionHelper
@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var userId = PermissionHelper.GetCurrentUserId();
    var userRoles = User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
    var userPermissions = User.Claims.Where(c => c.Type == "Permission").Select(c => c.Value).ToList();
    
    // Check if we're on login/register pages
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isAuthPage = currentController?.Equals("Account", StringComparison.OrdinalIgnoreCase) == true && 
                     (currentAction?.Equals("Login", StringComparison.OrdinalIgnoreCase) == true || 
                      currentAction?.Equals("Register", StringComparison.OrdinalIgnoreCase) == true);
    var showSidebar = !isAuthPage;
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="authenticated" content="@(isAuthenticated ? "true" : "false")" />
    @Html.AntiForgeryToken()
    <meta name="csrf-token" content="@Html.AntiForgeryToken()" />
    <title>@ViewData["Title"] - Modular Host</title>
    
    <!-- Tailwind CSS (Local Compiled) -->
    <link rel="stylesheet" href="~/lib/tailwind/tailwind-compiled.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/tailwind/datatables-tailwind.css" asp-append-version="true" />
    
    <style>
        /* Menu animations */
        .rotate-180 {
            transform: rotate(180deg);
        }
        
        .submenu-chevron {
            transition: transform 0.3s ease;
        }
        
        .submenu-container {
            transition: max-height 0.3s ease-out;
        }
        
        /* Prevent parent menu hover effect when it's just a toggle */
        .menu-parent a[href="javascript:void(0)"] {
            cursor: pointer;
        }
        
        /* Indentation for nested menus */
        .submenu-container .submenu-container {
            padding-left: 1rem;
        }
    </style>
    
    <!-- Font Awesome (Local) -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" asp-append-version="true" />
    
    
    <!-- Toastr for notifications (Local) -->
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" asp-append-version="true" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    @RenderSection("Styles", required: false)
</head>
<body class="h-full bg-gray-50 dark:bg-gray-900">
    <div class="min-h-full flex">
        @if (showSidebar)
        {
            <!-- Sidebar -->
            <nav id="sidebar" class="fixed inset-y-0 left-0 z-50 bg-white/95 dark:bg-gray-900/95 backdrop-blur-sm border-r border-gray-200 dark:border-gray-700 transition-all duration-300 ease-in-out w-64 -translate-x-full lg:translate-x-0 animate-slide-in-left" data-collapsed="false">
            <div class="h-full flex flex-col">
                <!-- Logo -->
                <div class="flex items-center justify-between h-16 px-6 bg-gradient-to-r from-primary-600 to-primary-700 text-white shadow-soft">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="text-xl font-bold flex items-center sidebar-logo hover:scale-105 transition-transform duration-200">
                        <i class="fas fa-cube mr-2 text-primary-200"></i><span class="sidebar-text">Modular Host</span>
                    </a>
                    <button class="lg:hidden p-2 rounded-lg hover:bg-primary-600/50 transition-colors duration-200" onclick="toggleSidebar()">
                        <i class="fas fa-times text-primary-200"></i>
                    </button>
                </div>
                
                <!-- Menu Search -->
                @if (isAuthenticated)
                {
                    <div class="px-3 py-4 border-b border-gray-200 dark:border-gray-700">
                        <div class="relative">
                            <input type="text" 
                                   id="menu-search" 
                                   placeholder="Search menus..." 
                                   class="w-full pl-8 pr-3 py-2 text-sm bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all duration-200 placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-gray-100">
                            <i class="fas fa-search absolute left-2.5 top-2.5 text-gray-400 dark:text-gray-500 text-xs"></i>
                            <div id="search-results" class="absolute top-full left-0 right-0 mt-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg hidden z-50 max-h-64 overflow-y-auto">
                                <!-- Search results will be populated here -->
                            </div>
                        </div>
                    </div>
                }
                
                <!-- Navigation Links -->
                <div class="flex-1 overflow-y-auto py-4">
                    <partial name="_MenuPartial" />
                </div>
            </div>
        </nav>
        }
        
        <!-- Main Content -->
        <div id="main-content" class="@(showSidebar ? "flex-1 lg:ml-64 transition-all duration-300" : "flex-1")">
            <!-- Top Bar -->
            <header class="bg-white/95 dark:bg-gray-900/95 backdrop-blur-sm border-b border-gray-200 dark:border-gray-700 shadow-soft animate-slide-in-down">
                <div class="flex items-center justify-between h-16 px-4 lg:px-8">
                    @if (showSidebar)
                    {
                        <button id="menu-toggle-btn" class="text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 p-2 rounded-lg transition-all duration-200 hover:scale-105 active:scale-95" onclick="toggleMenu()">
                            <i class="fas fa-bars text-xl"></i>
                        </button>
                    }
                    else
                    {
                        <div></div>
                    }
                    
                    <h1 class="text-xl font-semibold text-gray-800 dark:text-gray-200 animate-fade-in">
                        @ViewData["Title"]
                    </h1>
                    
                    <div class="flex items-center space-x-4">
                        <!-- Dark Mode Toggle -->
                        <button onclick="toggleDarkMode()" class="p-2 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-all duration-200 hover:scale-110 active:scale-95">
                            <i id="dark-mode-moon" class="fas fa-moon text-lg"></i>
                            <i id="dark-mode-sun" class="fas fa-sun text-lg" style="display: none;"></i>
                        </button>
                        
                        <!-- Notifications -->
                        @if (isAuthenticated)
                        {
                            <div class="relative">
                                <button id="notification-btn" class="p-2 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-all duration-200 hover:scale-110 active:scale-95 relative">
                                    <i class="fas fa-bell text-lg"></i>
                                    <span class="absolute -top-0.5 -right-0.5 bg-danger-500 text-white text-2xs rounded-full h-4 w-4 flex items-center justify-center animate-bounce-subtle" id="notification-count" style="display:none;">0</span>
                                </button>
                                <div id="notification-dropdown" class="absolute right-0 mt-2 w-80 bg-white/95 dark:bg-gray-800/95 backdrop-blur-sm rounded-xl shadow-medium border border-gray-200 dark:border-gray-700 hidden animate-slide-in-down">
                                    <div class="p-4 border-b dark:border-gray-700">
                                        <h3 class="font-semibold text-gray-800 dark:text-gray-200">Notifications</h3>
                                    </div>
                                    <div class="max-h-96 overflow-y-auto" id="notification-list">
                                        <p class="p-4 text-gray-500 dark:text-gray-400 text-center">No new notifications</p>
                                    </div>
                                </div>
                            </div>
                        }
                        
                        @if (isAuthenticated)
                        {
                            <!-- User Dropdown -->
                            <div class="relative ml-3">
                                <button id="user-dropdown-btn" class="flex items-center text-sm rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 p-2 transition-all duration-200 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">
                                    <img src="@(User.FindFirst("AvatarUrl")?.Value ?? "/img/default-avatar.png")" 
                                         alt="@(User.FindFirst("UserName")?.Value ?? "User")" 
                                         class="h-8 w-8 rounded-full object-cover ring-2 ring-primary-200 dark:ring-primary-700"
                                         onerror="this.onerror=null; this.src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"%236b7280\"%3E%3Cpath d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z\"/%3E%3C/svg%3E'">
                                    <span class="ml-2 text-gray-700 dark:text-gray-300 font-medium hidden sm:block">@(User.FindFirst("UserName")?.Value ?? User.Identity?.Name)</span>
                                    <i class="fas fa-chevron-down ml-2 text-gray-500 text-xs hidden sm:block"></i>
                                </button>
                                <div id="user-dropdown-menu" class="origin-top-right absolute right-0 mt-2 w-48 rounded-xl shadow-medium bg-white/95 dark:bg-gray-800/95 backdrop-blur-sm border border-gray-200 dark:border-gray-700 hidden animate-slide-in-down">
                                    <div class="py-1">
                                        <div class="px-4 py-2 text-sm text-gray-700 dark:text-gray-300 border-b dark:border-gray-700">
                                            <div class="font-medium">@(User.FindFirst("FullName")?.Value ?? User.Identity?.Name)</div>
                                            <div class="text-xs text-gray-500">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                                        </div>
                                        <a asp-area="" asp-controller="Account" asp-action="Profile" class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                            <i class="fas fa-user mr-2"></i>My Profile
                                        </a>
                                        <a asp-area="" asp-controller="Account" asp-action="Settings" class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                            <i class="fas fa-cog mr-2"></i>Settings
                                        </a>
                                        <div class="border-t dark:border-gray-700"></div>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="block">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                                <i class="fas fa-sign-out-alt mr-2"></i>Logout
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a asp-area="" asp-controller="Account" asp-action="Login" 
                               class="btn btn-primary animate-fade-in hover:shadow-colored-primary">
                                <i class="fas fa-sign-in-alt mr-2"></i>Login
                            </a>
                        }
                    </div>
                </div>
            </header>
            
            <!-- Page Content -->
            <main class="p-4 lg:p-8">
                <!-- Optimized Message Display -->
                @await Html.PartialAsync("_Messages")
                
                <!-- Loading Indicator -->
                @await Html.PartialAsync("_LoadingIndicator")
                
                @RenderBody()
            </main>
            
            
            <!-- Footer -->
            <footer class="mt-auto py-4 px-8 text-center text-gray-600 dark:text-gray-400 text-sm">
                <p>&copy; @DateTime.Now.Year Modular Host. All rights reserved.</p>
                <p class="mt-1">
                    🤖 Generated with <a href="https://claude.ai/code" class="text-primary hover:underline">Claude Code</a>
                </p>
            </footer>
        </div>
    </div>
    
    <!-- Scripts (Local) -->
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/toastr/toastr.min.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/dist/browser/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Initialize permissions in JavaScript
        permissions.init({
            permissions: @Html.Raw(Json.Serialize(userPermissions)),
            roles: @Html.Raw(Json.Serialize(userRoles)),
            userId: '@userId',
            isAuthenticated: @(isAuthenticated ? "true" : "false")
        });
        
        // Toggle menu for both mobile and desktop
        function toggleMenu() {
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('main-content');
            
            // Check if we're on mobile or desktop
            if (window.innerWidth < 1024) {
                // Mobile: slide in/out
                sidebar.classList.toggle('-translate-x-full');
            } else {
                // Desktop: collapse/expand
                toggleSidebarCollapse();
            }
        }
        
        // Toggle sidebar for mobile (legacy function for back compatibility)
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('-translate-x-full');
        }
        
        // Toggle sidebar collapse/expand for desktop
        function toggleSidebarCollapse() {
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('main-content');
            
            const isCollapsed = sidebar.getAttribute('data-collapsed') === 'true';
            
            if (isCollapsed) {
                // Expand
                sidebar.setAttribute('data-collapsed', 'false');
                mainContent.classList.remove('sidebar-collapsed');
                localStorage.setItem('sidebarCollapsed', 'false');
            } else {
                // Collapse
                sidebar.setAttribute('data-collapsed', 'true');
                mainContent.classList.add('sidebar-collapsed');
                localStorage.setItem('sidebarCollapsed', 'true');
            }
        }
        
        // Apply permission-based visibility on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Restore sidebar state from localStorage
            const sidebarCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
            if (sidebarCollapsed && window.innerWidth >= 1024) { // Only on desktop
                const sidebar = document.getElementById('sidebar');
                if (sidebar) {
                    toggleSidebarCollapse();
                }
            }
            
            permissions.hideForGuests('.auth-only');
            permissions.showForAdmins('.admin-only');
            
            // User dropdown toggle
            const userDropdownBtn = document.getElementById('user-dropdown-btn');
            const userDropdownMenu = document.getElementById('user-dropdown-menu');
            
            if (userDropdownBtn && userDropdownMenu) {
                userDropdownBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    userDropdownMenu.classList.toggle('hidden');
                });
                
                // Close dropdown when clicking outside
                document.addEventListener('click', function() {
                    userDropdownMenu.classList.add('hidden');
                });
            }
            
            // Initialize search functionality
            initializeMenuSearch();
        });
        
        // Menu search functionality
        function initializeMenuSearch() {
            const searchInput = document.getElementById('menu-search');
            const searchResults = document.getElementById('search-results');
            
            if (!searchInput || !searchResults) return;
            
            let searchTimeout;
            let menuData = [];
            
            // Extract actual menu items from the DOM
            function extractMenuItems() {
                const menuItems = [];
                
                // Get all menu links from the sidebar
                const sidebarLinks = document.querySelectorAll('#sidebar a[class*="flex items-center"]');
                
                sidebarLinks.forEach(link => {
                    const textElement = link.querySelector('.sidebar-text, span:not([class*="fas"])');
                    const iconElement = link.querySelector('i[class*="fas"]');
                    
                    if (textElement && iconElement) {
                        const title = textElement.textContent.trim();
                        const url = link.getAttribute('href');
                        const iconClass = iconElement.className;
                        
                        if (title && url && title !== '') {
                            menuItems.push({
                                title: title,
                                icon: iconClass,
                                url: url
                            });
                        }
                    }
                });
                
                return menuItems;
            }
            
            // Initialize menu data from DOM
            menuData = extractMenuItems();
            
            // Debug: Log extracted menu items (remove in production)
            console.log('Extracted menu items:', menuData);
            
            // Refresh menu data periodically to catch dynamic changes
            const refreshMenuData = () => {
                menuData = extractMenuItems();
                console.log('Refreshed menu items:', menuData);
            };
            
            // Refresh menu data when sidebar content might change
            setTimeout(refreshMenuData, 1000); // Initial delay for menu loading
            
            searchInput.addEventListener('input', function() {
                const query = this.value.trim();
                
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    if (query.length === 0) {
                        searchResults.classList.add('hidden');
                        return;
                    }
                    
                    if (query.length < 1) {
                        return;
                    }
                    
                    // Refresh menu data before searching to catch any dynamic changes
                    menuData = extractMenuItems();
                    
                    const results = menuData.filter(item => 
                        item.title.toLowerCase().includes(query.toLowerCase())
                    );
                    
                    displayMenuSearchResults(results, query);
                }, 200);
            });
            
            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    searchResults.classList.add('hidden');
                    this.blur();
                } else if (e.key === 'Enter') {
                    const firstResult = searchResults.querySelector('[data-url]');
                    if (firstResult) {
                        window.location.href = firstResult.getAttribute('data-url');
                    }
                }
            });
            
            // Close search results when clicking outside
            document.addEventListener('click', function(e) {
                if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
                    searchResults.classList.add('hidden');
                }
            });
        }
        
        function displayMenuSearchResults(results, query) {
            const searchResults = document.getElementById('search-results');
            if (!searchResults) return;
            
            if (results.length === 0) {
                searchResults.innerHTML = `
                    <div class="p-3 text-center text-gray-500 dark:text-gray-400">
                        <i class="fas fa-search mb-2 text-sm"></i>
                        <p class="text-xs">No menus found for "${query}"</p>
                    </div>
                `;
                searchResults.classList.remove('hidden');
                return;
            }
            
            let html = '';
            results.forEach(item => {
                const highlightedTitle = item.title.replace(
                    new RegExp(`(${query})`, 'gi'),
                    '<mark class="bg-yellow-200 dark:bg-yellow-800 px-1 rounded">$1</mark>'
                );
                
                html += `
                    <a href="${item.url}" 
                       data-url="${item.url}"
                       class="flex items-center px-3 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200 text-gray-700 dark:text-gray-300 border-b dark:border-gray-700 last:border-b-0">
                        <i class="${item.icon} w-4 text-center text-gray-500 dark:text-gray-400 mr-3"></i>
                        <span class="text-sm">${highlightedTitle}</span>
                    </a>
                `;
            });
            
            searchResults.innerHTML = html;
            searchResults.classList.remove('hidden');
        }
        
        // Menu collapse/expand functionality with accordion behavior
        function toggleSubmenu(menuId) {
            const submenu = document.querySelector(`.submenu-container[data-parent-id="${menuId}"]`);
            const chevron = document.querySelector(`.submenu-chevron[data-menu-id="${menuId}"]`);
            
            if (submenu) {
                const isHidden = submenu.style.display === 'none' || submenu.style.display === '';
                
                // Get current menu states from localStorage
                let menuStates = JSON.parse(localStorage.getItem('menuStates') || '{}');
                
                if (isHidden) {
                    // INTELLIGENT ACCORDION BEHAVIOR: Preserve parent hierarchy
                    const allSubmenus = document.querySelectorAll('.submenu-container');
                    const allChevrons = document.querySelectorAll('.submenu-chevron');
                    
                    // Find all ancestor menus that should stay open
                    const ancestorMenuIds = [];
                    let currentElement = submenu.parentElement;
                    
                    while (currentElement && currentElement !== document.body) {
                        if (currentElement.classList && currentElement.classList.contains('submenu-container')) {
                            const ancestorId = currentElement.dataset.parentId;
                            if (ancestorId) {
                                ancestorMenuIds.push(ancestorId);
                            }
                        }
                        currentElement = currentElement.parentElement;
                    }
                    
                    console.log('Ancestor menus for', menuId, ':', ancestorMenuIds);
                    
                    allSubmenus.forEach(otherSubmenu => {
                        if (otherSubmenu !== submenu) {
                            const otherMenuId = otherSubmenu.dataset.parentId;
                            
                            // Check if this submenu is an ancestor (should stay open)
                            const isAncestor = ancestorMenuIds.includes(otherMenuId);
                            
                            // Also check if the current menu is nested inside this submenu
                            const isParentOfCurrent = otherSubmenu.contains(submenu);
                            
                            if (!isAncestor && !isParentOfCurrent) {
                                // Collapse this menu as it's not in the hierarchy
                                otherSubmenu.style.maxHeight = otherSubmenu.scrollHeight + 'px';
                                otherSubmenu.style.overflow = 'hidden';
                                otherSubmenu.offsetHeight; // Force reflow
                                otherSubmenu.style.transition = 'max-height 0.3s ease-out';
                                otherSubmenu.style.maxHeight = '0';
                                
                                setTimeout(() => {
                                    otherSubmenu.style.display = 'none';
                                }, 300);
                                
                                // Update state for collapsed menu
                                if (otherMenuId) {
                                    menuStates[otherMenuId] = 'collapsed';
                                }
                                
                                console.log('Collapsed menu:', otherMenuId, 'as it\'s not in hierarchy');
                            } else {
                                console.log('Preserved menu:', otherMenuId, 'as it\'s an ancestor');
                            }
                        }
                    });
                    
                    allChevrons.forEach(otherChevron => {
                        if (otherChevron !== chevron) {
                            const otherMenuId = otherChevron.dataset.menuId;
                            const isAncestor = ancestorMenuIds.includes(otherMenuId);
                            
                            if (!isAncestor) {
                                otherChevron.classList.remove('rotate-180');
                            }
                        }
                    });
                    
                    // Now expand the clicked menu
                    submenu.style.display = 'block';
                    submenu.style.maxHeight = '0';
                    submenu.style.overflow = 'hidden';
                    submenu.style.transition = 'max-height 0.3s ease-out';
                    
                    // Force reflow
                    submenu.offsetHeight;
                    
                    submenu.style.maxHeight = submenu.scrollHeight + 'px';
                    
                    setTimeout(() => {
                        submenu.style.maxHeight = 'none';
                        submenu.style.overflow = 'visible';
                    }, 300);
                    
                    if (chevron) {
                        chevron.classList.add('rotate-180');
                    }
                    
                    // Store expanded state
                    menuStates[menuId] = 'expanded';
                    localStorage.setItem('menuStates', JSON.stringify(menuStates));
                    console.log('Menu expanded (accordion):', menuId);
                    
                } else {
                    // Hide submenu
                    submenu.style.maxHeight = submenu.scrollHeight + 'px';
                    submenu.style.overflow = 'hidden';
                    submenu.offsetHeight; // Force reflow
                    submenu.style.transition = 'max-height 0.3s ease-out';
                    submenu.style.maxHeight = '0';
                    
                    setTimeout(() => {
                        submenu.style.display = 'none';
                    }, 300);
                    
                    if (chevron) {
                        chevron.classList.remove('rotate-180');
                    }
                    
                    // Store collapsed state
                    menuStates[menuId] = 'collapsed';
                    localStorage.setItem('menuStates', JSON.stringify(menuStates));
                    console.log('Menu collapsed:', menuId);
                }
            }
        }
        
        // Restore menu states on page load
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Initializing menu state...');
            
            // First restore manually toggled menu states from localStorage (ACCORDION MODE)
            const menuStates = JSON.parse(localStorage.getItem('menuStates') || '{}');
            console.log('Restored menu states:', menuStates);
            
            // Find the most recently expanded menu (for accordion behavior)
            let lastExpandedMenu = null;
            let lastExpandedTime = 0;
            
            Object.keys(menuStates).forEach(menuId => {
                if (menuStates[menuId] === 'expanded') {
                    // In accordion mode, only restore the most recent one
                    // For now, just take the last one found
                    lastExpandedMenu = menuId;
                }
            });
            
            // Apply saved state for only the last expanded menu (accordion behavior)
            if (lastExpandedMenu) {
                const submenu = document.querySelector(`.submenu-container[data-parent-id="${lastExpandedMenu}"]`);
                const chevron = document.querySelector(`.submenu-chevron[data-menu-id="${lastExpandedMenu}"]`);
                
                if (submenu) {
                    submenu.style.display = 'block';
                    submenu.style.maxHeight = 'none';
                    submenu.style.overflow = 'visible';
                    if (chevron) {
                        chevron.classList.add('rotate-180');
                    }
                    console.log('Restored expanded state for (accordion):', lastExpandedMenu);
                }
            }
            
            // Find active menu items (only leaf items can be active, not parent menus)
            const activeItems = document.querySelectorAll('a.active-menu');
            console.log('Found active items:', activeItems.length);
            
            activeItems.forEach(activeItem => {
                console.log('Processing active item:', activeItem.textContent.trim());
                
                // First, collect all ancestor containers for this active item
                const ancestorContainers = [];
                let currentElement = activeItem.parentElement;
                
                while (currentElement && currentElement !== document.body) {
                    if (currentElement.classList.contains('submenu-container')) {
                        ancestorContainers.unshift(currentElement); // Add to beginning to get proper order
                        console.log('Found ancestor container with ID:', currentElement.dataset.parentId);
                    }
                    currentElement = currentElement.parentElement;
                }
                
                // Collect all menu IDs that should stay open (the entire hierarchy)
                const hierarchyMenuIds = ancestorContainers.map(container => container.dataset.parentId).filter(id => id);
                console.log('Hierarchy chain for active item:', hierarchyMenuIds);
                
                // ACCORDION: Close all menus that are NOT in the hierarchy
                const menuStates = JSON.parse(localStorage.getItem('menuStates') || '{}');
                
                document.querySelectorAll('.submenu-container').forEach(otherSubmenu => {
                    const otherMenuId = otherSubmenu.dataset.parentId;
                    const shouldStayOpen = ancestorContainers.includes(otherSubmenu);
                    
                    if (!shouldStayOpen) {
                        // Collapse menus not in hierarchy
                        otherSubmenu.style.display = 'none';
                        otherSubmenu.style.maxHeight = '0';
                        if (otherMenuId) {
                            menuStates[otherMenuId] = 'collapsed';
                        }
                        console.log('Collapsed unrelated menu:', otherMenuId);
                    }
                });
                
                // Close chevrons for non-hierarchy menus
                document.querySelectorAll('.submenu-chevron').forEach(chevron => {
                    const chevronMenuId = chevron.dataset.menuId;
                    if (!hierarchyMenuIds.includes(chevronMenuId)) {
                        chevron.classList.remove('rotate-180');
                    }
                });
                
                // Now expand ALL containers in the hierarchy chain
                ancestorContainers.forEach((container, index) => {
                    const parentId = container.dataset.parentId;
                    console.log(`Expanding hierarchy level ${index + 1}: ${parentId}`);
                    
                    // Expand the container
                    container.style.display = 'block';
                    container.style.maxHeight = 'none';
                    container.style.overflow = 'visible';
                    
                    // Store expanded state
                    menuStates[parentId] = 'expanded';
                    
                    // Rotate chevron
                    const chevron = document.querySelector(`.submenu-chevron[data-menu-id="${parentId}"]`);
                    if (chevron) {
                        chevron.classList.add('rotate-180');
                        console.log('Rotated chevron for hierarchy level:', parentId);
                    }
                    
                    // Highlight parent menu item
                    const parentMenuItem = document.querySelector(`li[data-menu-id="${parentId}"] > a, li[data-menu-id="${parentId}"] > div > a`);
                    if (parentMenuItem && parentMenuItem !== activeItem && !parentMenuItem.classList.contains('bg-gray-100')) {
                        parentMenuItem.classList.add('bg-gray-50', 'dark:bg-gray-800', 'font-semibold', 'border-l-4', 'border-blue-500');
                        console.log('Highlighted hierarchy menu:', parentMenuItem.textContent.trim());
                    }
                });
                
                // Save all states
                localStorage.setItem('menuStates', JSON.stringify(menuStates));
            });
            
            console.log('Menu initialization complete');
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>