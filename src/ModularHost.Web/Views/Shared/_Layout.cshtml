@using MRCMS.Core.Extensions
@inject IPermissionHelper PermissionHelper
@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var userId = PermissionHelper.GetCurrentUserId();
    var userRoles = User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
    var userPermissions = User.Claims.Where(c => c.Type == "Permission").Select(c => c.Value).ToList();
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="authenticated" content="@(isAuthenticated ? "true" : "false")" />
    <title>@ViewData["Title"] - Modular Host</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#3B82F6',
                        secondary: '#10B981',
                        danger: '#EF4444'
                    }
                }
            }
        }
    </script>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Toastr for notifications -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    @RenderSection("Styles", required: false)
</head>
<body class="h-full bg-gray-50 dark:bg-gray-900">
    <div class="min-h-full flex">
        <!-- Sidebar -->
        <nav id="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-white dark:bg-gray-800 shadow-lg transform -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out">
            <div class="h-full flex flex-col">
                <!-- Logo -->
                <div class="flex items-center justify-between h-16 px-6 bg-primary text-white">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="text-xl font-bold">
                        <i class="fas fa-cube mr-2"></i>Modular Host
                    </a>
                    <button class="lg:hidden" onclick="toggleSidebar()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                
                <!-- Navigation Links -->
                <div class="flex-1 overflow-y-auto py-4">
                    <ul class="space-y-1 px-3">
                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="Index" 
                               class="flex items-center px-3 py-2 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "bg-gray-100 dark:bg-gray-700" : "")">
                                <i class="fas fa-home w-5"></i>
                                <span class="ml-3">Dashboard</span>
                            </a>
                        </li>
                        
                        @if (isAuthenticated)
                        {
                            <li>
                                <a asp-area="Blog" asp-controller="Blog" asp-action="Index" 
                                   class="flex items-center px-3 py-2 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                                    <i class="fas fa-blog w-5"></i>
                                    <span class="ml-3">Blog</span>
                                </a>
                            </li>
                            
                            @if (PermissionHelper.IsAdmin())
                            {
                                <li class="pt-4">
                                    <div class="px-3 mb-2">
                                        <p class="text-xs font-semibold text-gray-400 uppercase">Admin</p>
                                    </div>
                                    <ul class="space-y-1">
                                        <li>
                                            <a asp-area="" asp-controller="Module" asp-action="Index" 
                                               class="flex items-center px-3 py-2 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                                                <i class="fas fa-puzzle-piece w-5"></i>
                                                <span class="ml-3">Modules</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-area="" asp-controller="User" asp-action="Index" 
                                               class="flex items-center px-3 py-2 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                                                <i class="fas fa-users w-5"></i>
                                                <span class="ml-3">Users</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-area="" asp-controller="Role" asp-action="Index" 
                                               class="flex items-center px-3 py-2 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                                                <i class="fas fa-shield-alt w-5"></i>
                                                <span class="ml-3">Roles</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-area="" asp-controller="Menu" asp-action="Index" 
                                               class="flex items-center px-3 py-2 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                                                <i class="fas fa-bars w-5"></i>
                                                <span class="ml-3">Menus</span>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                </div>
                
                <!-- User Info -->
                @if (isAuthenticated)
                {
                    <div class="border-t border-gray-200 dark:border-gray-700 p-4">
                        <div class="flex items-center">
                            <img src="@(User.FindFirst("ProfilePicture")?.Value ?? "/img/default-avatar.png")" 
                                 alt="User" 
                                 class="w-10 h-10 rounded-full">
                            <div class="ml-3 flex-1">
                                <p class="text-sm font-medium text-gray-700 dark:text-gray-300">@User.Identity?.Name</p>
                                <p class="text-xs text-gray-500 dark:text-gray-400">@userRoles.FirstOrDefault()</p>
                            </div>
                            <a asp-area="" asp-controller="Account" asp-action="Logout" 
                               class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">
                                <i class="fas fa-sign-out-alt"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </nav>
        
        <!-- Main Content -->
        <div class="flex-1 lg:ml-64">
            <!-- Top Bar -->
            <header class="bg-white dark:bg-gray-800 shadow-sm">
                <div class="flex items-center justify-between h-16 px-4 lg:px-8">
                    <button id="mobile-menu-btn" class="lg:hidden text-gray-600 dark:text-gray-300" onclick="toggleSidebar()">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    
                    <h1 class="text-xl font-semibold text-gray-800 dark:text-gray-200">
                        @ViewData["Title"]
                    </h1>
                    
                    <div class="flex items-center space-x-4">
                        <!-- Dark Mode Toggle -->
                        <button onclick="toggleDarkMode()" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">
                            <i class="fas fa-moon dark:hidden"></i>
                            <i class="fas fa-sun hidden dark:inline"></i>
                        </button>
                        
                        <!-- Notifications -->
                        @if (isAuthenticated)
                        {
                            <div class="relative">
                                <button id="notification-btn" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">
                                    <i class="fas fa-bell"></i>
                                    <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full h-4 w-4 flex items-center justify-center" id="notification-count" style="display:none;">0</span>
                                </button>
                                <div id="notification-dropdown" class="absolute right-0 mt-2 w-80 bg-white dark:bg-gray-800 rounded-lg shadow-lg hidden">
                                    <div class="p-4 border-b dark:border-gray-700">
                                        <h3 class="font-semibold text-gray-800 dark:text-gray-200">Notifications</h3>
                                    </div>
                                    <div class="max-h-96 overflow-y-auto" id="notification-list">
                                        <p class="p-4 text-gray-500 dark:text-gray-400 text-center">No new notifications</p>
                                    </div>
                                </div>
                            </div>
                        }
                        
                        @if (!isAuthenticated)
                        {
                            <a asp-area="" asp-controller="Account" asp-action="Login" 
                               class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-blue-600">
                                <i class="fas fa-sign-in-alt mr-2"></i>Login
                            </a>
                        }
                    </div>
                </div>
            </header>
            
            <!-- Page Content -->
            <main class="p-4 lg:p-8">
                @if (TempData["Success"] != null)
                {
                    <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
                        <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
                        <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="mb-4 p-4 bg-yellow-100 border border-yellow-400 text-yellow-700 rounded-lg">
                        <i class="fas fa-exclamation-triangle mr-2"></i>@TempData["Warning"]
                    </div>
                }
                @if (TempData["Info"] != null)
                {
                    <div class="mb-4 p-4 bg-blue-100 border border-blue-400 text-blue-700 rounded-lg">
                        <i class="fas fa-info-circle mr-2"></i>@TempData["Info"]
                    </div>
                }
                
                @RenderBody()
            </main>
            
            <!-- Footer -->
            <footer class="mt-auto py-4 px-8 text-center text-gray-600 dark:text-gray-400 text-sm">
                <p>&copy; @DateTime.Now.Year Modular Host. All rights reserved.</p>
                <p class="mt-1">
                    🤖 Generated with <a href="https://claude.ai/code" class="text-primary hover:underline">Claude Code</a>
                </p>
            </footer>
        </div>
    </div>
    
    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Initialize permissions in JavaScript
        permissions.init({
            permissions: @Html.Raw(Json.Serialize(userPermissions)),
            roles: @Html.Raw(Json.Serialize(userRoles)),
            userId: '@userId',
            isAuthenticated: @(isAuthenticated ? "true" : "false")
        });
        
        // Toggle sidebar
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('-translate-x-full');
            sidebar.classList.toggle('lg:translate-x-0');
        }
        
        // Apply permission-based visibility on page load
        document.addEventListener('DOMContentLoaded', function() {
            permissions.hideForGuests('.auth-only');
            permissions.showForAdmins('.admin-only');
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>