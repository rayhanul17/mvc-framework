@{
    var successMessage = TempData["Success"]?.ToString();
    var errorMessage = TempData["Error"]?.ToString();
    var warningMessage = TempData["Warning"]?.ToString();
    var infoMessage = TempData["Info"]?.ToString();
    
    // ViewBag fallback for non-redirect scenarios
    successMessage ??= ViewBag.Success as string;
    errorMessage ??= ViewBag.Error as string;
    warningMessage ??= ViewBag.Warning as string;
    infoMessage ??= ViewBag.Info as string;
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="bg-green-50 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-4 relative transition-opacity duration-300" role="alert" data-auto-dismiss="5000">
        <div class="flex items-center">
            <i class="fas fa-check-circle text-green-400 text-xl mr-3"></i>
            <span class="flex-1">@Html.Raw(successMessage)</span>
            <button type="button" class="ml-3 text-green-500 hover:text-green-700" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="bg-red-50 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-4 relative transition-opacity duration-300" role="alert" data-auto-dismiss="10000">
        <div class="flex items-center">
            <i class="fas fa-exclamation-circle text-red-400 text-xl mr-3"></i>
            <span class="flex-1">@Html.Raw(errorMessage)</span>
            <button type="button" class="ml-3 text-red-500 hover:text-red-700" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(warningMessage))
{
    <div class="bg-yellow-50 border border-yellow-400 text-yellow-700 px-4 py-3 rounded-lg mb-4 relative transition-opacity duration-300" role="alert" data-auto-dismiss="7000">
        <div class="flex items-center">
            <i class="fas fa-exclamation-triangle text-yellow-400 text-xl mr-3"></i>
            <span class="flex-1">@Html.Raw(warningMessage)</span>
            <button type="button" class="ml-3 text-yellow-500 hover:text-yellow-700" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(infoMessage))
{
    <div class="bg-blue-50 border border-blue-400 text-blue-700 px-4 py-3 rounded-lg mb-4 relative transition-opacity duration-300" role="alert" data-auto-dismiss="5000">
        <div class="flex items-center">
            <i class="fas fa-info-circle text-blue-400 text-xl mr-3"></i>
            <span class="flex-1">@Html.Raw(infoMessage)</span>
            <button type="button" class="ml-3 text-blue-500 hover:text-blue-700" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Auto-dismiss alerts after specified time
        document.addEventListener('DOMContentLoaded', function() {
            const alerts = document.querySelectorAll('[data-auto-dismiss]');
            alerts.forEach(alert => {
                const dismissTime = parseInt(alert.dataset.autoDismiss);
                if (dismissTime > 0) {
                    setTimeout(() => {
                        // Fade out animation
                        alert.style.opacity = '0';
                        setTimeout(() => {
                            alert.remove();
                        }, 300);
                    }, dismissTime);
                }
            });
        });
    </script>
}