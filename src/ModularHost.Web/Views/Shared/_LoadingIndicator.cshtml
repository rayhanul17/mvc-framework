<!-- Optimized Loading Indicator -->
<div id="loadingIndicator" class="loading-indicator" style="display: none;">
    <div class="loading-spinner">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
</div>

<!-- Page Loader for Initial Load -->
<div id="pageLoader" class="page-loader">
    <div class="loader-content">
        <div class="spinner-grow text-primary" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <p class="mt-3 text-muted">Loading...</p>
    </div>
</div>

<style>
    /* Loading Indicator Styles */
    .loading-indicator {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.9);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(5px);
    }
    
    .loading-spinner {
        text-align: center;
    }
    
    .page-loader {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: white;
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.3s ease-out;
    }
    
    .page-loader.fade-out {
        opacity: 0;
        pointer-events: none;
    }
    
    .loader-content {
        text-align: center;
    }
    
    /* Dark mode support */
    @@media (prefers-color-scheme: dark) {
        .loading-indicator {
            background: rgba(0, 0, 0, 0.9);
        }
        
        .page-loader {
            background: #1a1a1a;
        }
        
        .page-loader .text-muted {
            color: #6c757d !important;
        }
    }
</style>

<script>
    // Optimized loading indicator functions
    const LoadingIndicator = {
        show: function() {
            const indicator = document.getElementById('loadingIndicator');
            if (indicator) {
                indicator.style.display = 'flex';
                document.body.style.overflow = 'hidden';
            }
        },
        
        hide: function() {
            const indicator = document.getElementById('loadingIndicator');
            if (indicator) {
                indicator.style.display = 'none';
                document.body.style.overflow = '';
            }
        },
        
        // Show loading for AJAX requests
        attachToAjax: function() {
            let activeRequests = 0;
            
            // jQuery AJAX
            if (typeof $ !== 'undefined') {
                $(document).ajaxStart(function() {
                    activeRequests++;
                    if (activeRequests === 1) {
                        LoadingIndicator.show();
                    }
                }).ajaxStop(function() {
                    activeRequests--;
                    if (activeRequests === 0) {
                        LoadingIndicator.hide();
                    }
                });
            }
            
            // Fetch API
            const originalFetch = window.fetch;
            window.fetch = function(...args) {
                activeRequests++;
                if (activeRequests === 1) {
                    LoadingIndicator.show();
                }
                
                return originalFetch.apply(this, args)
                    .finally(() => {
                        activeRequests--;
                        if (activeRequests === 0) {
                            LoadingIndicator.hide();
                        }
                    });
            };
        }
    };
    
    // Hide page loader when DOM is ready
    document.addEventListener('DOMContentLoaded', function() {
        const pageLoader = document.getElementById('pageLoader');
        if (pageLoader) {
            setTimeout(() => {
                pageLoader.classList.add('fade-out');
                setTimeout(() => {
                    pageLoader.style.display = 'none';
                }, 300);
            }, 100);
        }
        
        // Attach loading indicator to AJAX requests
        LoadingIndicator.attachToAjax();
    });
    
    // Export for use in other scripts
    window.LoadingIndicator = LoadingIndicator;
</script>