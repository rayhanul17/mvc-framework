@using MRCMS.Core.Extensions
@using MRCMS.Core.Models.Entities
@using MRCMS.Services.Interfaces
@using Microsoft.AspNetCore.Identity
@inject IPermissionService PermissionService
@inject IPermissionHelper PermissionHelper
@inject UserManager<User> UserManager

@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    List<Menu> userMenus = new List<Menu>();
    
    if (isAuthenticated)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            userMenus = (await PermissionService.GetMenuForUserAsync(currentUser.Id)).ToList();
        }
    }
    
    // Group menus by parent
    var rootMenus = userMenus.Where(m => m.ParentId == null).OrderBy(m => m.Order).ToList();
    
    // Track visited menus to prevent circular references
    var visitedMenus = new HashSet<Guid>();
    
    // Helper function to get children with circular reference check
    Func<Guid, IEnumerable<Menu>> getChildren = (parentId) => 
    {
        if (visitedMenus.Contains(parentId))
        {
            return Enumerable.Empty<Menu>();
        }
        visitedMenus.Add(parentId);
        return userMenus.Where(m => m.ParentId == parentId && !visitedMenus.Contains(m.Id)).OrderBy(m => m.Order);
    };
    
    // Separate function for getting children without modifying visitedMenus (for active checking)
    Func<Guid, IEnumerable<Menu>> getChildrenForActiveCheck = (parentId) => 
    {
        return userMenus.Where(m => m.ParentId == parentId).OrderBy(m => m.Order);
    };
    
    // Store in ViewData so functions can access it
    ViewData["GetChildren"] = getChildren;
    ViewData["GetChildrenForActiveCheck"] = getChildrenForActiveCheck;
    ViewData["UserMenus"] = userMenus;
}

@if (isAuthenticated && userMenus.Any())
{
    <ul class="space-y-1 px-3">
        <!-- Always show Dashboard -->
        <li data-tooltip="Dashboard">
            <a asp-area="" asp-controller="Admin" asp-action="Index" 
               class="flex items-center px-3 py-2 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "bg-gray-100 dark:bg-gray-700" : "")">
                <i class="fas fa-tachometer-alt w-5"></i>
                <span class="ml-3 sidebar-text">Dashboard</span>
            </a>
        </li>
        
        @foreach (var menu in rootMenus.Where(m => m.Title != "Dashboard"))
        {
            var children = getChildren(menu.Id);
            
            @if (children.Any())
            {
                <!-- Parent menu with children - never active, just has parent-menu class -->
                var shouldExpand = false;
                <li class="pt-4 menu-parent" data-menu-id="@menu.Id">
                    <div data-tooltip="@menu.Title">
                        <a href="javascript:void(0)" 
                           onclick="toggleSubmenu('@menu.Id')" 
                           class="parent-menu-link flex items-center px-3 py-2 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                            <i class="@menu.Icon w-5"></i>
                            <span class="ml-3 sidebar-text">@menu.Title</span>
                            <i class="fas fa-chevron-down ml-auto transition-transform duration-200 submenu-chevron" data-menu-id="@menu.Id"></i>
                        </a>
                    </div>
                    
                    <!-- Render children recursively -->
                    @{
                        var menuViewData = new ViewDataDictionary(Html.ViewData);
                        menuViewData["Level"] = 1;
                        menuViewData["GetChildren"] = getChildren;
                        menuViewData["GetChildrenForActiveCheck"] = getChildrenForActiveCheck;
                        menuViewData["UserMenus"] = userMenus;
                    }
                    <div class="submenu-container" data-parent-id="@menu.Id" style="@(shouldExpand ? "display: block;" : "display: none;")">
                        @await Html.PartialAsync("_MenuItemsRecursive", children, menuViewData)
                    </div>
                </li>
            }
            else
            {
                <!-- Single menu item without children -->
                var isActive = false;
                var menuUrl = !string.IsNullOrWhiteSpace(menu.ActiveUrl) ? menu.ActiveUrl : menu.Url;
                if (!string.IsNullOrEmpty(menuUrl) && menuUrl != "#")
                {
                    var currentPath = Context.Request.Path.Value ?? "";
                    isActive = string.Equals(currentPath, menuUrl, StringComparison.OrdinalIgnoreCase);
                }
                <li data-tooltip="@menu.Title">
                    <a href="@menu.Url" 
                       class="flex items-center px-3 py-2 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 @(isActive ? "bg-gray-100 dark:bg-gray-700 active-menu" : "")">
                        <i class="@menu.Icon w-5"></i>
                        <span class="ml-3 sidebar-text">@menu.Title</span>
                    </a>
                </li>
            }
        }
    </ul>
}
else if (isAuthenticated)
{
    <!-- Default menu for authenticated users with no specific menus -->
    <ul class="space-y-1 px-3">
        <li>
            <a asp-area="" asp-controller="Admin" asp-action="Index" 
               class="flex items-center px-3 py-2 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "bg-gray-100 dark:bg-gray-700" : "")">
                <i class="fas fa-tachometer-alt w-5"></i>
                <span class="ml-3">Dashboard</span>
            </a>
        </li>
    </ul>
}
else
{
    <!-- Menu for non-authenticated users -->
    <ul class="space-y-1 px-3">
        <li>
            <a asp-area="" asp-controller="Home" asp-action="Index" 
               class="flex items-center px-3 py-2 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "bg-gray-100 dark:bg-gray-700" : "")">
                <i class="fas fa-home w-5"></i>
                <span class="ml-3">Home</span>
            </a>
        </li>
        <li>
            <a asp-area="" asp-controller="Account" asp-action="Login" 
               class="flex items-center px-3 py-2 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="fas fa-sign-in-alt w-5"></i>
                <span class="ml-3">Login</span>
            </a>
        </li>
        <li>
            <a asp-area="" asp-controller="Account" asp-action="Register" 
               class="flex items-center px-3 py-2 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="fas fa-user-plus w-5"></i>
                <span class="ml-3">Register</span>
            </a>
        </li>
    </ul>
}

