@model MRCMS.Models.ViewModels.ModuleDetailsViewModel
@{
    ViewData["Title"] = Model?.DisplayName ?? "Module Details";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="mb-6 flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">@Model?.DisplayName</h1>
                <p class="text-gray-600 dark:text-gray-400 mt-2">@Model?.Description</p>
            </div>
            <div class="flex space-x-3">
                @if (Model?.IsEnabled ?? false)
                {
                    <span class="px-3 py-1 bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300 rounded-full text-sm font-medium">
                        <i class="fas fa-check-circle mr-1"></i>Enabled
                    </span>
                }
                else
                {
                    <span class="px-3 py-1 bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300 rounded-full text-sm font-medium">
                        <i class="fas fa-times-circle mr-1"></i>Disabled
                    </span>
                }
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Module Information -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Basic Info -->
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
                    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-4">
                        <i class="fas fa-info-circle mr-2 text-blue-600"></i>Module Information
                    </h2>
                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Module Name</dt>
                            <dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">@Model?.Name</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Version</dt>
                            <dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">@Model?.Version</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Author</dt>
                            <dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">@Model?.Author</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Table Prefix</dt>
                            <dd class="mt-1 text-sm text-gray-900 dark:text-gray-100 font-mono">@Model?.TablePrefix</dd>
                        </div>
                    </dl>
                </div>

                <!-- Database Tables -->
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow">
                    <div class="px-6 py-4 border-b dark:border-gray-700">
                        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">
                            <i class="fas fa-database mr-2 text-green-600"></i>Database Tables
                        </h2>
                    </div>
                    <div class="p-6">
                        @if (Model?.Tables?.Any() ?? false)
                        {
                            <div class="overflow-x-auto">
                                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                                    <thead>
                                        <tr>
                                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Entity</th>
                                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Table Name</th>
                                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Full Name</th>
                                            <th class="px-4 py-2 text-center text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                                        @foreach (var table in Model.Tables)
                                        {
                                            <tr>
                                                <td class="px-4 py-3 text-sm text-gray-900 dark:text-gray-100">@table.EntityName</td>
                                                <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 font-mono">@table.TableName</td>
                                                <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 font-mono">@table.FullTableName</td>
                                                <td class="px-4 py-3 text-center">
                                                    <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300">
                                                        Active
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-gray-500 dark:text-gray-400">No database tables configured for this module.</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Module Actions & Status -->
            <div class="space-y-6">
                <!-- Quick Actions -->
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
                        <i class="fas fa-bolt mr-2 text-yellow-600"></i>Quick Actions
                    </h3>
                    <div class="space-y-3">
                        @if (Model?.IsEnabled ?? false)
                        {
                            <button onclick="toggleModule('@Model.Name', false)" class="w-full px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">
                                <i class="fas fa-power-off mr-2"></i>Disable Module
                            </button>
                        }
                        else
                        {
                            <button onclick="toggleModule('@Model?.Name', true)" class="w-full px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition">
                                <i class="fas fa-power-off mr-2"></i>Enable Module
                            </button>
                        }
                        
                        <button onclick="updateTables('@Model?.Name')" class="w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                            <i class="fas fa-sync mr-2"></i>Update Tables
                        </button>
                        
                        <button onclick="applyMigrations('@Model?.Name')" class="w-full px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition">
                            <i class="fas fa-database mr-2"></i>Apply Migrations
                        </button>
                    </div>
                </div>

                <!-- Module Statistics -->
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
                        <i class="fas fa-chart-bar mr-2 text-indigo-600"></i>Statistics
                    </h3>
                    <dl class="space-y-3">
                        <div class="flex justify-between">
                            <dt class="text-sm text-gray-600 dark:text-gray-400">Tables</dt>
                            <dd class="text-sm font-medium text-gray-900 dark:text-gray-100">@(Model?.Tables?.Count ?? 0)</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-sm text-gray-600 dark:text-gray-400">Controllers</dt>
                            <dd class="text-sm font-medium text-gray-900 dark:text-gray-100">N/A</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-sm text-gray-600 dark:text-gray-400">Views</dt>
                            <dd class="text-sm font-medium text-gray-900 dark:text-gray-100">N/A</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-sm text-gray-600 dark:text-gray-400">Services</dt>
                            <dd class="text-sm font-medium text-gray-900 dark:text-gray-100">N/A</dd>
                        </div>
                    </dl>
                </div>

                <!-- Back Button -->
                <div>
                    <a asp-action="Index" class="w-full inline-flex justify-center items-center px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition">
                        <i class="fas fa-arrow-left mr-2"></i>Back to Modules
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleModule(moduleName, enable) {
            if (confirm(`Are you sure you want to ${enable ? 'enable' : 'disable'} this module?`)) {
                $.post('@Url.Action("ToggleModule")', { 
                    moduleName: moduleName,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                })
                .done(function(data) {
                    if (data.success) {
                        location.reload();
                    } else {
                        toastr.error(data.message || 'Failed to toggle module');
                    }
                });
            }
        }
        
        function updateTables(moduleName) {
            if (confirm('Update database tables for this module?')) {
                $.post('@Url.Action("UpdateTables")', { 
                    moduleName: moduleName,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                })
                .done(function(data) {
                    if (data.success) {
                        toastr.success('Tables updated successfully');
                    } else {
                        toastr.error(data.message || 'Failed to update tables');
                    }
                });
            }
        }
        
        function applyMigrations(moduleName) {
            if (confirm('Apply pending migrations for this module?')) {
                $.post('@Url.Action("ApplyAllMigrations")', { 
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                })
                .done(function(data) {
                    if (data.success) {
                        toastr.success('Migrations applied successfully');
                    } else {
                        toastr.error(data.message || 'Failed to apply migrations');
                    }
                });
            }
        }
    </script>
}