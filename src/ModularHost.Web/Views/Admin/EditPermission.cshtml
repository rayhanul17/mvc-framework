@model MRCMS.Core.Models.Entities.RolePermission
@{
    ViewData["Title"] = "Edit Permission";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto">
        <div class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Edit Permission</h1>
            <p class="text-gray-600 dark:text-gray-400 mt-2">Modify permission settings and role assignments</p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg shadow">
            <form asp-action="EditPermission" method="post" class="p-6">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>
                
                <div class="space-y-4">
                    <div>
                        <label asp-for="PermissionName" class="form-label">Permission Name</label>
                        <input asp-for="PermissionName" class="form-input" />
                        <span asp-validation-for="PermissionName" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" rows="3" class="form-input"></textarea>
                        <span asp-validation-for="Description" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Url" class="form-label">URL Pattern</label>
                        <input asp-for="Url" class="form-input" />
                        <span asp-validation-for="Url" class="text-red-500 text-sm"></span>
                        <p class="text-xs text-gray-500 mt-1">Use * as wildcard. Examples: /Admin/*, /User/Edit/*</p>
                    </div>

                    <div>
                        <label asp-for="HttpMethod" class="form-label">HTTP Method</label>
                        <select asp-for="HttpMethod" class="form-select">
                            <option value="*">Any</option>
                            <option value="GET">GET</option>
                            <option value="POST">POST</option>
                            <option value="PUT">PUT</option>
                            <option value="DELETE">DELETE</option>
                        </select>
                        <span asp-validation-for="HttpMethod" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label class="form-label">Assigned Roles</label>
                        <div class="space-y-2 border dark:border-gray-700 rounded-lg p-3">
                            @{
                                var allRoles = ViewBag.AllRoles as List<string> ?? new List<string>();
                                var assignedRoles = Model?.Roles ?? new List<string>();
                                foreach (var role in allRoles)
                                {
                                    var isChecked = assignedRoles.Contains(role);
                                    <label class="flex items-center">
                                        <input type="checkbox" name="SelectedRoles" value="@role" class="form-checkbox mr-2" @(isChecked ? "checked" : "") />
                                        <span class="text-gray-700 dark:text-gray-300">@role</span>
                                    </label>
                                }
                            }
                        </div>
                    </div>

                    <div>
                        <label class="flex items-center">
                            <input asp-for="IsActive" type="checkbox" class="form-checkbox mr-2" />
                            <span class="text-gray-700 dark:text-gray-300">Active (Permission is enabled)</span>
                        </label>
                    </div>

                    <!-- Audit Information -->
                    <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4">
                        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Audit Information</h3>
                        <div class="text-xs text-gray-600 dark:text-gray-400 space-y-1">
                            <p>Created: @Model?.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
                            <p>Last Modified: @(Model?.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</p>
                        </div>
                    </div>
                </div>

                <div class="mt-6 pt-6 border-t dark:border-gray-700 flex justify-between">
                    <button type="button" onclick="confirmDelete()" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">
                        <i class="fas fa-trash mr-2"></i>Delete
                    </button>
                    
                    <div class="space-x-3">
                        <a asp-action="Permissions" class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700">
                            Cancel
                        </a>
                        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                            <i class="fas fa-save mr-2"></i>Save Changes
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function confirmDelete() {
            if (confirm('Are you sure you want to delete this permission? This action cannot be undone.')) {
                window.location.href = '@Url.Action("DeletePermission", new { id = Model?.Id })';
            }
        }
    </script>
}