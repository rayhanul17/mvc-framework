@model MRCMS.Core.Models.Entities.RolePermission
@{
    ViewData["Title"] = "Create Permission";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto">
        <div class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Create Permission</h1>
            <p class="text-gray-600 dark:text-gray-400 mt-2">Define a new permission for access control</p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg shadow">
            <form asp-action="CreatePermission" method="post" class="p-6">
                <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>
                
                <div class="space-y-4">
                    <div>
                        <label asp-for="PermissionName" class="form-label">Permission Name</label>
                        <input asp-for="PermissionName" class="form-input" placeholder="e.g., ManageUsers" />
                        <span asp-validation-for="PermissionName" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" rows="3" class="form-input" placeholder="Describe what this permission allows"></textarea>
                        <span asp-validation-for="Description" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Url" class="form-label">URL Pattern</label>
                        <input asp-for="Url" class="form-input" placeholder="/Admin/*" />
                        <span asp-validation-for="Url" class="text-red-500 text-sm"></span>
                        <p class="text-xs text-gray-500 mt-1">Use * as wildcard. Examples: /Admin/*, /User/Edit/*</p>
                    </div>

                    <div>
                        <label asp-for="HttpMethod" class="form-label">HTTP Method</label>
                        <select asp-for="HttpMethod" class="form-select">
                            <option value="*">Any</option>
                            <option value="GET">GET</option>
                            <option value="POST">POST</option>
                            <option value="PUT">PUT</option>
                            <option value="DELETE">DELETE</option>
                        </select>
                        <span asp-validation-for="HttpMethod" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label class="form-label">Assign to Roles</label>
                        <div class="space-y-2 border dark:border-gray-700 rounded-lg p-3">
                            @{
                                var roles = ViewBag.AllRoles as List<string> ?? new List<string>();
                                foreach (var role in roles)
                                {
                                    <label class="flex items-center">
                                        <input type="checkbox" name="SelectedRoles" value="@role" class="form-checkbox mr-2" />
                                        <span class="text-gray-700 dark:text-gray-300">@role</span>
                                    </label>
                                }
                            }
                        </div>
                    </div>

                    <div>
                        <label class="flex items-center">
                            <input asp-for="IsActive" type="checkbox" class="form-checkbox mr-2" checked />
                            <span class="text-gray-700 dark:text-gray-300">Active (Permission is enabled)</span>
                        </label>
                    </div>
                </div>

                <div class="mt-6 pt-6 border-t dark:border-gray-700 flex justify-end space-x-3">
                    <a asp-action="Permissions" class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700">
                        Cancel
                    </a>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                        <i class="fas fa-save mr-2"></i>Create Permission
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}