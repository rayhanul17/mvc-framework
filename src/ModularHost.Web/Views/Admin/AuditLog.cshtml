@model List<MRCMS.Models.ViewModels.AuditLogViewModel>
@{
    ViewData["Title"] = "Audit Logs";
    var entityNames = ViewBag.EntityNames as List<string> ?? new List<string>();
    var currentPage = ViewBag.CurrentPage ?? 1;
    var pageSize = ViewBag.PageSize ?? 50;
    var totalCount = ViewBag.TotalCount ?? 0;
    var totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
}

<div class="container mx-auto px-4 py-8 animate-fade-in">
    <div class="card-elevated">
        <div class="card-header">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 flex items-center">
                <i class="fas fa-history text-primary-500 mr-3"></i>
                Audit Logs
            </h1>
            @if (User.HasClaim("IsSuperAdmin", "true"))
            {
                <div class="flex items-center space-x-2">
                    <button type="button" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors duration-200" id="clearLogsBtn">
                        <i class="fas fa-trash mr-2"></i>
                        Clear Old Logs
                    </button>
                </div>
            }
        </div>
        <div class="card-body">
            <!-- Filters -->
            <form method="get" action="@Url.Action("AuditLog")" class="mb-6">
                <div class="grid grid-cols-1 md:grid-cols-6 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Entity</label>
                        <select name="entityName" class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm dark:bg-gray-700 dark:text-white">
                            <option value="">All Entities</option>
                            @foreach (var entity in entityNames)
                            {
                                <option value="@entity" selected="@(ViewBag.EntityNameFilter == entity)">@entity</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Action</label>
                        <select name="action" class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm dark:bg-gray-700 dark:text-white">
                            <option value="">All Actions</option>
                            <option value="Added" selected="@(ViewBag.ActionFilter == "Added")">Added</option>
                            <option value="Modified" selected="@(ViewBag.ActionFilter == "Modified")">Modified</option>
                            <option value="Deleted" selected="@(ViewBag.ActionFilter == "Deleted")">Deleted</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Start Date</label>
                        <input type="date" name="startDate" class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm dark:bg-gray-700 dark:text-white" value="@ViewBag.StartDateFilter?.ToString("yyyy-MM-dd")">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">End Date</label>
                        <input type="date" name="endDate" class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm dark:bg-gray-700 dark:text-white" value="@ViewBag.EndDateFilter?.ToString("yyyy-MM-dd")">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Per Page</label>
                        <select name="pageSize" class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm dark:bg-gray-700 dark:text-white">
                            <option value="25" selected="@(pageSize == 25)">25</option>
                            <option value="50" selected="@(pageSize == 50)">50</option>
                            <option value="100" selected="@(pageSize == 100)">100</option>
                        </select>
                    </div>
                    <div class="flex items-end space-x-2">
                        <button type="submit" class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors duration-200">
                            <i class="fas fa-filter mr-2"></i>Filter
                        </button>
                        <a href="@Url.Action("AuditLog")" class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors duration-200">
                            <i class="fas fa-undo mr-2"></i>Clear
                        </a>
                    </div>
                </div>
            </form>

            <!-- Audit Log Table -->
            <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                    <thead class="bg-gray-50 dark:bg-gray-800">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                                Timestamp
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                                Entity
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                                Action
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                                Version
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                                User
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                                IP Address
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                                Changed Properties
                            </th>
                            <th scope="col" class="relative px-6 py-3">
                                <span class="sr-only">Actions</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white dark:bg-gray-900 divide-y divide-gray-200 dark:divide-gray-700">
                        @if (Model.Any())
                        {
                            @foreach (var log in Model)
                            {
                                <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors duration-200">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">
                                        <div class="text-sm">
                                            @log.Timestamp.ToString("yyyy-MM-dd")
                                        </div>
                                        <div class="text-xs text-gray-500 dark:text-gray-400">
                                            @log.Timestamp.ToString("HH:mm:ss")
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 dark:bg-blue-800 dark:text-blue-200">
                                            @log.EntityName
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        @{
                                            var actionBadge = log.Action switch
                                            {
                                                "Added" => "bg-green-100 text-green-800 dark:bg-green-800 dark:text-green-200",
                                                "Modified" => "bg-yellow-100 text-yellow-800 dark:bg-yellow-800 dark:text-yellow-200",
                                                "Deleted" => "bg-red-100 text-red-800 dark:bg-red-800 dark:text-red-200",
                                                _ => "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200"
                                            };
                                        }
                                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full @actionBadge">
                                            @log.Action
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200">
                                            v@log.VersionNumber
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">
                                        @(log.UserName ?? "System")
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-gray-500 dark:text-gray-400">
                                        @log.IpAddress
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                                        @if (!string.IsNullOrEmpty(log.ChangedProperties))
                                        {
                                            <span>@log.ChangedProperties</span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400">-</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                        <div class="flex items-center space-x-2">
                                            @if (log.HasChanges)
                                            {
                                                <button type="button" class="text-indigo-600 hover:text-indigo-900 dark:text-indigo-400 dark:hover:text-indigo-300 view-diff p-1 rounded hover:bg-indigo-50 dark:hover:bg-indigo-900 transition-all duration-200" 
                                                        data-id="@log.Id" 
                                                        data-entity="@log.EntityName" 
                                                        data-version="@log.VersionNumber"
                                                        title="View Changes">
                                                    <i class="fas fa-code-compare"></i>
                                                </button>
                                            }
                                            <button type="button" class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-300 view-history p-1 rounded hover:bg-gray-50 dark:hover:bg-gray-700 transition-all duration-200" 
                                                    data-entity="@log.EntityName" 
                                                    data-entity-id="@log.EntityId"
                                                    title="View History">
                                                <i class="fas fa-clock-rotate-left"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="px-6 py-12 text-center">
                                    <div class="flex flex-col items-center">
                                        <i class="fas fa-search text-4xl text-gray-400 mb-4"></i>
                                        <p class="text-gray-500 dark:text-gray-400">No audit logs found</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="flex items-center justify-between border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-3 sm:px-6 mt-6">
                    <div class="flex-1 flex justify-between sm:hidden">
                        @if (currentPage > 1)
                        {
                            <a href="@Url.Action("AuditLog", new { page = currentPage - 1, entityName = ViewBag.EntityNameFilter, action = ViewBag.ActionFilter, startDate = ViewBag.StartDateFilter, endDate = ViewBag.EndDateFilter, pageSize = pageSize })" 
                               class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                Previous
                            </a>
                        }
                        @if (currentPage < totalPages)
                        {
                            <a href="@Url.Action("AuditLog", new { page = currentPage + 1, entityName = ViewBag.EntityNameFilter, action = ViewBag.ActionFilter, startDate = ViewBag.StartDateFilter, endDate = ViewBag.EndDateFilter, pageSize = pageSize })" 
                               class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                Next
                            </a>
                        }
                    </div>
                    <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                        <div>
                            <p class="text-sm text-gray-700 dark:text-gray-300">
                                Showing page <span class="font-medium">@currentPage</span> of <span class="font-medium">@totalPages</span>
                                (<span class="font-medium">@totalCount</span> total entries)
                            </p>
                        </div>
                        <div>
                            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                                @if (currentPage > 1)
                                {
                                    <a href="@Url.Action("AuditLog", new { page = currentPage - 1, entityName = ViewBag.EntityNameFilter, action = ViewBag.ActionFilter, startDate = ViewBag.StartDateFilter, endDate = ViewBag.EndDateFilter, pageSize = pageSize })" 
                                       class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                                        <i class="fas fa-chevron-left h-3 w-3"></i>
                                    </a>
                                }
                                
                                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                                {
                                    if (i == currentPage)
                                    {
                                        <span class="relative inline-flex items-center px-4 py-2 border border-primary-500 bg-primary-50 dark:bg-primary-900 text-sm font-medium text-primary-600 dark:text-primary-300">
                                            @i
                                        </span>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("AuditLog", new { page = i, entityName = ViewBag.EntityNameFilter, action = ViewBag.ActionFilter, startDate = ViewBag.StartDateFilter, endDate = ViewBag.EndDateFilter, pageSize = pageSize })" 
                                           class="relative inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700">
                                            @i
                                        </a>
                                    }
                                }
                                
                                @if (currentPage < totalPages)
                                {
                                    <a href="@Url.Action("AuditLog", new { page = currentPage + 1, entityName = ViewBag.EntityNameFilter, action = ViewBag.ActionFilter, startDate = ViewBag.StartDateFilter, endDate = ViewBag.EndDateFilter, pageSize = pageSize })" 
                                       class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                                        <i class="fas fa-chevron-right h-3 w-3"></i>
                                    </a>
                                }
                            </nav>
                        </div>
                    </div>
                </div>
            }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Diff Modal -->
<div id="diffModal" class="modal-overlay hidden">
    <div class="modal-container max-w-6xl">
        <div class="modal-header">
            <h3 id="diffModalLabel" class="modal-title">
                <i class="fas fa-code-compare text-info-500 mr-2"></i>
                Audit Changes
            </h3>
            <button type="button" class="modal-close" id="closeDiffModal">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body max-h-96 overflow-y-auto">
            <div id="diffViewer">
                <div class="text-center py-8">
                    <i class="fas fa-spinner fa-spin text-3xl text-primary-500 mb-4"></i>
                    <p class="text-gray-600 dark:text-gray-400">Loading changes...</p>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors duration-200" id="closeDiffModalFooter">Close</button>
        </div>
    </div>
</div>

<!-- History Modal -->
<div id="historyModal" class="modal-overlay hidden">
    <div class="modal-container max-w-4xl">
        <div class="modal-header">
            <h3 id="historyModalLabel" class="modal-title">
                <i class="fas fa-clock-rotate-left text-warning-500 mr-2"></i>
                Entity History
            </h3>
            <button type="button" class="modal-close" id="closeHistoryModal">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body max-h-96 overflow-y-auto">
            <div id="historyViewer">
                <div class="text-center py-8">
                    <i class="fas fa-spinner fa-spin text-3xl text-primary-500 mb-4"></i>
                    <p class="text-gray-600 dark:text-gray-400">Loading history...</p>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors duration-200" id="closeHistoryModalFooter">Close</button>
        </div>
    </div>
</div>

<!-- Clear Logs Modal -->
@if (User.HasClaim("IsSuperAdmin", "true"))
{
    <div id="clearLogsModal" class="modal-overlay hidden">
        <div class="modal-container">
            <form method="post" action="@Url.Action("ClearAuditLog")">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h3 class="modal-title">
                        <i class="fas fa-trash text-danger-500 mr-2"></i>
                        Clear Old Audit Logs
                    </h3>
                    <button type="button" class="modal-close" id="closeClearLogsModal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-4">
                        <label for="daysToKeep" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Keep logs for the last (days):
                        </label>
                        <input type="number" class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm dark:bg-gray-700 dark:text-white" id="daysToKeep" name="daysToKeep" value="30" min="7" max="365" required>
                        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                            Logs older than this will be permanently deleted.
                        </p>
                    </div>
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle mr-2"></i>
                        <strong>Warning:</strong> This action cannot be undone!
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors duration-200" id="cancelClearLogs">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors duration-200">
                        <i class="fas fa-trash mr-2"></i>
                        Clear Logs
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <style>
        .property-change {
            margin-bottom: 1rem;
            border: 1px solid #d1d5db;
            border-radius: 0.5rem;
            overflow: hidden;
        }
        .dark .property-change {
            border-color: #374151;
        }
        .property-header {
            background-color: #f9fafb;
            padding: 0.75rem 1rem;
            font-weight: 600;
            border-bottom: 1px solid #d1d5db;
            color: #374151;
        }
        .dark .property-header {
            background-color: #374151;
            border-color: #4b5563;
            color: #d1d5db;
        }
        .property-values {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            padding: 1rem;
        }
        .old-value {
            background-color: #fef2f2;
            padding: 0.75rem;
            border-radius: 0.375rem;
            border: 1px solid #fecaca;
        }
        .dark .old-value {
            background-color: #7f1d1d;
            border-color: #991b1b;
        }
        .new-value {
            background-color: #f0fdf4;
            padding: 0.75rem;
            border-radius: 0.375rem;
            border: 1px solid #bbf7d0;
        }
        .dark .new-value {
            background-color: #14532d;
            border-color: #166534;
        }
        .value-label {
            font-weight: 600;
            margin-bottom: 0.25rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            color: #6b7280;
        }
        .dark .value-label {
            color: #9ca3af;
        }
        .value-content {
            font-family: 'Courier New', monospace;
            word-break: break-all;
            font-size: 0.875rem;
        }
        .timeline-item {
            position: relative;
            padding-left: 2.5rem;
            margin-bottom: 1.25rem;
        }
        .timeline-item::before {
            content: '';
            position: absolute;
            left: 0.9375rem;
            top: 1.875rem;
            bottom: -1.25rem;
            width: 2px;
            background: #d1d5db;
        }
        .dark .timeline-item::before {
            background: #374151;
        }
        .timeline-item:last-child::before {
            display: none;
        }
        .timeline-marker {
            position: absolute;
            left: 0.625rem;
            top: 0.3125rem;
            width: 0.75rem;
            height: 0.75rem;
            border-radius: 50%;
            background: #3b82f6;
            border: 2px solid #ffffff;
            box-shadow: 0 0 0 2px #d1d5db;
        }
        .dark .timeline-marker {
            border-color: #111827;
            box-shadow: 0 0 0 2px #374151;
        }
        .timeline-content {
            background: #f9fafb;
            padding: 0.75rem;
            border-radius: 0.375rem;
            border: 1px solid #d1d5db;
        }
        .dark .timeline-content {
            background: #374151;
            border-color: #4b5563;
        }
    </style>
    
    <script>
        // Define URLs at the top to avoid Razor processing issues
        var getAuditDiffUrl = @Html.Raw(Json.Serialize(Url.Action("GetAuditDiff")));
        var getEntityHistoryUrl = @Html.Raw(Json.Serialize(Url.Action("GetEntityHistory")));
        
        document.addEventListener('DOMContentLoaded', function() {
            // Modal functionality
            function openModal(modalId) {
                document.getElementById(modalId).classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            }
            
            function closeModal(modalId) {
                document.getElementById(modalId).classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }
            
            // Clear logs modal
            document.getElementById('clearLogsBtn')?.addEventListener('click', function() {
                openModal('clearLogsModal');
            });
            
            document.getElementById('closeClearLogsModal')?.addEventListener('click', function() {
                closeModal('clearLogsModal');
            });
            
            document.getElementById('cancelClearLogs')?.addEventListener('click', function() {
                closeModal('clearLogsModal');
            });
            
            // Diff modal
            document.getElementById('closeDiffModal')?.addEventListener('click', function() {
                closeModal('diffModal');
            });
            
            document.getElementById('closeDiffModalFooter')?.addEventListener('click', function() {
                closeModal('diffModal');
            });
            
            // History modal
            document.getElementById('closeHistoryModal')?.addEventListener('click', function() {
                closeModal('historyModal');
            });
            
            document.getElementById('closeHistoryModalFooter')?.addEventListener('click', function() {
                closeModal('historyModal');
            });
            
            // Close modals on backdrop click
            document.querySelectorAll('.modal-overlay').forEach(modal => {
                modal.addEventListener('click', function(e) {
                    if (e.target === this) {
                        closeModal(this.id);
                    }
                });
            });
            
            // View Diff
            document.querySelectorAll('.view-diff').forEach(button => {
                button.addEventListener('click', function() {
                    const auditId = this.getAttribute('data-id');
                    const entityName = this.getAttribute('data-entity');
                    const version = this.getAttribute('data-version');
                    
                    document.getElementById('diffModalLabel').innerHTML = '<i class="fas fa-code-compare text-info-500 mr-2"></i>' + entityName + ' - Version ' + version;
                    openModal('diffModal');
                    
                    fetch(getAuditDiffUrl + '?id=' + auditId)
                        .then(response => response.json())
                        .then(data => displayDiff(data))
                        .catch(() => {
                            document.getElementById('diffViewer').innerHTML = '<div class="alert alert-danger">Failed to load changes</div>';
                        });
                });
            });
            
            // View History
            document.querySelectorAll('.view-history').forEach(button => {
                button.addEventListener('click', function() {
                    const entityName = this.getAttribute('data-entity');
                    const entityId = this.getAttribute('data-entity-id');
                    
                    document.getElementById('historyModalLabel').innerHTML = '<i class="fas fa-clock-rotate-left text-warning-500 mr-2"></i>' + entityName + ' History';
                    openModal('historyModal');
                    
                    fetch(getEntityHistoryUrl + '?entityName=' + encodeURIComponent(entityName) + '&entityId=' + entityId)
                        .then(response => response.json())
                        .then(data => displayHistory(data))
                        .catch(() => {
                            document.getElementById('historyViewer').innerHTML = '<div class="alert alert-danger">Failed to load history</div>';
                        });
                });
            });
            
            function displayDiff(data) {
                let html = '';
                
                if (!data.currentVersion) {
                    html = '<div class="alert alert-warning">No changes found</div>';
                } else {
                    html = '<div class="mb-4">';
                    html += '<div class="grid grid-cols-1 md:grid-cols-2 gap-4">';
                    html += '<div class="text-center p-4 bg-gray-50 dark:bg-gray-800 rounded-lg">';
                    html += '<h4 class="font-bold text-gray-900 dark:text-gray-100">Version ' + (data.previousVersion ? data.previousVersion.versionNumber : '0') + '</h4>';
                    if (data.previousVersion) {
                        html += '<p class="text-sm text-gray-600 dark:text-gray-400 mt-1">' + data.previousVersion.userName + ' - ' + formatDate(data.previousVersion.timestamp) + '</p>';
                    } else {
                        html += '<p class="text-sm text-gray-600 dark:text-gray-400 mt-1">Initial State</p>';
                    }
                    html += '</div>';
                    html += '<div class="text-center p-4 bg-primary-50 dark:bg-primary-900 rounded-lg">';
                    html += '<h4 class="font-bold text-primary-900 dark:text-primary-100">Version ' + data.currentVersion.versionNumber + '</h4>';
                    html += '<p class="text-sm text-primary-700 dark:text-primary-300 mt-1">' + data.currentVersion.userName + ' - ' + formatDate(data.currentVersion.timestamp) + '</p>';
                    html += '</div>';
                    html += '</div>';
                    html += '</div>';
                    
                    if (data.currentVersion.changedProperties && data.currentVersion.changedProperties.length > 0) {
                        const oldValues = data.currentVersion.oldValues ? JSON.parse(data.currentVersion.oldValues) : {};
                        const newValues = data.currentVersion.newValues ? JSON.parse(data.currentVersion.newValues) : {};
                        
                        data.currentVersion.changedProperties.forEach(function(prop) {
                            html += '<div class="property-change">';
                            html += '<div class="property-header">' + prop + '</div>';
                            html += '<div class="property-values">';
                            html += '<div class="old-value">';
                            html += '<div class="value-label">Old Value</div>';
                            html += '<div class="value-content">' + formatValue(oldValues[prop]) + '</div>';
                            html += '</div>';
                            html += '<div class="new-value">';
                            html += '<div class="value-label">New Value</div>';
                            html += '<div class="value-content">' + formatValue(newValues[prop]) + '</div>';
                            html += '</div>';
                            html += '</div>';
                            html += '</div>';
                        });
                    } else if (data.currentVersion.action === 'Added') {
                        const values = data.currentVersion.newValues ? JSON.parse(data.currentVersion.newValues) : {};
                        html += '<div class="alert alert-success"><i class="fas fa-plus mr-2"></i>New entity created</div>';
                        html += '<div class="property-change">';
                        html += '<div class="property-header">Created Values</div>';
                        html += '<div class="property-values">';
                        Object.keys(values).forEach(function(key) {
                            html += '<div class="col-span-2 py-2 px-3 bg-gray-50 dark:bg-gray-700 rounded">';
                            html += '<strong class="text-gray-900 dark:text-gray-100">' + key + ':</strong> ';
                            html += '<span class="text-gray-700 dark:text-gray-300">' + formatValue(values[key]) + '</span>';
                            html += '</div>';
                        });
                        html += '</div>';
                        html += '</div>';
                    } else if (data.currentVersion.action === 'Deleted') {
                        const values = data.currentVersion.oldValues ? JSON.parse(data.currentVersion.oldValues) : {};
                        html += '<div class="alert alert-danger"><i class="fas fa-trash mr-2"></i>Entity deleted</div>';
                        html += '<div class="property-change">';
                        html += '<div class="property-header">Deleted Values</div>';
                        html += '<div class="property-values">';
                        Object.keys(values).forEach(function(key) {
                            html += '<div class="col-span-2 py-2 px-3 bg-gray-50 dark:bg-gray-700 rounded">';
                            html += '<strong class="text-gray-900 dark:text-gray-100">' + key + ':</strong> ';
                            html += '<span class="text-gray-700 dark:text-gray-300">' + formatValue(values[key]) + '</span>';
                            html += '</div>';
                        });
                        html += '</div>';
                        html += '</div>';
                    }
                }
                
                document.getElementById('diffViewer').innerHTML = html;
            }
            
            function displayHistory(data) {
                let html = '';
                
                if (data && data.length > 0) {
                    html = '<div class="timeline">';
                    data.forEach(function(item) {
                        const actionClass = item.action === 'Added' ? 'success' : (item.action === 'Deleted' ? 'danger' : 'warning');
                        const badgeClass = 'badge-' + actionClass;
                        
                        html += '<div class="timeline-item">';
                        html += '<div class="timeline-marker"></div>';
                        html += '<div class="timeline-content">';
                        html += '<div class="flex justify-between items-start">';
                        html += '<div class="flex-1">';
                        html += '<span class="' + badgeClass + ' mr-2">' + item.action + '</span>';
                        html += '<span class="badge badge-secondary">v' + item.versionNumber + '</span>';
                        if (item.changedProperties) {
                            html += '<p class="text-sm text-gray-600 dark:text-gray-400 mt-2">Changed: ' + item.changedProperties + '</p>';
                        }
                        html += '</div>';
                        html += '<div class="text-right text-sm">';
                        html += '<p class="font-medium text-gray-900 dark:text-gray-100">' + item.userName + '</p>';
                        html += '<p class="text-gray-500 dark:text-gray-400">' + formatDate(item.timestamp) + '</p>';
                        html += '</div>';
                        html += '</div>';
                        html += '</div>';
                        html += '</div>';
                    });
                    html += '</div>';
                } else {
                    html = '<div class="alert alert-info"><i class="fas fa-info-circle mr-2"></i>No history found for this entity</div>';
                }
                
                document.getElementById('historyViewer').innerHTML = html;
            }
            
            function formatValue(value) {
                if (value === null || value === undefined) {
                    return '<span class="text-gray-400 dark:text-gray-500 italic">null</span>';
                }
                if (typeof value === 'object') {
                    return '<pre class="bg-gray-100 dark:bg-gray-700 p-2 rounded text-xs overflow-x-auto">' + JSON.stringify(value, null, 2) + '</pre>';
                }
                return escapeHtml(value.toString());
            }
            
            function escapeHtml(text) {
                const map = {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                };
                return text.replace(/[&<>"']/g, function(m) { return map[m]; });
            }
            
            function formatDate(dateString) {
                const date = new Date(dateString);
                return date.toLocaleDateString() + ' ' + date.toLocaleTimeString();
            }
            
            // Notification function
            function showNotification(message, type = 'info') {
                // Remove existing notifications
                const existingNotification = document.querySelector('.notification-toast');
                if (existingNotification) {
                    existingNotification.remove();
                }
                
                // Create notification element
                const notification = document.createElement('div');
                notification.className = 'notification-toast fixed top-4 right-4 z-50 max-w-md p-4 rounded-lg shadow-lg transition-all duration-300';
                
                const bgColor = type === 'success' ? 'bg-green-500' : 
                               type === 'error' ? 'bg-red-500' : 'bg-blue-500';
                
                notification.classList.add(bgColor, 'text-white');
                
                const iconClass = type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle';
                
                // Create elements safely
                const container = document.createElement('div');
                container.className = 'flex items-center';
                
                const icon = document.createElement('i');
                icon.className = 'fas ' + iconClass + ' mr-3';
                
                const messageSpan = document.createElement('span');
                messageSpan.className = 'flex-1';
                messageSpan.textContent = message; // Use textContent to prevent XSS
                
                const closeButton = document.createElement('button');
                closeButton.className = 'ml-4 text-white hover:text-gray-200';
                closeButton.onclick = function() { this.parentElement.parentElement.remove(); };
                
                const closeIcon = document.createElement('i');
                closeIcon.className = 'fas fa-times';
                closeButton.appendChild(closeIcon);
                
                container.appendChild(icon);
                container.appendChild(messageSpan);
                container.appendChild(closeButton);
                
                notification.appendChild(container);
                
                document.body.appendChild(notification);
                
                // Auto remove after 5 seconds
                setTimeout(() => {
                    if (notification.parentElement) {
                        notification.style.opacity = '0';
                        notification.style.transform = 'translateX(100%)';
                        setTimeout(() => {
                            if (notification.parentElement) {
                                notification.remove();
                            }
                        }, 300);
                    }
                }, 5000);
            }
        });
    </script>
}