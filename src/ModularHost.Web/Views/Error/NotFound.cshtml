@model MRCMS.Models.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Page Not Found";
    Layout = "_Layout";
}

<div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="max-w-2xl w-full text-center">
        <div class="mb-8">
            <div class="relative">
                <div class="text-9xl font-bold text-gray-200 dark:text-gray-700">404</div>
                <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2">
                    <i class="fas fa-search text-6xl text-gray-400 dark:text-gray-600"></i>
                </div>
            </div>
        </div>
        
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Oops! Page Not Found
        </h1>
        
        <p class="text-xl text-gray-600 dark:text-gray-400 mb-8">
            The page you're looking for doesn't exist or has been moved.
        </p>
        
        @if (!string.IsNullOrEmpty(Model.RequestedPath))
        {
            <div class="bg-gray-100 dark:bg-gray-800 rounded-lg p-4 mb-8 max-w-md mx-auto">
                <p class="text-sm text-gray-600 dark:text-gray-400">
                    You were looking for:
                </p>
                <code class="text-red-600 dark:text-red-400 text-sm break-all">@Model.RequestedPath</code>
            </div>
        }
        
        <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a href="/" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-200 inline-flex items-center justify-center">
                <i class="fas fa-home mr-2"></i>Go to Homepage
            </a>
            <button onclick="history.back()" class="px-6 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition duration-200 inline-flex items-center justify-center">
                <i class="fas fa-arrow-left mr-2"></i>Go Back
            </button>
        </div>
        
        <div class="mt-12 p-6 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
                <i class="fas fa-lightbulb mr-2 text-yellow-500"></i>Here are some helpful links:
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
                <a href="/" class="flex items-center text-blue-600 dark:text-blue-400 hover:underline">
                    <i class="fas fa-home mr-2"></i>Homepage
                </a>
                <a href="/Blog" class="flex items-center text-blue-600 dark:text-blue-400 hover:underline">
                    <i class="fas fa-blog mr-2"></i>Blog
                </a>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a href="/Account/Profile" class="flex items-center text-blue-600 dark:text-blue-400 hover:underline">
                        <i class="fas fa-user mr-2"></i>My Profile
                    </a>
                    <a href="/Home" class="flex items-center text-blue-600 dark:text-blue-400 hover:underline">
                        <i class="fas fa-tachometer-alt mr-2"></i>Dashboard
                    </a>
                }
                else
                {
                    <a href="/Account/Login" class="flex items-center text-blue-600 dark:text-blue-400 hover:underline">
                        <i class="fas fa-sign-in-alt mr-2"></i>Login
                    </a>
                    <a href="/Account/Register" class="flex items-center text-blue-600 dark:text-blue-400 hover:underline">
                        <i class="fas fa-user-plus mr-2"></i>Register
                    </a>
                }
            </div>
        </div>
    </div>
</div>