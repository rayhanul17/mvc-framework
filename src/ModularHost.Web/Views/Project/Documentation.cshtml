        display: block;
    }
    
    .tab-content.hidden {
        display: none;
    }
    
    .tab-button {
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .tab-button.active {
        border-color: #3b82f6 !important;
        color: #3b82f6 !important;
    }
</style>

<script>
    function showTab(tabName) {
        // Hide all tab contents
        document.querySelectorAll('.tab-content').forEach(content => {
            content.classList.add('hidden');
        });
        
        // Remove active class from all tab buttons
        document.querySelectorAll('.tab-button').forEach(button => {
            button.classList.remove('active');
            button.classList.remove('border-primary-500', 'text-primary-600');
            button.classList.add('border-transparent', 'text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300');
        });
        
        // Show selected tab content
        if (tabName === 'developer') {
            document.getElementById('developer-content').classList.remove('hidden');
            document.getElementById('developer-tab').classList.add('active');
            document.getElementById('developer-tab').classList.remove('border-transparent', 'text-gray-500');
            document.getElementById('developer-tab').classList.add('border-primary-500', 'text-primary-600');
        } else if (tabName === 'user-guide') {
            document.getElementById('user-guide-content').classList.remove('hidden');
            document.getElementById('user-guide-tab').classList.add('active');
            document.getElementById('user-guide-tab').classList.remove('border-transparent', 'text-gray-500');
            document.getElementById('user-guide-tab').classList.add('border-primary-500', 'text-primary-600');
        }
    }
    
    // Initialize with developer tab active
    document.addEventListener('DOMContentLoaded', function() {
        showTab('developer');
    });
</script>