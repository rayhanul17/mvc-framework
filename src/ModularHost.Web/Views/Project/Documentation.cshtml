        <!-- User Guide Sections -->
        <div class="space-y-8">
            <!-- Permission Management -->
            <section id="permission-management" class="card-elevated">
                <div class="card-header">
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
                        <i class="fas fa-shield-alt text-success-500 mr-2"></i>Permission Management Guide
                    </h2>
                </div>
                <div class="card-body">
                    <div class="prose dark:prose-invert max-w-none">
                        <p class="text-lg mb-6">Learn how to manage user permissions in the system using our comprehensive permission management interface.</p>
                        
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                            <div class="space-y-6">
                                <div>
                                    <h3 class="text-xl font-semibold mb-4 text-primary-600 dark:text-primary-400">
                                        <i class="fas fa-plus-circle mr-2"></i>Creating Single Permissions
                                    </h3>
                                    <div class="bg-blue-50 dark:bg-blue-900/20 p-4 rounded-lg mb-4">
                                        <p class="text-sm text-blue-800 dark:text-blue-200 mb-3">
                                            <i class="fas fa-route mr-2"></i><strong>Navigation:</strong> Go to Role Permissions → Create Permission
                                        </p>
                                        <p class="text-xs text-blue-700 dark:text-blue-300">URL: <code>/RolePermission/Create</code></p>
                                    </div>
                                    
                                    <div class="space-y-4">
                                        <div class="border-l-4 border-green-500 pl-4">
                                            <h4 class="font-medium text-green-700 dark:text-green-400">Step 1: Select Roles</h4>
                                            <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                                                Choose one or more roles from the scrollable checkbox list. You can assign the same permission to multiple roles at once.
                                            </p>
                                        </div>
                                        
                                        <div class="border-l-4 border-blue-500 pl-4">
                                            <h4 class="font-medium text-blue-700 dark:text-blue-400">Step 2: Define Permission</h4>
                                            <ul class="text-sm text-gray-600 dark:text-gray-400 mt-2 space-y-1">
                                                <li>• <strong>Permission Name:</strong> e.g., "Product Management"</li>
                                                <li>• <strong>URL Pattern:</strong> e.g., "/product/*" (supports wildcards)</li>
                                                <li>• <strong>HTTP Method:</strong> GET, POST, PUT, DELETE, or * (all)</li>
                                                <li>• <strong>Description:</strong> Explain what this permission allows</li>
                                            </ul>
                                        </div>
                                        
                                        <div class="border-l-4 border-purple-500 pl-4">
                                            <h4 class="font-medium text-purple-700 dark:text-purple-400">Quick Fill Options</h4>
                                            <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                                                Use the pre-defined buttons like "Admin Dashboard", "User Management" to auto-fill common permissions.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                
                                <div>
                                    <h3 class="text-xl font-semibold mb-4 text-warning-600 dark:text-warning-400">
                                        <i class="fas fa-layer-group mr-2"></i>Bulk Assignment
                                    </h3>
                                    <div class="bg-amber-50 dark:bg-amber-900/20 p-4 rounded-lg mb-4">
                                        <p class="text-sm text-amber-800 dark:text-amber-200 mb-2">
                                            <i class="fas fa-route mr-2"></i><strong>Navigation:</strong> Go to Role Permissions → Bulk Assign
                                        </p>
                                        <p class="text-xs text-amber-700 dark:text-amber-300">URL: <code>/RolePermission/BulkAssign</code></p>
                                    </div>
                                    
                                    <div class="grid grid-cols-3 gap-4 mb-4">
                                        <div class="text-center">
                                            <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center mx-auto mb-2">
                                                <i class="fas fa-users text-blue-600 dark:text-blue-400"></i>
                                            </div>
                                            <p class="text-xs font-medium">Select Multiple Roles</p>
                                        </div>
                                        <div class="text-center">
                                            <div class="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center mx-auto mb-2">
                                                <i class="fas fa-link text-green-600 dark:text-green-400"></i>
                                            </div>
                                            <p class="text-xs font-medium">Choose URLs</p>
                                        </div>
                                        <div class="text-center">
                                            <div class="w-12 h-12 bg-yellow-100 dark:bg-yellow-900/30 rounded-lg flex items-center justify-center mx-auto mb-2">
                                                <i class="fas fa-code text-yellow-600 dark:text-yellow-400"></i>
                                            </div>
                                            <p class="text-xs font-medium">Select Methods</p>
                                        </div>
                                    </div>
                                    
                                    <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded-lg">
                                        <p class="text-sm text-gray-600 dark:text-gray-400">
                                            <i class="fas fa-calculator mr-2"></i><strong>Smart Calculation:</strong> 
                                            The system shows exactly how many permissions will be created (roles × URLs × methods)
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="space-y-6">
                                <div>
                                    <h3 class="text-xl font-semibold mb-4 text-info-600 dark:text-info-400">
                                        <i class="fas fa-edit mr-2"></i>Managing Existing Permissions
                                    </h3>
                                    
                                    <div class="bg-cyan-50 dark:bg-cyan-900/20 p-4 rounded-lg mb-4">
                                        <p class="text-sm text-cyan-800 dark:text-cyan-200 mb-2">
                                            <i class="fas fa-route mr-2"></i><strong>Navigation:</strong> Go to Role Permissions → View List
                                        </p>
                                        <p class="text-xs text-cyan-700 dark:text-cyan-300">URL: <code>/RolePermission</code></p>
                                    </div>
                                    
                                    <div class="space-y-4">
                                        <div class="flex items-start space-x-3 p-3 bg-gray-50 dark:bg-gray-800 rounded-lg">
                                            <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center">
                                                <i class="fas fa-eye text-blue-600 dark:text-blue-400 text-sm"></i>
                                            </div>
                                            <div>
                                                <p class="font-medium text-sm">View Permissions</p>
                                                <p class="text-xs text-gray-600 dark:text-gray-400">Browse all permissions with search and filtering</p>
                                            </div>
                                        </div>
                                        
                                        <div class="flex items-start space-x-3 p-3 bg-gray-50 dark:bg-gray-800 rounded-lg">
                                            <div class="w-8 h-8 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center">
                                                <i class="fas fa-edit text-green-600 dark:text-green-400 text-sm"></i>
                                            </div>
                                            <div>
                                                <p class="font-medium text-sm">Edit Permissions</p>
                                                <p class="text-xs text-gray-600 dark:text-gray-400">Modify role assignments, URLs, methods, and descriptions</p>
                                            </div>
                                        </div>
                                        
                                        <div class="flex items-start space-x-3 p-3 bg-gray-50 dark:bg-gray-800 rounded-lg">
                                            <div class="w-8 h-8 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center">
                                                <i class="fas fa-trash text-red-600 dark:text-red-400 text-sm"></i>
                                            </div>
                                            <div>
                                                <p class="font-medium text-sm">Delete Permissions</p>
                                                <p class="text-xs text-gray-600 dark:text-gray-400">Remove permissions with impact assessment warnings</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div>
                                    <h3 class="text-xl font-semibold mb-4 text-red-600 dark:text-red-400">
                                        <i class="fas fa-exclamation-triangle mr-2"></i>Important Notes
                                    </h3>
                                    
                                    <div class="space-y-3">
                                        <div class="bg-red-50 dark:bg-red-900/20 p-3 rounded-lg">
                                            <h4 class="font-medium text-red-800 dark:text-red-300 text-sm mb-1">Immediate Effect</h4>
                                            <p class="text-xs text-red-700 dark:text-red-400">All permission changes are active immediately and affect user access instantly.</p>
                                        </div>
                                        
                                        <div class="bg-yellow-50 dark:bg-yellow-900/20 p-3 rounded-lg">
                                            <h4 class="font-medium text-yellow-800 dark:text-yellow-300 text-sm mb-1">Cache Management</h4>
                                            <p class="text-xs text-yellow-700 dark:text-yellow-400">The system automatically clears user permission cache when permissions are modified.</p>
                                        </div>
                                        
                                        <div class="bg-blue-50 dark:bg-blue-900/20 p-3 rounded-lg">
                                            <h4 class="font-medium text-blue-800 dark:text-blue-300 text-sm mb-1">URL Patterns</h4>
                                            <p class="text-xs text-blue-700 dark:text-blue-400">Use wildcards (*) for flexible matching. Example: "/admin/*" matches all admin pages.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Examples Section -->
                        <div class="mt-8 p-6 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-lg">
                            <h3 class="text-xl font-semibold mb-4 text-indigo-800 dark:text-indigo-300">
                                <i class="fas fa-lightbulb mr-2"></i>Common Permission Examples
                            </h3>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <h4 class="font-medium text-indigo-700 dark:text-indigo-400 mb-3">Basic Admin Permissions</h4>
                                    <div class="space-y-2 text-sm">
                                        <div class="flex justify-between items-center p-2 bg-white dark:bg-gray-800 rounded">
                                            <span>Admin Dashboard</span>
                                            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded">/admin - GET</code>
                                        </div>
                                        <div class="flex justify-between items-center p-2 bg-white dark:bg-gray-800 rounded">
                                            <span>User Management</span>
                                            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded">/user/* - *</code>
                                        </div>
                                        <div class="flex justify-between items-center p-2 bg-white dark:bg-gray-800 rounded">
                                            <span>View Reports</span>
                                            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded">/reports/* - GET</code>
                                        </div>
                                    </div>
                                </div>
                                
                                <div>
                                    <h4 class="font-medium text-indigo-700 dark:text-indigo-400 mb-3">Content Management</h4>
                                    <div class="space-y-2 text-sm">
                                        <div class="flex justify-between items-center p-2 bg-white dark:bg-gray-800 rounded">
                                            <span>Blog Management</span>
                                            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded">/blog/* - *</code>
                                        </div>
                                        <div class="flex justify-between items-center p-2 bg-white dark:bg-gray-800 rounded">
                                            <span>Category Access</span>
