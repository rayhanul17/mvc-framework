                                <div class="w-4 h-4 bg-primary-500 rounded-full mr-3"></div>
                                <div>
                                    <strong>Presentation Layer</strong> - Controllers, Views, ViewModels
                                </div>
                            </div>
                            <div class="flex items-center p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                                <div class="w-4 h-4 bg-success-500 rounded-full mr-3"></div>
                                <div>
                                    <strong>Business Layer</strong> - Services, Business Logic
                                </div>
                            </div>
