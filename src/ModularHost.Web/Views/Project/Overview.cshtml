                                <div class="w-4 h-4 bg-warning-500 rounded-full mr-3"></div>
                                <div>
                                    <strong>Data Layer</strong> - Repositories, Entity Framework
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

