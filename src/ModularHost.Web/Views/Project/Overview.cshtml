                <div class="card-header">
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
                        <i class="fas fa-puzzle-piece text-info-500 mr-2"></i>Module Development
                    </h2>
                </div>
                <div class="card-body">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <h3 class="text-lg font-semibold mb-3">Creating a New Module</h3>
                            <div class="bg-gray-900 dark:bg-gray-800 rounded-lg p-4 text-sm">
                                <pre class="text-green-400"><code>// 1. Create module folder structure
/Modules/YourModule/
  /Controllers/
  /Views/
  /Models/
  /Services/

// 2. Implement IModule interface
public class YourModule : IModule
{
    public string Name => "Your Module";
    public void ConfigureServices(IServiceCollection services) { }
}</code></pre>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold mb-3">Module Registration</h3>
                            <div class="bg-gray-900 dark:bg-gray-800 rounded-lg p-4 text-sm">
                                <pre class="text-green-400"><code>// Register in Program.cs
builder.Services.AddModule&lt;YourModule&gt;();

// Or auto-discover modules
builder.Services.AddModulesFromAssembly(
    Assembly.GetExecutingAssembly()
);</code></pre>
                            </div>
                        </div>
                    </div>
                </div>
