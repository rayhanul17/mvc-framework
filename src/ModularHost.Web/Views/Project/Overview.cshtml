                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <h3 class="text-lg font-semibold mb-3">.NET Commands</h3>
                            <div class="space-y-2 text-sm">
                                <div class="bg-gray-100 dark:bg-gray-700 p-2 rounded font-mono">dotnet restore</div>
                                <div class="bg-gray-100 dark:bg-gray-700 p-2 rounded font-mono">dotnet build</div>
                                <div class="bg-gray-100 dark:bg-gray-700 p-2 rounded font-mono">dotnet run</div>
                                <div class="bg-gray-100 dark:bg-gray-700 p-2 rounded font-mono">dotnet ef database update</div>
                            </div>
                        </div>
