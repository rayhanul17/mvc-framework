                                    <li>ASP.NET Core 8</li>
                                    <li>Entity Framework</li>
                                    <li>MySQL/MongoDB</li>
                                </ul>
                            </div>
                            <div class="p-3 bg-gradient-to-r from-green-50 to-green-100 dark:from-green-900/20 dark:to-green-800/20 rounded-lg">
                                <div class="flex items-center mb-2">
                                    <i class="fab fa-js-square text-green-600 text-2xl mr-2"></i>
                                    <span class="font-semibold">Frontend</span>
                                </div>
                                <ul class="text-sm text-gray-600 dark:text-gray-400">
                                    <li>Tailwind CSS</li>
                                    <li>JavaScript ES6+</li>
                                    <li>Font Awesome</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Key Features -->
