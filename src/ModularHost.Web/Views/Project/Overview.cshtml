@{
    ViewData["Title"] = "Project Overview";
}

<div class="container mx-auto px-4 py-8 animate-fade-in">
    <!-- Page Header -->
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">
            <i class="fas fa-project-diagram text-primary-500 mr-3"></i>
            Modular Host CMS
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-400">
            A modern, modular content management system built with ASP.NET Core and Tailwind CSS
        </p>
    </div>

    <!-- Tab Navigation -->
    <div class="mb-8">
        <div class="border-b border-gray-200 dark:border-gray-700">
            <nav class="-mb-px flex space-x-8">
                <button class="tab-button active py-4 px-6 text-sm font-medium border-b-2 border-primary-500 text-primary-600 dark:text-primary-400 focus:outline-none"
                        onclick="showTab('overview')">
                    <i class="fas fa-eye mr-2"></i>Project Overview
                </button>
                <button class="tab-button py-4 px-6 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300 focus:outline-none"
