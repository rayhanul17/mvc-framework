@model MRCMS.Models.ViewModels.PrivacySettingsViewModel
@{
    ViewData["Title"] = "Privacy Settings";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
        <div class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Privacy Settings</h1>
            <p class="text-gray-600 dark:text-gray-400 mt-2">Configure privacy and data protection settings</p>
        </div>

        <form asp-action="Privacy" method="post">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow">
                <!-- Cookie Consent -->
                <div class="p-6 border-b border-gray-200 dark:border-gray-700">
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
                        <i class="fas fa-cookie-bite mr-2 text-yellow-600"></i>Cookie Consent
                    </h2>
                    
                    <div class="space-y-4">
                        <label class="flex items-center">
                            <input asp-for="EnableCookieConsent" type="checkbox" class="form-checkbox mr-2" />
                            <span class="text-gray-700 dark:text-gray-300">Enable Cookie Consent Banner</span>
                        </label>
                        
                        <div>
                            <label asp-for="CookieConsentMessage" class="form-label">Consent Message</label>
                            <textarea asp-for="CookieConsentMessage" rows="3" class="form-input"></textarea>
                        </div>
                    </div>
                </div>

                <!-- GDPR Compliance -->
                <div class="p-6 border-b border-gray-200 dark:border-gray-700">
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
                        <i class="fas fa-shield-alt mr-2 text-blue-600"></i>Data Protection
                    </h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <label class="flex items-center">
                            <input asp-for="EnableGdprCompliance" type="checkbox" class="form-checkbox mr-2" />
                            <span class="text-gray-700 dark:text-gray-300">Enable GDPR Compliance</span>
                        </label>
                        
                        <label class="flex items-center">
                            <input asp-for="AllowUserDataExport" type="checkbox" class="form-checkbox mr-2" />
                            <span class="text-gray-700 dark:text-gray-300">Allow User Data Export</span>
                        </label>
                        
                        <label class="flex items-center">
                            <input asp-for="AllowUserDataDeletion" type="checkbox" class="form-checkbox mr-2" />
                            <span class="text-gray-700 dark:text-gray-300">Allow User Data Deletion</span>
                        </label>
                        
                        <label class="flex items-center">
                            <input asp-for="CollectAnonymousStatistics" type="checkbox" class="form-checkbox mr-2" />
                            <span class="text-gray-700 dark:text-gray-300">Collect Anonymous Statistics</span>
                        </label>
                    </div>
                    
                    <div class="mt-4">
                        <label asp-for="DataRetentionDays" class="form-label">Data Retention Period (days)</label>
                        <input asp-for="DataRetentionDays" type="number" min="30" max="3650" class="form-input" />
                    </div>
                </div>

                <!-- Legal Documents -->
                <div class="p-6 border-b border-gray-200 dark:border-gray-700">
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
                        <i class="fas fa-file-contract mr-2 text-green-600"></i>Legal Documents
                    </h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label asp-for="PrivacyPolicyUrl" class="form-label">Privacy Policy URL</label>
                            <input asp-for="PrivacyPolicyUrl" type="url" class="form-input" placeholder="/privacy-policy" />
                        </div>
                        
                        <div>
                            <label asp-for="TermsOfServiceUrl" class="form-label">Terms of Service URL</label>
                            <input asp-for="TermsOfServiceUrl" type="url" class="form-input" placeholder="/terms" />
                        </div>
                    </div>
                </div>

                <!-- Analytics -->
                <div class="p-6 border-b border-gray-200 dark:border-gray-700">
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
                        <i class="fas fa-chart-line mr-2 text-purple-600"></i>Analytics
                    </h2>
                    
                    <div class="space-y-4">
                        <label class="flex items-center">
                            <input asp-for="EnableThirdPartyAnalytics" type="checkbox" class="form-checkbox mr-2" />
                            <span class="text-gray-700 dark:text-gray-300">Enable Third-Party Analytics</span>
                        </label>
                        
                        <div>
                            <label asp-for="AnalyticsTrackingId" class="form-label">Analytics Tracking ID</label>
                            <input asp-for="AnalyticsTrackingId" type="text" class="form-input" placeholder="UA-XXXXXXXXX-X" />
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="p-6 bg-gray-50 dark:bg-gray-900/50">
                    <div class="flex justify-end space-x-3">
                        <a asp-action="Index" class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700">Cancel</a>
                        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                            <i class="fas fa-save mr-2"></i>Save Settings
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>