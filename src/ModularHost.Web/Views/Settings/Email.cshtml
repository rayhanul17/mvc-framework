@model MRCMS.Models.ViewModels.EmailSettingsViewModel
@{
    ViewData["Title"] = "Email Settings";
}

<div class="container mx-auto max-w-4xl">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Email Settings</h1>
                <p class="text-gray-600 dark:text-gray-400 mt-2">Configure SMTP settings for sending emails</p>
            </div>
            <a asp-action="Index" class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100">
                <i class="fas fa-arrow-left mr-2"></i>Back to Settings
            </a>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
        </div>
    }
    
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
        </div>
    }

    <!-- Settings Form -->
    <form asp-action="Email" method="post">
        <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>
        
        <!-- SMTP Configuration -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-4">SMTP Configuration</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="SmtpHost" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"></label>
                    <input asp-for="SmtpHost" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
                    <span asp-validation-for="SmtpHost" class="text-red-600 text-sm"></span>
                </div>
                
                <div>
                    <label asp-for="SmtpPort" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"></label>
                    <input asp-for="SmtpPort" type="number" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
                    <span asp-validation-for="SmtpPort" class="text-red-600 text-sm"></span>
                </div>
                
                <div>
                    <label asp-for="SmtpUsername" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"></label>
                    <input asp-for="SmtpUsername" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
                    <span asp-validation-for="SmtpUsername" class="text-red-600 text-sm"></span>
                </div>
                
                <div>
                    <label asp-for="SmtpPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"></label>
                    <input asp-for="SmtpPassword" type="password" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
                    <span asp-validation-for="SmtpPassword" class="text-red-600 text-sm"></span>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Leave blank to keep existing password</p>
                </div>
            </div>
            
            <div class="mt-4">
                <div class="flex items-center">
                    <input asp-for="UseSsl" type="checkbox" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" />
                    <label asp-for="UseSsl" class="ml-2 block text-sm text-gray-700 dark:text-gray-300">
                        Use SSL/TLS encryption
                    </label>
                </div>
                <span asp-validation-for="UseSsl" class="text-red-600 text-sm"></span>
            </div>
        </div>

        <!-- Email Settings -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-4">Email Settings</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="FromEmail" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"></label>
                    <input asp-for="FromEmail" type="email" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
                    <span asp-validation-for="FromEmail" class="text-red-600 text-sm"></span>
                </div>
                
                <div>
                    <label asp-for="FromName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"></label>
                    <input asp-for="FromName" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
                    <span asp-validation-for="FromName" class="text-red-600 text-sm"></span>
                </div>
                
                <div>
                    <label asp-for="AdminEmail" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"></label>
                    <input asp-for="AdminEmail" type="email" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
                    <span asp-validation-for="AdminEmail" class="text-red-600 text-sm"></span>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">System notifications will be sent to this address</p>
                </div>
                
                <div>
                    <label asp-for="SupportEmail" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"></label>
                    <input asp-for="SupportEmail" type="email" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
                    <span asp-validation-for="SupportEmail" class="text-red-600 text-sm"></span>
                </div>
            </div>
        </div>

        <!-- Email Features -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-4">Email Features</h2>
            
            <div class="space-y-4">
                <div>
                    <div class="flex items-center">
                        <input asp-for="EnableEmailNotifications" type="checkbox" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" />
                        <label asp-for="EnableEmailNotifications" class="ml-2 block text-sm text-gray-700 dark:text-gray-300">
                            Enable email notifications
                        </label>
                    </div>
                    <span asp-validation-for="EnableEmailNotifications" class="text-red-600 text-sm"></span>
                </div>
                
                <div>
                    <div class="flex items-center">
                        <input asp-for="SendWelcomeEmail" type="checkbox" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" />
                        <label asp-for="SendWelcomeEmail" class="ml-2 block text-sm text-gray-700 dark:text-gray-300">
                            Send welcome email to new users
                        </label>
                    </div>
                    <span asp-validation-for="SendWelcomeEmail" class="text-red-600 text-sm"></span>
                </div>
                
                <div>
                    <div class="flex items-center">
                        <input asp-for="SendAdminNotifications" type="checkbox" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" />
                        <label asp-for="SendAdminNotifications" class="ml-2 block text-sm text-gray-700 dark:text-gray-300">
                            Send admin notifications for important events
                        </label>
                    </div>
                    <span asp-validation-for="SendAdminNotifications" class="text-red-600 text-sm"></span>
                </div>
            </div>
        </div>

        <!-- Test Email -->
        <div class="bg-blue-50 dark:bg-blue-900 border-l-4 border-blue-400 p-4 mb-6">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i class="fas fa-info-circle text-blue-400"></i>
                </div>
                <div class="ml-3">
                    <p class="text-sm text-blue-700 dark:text-blue-200">
                        After saving your settings, you can test the email configuration by clicking the "Send Test Email" button.
                    </p>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex justify-between">
            <button type="button" onclick="sendTestEmail()" class="px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600">
                <i class="fas fa-paper-plane mr-2"></i>Send Test Email
            </button>
            
            <div class="flex space-x-3">
                <a asp-action="Index" class="px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700">
                    Cancel
                </a>
                <button type="submit" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">
                    <i class="fas fa-save mr-2"></i>Save Settings
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        function sendTestEmail() {
            const testEmailAddress = prompt('Enter email address to send test email to:');
            
            if (testEmailAddress) {
                fetch('/Settings/TestEmail', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ email: testEmailAddress })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Test email sent successfully!');
                    } else {
                        alert('Failed to send test email: ' + data.message);
                    }
                })
                .catch(error => {
                    alert('An error occurred while sending test email');
                });
            }
        }
    </script>
}