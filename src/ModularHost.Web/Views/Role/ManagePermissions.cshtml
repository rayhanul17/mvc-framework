@model MRCMS.Models.ViewModels.ManagePermissionsViewModel
@{
    ViewData["Title"] = $"Manage Permissions - {Model.RoleName}";
}

<div class="container mx-auto">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Manage Permissions</h1>
                <p class="text-gray-600 dark:text-gray-400 mt-2">Configure permissions for role: <span class="font-semibold">@Model.RoleName</span></p>
            </div>
            <a asp-action="Index" class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100">
                <i class="fas fa-arrow-left mr-2"></i>Back to Roles
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Add Permission Form -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold mb-4 text-gray-900 dark:text-gray-100">Add New Permission</h2>
            
            <form asp-action="AddPermission" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="roleId" value="@Model.RoleId" />
                
                <!-- URL Pattern -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">URL Pattern</label>
                    <input type="text" name="url" placeholder="/Controller/Action or /Controller/*" 
                           class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" required />
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Use * for wildcard matching</p>
                </div>

                <!-- HTTP Method -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">HTTP Method</label>
                    <select name="httpMethod" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" required>
                        <option value="*">All Methods</option>
                        <option value="GET">GET</option>
                        <option value="POST">POST</option>
                        <option value="PUT">PUT</option>
                        <option value="DELETE">DELETE</option>
                    </select>
                </div>

                <!-- Description -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Description</label>
                    <input type="text" name="description" placeholder="Permission description" 
                           class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
                </div>

                <!-- Quick Add from Menus -->
                @if (Model.AvailableMenus.Any())
                {
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Quick Add from Menu</label>
                        <select id="menuSelect" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white">
                            <option value="">-- Select a menu item --</option>
                            @foreach (var menu in Model.AvailableMenus.OrderBy(m => m.Order))
                            {
                                <option value="@menu.Url" data-name="@menu.Title">@menu.Title - @menu.Url</option>
                            }
                        </select>
                    </div>
                }

                <button type="submit" class="w-full px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">
                    <i class="fas fa-plus mr-2"></i>Add Permission
                </button>
            </form>
        </div>

        <!-- Current Permissions -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold mb-4 text-gray-900 dark:text-gray-100">
                Current Permissions 
                <span class="text-sm font-normal text-gray-500 dark:text-gray-400">(@Model.Permissions.Count)</span>
            </h2>
            
            @if (!Model.Permissions.Any())
            {
                <div class="text-center py-8 text-gray-500 dark:text-gray-400">
                    <i class="fas fa-lock text-4xl mb-3 block"></i>
                    <p>No permissions configured yet</p>
                </div>
            }
            else
            {
                <div class="space-y-2 max-h-96 overflow-y-auto">
                    @foreach (var permission in Model.Permissions.OrderBy(p => p.Url))
                    {
                        <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                            <div class="flex-1">
                                <div class="flex items-center space-x-2">
                                    <span class="text-sm font-medium text-gray-900 dark:text-gray-100">@permission.Url</span>
                                    <span class="px-2 py-1 text-xs rounded-full 
                                           @(permission.HttpMethod == "*" ? "bg-gray-200 text-gray-700 dark:bg-gray-600 dark:text-gray-300" : 
                                             permission.HttpMethod == "GET" ? "bg-green-100 text-green-800 dark:bg-green-800 dark:text-green-200" :
                                             permission.HttpMethod == "POST" ? "bg-blue-100 text-blue-800 dark:bg-blue-800 dark:text-blue-200" :
                                             permission.HttpMethod == "DELETE" ? "bg-red-100 text-red-800 dark:bg-red-800 dark:text-red-200" :
                                             "bg-yellow-100 text-yellow-800 dark:bg-yellow-800 dark:text-yellow-200")">
                                        @permission.HttpMethod
                                    </span>
                                </div>
                                @if (!string.IsNullOrEmpty(permission.Description))
                                {
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">@permission.Description</p>
                                }
                            </div>
                            <form asp-action="RemovePermission" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="permissionId" value="@permission.Id" />
                                <input type="hidden" name="roleId" value="@Model.RoleId" />
                                <button type="submit" class="text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300"
                                        onclick="return confirm('Remove this permission?');">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Common Permission Sets -->
    <div class="mt-6 bg-blue-50 dark:bg-blue-900 border-l-4 border-blue-400 p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <i class="fas fa-lightbulb text-blue-400"></i>
            </div>
            <div class="ml-3">
                <h3 class="text-sm font-medium text-blue-800 dark:text-blue-200">Common Permission Patterns</h3>
                <div class="mt-2 text-sm text-blue-700 dark:text-blue-300">
                    <ul class="list-disc list-inside space-y-1">
                        <li><code>/User/*</code> - All user management actions</li>
                        <li><code>/Blog/Create</code> - Create blog posts only</li>
                        <li><code>/Admin/*</code> - Full admin access</li>
                        <li><code>/Reports/View</code> - View reports only</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-fill form from menu selection
        document.getElementById('menuSelect')?.addEventListener('change', function() {
            if (this.value) {
                document.querySelector('input[name="url"]').value = this.value;
                document.querySelector('input[name="description"]').value = 'Access to ' + this.options[this.selectedIndex].dataset.name;
            }
        });
    </script>
}