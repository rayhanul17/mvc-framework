@{
    ViewData["Title"] = "Reports";
}

<div class="container mx-auto">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Reports & Analytics</h1>
        <p class="text-gray-600 dark:text-gray-400 mt-2">View system reports and analytics dashboards</p>
    </div>

    <!-- Reports Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- User Activity Report -->
        <a asp-action="UserActivity" class="block">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
                <div class="flex items-center mb-4">
                    <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center">
                        <i class="fas fa-users text-blue-600 dark:text-blue-400 text-xl"></i>
                    </div>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">User Activity</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">User registrations, logins, and activity metrics</p>
                <div class="mt-4 flex items-center text-sm text-blue-600 dark:text-blue-400">
                    <span>View Report</span>
                    <i class="fas fa-arrow-right ml-2"></i>
                </div>
            </div>
        </a>

        <!-- Blog Statistics -->
        <a asp-action="BlogStats" class="block">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
                <div class="flex items-center mb-4">
                    <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center">
                        <i class="fas fa-blog text-green-600 dark:text-green-400 text-xl"></i>
                    </div>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">Blog Statistics</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">Posts, comments, views, and engagement metrics</p>
                <div class="mt-4 flex items-center text-sm text-green-600 dark:text-green-400">
                    <span>View Report</span>
                    <i class="fas fa-arrow-right ml-2"></i>
                </div>
            </div>
        </a>

        <!-- System Performance -->
        <a asp-action="SystemPerformance" class="block">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
                <div class="flex items-center mb-4">
                    <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center">
                        <i class="fas fa-tachometer-alt text-purple-600 dark:text-purple-400 text-xl"></i>
                    </div>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">System Performance</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">Response times, resource usage, and errors</p>
                <div class="mt-4 flex items-center text-sm text-purple-600 dark:text-purple-400">
                    <span>View Report</span>
                    <i class="fas fa-arrow-right ml-2"></i>
                </div>
            </div>
        </a>

        <!-- Audit Logs -->
        <a asp-action="AuditLogs" class="block">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
                <div class="flex items-center mb-4">
                    <div class="w-12 h-12 bg-yellow-100 dark:bg-yellow-900 rounded-lg flex items-center justify-center">
                        <i class="fas fa-history text-yellow-600 dark:text-yellow-400 text-xl"></i>
                    </div>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">Audit Logs</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">System events and user activity logs</p>
                <div class="mt-4 flex items-center text-sm text-yellow-600 dark:text-yellow-400">
                    <span>View Report</span>
                    <i class="fas fa-arrow-right ml-2"></i>
                </div>
            </div>
        </a>

        <!-- Security Report -->
        <a asp-action="Security" class="block">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
                <div class="flex items-center mb-4">
                    <div class="w-12 h-12 bg-red-100 dark:bg-red-900 rounded-lg flex items-center justify-center">
                        <i class="fas fa-shield-alt text-red-600 dark:text-red-400 text-xl"></i>
                    </div>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">Security Report</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">Failed logins, security events, and threats</p>
                <div class="mt-4 flex items-center text-sm text-red-600 dark:text-red-400">
                    <span>View Report</span>
                    <i class="fas fa-arrow-right ml-2"></i>
                </div>
            </div>
        </a>

        <!-- Module Usage -->
        <a asp-action="ModuleUsage" class="block">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
                <div class="flex items-center mb-4">
                    <div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900 rounded-lg flex items-center justify-center">
                        <i class="fas fa-puzzle-piece text-indigo-600 dark:text-indigo-400 text-xl"></i>
                    </div>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">Module Usage</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">Module activation and usage statistics</p>
                <div class="mt-4 flex items-center text-sm text-indigo-600 dark:text-indigo-400">
                    <span>View Report</span>
                    <i class="fas fa-arrow-right ml-2"></i>
                </div>
            </div>
        </a>
    </div>

    <!-- Quick Stats -->
    <div class="mt-8 bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-4">Quick Statistics</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="text-center">
                <div class="text-3xl font-bold text-blue-600 dark:text-blue-400" id="totalUsers">-</div>
                <div class="text-sm text-gray-600 dark:text-gray-400">Total Users</div>
            </div>
            <div class="text-center">
                <div class="text-3xl font-bold text-green-600 dark:text-green-400" id="totalPosts">-</div>
                <div class="text-sm text-gray-600 dark:text-gray-400">Blog Posts</div>
            </div>
            <div class="text-center">
                <div class="text-3xl font-bold text-purple-600 dark:text-purple-400" id="todayLogins">-</div>
                <div class="text-sm text-gray-600 dark:text-gray-400">Today's Logins</div>
            </div>
            <div class="text-center">
                <div class="text-3xl font-bold text-yellow-600 dark:text-yellow-400" id="activeModules">-</div>
                <div class="text-sm text-gray-600 dark:text-gray-400">Active Modules</div>
            </div>
        </div>
    </div>

    <!-- Export Options -->
    <div class="mt-6 bg-blue-50 dark:bg-blue-900 border-l-4 border-blue-400 p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <i class="fas fa-info-circle text-blue-400"></i>
            </div>
            <div class="ml-3">
                <h3 class="text-sm font-medium text-blue-800 dark:text-blue-200">Export Reports</h3>
                <div class="mt-2 text-sm text-blue-700 dark:text-blue-300">
                    <p>All reports can be exported to PDF, Excel, or CSV format. Click on any report to view it and access export options.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load quick statistics
        document.addEventListener('DOMContentLoaded', function() {
            loadQuickStats();
        });
        
        function loadQuickStats() {
            // Simulated stats - replace with actual API calls
            document.getElementById('totalUsers').textContent = '1,234';
            document.getElementById('totalPosts').textContent = '456';
            document.getElementById('todayLogins').textContent = '89';
            document.getElementById('activeModules').textContent = '5';
        }
    </script>
}