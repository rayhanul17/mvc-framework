@model MRCMS.Core.Models.Entities.Menu
@{
    ViewData["Title"] = "Create Menu Item";
}

<div class="container mx-auto max-w-2xl">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Create Menu Item</h1>
                <p class="text-gray-600 dark:text-gray-400 mt-2">Add a new navigation menu item</p>
            </div>
            <a asp-action="Index" class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100">
                <i class="fas fa-arrow-left mr-2"></i>Back to Menus
            </a>
        </div>
    </div>

    <!-- Form -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>
            
            <div class="space-y-6">
                <!-- Title -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Title *</label>
                    <input asp-for="Title" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" required />
                    <span asp-validation-for="Title" class="text-red-600 text-sm"></span>
                </div>

                <!-- URL -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">URL *</label>
                    <input asp-for="Url" placeholder="/controller/action" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" required />
                    <span asp-validation-for="Url" class="text-red-600 text-sm"></span>
                </div>

                <!-- Active URL -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Active URL</label>
                    <input asp-for="ActiveUrl" placeholder="Leave empty to use the same as URL" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">URL to match for active menu highlighting (e.g., /Entity for /Entity/Manage pages)</p>
                    <span asp-validation-for="ActiveUrl" class="text-red-600 text-sm"></span>
                </div>

                <!-- Icon -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Icon</label>
                    <input asp-for="Icon" placeholder="fas fa-home" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Font Awesome class (e.g., fas fa-home, fas fa-users)</p>
                    <span asp-validation-for="Icon" class="text-red-600 text-sm"></span>
                </div>

                <!-- Parent Menu -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Parent Menu</label>
                    <select asp-for="ParentId" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white">
                        <option value="">-- No Parent (Top Level) --</option>
                        @if (ViewBag.ParentMenus != null)
                        {
                            @foreach (var parent in ViewBag.ParentMenus)
                            {
                                <option value="@parent.Id">@parent.Title</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="ParentId" class="text-red-600 text-sm"></span>
                </div>

                <!-- Order -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Display Order</label>
                    <input asp-for="Order" type="number" value="0" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Lower numbers appear first</p>
                    <span asp-validation-for="Order" class="text-red-600 text-sm"></span>
                </div>

                <!-- Module Name -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Module</label>
                    <input asp-for="ModuleName" placeholder="Leave empty for core menu" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
                    <span asp-validation-for="ModuleName" class="text-red-600 text-sm"></span>
                </div>


                <!-- Is Active -->
                <div>
                    <div class="flex items-center">
                        <input asp-for="IsActive" type="checkbox" checked class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" />
                        <label asp-for="IsActive" class="ml-2 block text-sm text-gray-700 dark:text-gray-300">
                            Active (Show in navigation)
                        </label>
                    </div>
                    <span asp-validation-for="IsActive" class="text-red-600 text-sm"></span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-8 flex justify-end space-x-3">
                <a asp-action="Index" class="px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700">
                    Cancel
                </a>
                <button type="submit" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">
                    <i class="fas fa-save mr-2"></i>Create Menu Item
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}