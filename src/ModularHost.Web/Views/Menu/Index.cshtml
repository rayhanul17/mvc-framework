@model IEnumerable<MRCMS.Core.Models.Entities.Menu>
@{
    ViewData["Title"] = "Menu Management";
}

<div class="container mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 space-y-4 md:space-y-0">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Menu Management</h1>
            <p class="text-gray-600 dark:text-gray-400 mt-2">Configure navigation menus and their hierarchical structure</p>
        </div>
        
        <a asp-action="Create" class="bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg transition duration-200 flex items-center">
            <i class="fas fa-plus mr-2"></i>Create Menu Item
        </a>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
        </div>
    }
    
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
        </div>
    }

    <!-- Menu Table -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-12 text-center text-gray-500 dark:text-gray-400">
                <i class="fas fa-bars text-6xl mb-4"></i>
                <h3 class="text-xl font-semibold mb-2">No Menu Items</h3>
                <p>Create your first menu item to build the navigation structure.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                    <thead class="bg-gray-50 dark:bg-gray-700">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Order</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Title</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">URL</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Icon</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Module</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                        @foreach (var menu in Model.OrderBy(m => m.Order))
                        {
                            var menuViewData = new ViewDataDictionary(Html.ViewData);
                            menuViewData["Level"] = 0;
                            @await Html.PartialAsync("_MenuRowPartial", menu, menuViewData)
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Info Box -->
    <div class="mt-6 bg-blue-50 dark:bg-blue-900 border-l-4 border-blue-400 p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <i class="fas fa-info-circle text-blue-400"></i>
            </div>
            <div class="ml-3">
                <h3 class="text-sm font-medium text-blue-800 dark:text-blue-200">Menu Structure Tips</h3>
                <div class="mt-2 text-sm text-blue-700 dark:text-blue-300">
                    <ul class="list-disc list-inside space-y-1">
                        <li>Set the order number to control menu item position</li>
                        <li>Create nested menus by selecting a parent menu (supports multiple levels)</li>
                        <li>Use Font Awesome icons (e.g., fas fa-home) for better visibility</li>
                        <li>Module-specific menus are automatically registered</li>
                        <li>Menus can have children, grandchildren, and deeper levels</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>