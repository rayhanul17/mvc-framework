@{
    ViewData["Title"] = "Locked out";
}

<div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-900 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div class="text-center">
            <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-red-100 dark:bg-red-900">
                <i class="fas fa-lock text-3xl text-red-600 dark:text-red-400"></i>
            </div>
            <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900 dark:text-white">
                Account Locked
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600 dark:text-gray-400">
                This account has been locked out due to multiple failed login attempts.
            </p>
            <p class="mt-4 text-center text-sm text-gray-600 dark:text-gray-400">
                Please try again later or contact support if you need immediate assistance.
            </p>
            <div class="mt-6 space-y-3">
                <a asp-action="ForgotPassword" class="block w-full px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-primary hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                    <i class="fas fa-key mr-2"></i>
                    Reset Password
                </a>
                <a asp-action="Login" class="block w-full px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <i class="fas fa-arrow-left mr-2"></i>
                    Back to Login
                </a>
            </div>
        </div>
    </div>
</div>