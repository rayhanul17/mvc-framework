@model MRCMS.Models.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">My Profile</h1>
            <p class="text-gray-600 dark:text-gray-400 mt-2">Manage your personal information and account settings</p>
        </div>

        <!-- Profile Card -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow">
            <!-- Profile Header -->
            <div class="bg-gradient-to-r from-blue-500 to-purple-600 rounded-t-lg p-6">
                <div class="flex items-center space-x-4">
                    <div class="relative">
                        <img src="@(Model?.ProfilePicture ?? "/img/default-avatar.png")" 
                             alt="@Model?.UserName" 
                             class="w-24 h-24 rounded-full border-4 border-white object-cover"
                             onerror="this.onerror=null; this.src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"%236b7280\"%3E%3Cpath d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z\"/%3E%3C/svg%3E'">
                        <button class="absolute bottom-0 right-0 bg-white dark:bg-gray-800 rounded-full p-1.5 shadow-lg">
                            <i class="fas fa-camera text-gray-600 dark:text-gray-400"></i>
                        </button>
                    </div>
                    <div class="text-white">
                        <h2 class="text-2xl font-bold">@(Model?.FirstName + " " + Model?.LastName)</h2>
                        <p class="text-blue-100">@@@Model?.UserName</p>
                        <p class="text-sm text-blue-200 mt-1">Member since @Model?.CreatedAt.ToString("MMMM yyyy")</p>
                    </div>
                </div>
            </div>

            <!-- Profile Form -->
            <form asp-action="Profile" method="post" class="p-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Personal Information -->
                    <div class="space-y-4">
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3">
                            <i class="fas fa-user mr-2 text-blue-600"></i>Personal Information
                        </h3>
                        
                        <div>
                            <label asp-for="FirstName" class="form-label">First Name</label>
                            <input asp-for="FirstName" class="form-input" />
                            <span asp-validation-for="FirstName" class="text-red-500 text-sm"></span>
                        </div>
                        
                        <div>
                            <label asp-for="LastName" class="form-label">Last Name</label>
                            <input asp-for="LastName" class="form-input" />
                            <span asp-validation-for="LastName" class="text-red-500 text-sm"></span>
                        </div>
                        
                        <div>
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" type="email" class="form-input" />
                            <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                        </div>
                        
                        <div>
                            <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                            <input asp-for="PhoneNumber" type="tel" class="form-input" />
                            <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm"></span>
                        </div>
                    </div>

                    <!-- Address Information -->
                    <div class="space-y-4">
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3">
                            <i class="fas fa-map-marker-alt mr-2 text-green-600"></i>Address Information
                        </h3>
                        
                        <div>
                            <label asp-for="Address" class="form-label">Street Address</label>
                            <input asp-for="Address" class="form-input" />
                            <span asp-validation-for="Address" class="text-red-500 text-sm"></span>
                        </div>
                        
                        <div>
                            <label asp-for="City" class="form-label">City</label>
                            <input asp-for="City" class="form-input" />
                            <span asp-validation-for="City" class="text-red-500 text-sm"></span>
                        </div>
                        
                        <div>
                            <label asp-for="Country" class="form-label">Country</label>
                            <input asp-for="Country" class="form-input" />
                            <span asp-validation-for="Country" class="text-red-500 text-sm"></span>
                        </div>
                        
                        <div>
                            <label asp-for="PostalCode" class="form-label">Postal Code</label>
                            <input asp-for="PostalCode" class="form-input" />
                            <span asp-validation-for="PostalCode" class="text-red-500 text-sm"></span>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="mt-6 pt-6 border-t dark:border-gray-700 flex justify-between items-center">
                    <div class="space-x-2">
                        <a asp-action="Settings" class="text-blue-600 hover:text-blue-700 dark:text-blue-400">
                            <i class="fas fa-cog mr-1"></i>Account Settings
                        </a>
                        <span class="text-gray-400">|</span>
                        <a asp-action="Manage" class="text-blue-600 hover:text-blue-700 dark:text-blue-400">
                            <i class="fas fa-shield-alt mr-1"></i>Security
                        </a>
                    </div>
                    
                    <div class="space-x-3">
                        <button type="button" onclick="history.back()" class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700">
                            Cancel
                        </button>
                        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                            <i class="fas fa-save mr-2"></i>Save Changes
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Quick Stats -->
        <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Account Status</p>
                        <p class="text-lg font-semibold text-green-600">Active</p>
                    </div>
                    <i class="fas fa-check-circle text-2xl text-green-600"></i>
                </div>
            </div>
            
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Email Verified</p>
                        <p class="text-lg font-semibold text-gray-900 dark:text-gray-100">@(Model?.EmailConfirmed ?? false ? "Yes" : "No")</p>
                    </div>
                    <i class="fas fa-envelope text-2xl text-blue-600"></i>
                </div>
            </div>
            
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Two-Factor Auth</p>
                        <p class="text-lg font-semibold text-gray-900 dark:text-gray-100">@(Model?.TwoFactorEnabled ?? false ? "Enabled" : "Disabled")</p>
                    </div>
                    <i class="fas fa-shield-alt text-2xl text-purple-600"></i>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}