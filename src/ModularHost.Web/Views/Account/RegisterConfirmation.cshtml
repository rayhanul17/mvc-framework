@model string
@{
    ViewData["Title"] = "Register confirmation";
}

<div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-900 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div class="text-center">
            <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-green-100 dark:bg-green-900">
                <i class="fas fa-envelope text-3xl text-green-600 dark:text-green-400"></i>
            </div>
            <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900 dark:text-white">
                Registration successful!
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600 dark:text-gray-400">
                Please check your email to confirm your account.
            </p>
            @if (!string.IsNullOrEmpty(Model))
            {
                <div class="mt-4 p-4 bg-gray-100 dark:bg-gray-800 rounded-lg">
                    <p class="text-sm text-gray-700 dark:text-gray-300">
                        A confirmation email has been sent to:
                    </p>
                    <p class="mt-1 font-medium text-gray-900 dark:text-white">
                        @Model
                    </p>
                </div>
            }
            <p class="mt-4 text-center text-xs text-gray-500 dark:text-gray-400">
                If you don't see the email, check your spam folder.
            </p>
            <div class="mt-6">
                <a asp-action="Login" class="font-medium text-primary hover:text-blue-500">
                    Back to Login
                </a>
            </div>
        </div>
    </div>
</div>