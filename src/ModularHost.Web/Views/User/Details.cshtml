@model MRCMS.Models.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "User Details";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="mb-6 flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">User Details</h1>
                <p class="text-gray-600 dark:text-gray-400 mt-2">View detailed information about this user</p>
            </div>
            <div class="space-x-2">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                    <i class="fas fa-edit mr-2"></i>Edit
                </a>
                <a asp-action="Index" class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700">
                    <i class="fas fa-arrow-left mr-2"></i>Back
                </a>
            </div>
        </div>

        <!-- User Profile Card -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow mb-6">
            <div class="bg-gradient-to-r from-blue-500 to-purple-600 rounded-t-lg p-6">
                <div class="flex items-center space-x-4">
                    <img src="@(Model?.ProfilePicture ?? "/img/default-avatar.png")" 
                         alt="@Model?.UserName" 
                         class="w-20 h-20 rounded-full border-4 border-white object-cover"
                         onerror="this.onerror=null; this.src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"%236b7280\"%3E%3Cpath d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z\"/%3E%3C/svg%3E'">
                    <div class="text-white">
                        <h2 class="text-2xl font-bold">@Model?.FirstName @Model?.LastName</h2>
                        <p class="text-blue-100">@@@Model?.UserName</p>
                    </div>
                </div>
            </div>

            <div class="p-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Personal Information -->
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3">
                            <i class="fas fa-user mr-2 text-blue-600"></i>Personal Information
                        </h3>
                        <dl class="space-y-2">
                            <div>
                                <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Email</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">
                                    @Model?.Email
                                    @if (Model?.EmailConfirmed ?? false)
                                    {
                                        <i class="fas fa-check-circle text-green-500 ml-1" title="Verified"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-times-circle text-red-500 ml-1" title="Not Verified"></i>
                                    }
                                </dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Phone Number</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">@(Model?.PhoneNumber ?? "Not provided")</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Address</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">@(Model?.Address ?? "Not provided")</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">City</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">@(Model?.City ?? "Not provided")</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Country</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">@(Model?.Country ?? "Not provided")</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Postal Code</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">@(Model?.PostalCode ?? "Not provided")</dd>
                            </div>
                        </dl>
                    </div>

                    <!-- Account Information -->
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3">
                            <i class="fas fa-shield-alt mr-2 text-green-600"></i>Account Information
                        </h3>
                        <dl class="space-y-2">
                            <div>
                                <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Account Status</dt>
                                <dd class="text-sm">
                                    @if (Model?.IsActive ?? false)
                                    {
                                        <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300">Active</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 text-xs rounded-full bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300">Inactive</span>
                                    }
                                </dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Two-Factor Authentication</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">
                                    @if (Model?.TwoFactorEnabled ?? false)
                                    {
                                        <span class="text-green-600"><i class="fas fa-check mr-1"></i>Enabled</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-500"><i class="fas fa-times mr-1"></i>Disabled</span>
                                    }
                                </dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Lockout Enabled</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">@(Model?.LockoutEnabled ?? false ? "Yes" : "No")</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Super Admin</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">
                                    @if (Model?.IsSuperAdmin ?? false)
                                    {
                                        <span class="text-red-600 font-semibold"><i class="fas fa-crown mr-1"></i>Yes</span>
                                    }
                                    else
                                    {
                                        <span>No</span>
                                    }
                                </dd>
                            </div>
                        </dl>
                    </div>
                </div>

                <!-- Roles -->
                <div class="mt-6 pt-6 border-t dark:border-gray-700">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3">
                        <i class="fas fa-users-cog mr-2 text-purple-600"></i>Assigned Roles
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        @if (Model?.SelectedRoles?.Any() ?? false)
                        {
                            @foreach (var role in Model.SelectedRoles)
                            {
                                <span class="px-3 py-1 bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-300 rounded-full text-sm">
                                    @role
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-gray-500 dark:text-gray-400">No roles assigned</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
            <div class="flex justify-between items-center">
                <div>
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        User ID: <code class="bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded">@Model?.Id</code>
                    </p>
                </div>
                <div class="space-x-3">
                    @if (Model?.IsActive ?? false)
                    {
                        <button onclick="toggleUserStatus('@Model.Id', false)" class="px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700">
                            <i class="fas fa-ban mr-2"></i>Deactivate User
                        </button>
                    }
                    else
                    {
                        <button onclick="toggleUserStatus('@Model?.Id', true)" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                            <i class="fas fa-check mr-2"></i>Activate User
                        </button>
                    }
                    
                    <a asp-action="Delete" asp-route-id="@Model?.Id" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">
                        <i class="fas fa-trash mr-2"></i>Delete User
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleUserStatus(userId, activate) {
            if (confirm(`Are you sure you want to ${activate ? 'activate' : 'deactivate'} this user?`)) {
                $.post('@Url.Action("ToggleStatus")', { 
                    id: userId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                })
                .done(function(data) {
                    if (data.success) {
                        location.reload();
                    } else {
                        toastr.error(data.message || 'Failed to update user status');
                    }
                });
            }
        }
    </script>
}