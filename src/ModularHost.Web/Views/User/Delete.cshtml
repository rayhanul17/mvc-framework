@model MRCMS.Models.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="min-h-screen flex items-center justify-center px-4">
    <div class="max-w-lg w-full">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg">
            <!-- Header -->
            <div class="bg-red-600 text-white rounded-t-lg p-6">
                <div class="flex items-center">
                    <i class="fas fa-exclamation-triangle text-3xl mr-4"></i>
                    <div>
                        <h1 class="text-2xl font-bold">Delete User Account</h1>
                        <p class="text-red-100">This action cannot be undone</p>
                    </div>
                </div>
            </div>

            <!-- User Info -->
            <div class="p-6">
                <div class="mb-6">
                    <p class="text-gray-700 dark:text-gray-300 mb-4">
                        You are about to permanently delete the following user account:
                    </p>
                    
                    <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4">
                        <div class="flex items-center space-x-4">
                            <img src="@(Model?.ProfilePicture ?? "/img/default-avatar.png")" 
                                 alt="@Model?.UserName" 
                                 class="w-16 h-16 rounded-full object-cover"
                                 onerror="this.onerror=null; this.src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"%236b7280\"%3E%3Cpath d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z\"/%3E%3C/svg%3E'">
                            <div>
                                <p class="font-semibold text-gray-900 dark:text-gray-100">@Model?.FirstName @Model?.LastName</p>
                                <p class="text-sm text-gray-600 dark:text-gray-400">@@@Model?.UserName</p>
                                <p class="text-sm text-gray-600 dark:text-gray-400">@Model?.Email</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Warning -->
                <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4 mb-6">
                    <h3 class="text-sm font-semibold text-yellow-800 dark:text-yellow-300 mb-2">
                        <i class="fas fa-exclamation-circle mr-1"></i>Warning: This will permanently delete:
                    </h3>
                    <ul class="text-sm text-yellow-700 dark:text-yellow-400 space-y-1">
                        <li>• User account and profile information</li>
                        <li>• All user-generated content and data</li>
                        <li>• Role assignments and permissions</li>
                        <li>• Login history and audit logs</li>
                        <li>• Any associated files or uploads</li>
                    </ul>
                </div>

                <!-- Confirmation -->
                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Type the username <strong>@Model?.UserName</strong> to confirm:
                    </label>
                    <input type="text" 
                           id="confirmUsername" 
                           class="form-input" 
                           placeholder="Enter username to confirm"
                           data-username="@Model?.UserName">
                    <p class="text-xs text-red-600 mt-1 hidden" id="confirmError">
                        Username doesn't match. Please type it exactly as shown above.
                    </p>
                </div>

                <!-- Additional Options -->
                <div class="space-y-2 mb-6">
                    <label class="flex items-center">
                        <input type="checkbox" id="keepAuditLogs" class="form-checkbox mr-2">
                        <span class="text-sm text-gray-700 dark:text-gray-300">Keep audit logs for compliance</span>
                    </label>
                    <label class="flex items-center">
                        <input type="checkbox" id="notifyUser" class="form-checkbox mr-2">
                        <span class="text-sm text-gray-700 dark:text-gray-300">Send notification email to user</span>
                    </label>
                </div>

                <!-- Actions -->
                <form asp-action="DeleteConfirmed" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="flex justify-between">
                        <a asp-action="Index" class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700">
                            <i class="fas fa-times mr-2"></i>Cancel
                        </a>
                        <button type="submit" 
                                id="deleteBtn" 
                                class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 disabled:opacity-50 disabled:cursor-not-allowed"
                                disabled>
                            <i class="fas fa-trash mr-2"></i>Delete User Permanently
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Additional Info -->
        <div class="mt-4 text-center">
            <p class="text-sm text-gray-600 dark:text-gray-400">
                Need to deactivate instead? 
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="text-blue-600 hover:underline">
                    Edit user to deactivate account
                </a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var expectedUsername = $('#confirmUsername').data('username');
            
            $('#confirmUsername').on('input', function() {
                var enteredUsername = $(this).val();
                var deleteBtn = $('#deleteBtn');
                
                if (enteredUsername === expectedUsername) {
                    deleteBtn.prop('disabled', false);
                    $('#confirmError').addClass('hidden');
                    $(this).removeClass('border-red-500').addClass('border-green-500');
                } else {
                    deleteBtn.prop('disabled', true);
                    if (enteredUsername.length > 0) {
                        $('#confirmError').removeClass('hidden');
                        $(this).addClass('border-red-500').removeClass('border-green-500');
                    } else {
                        $('#confirmError').addClass('hidden');
                        $(this).removeClass('border-red-500 border-green-500');
                    }
                }
            });
            
            $('form').on('submit', function(e) {
                if (!confirm('This is your last chance. Are you absolutely sure you want to delete this user?')) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}