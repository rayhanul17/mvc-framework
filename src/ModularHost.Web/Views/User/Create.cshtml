@model MRCMS.Models.ViewModels.CreateUserViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="container mx-auto px-4 py-8 max-w-3xl">
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Create New User</h1>
        <p class="text-gray-600">Add a new user to the system</p>
    </div>

    <div class="bg-white shadow-md rounded-lg p-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Username -->
                <div class="form-group">
                    <label asp-for="UserName" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <input asp-for="UserName" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
                    <span asp-validation-for="UserName" class="text-red-600 text-sm"></span>
                </div>

                <!-- Email -->
                <div class="form-group">
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <input asp-for="Email" type="email" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
                    <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
                </div>

                <!-- First Name -->
                <div class="form-group">
                    <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <input asp-for="FirstName" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
                    <span asp-validation-for="FirstName" class="text-red-600 text-sm"></span>
                </div>

                <!-- Last Name -->
                <div class="form-group">
                    <label asp-for="LastName" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <input asp-for="LastName" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
                    <span asp-validation-for="LastName" class="text-red-600 text-sm"></span>
                </div>

                <!-- Password -->
                <div class="form-group">
                    <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <input asp-for="Password" type="password" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
                    <span asp-validation-for="Password" class="text-red-600 text-sm"></span>
                </div>

                <!-- Confirm Password -->
                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <input asp-for="ConfirmPassword" type="password" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
                    <span asp-validation-for="ConfirmPassword" class="text-red-600 text-sm"></span>
                </div>

                <!-- Phone Number -->
                <div class="form-group">
                    <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <input asp-for="PhoneNumber" type="tel" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
                    <span asp-validation-for="PhoneNumber" class="text-red-600 text-sm"></span>
                </div>
            </div>

            <!-- Roles -->
            <div class="form-group mt-6">
                <label asp-for="SelectedRoles" class="block text-sm font-medium text-gray-700 mb-2">Roles</label>
                <div class="space-y-2">
                    @foreach (var role in Model.AllRoles)
                    {
                        <label class="inline-flex items-center mr-4">
                            <input type="checkbox" name="SelectedRoles" value="@role" class="rounded border-gray-300 text-indigo-600 shadow-sm focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" />
                            <span class="ml-2">@role</span>
                        </label>
                    }
                </div>
            </div>

            <!-- Status Options -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                <div class="form-group">
                    <label class="inline-flex items-center">
                        <input asp-for="IsActive" type="checkbox" class="rounded border-gray-300 text-indigo-600 shadow-sm focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" />
                        <span class="ml-2">Active</span>
                    </label>
                </div>

                <div class="form-group">
                    <label class="inline-flex items-center">
                        <input asp-for="EmailConfirmed" type="checkbox" class="rounded border-gray-300 text-indigo-600 shadow-sm focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" />
                        <span class="ml-2">Email Confirmed</span>
                    </label>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="flex justify-end space-x-4 mt-8">
                <a asp-action="Index" class="bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded">
                    Cancel
                </a>
                <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                    <i class="fas fa-save mr-2"></i>
                    Create User
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}