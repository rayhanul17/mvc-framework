@model ModularHost.Web.Modules.Blog.Models.Entities.BlogPost
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <article class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden">
        @if (!string.IsNullOrEmpty(Model.FeaturedImage))
        {
            <img src="@Model.FeaturedImage" alt="@Model.Title" class="w-full h-96 object-cover">
        }
        
        <div class="p-8">
            <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">@Model.Title</h1>
            
            <div class="flex items-center text-sm text-gray-600 dark:text-gray-400 mb-6">
                <span class="mr-4">
                    <i class="fas fa-user mr-1"></i> @Model.Author?.UserName
                </span>
                <span class="mr-4">
                    <i class="fas fa-calendar mr-1"></i> @Model.PublishedAt?.ToString("MMMM dd, yyyy")
                </span>
                <span class="mr-4">
                    <i class="fas fa-eye mr-1"></i> @Model.ViewCount views
                </span>
                <span>
                    <i class="fas fa-comment mr-1"></i> @Model.Comments?.Count comments
                </span>
            </div>

            @if (!string.IsNullOrEmpty(Model.TagNames))
            {
                <div class="mb-6">
                    @foreach (var tag in Model.TagNames.Split(','))
                    {
                        <a href="@Url.Action("Index", new { tag = tag.Trim() })" class="inline-block bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full px-3 py-1 text-sm font-semibold mr-2 mb-2 hover:bg-blue-200 dark:hover:bg-blue-800">
                            #@tag.Trim()
                        </a>
                    }
                </div>
            }

            <div class="prose dark:prose-invert max-w-none mb-8">
                @Html.Raw(Model.Content)
            </div>

            @if (User.Identity.IsAuthenticated && (Model.AuthorId.ToString() == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value || User.IsInRole("Administrator")))
            {
                <div class="flex gap-2 mb-8">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2 px-4 rounded">
                        <i class="fas fa-edit mr-2"></i>Edit
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this post?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded">
                            <i class="fas fa-trash mr-2"></i>Delete
                        </button>
                    </form>
                </div>
            }
        </div>
    </article>

    <!-- Comments Section -->
    <div class="mt-8 bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
        <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-gray-100">Comments (@Model.Comments?.Count)</h2>
        
        @if (User.Identity.IsAuthenticated)
        {
            <form asp-action="AddComment" method="post" class="mb-6">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" value="@Model.Id" />
                <div class="mb-4">
                    <textarea name="body" rows="3" class="w-full px-3 py-2 text-gray-700 dark:text-gray-300 border rounded-lg focus:outline-none dark:bg-gray-700 dark:border-gray-600" placeholder="Write a comment..." required></textarea>
                </div>
                <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded">
                    Post Comment
                </button>
            </form>
        }
        else
        {
            <p class="mb-6 text-gray-600 dark:text-gray-400">
                <a href="/Account/Login" class="text-blue-500 hover:underline">Login</a> to comment on this post.
            </p>
        }

        <div id="comments-list">
            @if (Model.Comments != null)
            {
                @foreach (var comment in Model.Comments.Where(c => c.ParentCommentId == null).OrderBy(c => c.CreatedAt))
                {
                    <partial name="_Comment" model="comment" />
                }
            }
        </div>
    </div>
}