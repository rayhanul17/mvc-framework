@model ModularHost.Web.Modules.Blog.Models.Entities.BlogPost
@{
    ViewData["Title"] = "Edit Blog Post";
}

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-6">Edit Blog Post</h1>
        
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>
            
            <div class="mb-4">
                <label asp-for="Title" class="block text-gray-700 dark:text-gray-300 text-sm font-bold mb-2">Title</label>
                <input asp-for="Title" class="w-full px-3 py-2 text-gray-700 dark:text-gray-300 border rounded-lg focus:outline-none focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600" />
                <span asp-validation-for="Title" class="text-red-600 text-sm"></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="Summary" class="block text-gray-700 dark:text-gray-300 text-sm font-bold mb-2">Summary</label>
                <textarea asp-for="Summary" rows="2" class="w-full px-3 py-2 text-gray-700 dark:text-gray-300 border rounded-lg focus:outline-none focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600"></textarea>
                <span asp-validation-for="Summary" class="text-red-600 text-sm"></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="Content" class="block text-gray-700 dark:text-gray-300 text-sm font-bold mb-2">Content</label>
                <textarea asp-for="Content" rows="15" class="w-full px-3 py-2 text-gray-700 dark:text-gray-300 border rounded-lg focus:outline-none focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600" required></textarea>
                <span asp-validation-for="Content" class="text-red-600 text-sm"></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="FeaturedImage" class="block text-gray-700 dark:text-gray-300 text-sm font-bold mb-2">Featured Image URL</label>
                <input asp-for="FeaturedImage" class="w-full px-3 py-2 text-gray-700 dark:text-gray-300 border rounded-lg focus:outline-none focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600" placeholder="https://example.com/image.jpg" />
                <span asp-validation-for="FeaturedImage" class="text-red-600 text-sm"></span>
            </div>
            
            <div class="mb-6">
                <label for="TagInput" class="block text-gray-700 dark:text-gray-300 text-sm font-bold mb-2">Tags (comma-separated)</label>
                <input name="TagInput" id="TagInput" class="w-full px-3 py-2 text-gray-700 dark:text-gray-300 border rounded-lg focus:outline-none focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600" placeholder="technology, programming, web" value="@Model.TagNames" />
                <span class="text-red-600 text-sm field-validation-valid" data-valmsg-for="TagInput"></span>
            </div>
            
            <div class="flex gap-2">
                <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded">
                    <i class="fas fa-save mr-2"></i>Update Post
                </button>
                <a asp-action="Details" asp-route-slug="@Model.Slug" class="bg-gray-500 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded">
                    Cancel
                </a>
            </div>
        </form>
    </div>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}