@model MRCMS.Modules.Blog.Models.Entities.Category
@{
    ViewBag.Title = "Delete Category";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Delete Category
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger" role="alert">
                        <h4 class="alert-heading">Warning!</h4>
                        <p>Are you sure you want to delete this category? This action cannot be undone.</p>
                    </div>
                    
                    <dl class="row">
                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">
                            <strong>@Model.Name</strong>
                        </dd>
                        
                        <dt class="col-sm-3">Slug</dt>
                        <dd class="col-sm-9">
                            <code>@Model.Slug</code>
                        </dd>
                        
                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                @Model.Description
                            }
                            else
                            {
                                <span class="text-muted">No description</span>
                            }
                        </dd>
                        
                        @if (Model.Parent != null)
                        {
                            <dt class="col-sm-3">Parent Category</dt>
                            <dd class="col-sm-9">@Model.Parent.Name</dd>
                        }
                        
                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Inactive</span>
                            }
                        </dd>
                    </dl>
                    
                    @if (Model.Children != null && Model.Children.Any(c => !c.IsDeleted))
                    {
                        <div class="alert alert-warning">
                            <h5 class="alert-heading">Cannot Delete - Has Child Categories</h5>
                            <p>This category has @Model.Children.Count(c => !c.IsDeleted) child categories. Please delete or reassign these child categories first:</p>
                            <ul class="mb-0">
                                @foreach (var child in Model.Children.Where(c => !c.IsDeleted))
                                {
                                    <li>@child.Name</li>
                                }
                            </ul>
                        </div>
                    }
                    
                    @if (Model.BlogPosts != null && Model.BlogPosts.Any(p => !p.IsDeleted))
                    {
                        <div class="alert alert-warning">
                            <h5 class="alert-heading">Cannot Delete - Has Blog Posts</h5>
                            <p>This category contains @Model.BlogPosts.Count(p => !p.IsDeleted) blog posts. Please remove or reassign these posts first:</p>
                            <ul class="mb-0">
                                @foreach (var post in Model.BlogPosts.Where(p => !p.IsDeleted).Take(5))
                                {
                                    <li>@post.Title</li>
                                }
                                @if (Model.BlogPosts.Count(p => !p.IsDeleted) > 5)
                                {
                                    <li>... and @(Model.BlogPosts.Count(p => !p.IsDeleted) - 5) more</li>
                                }
                            </ul>
                        </div>
                    }
                    
                    <form asp-action="DeleteConfirmed" method="post">
                        <input asp-for="Id" type="hidden" />
                        
                        @if ((Model.Children == null || !Model.Children.Any(c => !c.IsDeleted)) && 
                             (Model.BlogPosts == null || !Model.BlogPosts.Any(p => !p.IsDeleted)))
                        {
                            <div class="form-group">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" class="custom-control-input" id="confirmDelete" required>
                                    <label class="custom-control-label" for="confirmDelete">
                                        I understand that this action cannot be undone
                                    </label>
                                </div>
                            </div>
                            
                            <button type="submit" class="btn btn-danger" id="deleteBtn" disabled>
                                <i class="fas fa-trash"></i> Delete Category
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-danger" disabled>
                                <i class="fas fa-ban"></i> Cannot Delete (Has Dependencies)
                            </button>
                        }
                        
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#confirmDelete').change(function() {
                $('#deleteBtn').prop('disabled', !$(this).is(':checked'));
            });
        });
    </script>
}