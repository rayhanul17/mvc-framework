@model MRCMS.Modules.Blog.Models.Entities.Tag
@{
    ViewBag.Title = "Create Tag";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-plus-circle"></i> Create New Tag
                    </h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Name" class="control-label">Name <span class="text-danger">*</span></label>
                                    <input asp-for="Name" class="form-control" placeholder="Enter tag name" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Slug" class="control-label">Slug</label>
                                    <input asp-for="Slug" class="form-control" placeholder="Leave empty to auto-generate" />
                                    <span asp-validation-for="Slug" class="text-danger"></span>
                                    <small class="form-text text-muted">URL-friendly version of the name. Will be auto-generated if left empty.</small>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Description" class="control-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter tag description (optional)"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label">Status</label>
                                    <div class="custom-control custom-switch mt-2">
                                        <input asp-for="IsActive" type="checkbox" class="custom-control-input" id="isActiveSwitch" checked />
                                        <label class="custom-control-label" for="isActiveSwitch">Active</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Create Tag
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto-generate slug from name
        $(document).ready(function() {
            $('#Name').on('blur', function() {
                var name = $(this).val();
                var slug = $('#Slug').val();
                
                if (name && !slug) {
                    // Generate slug from name
                    slug = name.toLowerCase()
                        .replace(/[^a-z0-9\s-]/g, '')
                        .replace(/\s+/g, '-')
                        .replace(/-+/g, '-')
                        .trim('-');
                    
                    $('#Slug').val(slug);
                }
            });
        });
    </script>
}