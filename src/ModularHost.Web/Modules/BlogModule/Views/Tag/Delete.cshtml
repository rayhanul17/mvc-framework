@model MRCMS.Modules.Blog.Models.Entities.Tag
@{
    ViewBag.Title = "Delete Tag";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Delete Tag
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger" role="alert">
                        <h4 class="alert-heading">Warning!</h4>
                        <p>Are you sure you want to delete this tag? This action cannot be undone.</p>
                    </div>
                    
                    <dl class="row">
                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">
                            <strong class="badge badge-primary">@Model.Name</strong>
                        </dd>
                        
                        <dt class="col-sm-3">Slug</dt>
                        <dd class="col-sm-9">
                            <code>@Model.Slug</code>
                        </dd>
                        
                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                @Model.Description
                            }
                            else
                            {
                                <span class="text-muted">No description</span>
                            }
                        </dd>
                        
                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Inactive</span>
                            }
                        </dd>
                        
                        <dt class="col-sm-3">Created</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</dd>
                    </dl>
                    
                    @if (Model.BlogPosts != null && Model.BlogPosts.Any(p => !p.IsDeleted))
                    {
                        <div class="alert alert-warning">
                            <h5 class="alert-heading">Tag Has Blog Posts</h5>
                            <p>This tag is currently used in @Model.BlogPosts.Count(p => !p.IsDeleted) blog posts. Deleting this tag will remove it from all these posts:</p>
                            <div class="list-group">
                                @foreach (var post in Model.BlogPosts.Where(p => !p.IsDeleted).Take(5))
                                {
                                    <div class="list-group-item">
                                        <i class="fas fa-newspaper"></i> @post.Title
                                        @if (post.IsPublished)
                                        {
                                            <span class="badge badge-success float-right">Published</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning float-right">Draft</span>
                                        }
                                    </div>
                                }
                                @if (Model.BlogPosts.Count(p => !p.IsDeleted) > 5)
                                {
                                    <div class="list-group-item text-muted">
                                        ... and @(Model.BlogPosts.Count(p => !p.IsDeleted) - 5) more posts
                                    </div>
                                }
                            </div>
                            <p class="mt-3 mb-0"><strong>Note:</strong> You may want to consider merging this tag with another tag instead of deleting it.</p>
                        </div>
                    }
                    
                    <form asp-action="DeleteConfirmed" method="post">
                        <input asp-for="Id" type="hidden" />
                        
                        @if (Model.BlogPosts == null || !Model.BlogPosts.Any(p => !p.IsDeleted))
                        {
                            <div class="form-group">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" class="custom-control-input" id="confirmDelete" required>
                                    <label class="custom-control-label" for="confirmDelete">
                                        I understand that this action cannot be undone
                                    </label>
                                </div>
                            </div>
                            
                            <button type="submit" class="btn btn-danger" id="deleteBtn" disabled>
                                <i class="fas fa-trash"></i> Delete Tag
                            </button>
                        }
                        else
                        {
                            <div class="form-group">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" class="custom-control-input" id="confirmDeleteWithPosts" required>
                                    <label class="custom-control-label" for="confirmDeleteWithPosts">
                                        I understand this will remove the tag from @Model.BlogPosts.Count(p => !p.IsDeleted) posts and cannot be undone
                                    </label>
                                </div>
                            </div>
                            
                            <button type="submit" class="btn btn-danger" id="deleteBtnWithPosts" disabled>
                                <i class="fas fa-trash"></i> Delete Tag and Remove from Posts
                            </button>
                            
                            <div class="mt-3">
                                <p class="text-info">
                                    <i class="fas fa-info-circle"></i> 
                                    <strong>Alternative:</strong> Consider using the 
                                    <a asp-action="Index" class="text-primary">Merge Tags</a> 
                                    feature to combine this tag with another one.
                                </p>
                            </div>
                        }
                        
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#confirmDelete').change(function() {
                $('#deleteBtn').prop('disabled', !$(this).is(':checked'));
            });
            
            $('#confirmDeleteWithPosts').change(function() {
                $('#deleteBtnWithPosts').prop('disabled', !$(this).is(':checked'));
            });
        });
    </script>
}