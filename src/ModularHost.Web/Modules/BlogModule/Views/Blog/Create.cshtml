@model MRCMS.Modules.Blog.Models.DTOs.CreateBlogPostDto
@using MRCMS.Core.Extensions
@inject IPermissionHelper PermissionHelper
@{
    ViewData["Title"] = "Create Blog Post";
}

<div class="container mx-auto px-4 py-8 max-w-5xl">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8">
        <div class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Create New Blog Post</h1>
            <p class="text-gray-600 dark:text-gray-400 mt-2">Share your thoughts with the world</p>
        </div>
        
        <form asp-action="Create" method="post" enctype="multipart/form-data" id="blogForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>
            
            <div class="space-y-6">
                <!-- Title -->
                <div>
                    <label asp-for="Title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Title <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Title" 
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                           placeholder="Enter an engaging title"
                           required />
                    <span asp-validation-for="Title" class="text-red-600 text-sm"></span>
                </div>

                <!-- Slug -->
                <div>
                    <label asp-for="Slug" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        URL Slug
                    </label>
                    <input asp-for="Slug" 
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                           placeholder="auto-generated-from-title" />
                    <span asp-validation-for="Slug" class="text-red-600 text-sm"></span>
                    <small class="text-gray-500 dark:text-gray-400">Leave empty to auto-generate from title</small>
                </div>
            
                <!-- Summary -->
                <div>
                    <label asp-for="Summary" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Summary
                    </label>
                    <textarea asp-for="Summary" 
                              rows="3"
                              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                              placeholder="A brief summary of your post"></textarea>
                    <span asp-validation-for="Summary" class="text-red-600 text-sm"></span>
                </div>

                <!-- Category and Tags -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="CategoryId" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Category
                        </label>
                        <select asp-for="CategoryId" id="CategoryId"
                                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white">
                            <option value="">Select a category</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-red-600 text-sm"></span>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Tags
                        </label>
                        <input type="text" 
                               id="tagInput"
                               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                               placeholder="Type and press Enter to add tags" />
                        <div id="selectedTags" class="flex flex-wrap gap-2 mt-2"></div>
                        <input type="hidden" name="TagIds" id="tagIds" />
                    </div>
                </div>
            
                <!-- Featured Image -->
                <div>
                    <label asp-for="FeaturedImage" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Featured Image
                    </label>
                    <div class="flex items-center space-x-4">
                        <input type="file" 
                               id="imageUpload"
                               accept="image/*"
                               class="hidden" />
                        <button type="button" 
                                onclick="document.getElementById('imageUpload').click()"
                                class="px-4 py-2 bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-500">
                            <i class="fas fa-upload mr-2"></i>Choose Image
                        </button>
                        <input asp-for="FeaturedImage" 
                               id="FeaturedImage"
                               class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                               placeholder="Or enter image URL" />
                    </div>
                    <div id="imagePreview" class="mt-4 hidden">
                        <img src="" alt="Preview" class="max-w-xs rounded-lg shadow-md" />
                    </div>
                </div>

                <!-- Content with Summernote -->
                <div>
                    <label asp-for="Content" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Content <span class="text-red-500">*</span>
                    </label>
                    <textarea asp-for="Content" 
                              id="summernote"
                              class="w-full"
                              required></textarea>
                    <span asp-validation-for="Content" class="text-red-600 text-sm"></span>
                </div>

                <!-- Publish Options -->
                <div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-4">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Publishing Options</h3>
                    
                    <div class="space-y-4">
                        <div class="flex items-center">
                            <input asp-for="IsPublished" 
                                   type="checkbox"
                                   checked="checked"
                                   class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:bg-gray-600 dark:border-gray-500" />
                            <label asp-for="IsPublished" class="ml-2 text-sm font-medium text-gray-900 dark:text-gray-300">
                                Publish immediately
                            </label>
                        </div>

                        <!-- AllowComments can be added to DTO if needed -->
                    </div>
                </div>
            
                <!-- Action Buttons -->
                <div class="flex justify-between items-center pt-6 border-t border-gray-200 dark:border-gray-700">
                    <a asp-action="Index" class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100">
                        <i class="fas fa-arrow-left mr-2"></i>Back to Posts
                    </a>
                    
                    <div class="space-x-3">
                        <button type="button" 
                                onclick="saveDraft()"
                                class="px-6 py-2 bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-500">
                            <i class="fas fa-save mr-2"></i>Save Draft
                        </button>
                        <button type="submit" 
                                class="px-6 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">
                            <i class="fas fa-paper-plane mr-2"></i>Publish Post
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link href="~/lib/summernote/summernote-lite.min.css" rel="stylesheet" asp-append-version="true">
}

@section Scripts {
    <script src="~/lib/summernote/summernote-lite.min.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            // Initialize Summernote
            $('#summernote').summernote({
                placeholder: 'Write your blog content here...',
                tabsize: 2,
                height: 400,
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'underline', 'clear']],
                    ['fontname', ['fontname']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link', 'picture', 'video']],
                    ['view', ['fullscreen', 'codeview', 'help']]
                ],
                callbacks: {
                    onChange: function(contents, $editable) {
                        $('#Content').val(contents);
                    },
                    onImageUpload: function(files) {
                        uploadImage(files[0]);
                    }
                }
            });

            // Load categories
            loadCategories();

            // Auto-generate slug
            $('#Title').on('blur', function() {
                if (!$('#Slug').val()) {
                    $('#Slug').val(generateSlug($(this).val()));
                }
            });

            // Tag input handling
            $('#tagInput').on('keypress', function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    addTag($(this).val());
                    $(this).val('');
                }
            });

            // Image preview
            $('#imageUpload').on('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        $('#imagePreview img').attr('src', e.target.result);
                        $('#imagePreview').removeClass('hidden');
                        $('#FeaturedImage').val(e.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });

            $('#FeaturedImage').on('input', function() {
                const url = $(this).val();
                if (url) {
                    $('#imagePreview img').attr('src', url);
                    $('#imagePreview').removeClass('hidden');
                } else {
                    $('#imagePreview').addClass('hidden');
                }
            });

            // Form submission
            $('#blogForm').on('submit', function(e) {
                if ($('#summernote').summernote('isEmpty')) {
                    e.preventDefault();
                    notification.error('Content is required');
                    return false;
                }
                
                $('#Content').val($('#summernote').summernote('code'));
                updateTagInput();
                loader.show('Saving blog post...');
            });
        });

        function loadCategories() {
            fetch('/Blog/categories')
                .then(response => {
                    if (response.headers.get('content-type')?.includes('application/json')) {
                        return response.json();
                    } else {
                        // If HTML is returned, we need to fetch the data differently
                        return [];
                    }
                })
                .then(categories => {
                    const select = $('#CategoryId');
                    if (Array.isArray(categories)) {
                        categories.forEach(cat => {
                            select.append(`<option value="${cat.id}">${cat.name}</option>`);
                        });
                    }
                })
                .catch(error => console.error('Failed to load categories:', error));
        }

        const selectedTags = new Set();

        function addTag(tagName) {
            tagName = tagName.trim();
            if (!tagName || selectedTags.has(tagName)) return;
            
            selectedTags.add(tagName);
            updateTagDisplay();
            updateTagInput();
        }

        function removeTag(tagName) {
            selectedTags.delete(tagName);
            updateTagDisplay();
            updateTagInput();
        }

        function updateTagDisplay() {
            const container = $('#selectedTags');
            container.empty();
            
            selectedTags.forEach(tag => {
                container.append(`
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                        ${tag}
                        <button type="button" onclick="removeTag('${tag}')" class="ml-2 text-blue-600 hover:text-blue-800">
                            <i class="fas fa-times"></i>
                        </button>
                    </span>
                `);
            });
        }

        function updateTagInput() {
            // For now, we'll just store the tag names as a comma-separated string
            // The backend will need to handle creating/finding tags by name
            $('#tagIds').val(Array.from(selectedTags).join(','));
        }

        function saveDraft() {
            $('#IsPublished').prop('checked', false);
            $('#blogForm').submit();
        }

        function uploadImage(file) {
            loader.show('Uploading image...');
            
            const data = new FormData();
            data.append("file", file);
            
            fetch('/Blog/UploadImage', {
                method: 'POST',
                body: data,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.url) {
                    $('#summernote').summernote('insertImage', data.url);
                    notification.success('Image uploaded successfully');
                } else {
                    notification.error('Failed to upload image');
                }
                loader.hide();
            })
            .catch(error => {
                notification.error('Error uploading image');
                loader.hide();
            });
        }
    </script>
}