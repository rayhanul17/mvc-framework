@using MRCMS.Core.Helpers
@using System.IO
@model MRCMS.Modules.Blog.Models.Entities.Comment

<div class="border-l-2 border-gray-200 dark:border-gray-700 pl-4 mb-4">
    <div class="flex items-start space-x-3">
        <div class="flex-shrink-0">
            <div class="w-10 h-10 rounded-full bg-gray-300 dark:bg-gray-600 flex items-center justify-center">
                <i class="fas fa-user text-gray-600 dark:text-gray-400"></i>
            </div>
        </div>
        <div class="flex-1">
            <div class="flex items-center">
                <h4 class="text-sm font-semibold text-gray-900 dark:text-gray-100">@Model.User?.UserName</h4>
                <span class="ml-2 text-xs text-gray-500 dark:text-gray-400">@Model.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</span>
            </div>
            <p class="mt-1 text-sm text-gray-700 dark:text-gray-300">@Model.Body</p>
            
            @if (!string.IsNullOrEmpty(Model.AttachmentPath))
            {
                <div class="mt-2 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                    <div class="flex items-center">
                        <i class="@FileUploadHelper.GetFileIcon(Model.AttachmentFileName ?? "") mr-2"></i>
                        <a href="/uploads/comments/@(System.IO.Path.GetFileName(Model.AttachmentPath ?? ""))" target="_blank" 
                           class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">
                            @Model.AttachmentFileName
                        </a>
                        <span class="ml-2 text-xs text-gray-500">
                            (@FileUploadHelper.FormatFileSize(Model.AttachmentSize ?? 0))
                        </span>
                    </div>
                </div>
            }
            
            @if (User.Identity.IsAuthenticated)
            {
                <button onclick="toggleReplyForm(@Model.Id)" class="mt-2 text-xs text-blue-500 hover:underline">
                    Reply
                </button>
                
                <div id="reply-form-@Model.Id" class="hidden mt-3">
                    <form asp-action="AddComment" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="postId" value="@Model.PostId" />
                        <input type="hidden" name="parentCommentId" value="@Model.Id" />
                        <textarea name="body" rows="2" class="w-full px-3 py-2 text-sm text-gray-700 dark:text-gray-300 border rounded-lg focus:outline-none dark:bg-gray-700 dark:border-gray-600" placeholder="Write a reply..." required></textarea>
                        <div class="mt-2">
                            <input type="file" name="attachment" accept=".pdf,.doc,.docx,.txt,.jpg,.jpeg,.png,.gif" 
                                   class="text-xs mb-2 w-full px-2 py-1 border rounded focus:outline-none dark:bg-gray-700 dark:border-gray-600 dark:text-gray-300" />
                        </div>
                        <div class="mt-2">
                            <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white text-xs font-bold py-1 px-3 rounded">
                                <i class="fas fa-reply mr-1"></i>Post Reply
                            </button>
                            <button type="button" onclick="toggleReplyForm(@Model.Id)" class="ml-2 text-xs text-gray-500 hover:underline">
                                Cancel
                            </button>
                        </div>
                    </form>
                </div>
            }
            
            @if (Model.Replies != null && Model.Replies.Any())
            {
                <div class="mt-4">
                    @foreach (var reply in Model.Replies.OrderBy(r => r.CreatedAt))
                    {
                        <partial name="_Comment" model="reply" />
                    }
                </div>
            }
        </div>
    </div>
</div>

<script>
    function toggleReplyForm(commentId) {
        var form = document.getElementById('reply-form-' + commentId);
        if (form) {
            form.classList.toggle('hidden');
        }
    }
</script>