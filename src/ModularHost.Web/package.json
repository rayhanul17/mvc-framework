{
  "name": "modularhost-web",
  "version": "1.0.0",
  "description": "Modular Host Web Application",
  "scripts": {
    "build-css": "tailwindcss -i ./wwwroot/lib/tailwind/tailwind.input.css -o ./wwwroot/lib/tailwind/tailwind-compiled.css --minify",
    "watch-css": "tailwindcss -i ./wwwroot/lib/tailwind/tailwind.input.css -o ./wwwroot/lib/tailwind/tailwind-compiled.css --watch",
    "build": "npm run build-css",
    "dev": "npm run watch-css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10"
  }
}